@{
    ViewData["Title"] = "تمدید دوره";
}

<div class="row g-3">
    <div class="col-lg-3 col-md-4">
        <div class="card">
            <div class="card-header"><i class="bi bi-list-ul"></i> دسته‌بندی ورزش‌ها</div>
            <div class="card-body p-0">
                <ul id="categoryList" class="list-group list-group-flush">
                    <li class="list-group-item text-center text-muted">در حال بارگذاری...</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-9 col-md-8">
        <div class="card">
            <div class="card-header"><i class="bi bi-arrow-repeat"></i> سانس‌های قابل تمدید</div>
            <div class="card-body">
                <div id="sanseList">
                    <div class="empty-state"><div class="empty-icon">⏳</div>در حال بارگذاری...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* === تقویم روزهای اداری === *@
<div class="modal fade" id="datePickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-calendar3"></i> انتخاب تاریخ شروع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="prevMonth">›</button>
                    <strong id="currentMonthLabel" class="fs-5"></strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="nextMonth">‹</button>
                </div>
                <table class="cal-table">
                    <thead class="text-center">
                        <tr>
                            <th>شنبه</th>
                            <th>یک شنبه</th>
                            <th>دو شنبه</th>
                            <th>سه شنبه</th>
                            <th>چهار شنبه</th>
                            <th>پنج شنبه</th>
                            <th>جمعه</th>
                        </tr>
                    </thead>
                    <tbody id="calendarBody"></tbody>
                </table>
                <div class="alert alert-info mt-3 mb-0 small">
                    <i class="bi bi-info-circle"></i>
                    فقط تاریخ‌های امروز و آینده قابل انتخاب هستند.
                </div>
            </div>
        </div>
    </div>
</div>

@* === مودال تمدید === *@
<div class="modal fade" id="renewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-arrow-repeat"></i> تأیید تمدید دوره</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="renewInfo" class="mb-3"></div>
                <label class="form-label"><i class="bi bi-calendar-event"></i> تاریخ شروع دوره</label>
                <div class="input-group">
                    <input type="text" id="renewStartDate" class="form-control" placeholder="انتخاب کنید" readonly />
                    <button type="button" class="btn btn-outline-primary" id="btnOpenCalendar">
                        <i class="bi bi-calendar3"></i>
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnConfirmRenew">
                    <i class="bi bi-check-lg"></i> تأیید و تمدید
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var selectedSanse = null;
    var todayPersian = todayJalaliStr();

    function loadCategories() {
        apiCall('/api/Register/SportCategories', 'GET', null, function (res) {
            var html = '<li class="list-group-item list-group-item-action active" data-id="0" onclick="filterSanses(0)"><i class="bi bi-grid"></i> همه</li>';
            $.each(res.data, function (i, c) {
                html += '<li class="list-group-item list-group-item-action" data-id="' + c.sportCatID + '" onclick="filterSanses(' + c.sportCatID + ')">' + esc(c.sportName) + '</li>';
            });
            $('#categoryList').html(html);
        });
    }

    function filterSanses(catId) {
        $('#categoryList li').removeClass('active');
        $('#categoryList li[data-id="' + catId + '"]').addClass('active');
        var url = '/api/Register/SansesForRenew' + (catId > 0 ? '?sportCatID=' + catId : '');
        apiCall(url, 'GET', null, function (res) {
            var html = '';
            if (!res.data || res.data.length === 0) {
                html = '<div class="empty-state"><div class="empty-icon">🔍</div>سانسی یافت نشد</div>';
            } else {
                $.each(res.data, function (i, s) {
                    html += '<div class="sanse-card" data-id="' + s.sportSanseID + '" data-name="' + esc(s.sportName + ' - ' + s.sanseName) + '" data-amount="' + esc(s.totalAmountDisplay) + '">' +
                        '<div class="sanse-top">' +
                            '<div class="sanse-sport"><i class="bi bi-trophy"></i> ' + esc(s.sportName) + '</div>' +
                            '<div class="sanse-name">' + esc(s.sanseName) + '</div>' +
                        '</div>' +
                        '<div class="sanse-body">' +
                            '<div class="sanse-info">' +
                                '<span class="sanse-badge"><i class="bi bi-person"></i> ' + esc(s.coachName || 'بدون مربی') + '</span>' +
                                '<span class="sanse-badge"><i class="bi bi-tag"></i> ' + esc(s.membershipTypeDesc || '-') + '</span>' +
                                '<span class="sanse-badge"><i class="bi bi-clock-history"></i> ' + esc(s.periodDesc || '-') + '</span>' +
                            '</div>' +
                            '<div class="sanse-price">' + esc(s.totalAmountDisplay) + '</div>' +
                            '<button class="btn btn-primary sanse-btn renew-btn"><i class="bi bi-arrow-repeat"></i> تمدید دوره</button>' +
                        '</div>' +
                    '</div>';
                });
            }
            $('#sanseList').html(html);

            // event delegation
            $('.renew-btn').off('click').on('click', function () {
                var card = $(this).closest('.sanse-card');
                var id = card.data('id');
                var name = card.data('name');
                var amount = card.data('amount');
                openRenew(id, name, amount);
            });
        });
    }

    function openRenew(id, name, display) {
        selectedSanse = id;
        $('#renewInfo').html(
            '<div class="alert alert-light border">' +
                '<strong>ورزش:</strong> ' + name + '<br/>' +
                '<strong>مبلغ:</strong> <span class="text-primary">' + display + '</span>' +
            '</div>'
        );
        $('#renewStartDate').val(todayPersian);
        new bootstrap.Modal('#renewModal').show();
    }

    $('#btnOpenCalendar').click(function () {
        bootstrap.Modal.getInstance('#renewModal').hide();
        initCalendar('renewStartDate', '#renewModal');
        new bootstrap.Modal('#datePickerModal').show();
    });
    $('#prevMonth').click(function () {
        calendarDate.m++;
        if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
        renderCalendar();
    });
    $('#nextMonth').click(function () {
        calendarDate.m--;
        if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
        renderCalendar();
    });

    $('#btnConfirmRenew').click(function () {
        var date = $.trim($('#renewStartDate').val());
        if (!date) { showToast('تاریخ شروع را انتخاب کنید', 'error'); return; }
        apiCall('/api/Register/Renew', 'POST', { sportSanseID: selectedSanse, startDate: date }, function (res) {
            if (res.success) {
                showToast(res.message, 'success');
                bootstrap.Modal.getInstance('#renewModal').hide();
                filterSanses($('#categoryList li.active').data('id') || 0);
            } else { showToast(res.message, 'error'); }
        });
    });

    function esc(str) {
        if (str === null || str === undefined) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    $(function () { loadCategories(); filterSanses(0); });
</script>
}
