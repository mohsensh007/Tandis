@{
    ViewData["Title"] = "ثبت‌نام / تمدید دوره";
}

<!-- ========== هدر صفحه ========== -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-arrow-repeat hd-icon"></i> ثبت‌نام / تمدید دوره</h5>
    <a href="/Home" class="purple-style btn-back-glass"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

<div class="row g-3">
    <!-- ========== دسته‌بندی ورزش‌ها ========== -->
    <div class="col-lg-3 col-md-4">
        <div class="glass-card">
            <div class="card-header grad-header"><i class="bi bi-list-ul me-2"></i>دسته‌بندی ورزش‌ها</div>
            <div class="purple-style card-body p-2">
                <ul id="categoryList">
                    <li class="cat-item text-center text-muted">در حال بارگذاری...</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ========== سانس‌های قابل ثبت‌نام / تمدید ========== -->
    <div class="col-lg-9 col-md-8">
        <div class="purple-style glass-card">
            <div class="card-header grad-header"><i class="bi bi-arrow-repeat me-2"></i>سانس‌های قابل ثبت‌نام / تمدید</div>
            <div class="card-body">
                <div id="sanseList" class="row g-3">
                    <div class="col-12"><div class="empty-state"><div class="empty-icon">⏳</div>در حال بارگذاری...</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* === تقویم روزهای اداری === *@
<div class="modal fade" id="datePickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header grad-header">
                <h5 class="modal-title"><i class="bi bi-calendar3 me-2"></i>انتخاب تاریخ شروع</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-sm btn-outline-light px-3" id="prevMonth">›</button>
                    <strong id="currentMonthLabel" class="fs-5"></strong>
                    <button type="button" class="btn btn-sm btn-outline-light px-3" id="nextMonth">‹</button>
                </div>
                <table class="cal-table">
                    <thead class="text-center">
                        <tr>
                            <th>شنبه</th>
                            <th>یک شنبه</th>
                            <th>دو شنبه</th>
                            <th>سه شنبه</th>
                            <th>چهار شنبه</th>
                            <th>پنج شنبه</th>
                            <th>جمعه</th>
                        </tr>
                    </thead>
                    <tbody id="calendarBody"></tbody>
                </table>
                <div class="renew-info-box mt-3 mb-0 small">
                    <i class="bi bi-info-circle hd-icon"></i>
                    فقط تاریخ‌های امروز و آینده قابل انتخاب هستند.
                </div>
            </div>
        </div>
    </div>
</div>

@* === مودال ثبت‌نام / تمدید === *@
<div class="modal fade" id="renewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="purple-style modal-content glass-modal">
            <div class="modal-header grad-header">
                <h5 class="modal-title" id="renewModalTitle"><i class="bi bi-arrow-repeat me-2"></i>تأیید تمدید دوره</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="renewInfo" class="mb-3"></div>
                <label class="form-label small text-muted"><i class="bi bi-calendar-event hd-icon"></i> تاریخ شروع دوره</label>
                <div class="input-group">
                    <input type="text" id="renewStartDate" class="form-control" placeholder="انتخاب کنید" readonly />
                    <button type="button" class="btn btn-outline-info" id="btnOpenCalendar">
                        <i class="bi bi-calendar3"></i>
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-renew px-4" id="btnConfirmRenew">
                    <i class="bi bi-check-lg me-1"></i> تأیید و تمدید
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .hd-icon {
        color: var(--g-primary);
        margin-left: 6px;
        font-size: 1.05rem;
    }

    .glass-card {
        background: color-mix(in srgb, var(--g-nested-solid) 5%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 12%, transparent);
        border-radius: 18px;
        overflow: hidden;
    }

    .grad-header {
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        color: var(--g-text);
        font-weight: 800;
        font-size: 1rem;
        padding: 13px 20px;
        border-bottom: 1px solid color-mix(in srgb, var(--g-text) 15%, transparent);
    }

        .grad-header i {
            font-size: 1.1rem;
        }

    #categoryList {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cat-item {
        border-radius: 12px;
        background: color-mix(in srgb, var(--g-nested-solid) 6%, transparent);
        border: 1px solid transparent;
        color: color-mix(in srgb, var(--g-text) 62%, transparent);
        cursor: pointer;
        padding: 10px 16px;
        font-size: .88rem;
        font-weight: 600;
        transition: all .25s;
        display: flex;
        align-items: center;
    }

        .cat-item::before {
            content: '';
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--g-primary);
            box-shadow: 0 0 6px color-mix(in srgb, var(--g-primary) 80%, transparent);
            display: inline-block;
            margin-left: 10px;
            flex: 0 0 auto;
        }

        .cat-item:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
            color: var(--g-text);
        }

        .cat-item.active {
            background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
            border-color: color-mix(in srgb, var(--g-text) 25%, transparent);
            color: var(--g-text);
        }

            .cat-item.active::before {
                background: var(--g-primary);
                box-shadow: none;
            }

    @@media (max-width: 767.98px) {
        #categoryList {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 8px;
        }

        .cat-item {
            flex: 0 0 auto;
            border-radius: 999px;
            padding: 8px 20px;
            font-size: .8rem;
            background: color-mix(in srgb, var(--g-nested-solid) 10%, transparent);
            border: 1px solid color-mix(in srgb, var(--g-text) 16%, transparent);
            -webkit-backdrop-filter: blur(6px);
            backdrop-filter: blur(6px);
        }

            .cat-item::before {
                display: none;
            }

            .cat-item.active {
                background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
                border-color: color-mix(in srgb, var(--g-text) 30%, transparent);
                box-shadow: 0 4px 14px color-mix(in srgb, var(--g-primary) 45%, transparent);
            }
    }

    .sans-card {
        position: relative;
        border-radius: 20px;
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        padding: 16px;
        overflow: hidden;
        height: 100%;
    }

        .sans-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-nested-solid) 30%, transparent), transparent 70%);
            pointer-events: none;
        }

    .sans-name {
        font-weight: 800;
        font-size: 1.02rem;
        color: var(--g-text);
        display: flex;
        align-items: center;
    }

        .sans-name .hd-icon {
            font-size: 1rem;
        }

    .sans-coach {
        font-size: .8rem;
        color: var(--g-text);
        margin-top: 4px;
    }

    .sans-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .75rem;
        font-weight: 700;
    }

        .sans-pill i {
            color: var(--g-primary);
            font-size: .85rem;
        }

    .renew-price {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        border-radius: 14px;
        padding: 8px 14px;
        color: var(--g-text);
        font-weight: 800;
        font-size: .9rem;
    }

        .renew-price i {
            color: var(--g-primary);
            font-size: 1.15rem;
        }

    .btn-renew {
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        border: none;
        color: var(--g-text);
        font-weight: 700;
        border-radius: 14px;
        padding: 10px;
        box-shadow: 0 6px 18px color-mix(in srgb, var(--g-primary) 40%, transparent);
    }

        .btn-renew:hover, .btn-renew:focus {
            filter: brightness(1.08);
            color: var(--g-text);
        }

    .glass-modal {
        background: color-mix(in srgb, var(--g-surface-solid) 97%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 15%, transparent);
        border-radius: 18px;
        color: var(--g-text);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
    }

        .glass-modal .form-control {
            background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
            border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
            color: var(--g-text);
        }

            .glass-modal .form-control::placeholder {
                color: color-mix(in srgb, var(--g-text) 62%, transparent);
            }

    .renew-info-box {
        background: color-mix(in srgb, var(--g-nested-solid) 6%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 12%, transparent);
        border-radius: 14px;
        padding: 14px;
    }

    .btn-back-glass {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .btn-back-glass i {
            color: var(--g-primary);
            transition: transform .25s;
        }

        .btn-back-glass:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
            color: var(--g-text);
            border-color: color-mix(in srgb, var(--g-primary) 45%, transparent);
        }

            .btn-back-glass:hover i {
                transform: translateX(3px);
            }

        .btn-back-glass:active {
            transform: scale(.95);
        }

    #sanseList {
        padding-top: 10px;
    }

    #categoryList {
        padding-top: 4px;
    }
</style>

@section Scripts {
    <script>
        var selectedSanse = null;
        var todayPersian = todayJalaliStr();

        function loadCategories() {
            apiCall('/api/Register/SportCategories', 'GET', null, function (res) {
                var html = '<li class="cat-item active" data-id="0" onclick="filterSanses(0)">همه</li>';
                $.each(res.data, function (i, c) {
                    html += '<li class="cat-item" data-id="' + c.sportCatID + '" onclick="filterSanses(' + c.sportCatID + ')">' + esc(c.sportName) + '</li>';
                });
                $('#categoryList').html(html);
            });
        }

        function filterSanses(catId) {
            $('#categoryList li').removeClass('active');
            $('#categoryList li[data-id="' + catId + '"]').addClass('active');
            var url = '/api/Register/SansesForRenew' + (catId > 0 ? '?sportCatID=' + catId : '');
            apiCall(url, 'GET', null, function (res) {
                var html = '';
                if (!res.data || res.data.length === 0) {
                    html = '<div class="col-12"><div class="empty-state"><div class="empty-icon">🔍</div>سانسی یافت نشد</div></div>';
                } else {
                    $.each(res.data, function (i, s) {
                        // ✅ هوشمند: ثبت‌نام یا تمدید
                        var isRenew = s.hasActiveRegister === true;
                        var btnIcon = isRenew ? 'bi-arrow-repeat' : 'bi-plus-circle';
                        var btnText = isRenew ? 'تمدید دوره' : 'ثبت‌نام';

                        html += '<div class="col-md-6">' +
                            '<div class="sans-card" data-id="' + s.sportSanseID + '" data-name="' + esc(s.sportName + ' - ' + s.sanseName) + '" data-amount="' + esc(s.totalAmountDisplay) + '">' +
                                '<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">' +
                                    '<div style="min-width:0">' +
                                        '<div class="sans-name"><i class="bi bi-trophy-fill hd-icon"></i>' + esc(s.sportName) + '</div>' +
                                        '<div class="sans-coach">' + esc(s.sanseName) + '</div>' +
                                    '</div>' +
                                    '<div class="renew-price"><i class="bi bi-cash-coin"></i>' + esc(s.totalAmountDisplay) + '</div>' +
                                '</div>' +
                                '<div class="d-flex flex-wrap gap-2 mt-3">' +
                                    '<span class="sans-pill"><i class="bi bi-person-fill"></i>' + esc(s.coachName || 'بدون مربی') + '</span>' +
                                    '<span class="sans-pill"><i class="bi bi-tag-fill"></i>' + esc(s.membershipTypeDesc || '-') + '</span>' +
                                    '<span class="sans-pill"><i class="bi bi-stopwatch-fill"></i>' + esc(s.periodDesc || '-') + '</span>' +
                                '</div>' +
                                '<button class="btn btn-renew w-100 mt-3 renew-btn" data-renew="' + (isRenew ? 1 : 0) + '">' +
                                    '<i class="bi ' + btnIcon + ' me-1"></i> ' + btnText +
                                '</button>' +
                            '</div>' +
                        '</div>';
                    });
                }
                $('#sanseList').html(html);

                $('.renew-btn').off('click').on('click', function () {
                    var card = $(this).closest('.sans-card');
                    var id = card.data('id');
                    var name = card.data('name');
                    var amount = card.data('amount');
                    var isRenew = $(this).data('renew') == 1;
                    openRenew(id, name, amount, isRenew);
                });
            });
        }

        var renewAmountDisplay = '';

        function openRenew(id, name, display, isRenew) {
            selectedSanse = id;
            renewAmountDisplay = display;

            // ✅ عنوان و دکمه مودال هوشمند
            var icon = isRenew ? 'bi-arrow-repeat' : 'bi-plus-circle';
            var title = isRenew ? 'تأیید تمدید دوره' : 'تأیید ثبت‌نام دوره';
            var btnText = isRenew ? 'تأیید و تمدید' : 'تأیید و ثبت‌نام';

            $('#renewModalTitle').html('<i class="bi ' + icon + ' me-2"></i>' + title);
            $('#btnConfirmRenew').html('<i class="bi bi-check-lg me-1"></i> ' + btnText);

            $('#renewInfo').html(
                '<div class="renew-info-box">' +
                    '<div class="small text-muted mb-1">ورزش</div>' +
                    '<div class="fw-bold mb-3"><i class="bi bi-trophy-fill hd-icon"></i> ' + name + '</div>' +
                    '<div class="small text-muted mb-1">مبلغ قابل پرداخت</div>' +
                    '<div class="renew-price"><i class="bi bi-cash-coin"></i>' + display + '</div>' +
                '</div>'
            );
            $('#renewStartDate').val(todayPersian);
            new bootstrap.Modal('#renewModal').show();
        }

        $('#btnOpenCalendar').click(function () {
            bootstrap.Modal.getInstance('#renewModal').hide();
            initCalendar('renewStartDate', '#renewModal');
            new bootstrap.Modal('#datePickerModal').show();
        });

        $('#prevMonth').click(function () {
            calendarDate.m++;
            if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
            renderCalendar();
        });

        $('#nextMonth').click(function () {
            calendarDate.m--;
            if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
            renderCalendar();
        });

        $('#btnConfirmRenew').click(function () {
            var date = $.trim($('#renewStartDate').val());
            if (!date) { showToast('تاریخ شروع را انتخاب کنید', 'error'); return; }

            var amount = parseInt(String(renewAmountDisplay || '0').replace(/[^0-9]/g, ''), 10) || 0;
            var payload = { sportSanseID: selectedSanse, startDate: date };
            bootstrap.Modal.getInstance('#renewModal').hide();

            openPaymentModal({
                amount: amount,
                creditType: 'sport',
                buyUrl: '/api/Register/Renew',
                payload: payload,
                title: 'پرداخت ثبت‌نام / تمدید دوره',
                onDone: function (res) {
                    showToast(res.message, 'success');
                    filterSanses($('#categoryList li.active').data('id') || 0);
                    setTimeout(function () {
                        window.location.href = '/Home';
                    }, 1500);
                }
            });
        });

        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
        }

        $(function () { loadCategories(); filterSanses(0); });
    </script>
}