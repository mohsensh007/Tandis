@{
    ViewData["Title"] = "تمدید دوره";
}

<!-- ========== هدر صفحه ========== -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-arrow-repeat hd-icon"></i> تمدید دوره</h5>
    <a href="/Home" class="purple-style btn-back-glass"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

<div class="row g-3">
    <!-- ========== دسته‌بندی ورزش‌ها ========== -->
    <div class="col-lg-3 col-md-4">
        <div class="glass-card">
            <div class="card-header grad-header"><i class="bi bi-list-ul me-2"></i>دسته‌بندی ورزش‌ها</div>
            <div class="purple-style card-body p-2">
                <ul id="categoryList">
                    <li class="cat-item text-center text-muted">در حال بارگذاری...</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ========== سانس‌های قابل تمدید ========== -->
    <div class="col-lg-9 col-md-8">
        <div class="purple-style glass-card">
            <div class="card-header grad-header"><i class="bi bi-arrow-repeat me-2"></i>سانس‌های قابل تمدید</div>
            <div class="card-body">
                <div id="sanseList" class="row g-3">
                    <div class="col-12"><div class="empty-state"><div class="empty-icon">⏳</div>در حال بارگذاری...</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* === تقویم روزهای اداری === *@
<div class="modal fade" id="datePickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header grad-header">
                <h5 class="modal-title"><i class="bi bi-calendar3 me-2"></i>انتخاب تاریخ شروع</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-sm btn-outline-light px-3" id="prevMonth">›</button>
                    <strong id="currentMonthLabel" class="fs-5"></strong>
                    <button type="button" class="btn btn-sm btn-outline-light px-3" id="nextMonth">‹</button>
                </div>
                <table class="cal-table">
                    <thead class="text-center">
                        <tr>
                            <th>شنبه</th>
                            <th>یک شنبه</th>
                            <th>دو شنبه</th>
                            <th>سه شنبه</th>
                            <th>چهار شنبه</th>
                            <th>پنج شنبه</th>
                            <th>جمعه</th>
                        </tr>
                    </thead>
                    <tbody id="calendarBody"></tbody>
                </table>
                <div class="renew-info-box mt-3 mb-0 small">
                    <i class="bi bi-info-circle hd-icon"></i>
                    فقط تاریخ‌های امروز و آینده قابل انتخاب هستند.
                </div>
            </div>
        </div>
    </div>
</div>

@* === مودال تمدید === *@
<div class="modal fade" id="renewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="purple-style modal-content glass-modal">
            <div class="modal-header grad-header">
                <h5 class="modal-title"><i class="bi bi-arrow-repeat me-2"></i>تأیید تمدید دوره</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="renewInfo" class="mb-3"></div>
                <label class="form-label small text-muted"><i class="bi bi-calendar-event hd-icon"></i> تاریخ شروع دوره</label>
                <div class="input-group">
                    <input type="text" id="renewStartDate" class="form-control" placeholder="انتخاب کنید" readonly />
                    <button type="button" class="btn btn-outline-info" id="btnOpenCalendar">
                        <i class="bi bi-calendar3"></i>
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-renew px-4" id="btnConfirmRenew">
                    <i class="bi bi-check-lg me-1"></i> تأیید و تمدید
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== آیکن‌های فیروزه‌ای (بدون تغییر) ===== */
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
        font-size: 1.05rem;
    }

    /* ===== کارت‌های شیشه‌ای ===== */
    .glass-card {
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        overflow: hidden;
    }

    /* ===== هدرها: گرادیان بنفش تم وب‌اپ + فاصله‌دار ===== */
    .grad-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 800;
        font-size: 1rem;
        padding: 13px 20px;
        border-bottom: 1px solid rgba(255,255,255,.15);
    }

        .grad-header i {
            font-size: 1.1rem;
        }

    /* ===== لیست دسته‌بندی (دسکتاپ: عمودی) ===== */
    #categoryList {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cat-item {
        border-radius: 12px;
        background: rgba(255,255,255,.06);
        border: 1px solid transparent;
        color: #cbd3da;
        cursor: pointer;
        padding: 10px 16px;
        font-size: .88rem;
        font-weight: 600;
        transition: all .25s;
        display: flex;
        align-items: center;
    }

        .cat-item::before {
            content: '';
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #66d3e8;
            box-shadow: 0 0 6px rgba(102,211,232,.8);
            display: inline-block;
            margin-left: 10px;
            flex: 0 0 auto;
        }

        .cat-item:hover {
            background: rgba(255,255,255,.12);
            color: #fff;
        }

        .cat-item.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: rgba(255,255,255,.25);
            color: #fff;
        }

            .cat-item.active::before {
                background: #fff;
                box-shadow: none;
            }

    /* ===== 📱 موبایل: بیضی‌های شیشه‌ای کنار هم (flex-wrap) ===== */
    @@media (max-width: 767.98px) {
        #categoryList {
            flex-direction: row;
            flex-wrap: wrap; /* ✅ کنار هم، خط به خط */
            gap: 8px;
        }

        .cat-item {
            flex: 0 0 auto;
            border-radius: 999px; /* ✅ بیضی */
            padding: 8px 20px;
            font-size: .8rem;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.16);
            backdrop-filter: blur(6px);
        }

            .cat-item::before {
                display: none;
            }
            /* بیضی‌ها بدون نقطه، مثل عکس */
            .cat-item.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-color: rgba(255,255,255,.30);
                box-shadow: 0 4px 14px rgba(118,75,162,.45);
            }
    }

    /* ===== کارت سانس ===== */
    .sans-card {
        position: relative;
        border-radius: 20px;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        padding: 16px;
        overflow: hidden;
        height: 100%;
    }

        .sans-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.30), transparent 70%);
            pointer-events: none;
        }

    .sans-name {
        font-weight: 800;
        font-size: 1.02rem;
        color: #fff;
        display: flex;
        align-items: center;
    }

        .sans-name .hd-icon {
            font-size: 1rem;
        }

    .sans-coach {
        font-size: .8rem;
        color: #9fb3c8;
        margin-top: 4px;
    }

    /* ===== pills فیروزه‌ای (بدون تغییر) ===== */
    .sans-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(13,110,253,.30);
        color: #dce9ff;
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .75rem;
        font-weight: 700;
    }

        .sans-pill i {
            color: #66d3e8;
            font-size: .85rem;
        }

    /* ===== کادر قیمت فیروزه‌ای (بدون تغییر) ===== */
    .renew-price {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(102,211,232,.35);
        border-radius: 14px;
        padding: 8px 14px;
        color: #dce9ff;
        font-weight: 800;
        font-size: .9rem;
    }

        .renew-price i {
            color: #66d3e8;
            font-size: 1.15rem;
        }

    /* ===== دکمه تمدید: گرادیان بنفش تم وب‌اپ ===== */
    .btn-renew {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        border-radius: 14px;
        padding: 10px;
        box-shadow: 0 6px 18px rgba(118,75,162,.40);
    }

        .btn-renew:hover, .btn-renew:focus {
            filter: brightness(1.08);
            color: #fff;
        }

    /* ===== مودال شیشه‌ای ===== */
    .glass-modal {
        background: rgba(16,20,36,.97);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 18px;
        color: #fff;
        backdrop-filter: blur(14px);
    }

        .glass-modal .form-control {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.18);
            color: #fff;
        }

            .glass-modal .form-control::placeholder {
                color: #8a93a6;
            }

    .renew-info-box {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 14px;
        padding: 14px;
    }
    /* ===== دکمه بازگشت شیشه‌ای ===== */
    .btn-back-glass {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .btn-back-glass i {
            color: #66d3e8;
            transition: transform .25s;
        }

        .btn-back-glass:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
            border-color: rgba(102,211,232,.45);
        }

            .btn-back-glass:hover i {
                transform: translateX(3px);
            }
        /* ✅ فلش موقع hover تکون می‌خوره */
        .btn-back-glass:active {
            transform: scale(.95);
        }
    /* ✅ فاصله اولین کارت از هدر بخش */
    #sanseList {
        padding-top: 10px;
    }

    #categoryList {
        padding-top: 4px;
    }
</style>

@section Scripts {
    <script>
        var selectedSanse = null;
        var todayPersian = todayJalaliStr();

        function loadCategories() {
            apiCall('/api/Register/SportCategories', 'GET', null, function (res) {
                var html = '<li class="cat-item active" data-id="0" onclick="filterSanses(0)">همه</li>';
                $.each(res.data, function (i, c) {
                    html += '<li class="cat-item" data-id="' + c.sportCatID + '" onclick="filterSanses(' + c.sportCatID + ')">' + esc(c.sportName) + '</li>';
                });
                $('#categoryList').html(html);
            });
        }

        function filterSanses(catId) {
            $('#categoryList li').removeClass('active');
            $('#categoryList li[data-id="' + catId + '"]').addClass('active');
            var url = '/api/Register/SansesForRenew' + (catId > 0 ? '?sportCatID=' + catId : '');
            apiCall(url, 'GET', null, function (res) {
                var html = '';
                if (!res.data || res.data.length === 0) {
                    html = '<div class="col-12"><div class="empty-state"><div class="empty-icon">🔍</div>سانسی یافت نشد</div></div>';
                } else {
                    $.each(res.data, function (i, s) {
                        html += '<div class="col-md-6">' +
                            '<div class="sans-card" data-id="' + s.sportSanseID + '" data-name="' + esc(s.sportName + ' - ' + s.sanseName) + '" data-amount="' + esc(s.totalAmountDisplay) + '">' +
                                '<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">' +
                                    '<div style="min-width:0">' +
                                        '<div class="sans-name"><i class="bi bi-trophy-fill hd-icon"></i>' + esc(s.sportName) + '</div>' +
                                        '<div class="sans-coach">' + esc(s.sanseName) + '</div>' +
                                    '</div>' +
                                    '<div class="renew-price"><i class="bi bi-cash-coin"></i>' + esc(s.totalAmountDisplay) + '</div>' +
                                '</div>' +
                                '<div class="d-flex flex-wrap gap-2 mt-3">' +
                                    '<span class="sans-pill"><i class="bi bi-person-fill"></i>' + esc(s.coachName || 'بدون مربی') + '</span>' +
                                    '<span class="sans-pill"><i class="bi bi-tag-fill"></i>' + esc(s.membershipTypeDesc || '-') + '</span>' +
                                    '<span class="sans-pill"><i class="bi bi-stopwatch-fill"></i>' + esc(s.periodDesc || '-') + '</span>' +
                                '</div>' +
                                '<button class="btn btn-renew w-100 mt-3 renew-btn"><i class="bi bi-arrow-repeat me-1"></i> تمدید دوره</button>' +
                            '</div>' +
                        '</div>';
                    });
                }
                $('#sanseList').html(html);

                // event delegation
                $('.renew-btn').off('click').on('click', function () {
                    var card = $(this).closest('.sans-card');
                    var id = card.data('id');
                    var name = card.data('name');
                    var amount = card.data('amount');
                    openRenew(id, name, amount);
                });
            });
        }

        function openRenew(id, name, display) {
            selectedSanse = id;
            $('#renewInfo').html(
                '<div class="renew-info-box">' +
                    '<div class="small text-muted mb-1">ورزش</div>' +
                    '<div class="fw-bold mb-3"><i class="bi bi-trophy-fill hd-icon"></i> ' + name + '</div>' +
                    '<div class="small text-muted mb-1">مبلغ قابل پرداخت</div>' +
                    '<div class="renew-price"><i class="bi bi-cash-coin"></i>' + display + '</div>' +
                '</div>'
            );
            $('#renewStartDate').val(todayPersian);
            new bootstrap.Modal('#renewModal').show();
        }

        $('#btnOpenCalendar').click(function () {
            bootstrap.Modal.getInstance('#renewModal').hide();
            initCalendar('renewStartDate', '#renewModal');
            new bootstrap.Modal('#datePickerModal').show();
        });
        $('#prevMonth').click(function () {
            calendarDate.m++;
            if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
            renderCalendar();
        });
        $('#nextMonth').click(function () {
            calendarDate.m--;
            if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
            renderCalendar();
        });

        $('#btnConfirmRenew').click(function () {
            var date = $.trim($('#renewStartDate').val());
            if (!date) { showToast('تاریخ شروع را انتخاب کنید', 'error'); return; }

            apiCall('/api/Register/Renew', 'POST', { sportSanseID: selectedSanse, startDate: date }, function (res) {
                if (res.success) {
                    showToast(res.message, 'success');
                    bootstrap.Modal.getInstance('#renewModal').hide();
                    filterSanses($('#categoryList li.active').data('id') || 0);

                    // ✅ رفرش داشبورد + بازگشت به صفحه اصلی بعد از ۱.۵ ثانیه
                    setTimeout(function () {
                        window.location.href = '/Home';
                    }, 1500);
                } else {
                    showToast(res.message, 'error');
                }
            });
        });

        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
        }

        $(function () { loadCategories(); filterSanses(0); });
    </script>
}