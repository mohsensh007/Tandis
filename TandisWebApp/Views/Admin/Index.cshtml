@{
    ViewData["Title"] = "داشبورد مدیر";
    Layout = "_AdminLayout";
}
<!-- ========== داشبورد مدیریت ========== -->
<div class="row g-3 mb-4">
    <!-- کارت افراد حاضر -->
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body text-center d-flex flex-column justify-content-between">
                <!-- بلوک عدد -->
                <div>
                    <div class="text-muted mb-1">🏋️ افراد حاضر در باشگاه</div>
                    <div id="insideCount" style="font-size:36px;font-weight:800;line-height:1.2;">-</div>
                    <div class="text-muted small">نفر</div>
                </div>

                <!-- ✅ پیش‌نمایش زنده: دقیقاً اینجا، بین عدد و دکمه‌ها -->
                <div id="insidePreview" class="inside-preview mt-3 text-start"></div>

                <!-- بلوک دکمه‌ها -->
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-outline-primary w-100" id="btnInsideList">
                        <i class="bi bi-people-fill me-1"></i> مشاهده لیست
                    </button>
                    <button class="btn btn-outline-secondary" id="btnRefreshInside" title="به‌روزرسانی">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- کارت ثبت‌نام/تمدید + نمودار -->
    <div class="col-12 col-md-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="fw-bold">📊 ثبت‌نام و تمدید</div>
                    <span id="deltaBadge" class="badge bg-success">-</span>
                </div>

                <div class="btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="periodRadio" id="pDay" value="day" checked autocomplete="off">
                    <label class="btn btn-outline-primary" for="pDay">روز</label>
                    <input type="radio" class="btn-check" name="periodRadio" id="pWeek" value="week" autocomplete="off">
                    <label class="btn btn-outline-success" for="pWeek">هفته</label>
                    <input type="radio" class="btn-check" name="periodRadio" id="pMonth" value="month" autocomplete="off">
                    <label class="btn btn-outline-warning" for="pMonth">ماه</label>
                </div>

                <div class="row text-center g-2">
                    <div class="col-6">
                        <div class="donut-wrap">
                            <svg viewBox="0 0 42 42" class="donut" id="donutCur">
                                <circle cx="21" cy="21" r="15.9155" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="5"></circle>
                                <circle class="seg-reg" cx="21" cy="21" r="15.9155" fill="none" stroke="#4a90e2" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                                <circle class="seg-ren" cx="21" cy="21" r="15.9155" fill="none" stroke="#2ecc71" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                                <text class="donut-center" x="21" y="23.5" text-anchor="middle" fill="#ffffff" font-size="7.5" font-weight="700">0</text>
                            </svg>
                        </div>
                        <div class="text-muted small mt-1" id="curLabel">دوره جاری</div>
                    </div>
                    <div class="col-6">
                        <div class="donut-wrap">
                            <svg viewBox="0 0 42 42" class="donut" id="donutPrev">
                                <circle cx="21" cy="21" r="15.9155" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="5"></circle>
                                <circle class="seg-reg" cx="21" cy="21" r="15.9155" fill="none" stroke="#4a90e2" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                                <circle class="seg-ren" cx="21" cy="21" r="15.9155" fill="none" stroke="#2ecc71" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                                <text class="donut-center" x="21" y="23.5" text-anchor="middle" fill="#ffffff" font-size="7.5" font-weight="700">0</text>
                            </svg>
                        </div>
                        <div class="text-muted small mt-1" id="prevLabel">دوره قبل</div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-4 mt-3 small">
                    <span><span style="color:#4a90e2;">●</span> ثبت‌نام: <b id="curReg">0</b></span>
                    <span><span style="color:#2ecc71;">●</span> تمدید: <b id="curRen">0</b></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال لیست افراد حاضر -->
<div class="modal fade" id="insideModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> افراد حاضر در باشگاه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr><th>نام</th><th>کد عضویت</th><th>ورزش</th><th>ساعت ورود</th><th>وضعیت</th></tr>
                        </thead>
                        <tbody id="tbodyInside"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- کارت مبالغ دریافتی -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="fw-bold">💰 مبالغ دریافتی</div>
                    <span id="creditDeltaBadge" class="badge bg-success">-</span>
                </div>
                <div class="row text-center g-3">
                    <div class="col-6 col-md-5 offset-md-1">
                        <div class="text-muted small" id="creditCurLabel">دوره جاری</div>
                        <div class="fs-5 fw-bold text-success mt-1">
                            <span id="curCredit">0</span> <small class="text-muted">ریال</small>
                        </div>
                        <div class="text-muted small"><span id="curCreditCount">0</span> سند دریافتی</div>
                    </div>
                    <div class="col-6 col-md-5">
                        <div class="text-muted small" id="creditPrevLabel">دوره قبل</div>
                        <div class="fs-5 fw-bold mt-1">
                            <span id="prevCredit">0</span> <small class="text-muted">ریال</small>
                        </div>
                        <div class="text-muted small"><span id="prevCreditCount">0</span> سند دریافتی</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-grid-1x2"></i> گزارش‌های مدیریتی</h5>
                <p class="text-muted">از منوی بالا یا کارت‌های زیر گزارش مورد نظر را انتخاب کنید.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="/Admin/TrafficReport" class="text-decoration-none">
            <div class="card text-center h-100" style="border-top:3px solid #0d6efd">
                <div class="card-body p-4">
                    <div style="font-size:2.5rem">🚪</div>
                    <h6 class="mt-2">گزارش ترددها</h6>
                    <small class="text-muted">ورود و خروج اعضای شیفت</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/Admin/RegisterReport" class="text-decoration-none">
            <div class="card text-center h-100" style="border-top:3px solid #198754">
                <div class="card-body p-4">
                    <div style="font-size:2.5rem">🔄</div>
                    <h6 class="mt-2">ثبت‌نام و تمدید</h6>
                    <small class="text-muted">ثبت‌نام‌ها و تمدیدهای دوره</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/Admin/OneSessionReport" class="text-decoration-none">
            <div class="card text-center h-100" style="border-top:3px solid #ffc107">
                <div class="card-body p-4">
                    <div style="font-size:2.5rem">🎫</div>
                    <h6 class="mt-2">تک‌جلسه‌ها</h6>
                    <small class="text-muted">بلیت‌های جلسه آزاد</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/Admin/FinanceReport" class="text-decoration-none">
            <div class="card text-center h-100" style="border-top:3px solid #dc3545">
                <div class="card-body p-4">
                    <div style="font-size:2.5rem">💰</div>
                    <h6 class="mt-2">گزارش صندوق</h6>
                    <small class="text-muted">تراکنش‌های مالی شیفت</small>
                </div>
            </div>
        </a>
    </div>
</div>
@section Scripts {
    <script>
                // ✅ پیش‌نمایش زنده افراد حاضر (پر کردن فضای خالی کارت)
        function loadInsidePreview() {
            apiCall('/api/Admin/InsideList', 'GET', null, function (res) {
                if (!res.success) return;
                var rows = res.data || [];
                var box = $('#insidePreview');
                box.empty();

                if (!rows.length) {
                    box.html('<div class="text-muted small text-center py-2">در حال حاضر کسی داخل باشگاه نیست</div>');
                    return;
                }

                var max = 4;
                rows.slice(0, max).forEach(function (r) {
                    box.append(
                        '<div class="inside-row d-flex justify-content-between align-items-center gap-2">' +
                            '<span class="text-truncate">' + esc(r.personName) +
                                (r.isGuest ? ' <span class="badge bg-warning" style="font-size:10px;">مهمان</span>' : '') +
                            '</span>' +
                            '<span class="text-muted small" style="direction:ltr;">' + esc(r.entryTime || '') + '</span>' +
                        '</div>'
                    );
                });

                if (rows.length > max) {
                    box.append('<div class="text-center small mt-1">' +
                        '<a href="#" id="lnkMoreInside" class="link-light text-decoration-none">+ ' +
                        faNum(rows.length - max) + ' نفر دیگر…</a></div>');
                }
            });
        }

        // کلیک روی «+N نفر دیگر» → باز کردن مودال لیست کامل
        $(document).on('click', '#lnkMoreInside', function (e) {
            e.preventDefault();
            loadInsideList();
        });
        function renderDonut(sel, reg, ren, center) {
            var total = reg + ren;
            var pReg = total ? Math.round(reg * 100 / total) : 0;
            var svg = $(sel);
            if (!total) {
                svg.find('.seg-reg').attr('stroke-dasharray', '0 100').attr('stroke-dashoffset', 25);
                svg.find('.seg-ren').attr('stroke-dasharray', '0 100').attr('stroke-dashoffset', 25);
            } else {
                svg.find('.seg-reg').attr('stroke-dasharray', pReg + ' ' + (100 - pReg)).attr('stroke-dashoffset', 25);
                svg.find('.seg-ren').attr('stroke-dasharray', (100 - pReg) + ' ' + pReg).attr('stroke-dashoffset', 25 - pReg);
            }
            svg.find('.donut-center').text(center);
        }

        function loadDashboard(period) {
            apiCall('/api/Admin/DashboardStats?period=' + period, 'GET', null, function (res) {
                if (!res.success) return;
                var d = res.data;
                $('#insideCount').text(faNum(d.insideCount));
                $('#curLabel').text(d.currentLabel);
                $('#prevLabel').text(d.previousLabel);
                $('#curReg').text(faNum(d.currentRegister));
                $('#curRen').text(faNum(d.currentRenew));
                renderDonut('#donutCur',  d.currentRegister,  d.currentRenew,  faNum(d.currentRegister  + d.currentRenew));
                renderDonut('#donutPrev', d.previousRegister, d.previousRenew, faNum(d.previousRegister + d.previousRenew));

                var curT  = d.currentRegister  + d.currentRenew;
                var prevT = d.previousRegister + d.previousRenew;
                var delta = prevT === 0 ? (curT > 0 ? 100 : 0) : Math.round((curT - prevT) * 100 / prevT);
                $('#deltaBadge').removeClass('bg-success bg-danger')
                    .addClass(delta >= 0 ? 'bg-success' : 'bg-danger')
                    .text((delta >= 0 ? '▲ ' : '▼ ') + faNum(Math.abs(delta)) + '٪ نسبت به دوره قبل');
                            // ✅ کارت مبالغ دریافتی
        $('#creditCurLabel').text(d.currentLabel);
        $('#creditPrevLabel').text(d.previousLabel);
        $('#curCredit').text(faNum(d.currentCredit));
        $('#prevCredit').text(faNum(d.previousCredit));
        $('#curCreditCount').text(faNum(d.currentCreditCount));
        $('#prevCreditCount').text(faNum(d.previousCreditCount));

        var cd = d.previousCredit === 0 ? (d.currentCredit > 0 ? 100 : 0)
                 : Math.round((d.currentCredit - d.previousCredit) * 100 / d.previousCredit);
        $('#creditDeltaBadge').removeClass('bg-success bg-danger')
            .addClass(cd >= 0 ? 'bg-success' : 'bg-danger')
            .text((cd >= 0 ? '▲ ' : '▼ ') + faNum(Math.abs(cd)) + '٪ نسبت به دوره قبل');
            });
        }

        function loadInsideList() {
            apiCall('/api/Admin/InsideList', 'GET', null, function (res) {
                if (!res.success) return;
                var rows = res.data || [];
                if (!rows.length) {
                    $('#tbodyInside').html('<tr><td colspan="5" class="text-center py-3">در حال حاضر کسی داخل باشگاه نیست.</td></tr>');
                } else {
                    var html = '';
                    rows.forEach(function (r) {
                        html += '<tr>' +
                            '<td>' + esc(r.personName) + '</td>' +
                            '<td>' + (r.memberCode ? esc(r.memberCode) : '-') + '</td>' +
                            '<td>' + esc(r.sportName) + '</td>' +
                            '<td>' + esc(r.entryTime || '-') + '</td>' +
                            '<td>' + (r.isGuest ? '<span class="badge bg-warning">مهمان</span>' : '<span class="badge bg-success">عضو</span>') + '</td>' +
                        '</tr>';
                    });
                    $('#tbodyInside').html(html);
                }
                new bootstrap.Modal('#insideModal').show();
            });
        }

        // ✅ فقط وقتی همه‌چیز (jQuery + DOM) آماده شد اجرا کن
        $(function () {
            $('input[name="periodRadio"]').on('change', function () {
                loadDashboard($(this).val());
            });
            $('#btnInsideList').on('click', loadInsideList);
            $('#btnRefreshInside').on('click', function () {
            loadDashboard($('input[name="periodRadio"]:checked').val());
            loadInsidePreview();   // ✅ جدید
            });

            // بارگذاری اولیه
            loadDashboard('day');
            loadInsidePreview();   // ✅ جدید
        });
    </script>
}
