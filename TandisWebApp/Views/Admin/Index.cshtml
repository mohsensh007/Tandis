@{
    ViewData["Title"] = "داشبورد مدیر";
    Layout = "_AdminLayout";
}

<!-- ========== ردیف ۱: حاضرین + ثبت‌نام/تمدید ========== -->
<div class="row g-3 mb-3">
    <!-- کارت افراد حاضر -->
    <div class="col-12 col-md-4">
        <div class="dash-card h-100">
            <div class="dash-head">
                <span><i class="bi bi-people-fill hd-icon"></i> افراد حاضر در باشگاه</span>
            </div>
            <div class="text-center py-2">
                <div id="insideCount" class="inside-count">-</div>
                <div class="text-muted small">نفر داخل باشگاه</div>
            </div>
            <div id="insidePreview" class="inside-preview mt-2"></div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn-glass flex-fill" id="btnInsideList">
                    <i class="bi bi-people-fill"></i> مشاهده لیست
                </button>
                <button class="btn-glass-icon" id="btnRefreshInside" title="به‌روزرسانی">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- کارت ثبت‌نام/تمدید -->
    <div class="col-12 col-md-8">
        <div class="dash-card h-100">
            <div class="dash-head">
                <span><i class="bi bi-bar-chart-fill hd-icon"></i> ثبت‌نام و تمدید</span>
                <span id="deltaBadge" class="delta-badge up">-</span>
            </div>

            <!-- انتخاب دوره: pill های شیشه‌ای -->
            <div class="period-group mt-3">
                <input type="radio" class="btn-check" name="periodRadio" id="pDay" value="day" checked autocomplete="off">
                <label class="period-btn" for="pDay">روز</label>
                <input type="radio" class="btn-check" name="periodRadio" id="pWeek" value="week" autocomplete="off">
                <label class="period-btn" for="pWeek">هفته</label>
                <input type="radio" class="btn-check" name="periodRadio" id="pMonth" value="month" autocomplete="off">
                <label class="period-btn" for="pMonth">ماه</label>
            </div>

            <div class="row text-center g-2 mt-2">
                <div class="col-6">
                    <div class="donut-wrap">
                        <svg viewBox="0 0 42 42" class="donut" id="donutCur">
                            <circle cx="21" cy="21" r="15.9155" fill="none" stroke="rgba(255,255,255,.10)" stroke-width="5"></circle>
                            <circle class="seg-reg" cx="21" cy="21" r="15.9155" fill="none" stroke="#66d3e8" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                            <circle class="seg-ren" cx="21" cy="21" r="15.9155" fill="none" stroke="#667eea" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                            <text class="donut-center" x="21" y="23.5" text-anchor="middle" fill="#ffffff" font-size="7.5" font-weight="700">0</text>
                        </svg>
                    </div>
                    <div class="donut-label" id="curLabel">دوره جاری</div>
                </div>
                <div class="col-6">
                    <div class="donut-wrap">
                        <svg viewBox="0 0 42 42" class="donut" id="donutPrev">
                            <circle cx="21" cy="21" r="15.9155" fill="none" stroke="rgba(255,255,255,.10)" stroke-width="5"></circle>
                            <circle class="seg-reg" cx="21" cy="21" r="15.9155" fill="none" stroke="#66d3e8" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                            <circle class="seg-ren" cx="21" cy="21" r="15.9155" fill="none" stroke="#667eea" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25"></circle>
                            <text class="donut-center" x="21" y="23.5" text-anchor="middle" fill="#ffffff" font-size="7.5" font-weight="700">0</text>
                        </svg>
                    </div>
                    <div class="donut-label" id="prevLabel">دوره قبل</div>
                </div>
            </div>

            <div class="donut-legend">
                <span><i style="background:#66d3e8"></i> ثبت‌نام: <b id="curReg">0</b></span>
                <span><i style="background:#667eea"></i> تمدید: <b id="curRen">0</b></span>
            </div>
        </div>
    </div>
</div>

<!-- ========== ردیف ۲: مبالغ دریافتی (سلولی) ========== -->
<div class="dash-card mb-3">
    <div class="dash-head">
        <span><i class="bi bi-cash-coin hd-icon"></i> مبالغ دریافتی</span>
        <span id="creditDeltaBadge" class="delta-badge up">-</span>
    </div>
    <div class="money-grid mt-3">
        <div class="money-cell cur">
            <div class="mc-head"><i class="bi bi-calendar-check-fill"></i> <span id="creditCurLabel">دوره جاری</span></div>
            <div class="mc-amount"><span id="curCredit">0</span> <small>ریال</small></div>
            <div class="mc-sub"><i class="bi bi-receipt"></i> <span><span id="curCreditCount">0</span> سند دریافتی</span></div>
        </div>
        <div class="money-cell">
            <div class="mc-head"><i class="bi bi-calendar-x-fill"></i> <span id="creditPrevLabel">دوره قبل</span></div>
            <div class="mc-amount"><span id="prevCredit">0</span> <small>ریال</small></div>
            <div class="mc-sub"><i class="bi bi-receipt"></i> <span><span id="prevCreditCount">0</span> سند دریافتی</span></div>
        </div>
    </div>
</div>

<!-- مودال لیست افراد حاضر -->
<div class="modal fade" id="insideModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header grad-header">
                <h5 class="modal-title"><i class="bi bi-people-fill me-2"></i>افراد حاضر در باشگاه</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle" style="--bs-table-bg:transparent;">
                        <thead>
                            <tr><th>نام</th><th>کد عضویت</th><th>ورزش</th><th>ساعت ورود</th><th>وضعیت</th></tr>
                        </thead>
                        <tbody id="tbodyInside"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== کارت شیشه‌ای داشبورد ===== */
    .dash-card {
        position: relative;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        padding: 16px;
        overflow: hidden;
    }

        .dash-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.25), transparent 70%);
            pointer-events: none;
        }

    .dash-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-weight: 800;
        color: #fff;
        font-size: .95rem;
    }

    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    /* ===== عدد حاضرین: متن گرادیان ===== */
    .inside-count {
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.1;
        background: linear-gradient(135deg, #66d3e8, #667eea);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    /* ===== ردیف پیش‌نمایش حاضرین ===== */
    .inside-row {
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 10px;
        padding: 6px 10px;
        margin-bottom: 6px;
        font-size: .8rem;
        color: #cbd3da;
    }

    /* ===== دکمه‌های شیشه‌ای ===== */
    .btn-glass {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(102,211,232,.35);
        color: #dce9ff;
        border-radius: 14px;
        padding: 10px 14px;
        font-weight: 700;
        font-size: .85rem;
        transition: all .25s;
    }

        .btn-glass i {
            color: #66d3e8;
        }

        .btn-glass:hover {
            background: rgba(13,110,253,.28);
            color: #fff;
        }

    .btn-glass-icon {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.16);
        color: #66d3e8;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .35s;
    }

        .btn-glass-icon:hover {
            transform: rotate(120deg);
            background: rgba(102,211,232,.15);
            color: #fff;
        }

    /* ===== انتخاب دوره: pill شیشه‌ای ===== */
    .period-group {
        display: flex;
        gap: 8px;
    }

    .period-btn {
        flex: 1;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.14);
        color: #9fb3c8;
        border-radius: 12px;
        padding: 9px 0;
        font-size: .85rem;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        transition: all .25s;
        margin: 0;
    }

        .period-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.10);
        }

    .btn-check:checked + .period-btn {
        background: linear-gradient(135deg, #1E6FD9, #667eea);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 6px 16px rgba(30,111,217,.35);
    }

    /* ===== بج تغییر درصد: شیشه‌ای ===== */
    .delta-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .72rem;
        font-weight: 800;
    }

        .delta-badge.up {
            background: rgba(56,217,169,.14);
            border: 1px solid rgba(56,217,169,.40);
            color: #38d9a9;
        }

        .delta-badge.down {
            background: rgba(255,107,129,.14);
            border: 1px solid rgba(255,107,129,.40);
            color: #ff6b81;
        }

    /* ===== دونات ===== */
    .donut-wrap {
        display: flex;
        justify-content: center;
    }

    .donut {
        width: 120px;
        height: 120px;
    }

    .donut-label {
        font-size: .78rem;
        color: #9fb3c8;
        margin-top: 6px;
    }

    .donut-legend {
        display: flex;
        justify-content: center;
        gap: 22px;
        margin-top: 12px;
        font-size: .8rem;
        color: #9fb3c8;
    }

        .donut-legend i {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-left: 5px;
        }

        .donut-legend b {
            color: #fff;
        }

    /* ===== سلول‌های مبالغ ===== */
    .money-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    @@media (max-width: 575.98px) {
        .money-grid {
            grid-template-columns: 1fr;
        }
    }

    .money-cell {
        position: relative;
        overflow: hidden;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 16px;
        padding: 16px;
    }

        .money-cell::before {
            content: '';
            position: absolute;
            top: -30px;
            left: -30px;
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, rgba(102,211,232,.16), transparent 70%);
            pointer-events: none;
        }

    .mc-head {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .78rem;
        color: #9fb3c8;
        font-weight: 700;
        margin-bottom: 10px;
    }

        .mc-head i {
            color: #66d3e8;
            font-size: 1rem;
        }

    .mc-amount {
        font-size: 1.3rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: .5px;
    }

    .money-cell.cur .mc-amount {
        background: linear-gradient(90deg, #66d3e8, #8ab6ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .mc-amount small {
        font-size: .68rem;
        color: #9fb3c8;
        font-weight: 600;
    }

    .money-cell.cur .mc-amount small {
        color: #9fb3c8;
        -webkit-text-fill-color: #9fb3c8;
    }

    .mc-sub {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        color: #9fb3c8;
        margin-top: 8px;
    }

        .mc-sub i {
            color: #667eea;
        }

    /* ===== مودال شیشه‌ای ===== */
    .glass-modal {
        background: rgba(16,20,36,.97);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 18px;
        color: #fff;
        backdrop-filter: blur(14px);
    }

    .grad-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 800;
    }
</style>

@section Scripts {
    <script>
        function loadInsidePreview() {
            apiCall('/api/Admin/InsideList', 'GET', null, function (res) {
                if (!res.success) return;
                var rows = res.data || [];
                var box = $('#insidePreview');
                box.empty();
                if (!rows.length) {
                    box.html('<div class="text-center small py-2" style="color:#9fb3c8">در حال حاضر کسی داخل باشگاه نیست</div>');
                    return;
                }
                var max = 3;
                rows.slice(0, max).forEach(function (r) {
                    box.append(
                        '<div class="inside-row d-flex justify-content-between align-items-center gap-2">' +
                            '<span class="text-truncate">' + esc(r.personName) +
                                (r.isGuest ? ' <span class="badge bg-warning" style="font-size:10px;">مهمان</span>' : '') +
                            '</span>' +
                            '<span style="direction:ltr;color:#66d3e8;font-size:.72rem;">' + esc(r.entryTime || '') + '</span>' +
                        '</div>'
                    );
                });
                if (rows.length > max) {
                    box.append('<div class="text-center small mt-1">' +
                        '<a href="#" id="lnkMoreInside" style="color:#66d3e8;text-decoration:none">+ ' +
                        faNum(rows.length - max) + ' نفر دیگر…</a></div>');
                }
            });
        }

        $(document).on('click', '#lnkMoreInside', function (e) {
            e.preventDefault();
            loadInsideList();
        });

        function renderDonut(sel, reg, ren, center) {
            var total = reg + ren;
            var pReg = total ? Math.round(reg * 100 / total) : 0;
            var svg = $(sel);
            if (!total) {
                svg.find('.seg-reg').attr('stroke-dasharray', '0 100').attr('stroke-dashoffset', 25);
                svg.find('.seg-ren').attr('stroke-dasharray', '0 100').attr('stroke-dashoffset', 25);
            } else {
                svg.find('.seg-reg').attr('stroke-dasharray', pReg + ' ' + (100 - pReg)).attr('stroke-dashoffset', 25);
                svg.find('.seg-ren').attr('stroke-dasharray', (100 - pReg) + ' ' + pReg).attr('stroke-dashoffset', 25 - pReg);
            }
            svg.find('.donut-center').text(center);
        }

        function setDelta(sel, delta) {
            $(sel).removeClass('up down').addClass(delta >= 0 ? 'up' : 'down')
                .html('<i class="bi ' + (delta >= 0 ? 'bi-caret-up-fill' : 'bi-caret-down-fill') + '"></i> ' +
                      faNum(Math.abs(delta)) + '٪ نسبت به دوره قبل');
        }

        function loadDashboard(period) {
            apiCall('/api/Admin/DashboardStats?period=' + period, 'GET', null, function (res) {
                if (!res.success) return;
                var d = res.data;
                $('#insideCount').text(faNum(d.insideCount));
                $('#curLabel').text(d.currentLabel);
                $('#prevLabel').text(d.previousLabel);
                $('#curReg').text(faNum(d.currentRegister));
                $('#curRen').text(faNum(d.currentRenew));
                renderDonut('#donutCur', d.currentRegister, d.currentRenew, faNum(d.currentRegister + d.currentRenew));
                renderDonut('#donutPrev', d.previousRegister, d.previousRenew, faNum(d.previousRegister + d.previousRenew));

                var curT = d.currentRegister + d.currentRenew;
                var prevT = d.previousRegister + d.previousRenew;
                var delta = prevT === 0 ? (curT > 0 ? 100 : 0) : Math.round((curT - prevT) * 100 / prevT);
                setDelta('#deltaBadge', delta);

                $('#creditCurLabel').text(d.currentLabel);
                $('#creditPrevLabel').text(d.previousLabel);
                $('#curCredit').text(faNum(d.currentCredit));
                $('#prevCredit').text(faNum(d.previousCredit));
                $('#curCreditCount').text(faNum(d.currentCreditCount));
                $('#prevCreditCount').text(faNum(d.previousCreditCount));

                var cd = d.previousCredit === 0 ? (d.currentCredit > 0 ? 100 : 0)
                         : Math.round((d.currentCredit - d.previousCredit) * 100 / d.previousCredit);
                setDelta('#creditDeltaBadge', cd);
            });
        }

        function loadInsideList() {
            apiCall('/api/Admin/InsideList', 'GET', null, function (res) {
                if (!res.success) return;
                var rows = res.data || [];
                if (!rows.length) {
                    $('#tbodyInside').html('<tr><td colspan="5" class="text-center py-3">در حال حاضر کسی داخل باشگاه نیست.</td></tr>');
                } else {
                    var html = '';
                    rows.forEach(function (r) {
                        html += '<tr>' +
                            '<td>' + esc(r.personName) + '</td>' +
                            '<td>' + (r.memberCode ? esc(r.memberCode) : '-') + '</td>' +
                            '<td>' + esc(r.sportName) + '</td>' +
                            '<td style="direction:ltr;text-align:right;">' + esc(r.entryTime || '-') + '</td>' +
                            '<td>' + (r.isGuest ? '<span class="badge bg-warning">مهمان</span>' : '<span class="badge" style="background:rgba(56,217,169,.2);color:#38d9a9;">عضو</span>') + '</td>' +
                        '</tr>';
                    });
                    $('#tbodyInside').html(html);
                }
                new bootstrap.Modal('#insideModal').show();
            });
        }

        $(function () {
            $('input[name="periodRadio"]').on('change', function () { loadDashboard($(this).val()); });
            $('#btnInsideList').on('click', loadInsideList);
            $('#btnRefreshInside').on('click', function () {
                loadDashboard($('input[name="periodRadio"]:checked').val());
                loadInsidePreview();
            });
            loadDashboard('day');
            loadInsidePreview();
        });
    </script>
}