@{
    ViewData["Title"] = "گزارش صندوق";
    Layout = "_AdminLayout";
}

<div class="card mb-3">
    <div class="card-header"><i class="bi bi-funnel"></i> فیلتر بازه زمانی</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">از تاریخ</label>
                <div class="input-group">
                    <input type="text" id="fromDate" class="form-control" placeholder="مثلاً 1405/01/01" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="openCalendar('fromDate','از تاریخ')">
                        <i class="bi bi-calendar3"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="$('#fromDate').val('')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">تا تاریخ</label>
                <div class="input-group">
                    <input type="text" id="toDate" class="form-control" placeholder="مثلاً 1405/03/31" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="openCalendar('toDate','تا تاریخ')">
                        <i class="bi bi-calendar3"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="$('#toDate').val('')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" id="btnSearch"><i class="bi bi-search"></i> نمایش گزارش</button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" onclick="exportTableToCSV('tblFinance','گزارش-صندوق')">
                    <i class="bi bi-file-earmark-excel"></i> خروجی اکسل
                </button>
            </div>
        </div>
        <div class="mt-2">
            <small class="text-muted">
                مجموع دریافتی: <strong class="text-success" id="sumCredit">—</strong>
            </small>
        </div>
    </div>
</div>

<!-- خلاصه گزارش -->
<div class="row g-3 mb-3" id="summaryCards" style="display:none;">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h5 id="summaryTotal">۰</h5>
                <small>تعداد تراکنش‌ها</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h5 id="summaryCreditCount">۰</h5>
                <small>تعداد دریافتی</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h5 id="summaryTotalAmount">—</h5>
                <small>مجموع دریافتی</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body text-center">
                <h5 id="summaryAvg">—</h5>
                <small>میانگین هر تراکنش</small>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-cash-stack"></i> لیست دریافتی‌های صندوق</span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success" id="rowCount">۰ رکورد</span>
            <input type="text" id="searchInput" class="form-control form-control-sm" style="width: 200px;" placeholder="جستجو در جدول..." />
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0" id="tblFinance">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>نوع دریافتی</th>
                        <th>شرح</th>
                        <th>نام شخص</th>
                        <th>توضیحات</th>
                        <th>مبلغ (ریال)</th>
                        <th>تاریخ</th>
                    </tr>
                </thead>
                <tbody id="tbodyFinance">
                    <tr><td colspan="7" class="text-center text-muted p-4">برای نمایش گزارش، فیلتر را تنظیم کرده و دکمه «نمایش گزارش» را بزنید.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#btnSearch').click(function () {
        var from = $.trim($('#fromDate').val());
        var to = $.trim($('#toDate').val());
        if (from && to && from > to) { showToast('«از تاریخ» باید قبل از «تا تاریخ» باشد', 'error'); return; }

        var qs = '?';
        if (from) qs += 'from=' + encodeURIComponent(from) + '&';
        if (to) qs += 'to=' + encodeURIComponent(to) + '&';

        apiCall('/api/Admin/FinanceReport' + qs, 'GET', null, function (res) {
            if (res.success) renderTable(res.data || [], res.summary);
        });
    });

    function renderTable(rows, summary) {
        $('#rowCount').text(faNum(rows.length) + ' رکورد');
        var sumCredit = 0;
        
        // نمایش خلاصه گزارش
        if (summary) {
            $('#summaryTotal').text(faNum(summary.totalCount));
            $('#summaryCreditCount').text(faNum(summary.creditCount));
            $('#summaryTotalAmount').text(summary.totalCreditDisplay);
            var avg = summary.totalCount > 0 ? Math.round(summary.totalCredit / summary.totalCount) : 0;
            $('#summaryAvg').text(faNum(avg) + ' ریال');
            $('#summaryCards').show();
        } else {
            $('#summaryCards').hide();
        }

        if (rows.length === 0) {
            $('#tbodyFinance').html('<tr><td colspan="7" class="text-center text-muted p-4">تراکنشی در این بازه یافت نشد.</td></tr>');
            $('#sumCredit').text('—');
            return;
        }
        var html = '';
        $.each(rows, function (i, r) {
            sumCredit += (r.amount || 0);
            var typeBadge = '<span class="badge bg-success">دریافتی</span>';
            html += '<tr>' +
                '<td>' + faNum(i + 1) + '</td>' +
                '<td>' + typeBadge + '</td>' +
                '<td>' + esc(r.typeDesc || '-') + '</td>' +
                '<td>' + esc(r.personName || '-') + '</td>' +
                '<td>' + esc(r.description || '-') + '</td>' +
                '<td class="text-nowrap text-success">' + esc(r.amountDisplay || '-') + '</td>' +
                '<td>' + esc(r.dateDisplay || '-') + '</td>' +
                '</tr>';
        });
        $('#tbodyFinance').html(html);
        $('#sumCredit').text(faNum(sumCredit) + ' ریال');
        initTableSearch();
    }

    // جستجوی ساده در جدول
    function initTableSearch() {
        $('#searchInput').off('keyup').on('keyup', function () {
            var value = $(this).val().toLowerCase();
            var visibleCount = 0;
            $('#tblFinance tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                var match = text.indexOf(value) > -1;
                $(this).toggle(match);
                if (match) {
                    visibleCount++;
                    $(this).find('td:first').text(faNum(visibleCount));
                }
            });
            $('#rowCount').text(faNum(visibleCount) + ' رکورد');
        });
    }

    function exportTableToCSV(tableId, fileName) {
        var rows = document.querySelectorAll('#' + tableId + ' tr');
        if (rows.length <= 1) { showToast('ابتدا گزارش را نمایش دهید', 'warning'); return; }
        var csv = [];
        for (var i = 0; i < rows.length; i++) {
            var cols = rows[i].querySelectorAll('td, th');
            var line = [];
            for (var j = 0; j < cols.length; j++) line.push('"' + cols[j].innerText.replace(/"/g, '""') + '"');
            csv.push(line.join(','));
        }
        var blob = new Blob(['\uFEFF' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = fileName + '.csv';
        link.click();
    }
</script>
}