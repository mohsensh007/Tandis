@{
    ViewData["Title"] = "گزارش بدهی و دریافت";
    Layout = "_AdminLayout";
}

<div class="card mb-3">
    <div class="card-header"><i class="bi bi-funnel"></i> فیلتر بازه زمانی</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">از تاریخ</label>
                <div class="input-group">
                    <input type="text" id="fromDate" class="form-control" placeholder="مثلاً 1405/01/01" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="openCalendar('fromDate','از تاریخ')">
                        <i class="bi bi-calendar3"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="$('#fromDate').val('')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">تا تاریخ</label>
                <div class="input-group">
                    <input type="text" id="toDate" class="form-control" placeholder="مثلاً 1405/03/31" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="openCalendar('toDate','تا تاریخ')">
                        <i class="bi bi-calendar3"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="$('#toDate').val('')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" id="btnSearch"><i class="bi bi-search"></i> نمایش گزارش</button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" onclick="exportTableToCSV('tblFinance','گزارش-مالی')">
                    <i class="bi bi-file-earmark-excel"></i> خروجی اکسل
                </button>
            </div>
        </div>
        <div class="mt-2">
            <small class="text-muted">
                جمع بستانکار: <strong class="text-success" id="sumCredit">—</strong> &nbsp;|&nbsp;
                جمع بدهکار: <strong class="text-danger" id="sumDebit">—</strong> &nbsp;|&nbsp;
                مانده: <strong id="sumBalance">—</strong>
            </small>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul"></i> لیست تراکنش‌های مالی</span>
        <span class="badge bg-primary" id="rowCount">۰ رکورد</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0" id="tblFinance">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>نوع تراکنش</th>
                        <th>شرح</th>
                        <th>نام شخص</th>
                        <th>توضیحات</th>
                        <th>مبلغ</th>
                        <th>تاریخ</th>
                    </tr>
                </thead>
                <tbody id="tbodyFinance">
                    <tr><td colspan="7" class="text-center text-muted p-4">برای نمایش گزارش، فیلتر را تنظیم کرده و دکمه «نمایش گزارش» را بزنید.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#btnSearch').click(function () {
        var from = $.trim($('#fromDate').val());
        var to = $.trim($('#toDate').val());
        if (from && to && from > to) { showToast('«از تاریخ» باید قبل از «تا تاریخ» باشد', 'error'); return; }

        var qs = '?';
        if (from) qs += 'from=' + encodeURIComponent(from) + '&';
        if (to) qs += 'to=' + encodeURIComponent(to) + '&';

        apiCall('/api/Admin/FinanceReport' + qs, 'GET', null, function (res) {
            if (res.success) renderTable(res.data || []);
        });
    });

    function renderTable(rows) {
        $('#rowCount').text(faNum(rows.length) + ' رکورد');
        var sumCredit = 0, sumDebit = 0;
        if (rows.length === 0) {
            $('#tbodyFinance').html('<tr><td colspan="7" class="text-center text-muted p-4">تراکنشی در این بازه یافت نشد.</td></tr>');
            $('#sumCredit,#sumDebit,#sumBalance').text('—');
            return;
        }
        var html = '';
        $.each(rows, function (i, r) {
            var isCredit = r.rowType === 'بستانکار';
            if (isCredit) sumCredit += (r.amount || 0); else sumDebit += (r.amount || 0);
            var typeBadge = isCredit
                ? '<span class="badge bg-success">بستانکار</span>'
                : '<span class="badge bg-danger">بدهکار</span>';
            var amtClass = isCredit ? 'text-success' : 'text-danger';
            html += '<tr>' +
                '<td>' + faNum(i + 1) + '</td>' +
                '<td>' + typeBadge + '</td>' +
                '<td>' + esc(r.typeDesc || '-') + '</td>' +
                '<td>' + esc(r.personName || '-') + '</td>' +
                '<td>' + esc(r.description || '-') + '</td>' +
                '<td class="text-nowrap ' + amtClass + '">' + esc(r.amountDisplay || '-') + '</td>' +
                '<td>' + esc(r.dateDisplay || '-') + '</td>' +
                '</tr>';
        });
        $('#tbodyFinance').html(html);
        $('#sumCredit').text(faNum(sumCredit) + ' ریال');
        $('#sumDebit').text(faNum(sumDebit) + ' ریال');
        var bal = sumCredit - sumDebit;
        $('#sumBalance').text((bal >= 0 ? '+' : '') + faNum(bal) + ' ریال');
    }

    function exportTableToCSV(tableId, fileName) {
        var rows = document.querySelectorAll('#' + tableId + ' tr');
        if (rows.length <= 1) { showToast('ابتدا گزارش را نمایش دهید', 'warning'); return; }
        var csv = [];
        for (var i = 0; i < rows.length; i++) {
            var cols = rows[i].querySelectorAll('td, th');
            var line = [];
            for (var j = 0; j < cols.length; j++) line.push('"' + cols[j].innerText.replace(/"/g, '""') + '"');
            csv.push(line.join(','));
        }
        var blob = new Blob(['\uFEFF' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = fileName + '.csv';
        link.click();
    }
</script>
}
