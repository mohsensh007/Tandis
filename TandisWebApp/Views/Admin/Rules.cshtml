@{
    ViewData["Title"] = "شرایط باشگاه";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-shield-check"></i> شرایط و تعهدات باشگاه</h5>
    <a href="/Admin" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> بازگشت</a>
</div>

<div class="card">
    <div class="card-header"><span>متن شرایط (نمایش در صفحه ثبت‌نام اعضا)</span></div>
    <div class="purple-style card-body">
        <textarea id="txtRules" class="form-control" rows="14"
                  style="white-space:pre-wrap; line-height:1.9;"
                  placeholder="متن شرایط و تعهدات باشگاه را اینجا بنویسید..."></textarea>
        <button id="btnSaveRules" class="btn btn-primary w-100 py-2 mt-3">
            <i class="bi bi-save"></i> ذخیره شرایط
        </button>
    </div>
</div>

@section Scripts {
    <script>
        apiCall('/api/Admin/Rules', 'GET', null, function (res) {
            if (res && res.success) $('#txtRules').val(res.data || '');
        });

        $('#btnSaveRules').click(function () {
            var text = $('#txtRules').val();
            if (!text || !$.trim(text)) { showToast('متن شرایط خالی است', 'error'); return; }
            apiCall('/api/Admin/Rules', 'POST', { rulesText: text }, function (res) {
                showToast(res.message, res.success ? 'success' : 'error');
            });
        });
    </script>
}