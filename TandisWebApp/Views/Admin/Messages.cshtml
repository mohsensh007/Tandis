@{
    ViewData["Title"] = "مدیریت پیام‌ها";
    Layout = "_AdminLayout";  
}

<!-- ✅ نوار ابزار بالا -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">📨 مدیریت پیام‌ها</h4>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/Admin/CoachMessages" class="btn btn-outline-warning btn-sm">
            🕵️ نظارت پیام‌های مربی-شاگرد
        </a>
        <a href="/Admin" class="btn btn-outline-secondary btn-sm">🔙 داشبورد</a>
    </div>
</div>

<div class="row g-3">
    <!-- ستون لیست پیام‌ها -->
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📨 اینباکس پیام‌ها</h5>
                <button class="btn btn-sm btn-outline-light" id="btnRefreshInbox">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>عضو</th>
                                <th>موبایل</th>
                                <th>پیام</th>
                                <th>تاریخ</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyInbox">
                            <tr><td colspan="5" class="text-center py-3">در حال بارگذاری...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ستون ارسال پیام گروهی -->
    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">📢 ارسال پیام گروهی</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">مخاطب</label>
                    <select class="form-select" id="selTargetType">
                        <option value="1">همه اعضا</option>
                        <option value="2">یک نقش خاص</option>
                        <option value="3">اعضای یک رشته خاص</option>
                        <option value="4">یک عضو خاص</option>
                    </select>
                </div>

                <div id="divRole" class="mb-3" style="display:none;">
                    <label class="form-label">نقش</label>
                    <select class="form-select" id="selRole">
                        <option value="">در حال بارگذاری...</option>
                    </select>
                </div>

                <div id="divSport" class="mb-3" style="display:none;">
                    <label class="form-label">رشته ورزشی</label>
                    <select class="form-select" id="selSport">
                        <option value="">در حال بارگذاری...</option>
                    </select>
                </div>

                <div id="divMember" class="mb-3" style="display:none;">
                    <label class="form-label">کد عضویت یا نام</label>
                    <input type="text" class="form-control" id="txtMemberSearch" placeholder="جستجو...">
                    <select class="form-select mt-2" id="selMember" style="display:none;"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label">عنوان (اختیاری)</label>
                    <input type="text" class="form-control" id="txtTitle" maxlength="200">
                </div>

                <div class="mb-3">
                    <label class="form-label">متن پیام</label>
                    <textarea class="form-control" id="txtBody" rows="5"></textarea>
                </div>

                <button class="btn btn-primary w-100" id="btnSendBroadcast">
                    <i class="bi bi-send-fill"></i> ارسال پیام
                </button>
            </div>
        </div>
    </div>
</div>

<!-- مودال پاسخ به پیام -->
<div class="modal fade" id="replyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">پاسخ به <span id="replyTo"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-light small" id="origBody"></div>
                <div class="mb-3">
                    <label class="form-label">متن پاسخ</label>
                    <textarea class="form-control" id="txtReplyBody" rows="4"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnSendReply">ارسال پاسخ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-messages.js?v=1"></script>
}
<style>
    /* ===== دکمه‌های تم‌رنگ: گرادیان بنفش-آبی، کوچیک و جمع‌وجور ===== */
    .btn-outline-warning,
    .btn-outline-secondary,
    .btn-outline-primary,
    .btn-outline-light {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: .78rem;
        padding: .5rem .95rem;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(118,75,162,.35);
        transition: all .25s;
    }

        .btn-outline-warning:hover,
        .btn-outline-secondary:hover,
        .btn-outline-primary:hover,
        .btn-outline-light:hover {
            filter: brightness(1.12);
            color: #fff;
            transform: translateY(-1px);
        }

    /* ===== دکمه ارسال پیام: همون گرادیان، تمام‌عرض ولی نه ضخیم ===== */
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
        font-weight: 800;
        font-size: .88rem;
        padding: .6rem 1rem;
        border-radius: 14px;
        box-shadow: 0 6px 16px rgba(118,75,162,.40);
        transition: all .25s;
    }

        .btn-primary:hover {
            filter: brightness(1.12);
            color: #fff;
        }

    /* ===== اینپوت‌های شیشه‌ای ===== */
    .form-control, .form-select {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.16);
        color: #fff;
        border-radius: 12px;
        font-size: .85rem;
    }

        .form-control::placeholder {
            color: #8a93a6;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,.12);
            border-color: rgba(102,211,232,.5);
            color: #fff;
            box-shadow: 0 0 0 .2rem rgba(102,211,232,.15);
        }

        .form-select option {
            background: #101424;
            color: #fff;
        }

    .form-label {
        color: #9fb3c8;
        font-size: .8rem;
        font-weight: 700;
    }

    /* ===== جدول اینباکس شیشه‌ای ===== */
    .table thead th {
        background: rgba(255,255,255,.06);
        color: #9fb3c8;
        font-size: .78rem;
        font-weight: 700;
        border-bottom: 1px solid rgba(255,255,255,.10);
    }

    .table tbody td {
        border-color: rgba(255,255,255,.06);
        font-size: .82rem;
        color: #cbd3da;
    }

    .table-hover tbody tr:hover > * {
        background: rgba(102,211,232,.06);
    }

    /* ===== بج‌های داخل جدول ===== */
    .badge.bg-warning {
        background: rgba(255,193,7,.18) !important;
        color: #ffd200;
        border: 1px solid rgba(255,193,7,.4);
    }

    .badge.bg-success {
        background: rgba(56,217,169,.18) !important;
        color: #38d9a9;
        border: 1px solid rgba(56,217,169,.4);
    }

    .badge.bg-danger {
        background: rgba(255,107,129,.18) !important;
        color: #ff6b81;
        border: 1px solid rgba(255,107,129,.4);
    }
</style>