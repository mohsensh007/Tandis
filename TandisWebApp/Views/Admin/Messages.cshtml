@{
    ViewData["Title"] = "مدیریت پیام‌ها";
    Layout = "_AdminLayout";  
}

<!-- ✅ نوار ابزار بالا -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">📨 مدیریت پیام‌ها</h4>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/Admin/CoachMessages" class="btn btn-outline-warning btn-sm">
            🕵️ نظارت پیام‌های مربی-شاگرد
        </a>
        <a href="/Admin" class="btn btn-outline-secondary btn-sm">🔙 داشبورد</a>
    </div>
</div>

<div class="row g-3">
    <!-- ستون لیست پیام‌ها -->
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📨 اینباکس پیام‌ها</h5>
                <button class="btn btn-sm btn-outline-light" id="btnRefreshInbox">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>عضو</th>
                                <th>موبایل</th>
                                <th>پیام</th>
                                <th>تاریخ</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyInbox">
                            <tr><td colspan="5" class="text-center py-3">در حال بارگذاری...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ستون ارسال پیام گروهی -->
    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">📢 ارسال پیام</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">گیرندگان</label>
                    <button type="button" class="btn btn-recipients w-100" id="btnOpenRecipients">
                        <i class="bi bi-people-fill"></i>
                        <span id="recSummary">همه اعضا</span>
                        <i class="bi bi-caret-left-fill"></i>
                    </button>
                    <div class="small mt-1" style="color:#8a93a6">
                        برای انتخاب نقش، رشته یا افراد مشخص، روی دکمه بالا بزنید.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">عنوان (اختیاری)</label>
                    <input type="text" class="form-control" id="txtTitle" maxlength="200">
                </div>

                <div class="mb-3">
                    <label class="form-label">متن پیام</label>
                    <textarea class="form-control" id="txtBody" rows="5"></textarea>
                </div>

                <button class="btn btn-primary w-100" id="btnSendBroadcast">
                    <i class="bi bi-send-fill"></i> ارسال پیام
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= مودال انتخاب گیرندگان (روی همین صفحه باز می‌شود) ================= -->
<div class="modal fade" id="recipientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
        <div class="modal-content rec-modal">
            <div class="modal-header rec-head">
                <h5 class="modal-title"><i class="bi bi-people-fill"></i> انتخاب گیرندگان پیام</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- تب‌های نوع گیرنده -->
                <div class="rec-tabs" role="tablist">
                    <button type="button" class="rec-tab active" data-mode="all">همه اعضا</button>
                    <button type="button" class="rec-tab" data-mode="role">بر اساس نقش</button>
                    <button type="button" class="rec-tab" data-mode="sport">بر اساس رشته</button>
                </div>

                <!-- حالت ۱: همه اعضا -->
                <div class="rec-panel" id="panelAll">
                    <div class="rec-note">
                        <i class="bi bi-broadcast"></i>
                        پیام برای <b>همه اعضا</b> (همه نقش‌ها و همه رشته‌ها) ارسال می‌شود.
                    </div>
                </div>

                <!-- حالت ۲: نقش -->
                <div class="rec-panel" id="panelRole" style="display:none">
                    <label class="form-label">نقش را انتخاب کنید</label>
                    <select class="form-select" id="selRecRole">
                        <option value="">-- انتخاب نقش --</option>
                    </select>

                    <div class="rec-toolbar d-flex align-items-center justify-content-between gap-2">
                        <input type="search" class="form-control" id="txtRoleSearch"
                               placeholder="جستجو: نام / موبایل / کد عضویت" />
                    </div>
                    <div class="rec-counter" id="roleCounter"></div>
                    <div class="rec-list" id="roleList" data-mode="role">
                        <div class="rec-hint">ابتدا یک نقش انتخاب کنید</div>
                    </div>
                </div>

                <!-- حالت ۳: رشته ورزشی -->
                <div class="rec-panel" id="panelSport" style="display:none">
                    <label class="form-label">رشته‌های ورزشی (چندتایی)</label>
                    <div class="rec-toolbar">
                        <input type="search" class="form-control" id="txtSportSearch"
                               placeholder="جستجوی رشته ورزشی" />
                    </div>
                    <div class="rec-chips" id="sportChips">
                        <div class="rec-hint">در حال بارگذاری رشته‌ها...</div>
                    </div>

                    <div class="rec-subhead">
                        اعضای رشته‌های انتخاب‌شده
                        <span class="badge rec-badge" id="sportScopeCount">۰ رشته</span>
                    </div>
                    <div class="rec-toolbar">
                        <input type="search" class="form-control" id="txtSportMemberSearch"
                               placeholder="جستجو: نام / موبایل / کد عضویت" />
                    </div>
                    <div class="rec-counter" id="sportCounter"></div>
                    <div class="rec-list" id="sportMemberList" data-mode="sport">
                        <div class="rec-hint">ابتدا حداقل یک رشته را تیک بزنید</div>
                    </div>
                </div>
            </div>

            <!-- فوتر مودال: دامنه ارسال + تأیید -->
            <div class="rec-footer">
                <div class="rec-scope" id="recScopeBox">
                    <label class="rec-radio">
                        <input type="radio" name="recScope" value="all" checked />
                        <span>ارسال به همهٔ این فیلتر</span>
                    </label>
                    <label class="rec-radio">
                        <input type="radio" name="recScope" value="ids" />
                        <span>فقط افراد تیک‌خورده (<b id="recCount">۰</b>)</span>
                    </label>
                </div>
                <div class="d-flex gap-2 w-100 mt-2">
                    <button type="button" class="btn btn-outline-light flex-grow-1" id="btnRecClear">پاک کردن</button>
                    <button type="button" class="btn btn-primary flex-grow-1" id="btnRecApply">
                        <i class="bi bi-check2-all"></i> تأیید انتخاب
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال پاسخ به پیام -->
<div class="modal fade" id="replyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">پاسخ به <span id="replyTo"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-light small" id="origBody"></div>
                <div class="mb-3">
                    <label class="form-label">متن پاسخ</label>
                    <textarea class="form-control" id="txtReplyBody" rows="4"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnSendReply">ارسال پاسخ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-messages.js?v=4"></script>
}
<style>
    /* ===== دکمه‌های تم‌رنگ: گرادیان بنفش-آبی، کوچیک و جمع‌وجور ===== */
    .btn-outline-warning,
    .btn-outline-secondary,
    .btn-outline-primary,
    .btn-outline-light {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: .78rem;
        padding: .5rem .95rem;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(118,75,162,.35);
        transition: all .25s;
    }

        .btn-outline-warning:hover,
        .btn-outline-secondary:hover,
        .btn-outline-primary:hover,
        .btn-outline-light:hover {
            filter: brightness(1.12);
            color: #fff;
            transform: translateY(-1px);
        }

    /* ===== دکمه ارسال پیام: همون گرادیان، تمام‌عرض ولی نه ضخیم ===== */
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
        font-weight: 800;
        font-size: .88rem;
        padding: .6rem 1rem;
        border-radius: 14px;
        box-shadow: 0 6px 16px rgba(118,75,162,.40);
        transition: all .25s;
    }

        .btn-primary:hover {
            filter: brightness(1.12);
            color: #fff;
        }

    /* ===== اینپوت‌های شیشه‌ای ===== */
    .form-control, .form-select {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.16);
        color: #fff;
        border-radius: 12px;
        font-size: .85rem;
    }

        .form-control::placeholder {
            color: #8a93a6;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,.12);
            border-color: rgba(102,211,232,.5);
            color: #fff;
            box-shadow: 0 0 0 .2rem rgba(102,211,232,.15);
        }

        .form-select option {
            background: #101424;
            color: #fff;
        }

    .form-label {
        color: #9fb3c8;
        font-size: .8rem;
        font-weight: 700;
    }

    /* ===== جدول اینباکس شیشه‌ای ===== */
    .table thead th {
        background: rgba(255,255,255,.06);
        color: #9fb3c8;
        font-size: .78rem;
        font-weight: 700;
        border-bottom: 1px solid rgba(255,255,255,.10);
    }

    .table tbody td {
        border-color: rgba(255,255,255,.06);
        font-size: .82rem;
        color: #cbd3da;
    }

    .table-hover tbody tr:hover > * {
        background: rgba(102,211,232,.06);
    }

    /* ===== بج‌های داخل جدول ===== */
    .badge.bg-warning {
        background: rgba(255,193,7,.18) !important;
        color: #ffd200;
        border: 1px solid rgba(255,193,7,.4);
    }

    .badge.bg-success {
        background: rgba(56,217,169,.18) !important;
        color: #38d9a9;
        border: 1px solid rgba(56,217,169,.4);
    }

    .badge.bg-danger {
        background: rgba(255,107,129,.18) !important;
        color: #ff6b81;
        border: 1px solid rgba(255,107,129,.4);
    }

    /* ===== دکمه انتخاب گیرندگان ===== */
    .btn-recipients {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,.06);
        border: 1px dashed rgba(102,211,232,.5);
        color: #dce9ff;
        border-radius: 14px;
        padding: .68rem .9rem;
        font-weight: 700;
        font-size: .85rem;
        text-align: right;
        transition: all .25s;
    }

        .btn-recipients:hover, .btn-recipients:focus {
            background: rgba(102,211,232,.12);
            color: #fff;
            border-color: rgba(102,211,232,.8);
        }

        .btn-recipients .bi-caret-left-fill {
            margin-inline-start: auto;
            color: #66d3e8;
        }

    /* ===== مودال انتخاب گیرندگان ===== */
    .rec-modal {
        background: #131a2e;
        border: 1px solid rgba(255,255,255,.10);
        color: #e9ecef;
    }

    .rec-head {
        border-bottom: 1px solid rgba(255,255,255,.08);
        padding: 14px 16px;
    }

        .rec-head .modal-title {
            font-size: .95rem;
            font-weight: 800;
            color: #fff;
        }

            .rec-head .modal-title i {
                color: #66d3e8;
                margin-left: 6px;
            }

    .rec-tabs {
        display: flex;
        gap: 6px;
        background: rgba(255,255,255,.06);
        padding: 5px;
        border-radius: 14px;
        margin-bottom: 14px;
    }

    .rec-tab {
        flex: 1 1 0;
        border: none;
        background: transparent;
        color: #9fb3c8;
        font-weight: 700;
        font-size: .78rem;
        padding: .55rem .3rem;
        border-radius: 10px;
        transition: all .2s;
        min-height: 42px;
    }

        .rec-tab.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            box-shadow: 0 4px 12px rgba(118,75,162,.4);
        }

    .rec-note {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 14px;
        padding: 14px;
        font-size: .85rem;
        color: #cbd3da;
        line-height: 1.9;
    }

        .rec-note i {
            color: #66d3e8;
            margin-left: 6px;
        }

    .rec-toolbar {
        margin: 10px 0 8px;
    }

    .rec-counter {
        font-size: .74rem;
        color: #66d3e8;
        margin: 0 2px 6px;
        min-height: 1em;
    }

    .rec-list {
        max-height: 40vh;
        overflow-y: auto;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 14px;
        padding: 6px;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(102,211,232,.55) rgba(255,255,255,.06);
    }

        .rec-list::-webkit-scrollbar {
            width: 8px;
        }

        .rec-list::-webkit-scrollbar-track {
            background: rgba(255,255,255,.06);
            border-radius: 8px;
        }

        .rec-list::-webkit-scrollbar-thumb {
            background: rgba(102,211,232,.55);
            border-radius: 8px;
        }

    .rec-more {
        text-align: center;
        color: #8a93a6;
        font-size: .74rem;
        padding: 10px 6px 4px;
    }

    .rec-hint {
        color: #8a93a6;
        font-size: .8rem;
        text-align: center;
        padding: 18px 8px;
        margin: 0;
    }

    .rec-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-radius: 10px;
        cursor: pointer;
        border-bottom: 1px solid rgba(255,255,255,.05);
        min-height: 48px;
    }

        .rec-item:last-child {
            border-bottom: none;
        }

        .rec-item:hover {
            background: rgba(102,211,232,.08);
        }

        .rec-item input {
            width: 18px;
            height: 18px;
            accent-color: #667eea;
            flex: 0 0 auto;
            margin: 0;
        }

    .rec-item-body {
        min-width: 0;
        flex: 1 1 auto;
    }

    .rec-name {
        font-size: .85rem;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rec-sub {
        font-size: .7rem;
        color: #66d3e8;
        direction: ltr;
        text-align: right;
    }

    .rec-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 22vh;
        overflow-y: auto;
        padding: 4px 2px 10px;
        -webkit-overflow-scrolling: touch;
    }

    .rec-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 999px;
        padding: 8px 13px;
        font-size: .78rem;
        color: #dce9ff;
        cursor: pointer;
        min-height: 40px;
        transition: all .2s;
    }

        .rec-chip.on {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: transparent;
            color: #fff;
            box-shadow: 0 4px 10px rgba(118,75,162,.4);
        }

        .rec-chip .bi-check2 {
            display: none;
        }

        .rec-chip.on .bi-check2 {
            display: inline-block;
        }

    .rec-subhead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        font-size: .82rem;
        font-weight: 800;
        color: #9fb3c8;
    }

    .rec-badge {
        background: rgba(102,211,232,.15);
        color: #66d3e8;
        border: 1px solid rgba(102,211,232,.35);
        font-size: .7rem;
    }

    .rec-footer {
        border-top: 1px solid rgba(255,255,255,.08);
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
        background: rgba(0,0,0,.25);
    }

    .rec-scope {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rec-radio {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: .82rem;
        color: #cbd3da;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 10px 12px;
        cursor: pointer;
        margin: 0;
        min-height: 46px;
    }

        .rec-radio input {
            width: 17px;
            height: 17px;
            accent-color: #667eea;
            margin: 0;
        }

        .rec-radio.disabled {
            opacity: .45;
            pointer-events: none;
        }

    @@media (max-width: 576px) {
        .rec-list {
            max-height: 36vh;
        }

        .rec-chips {
            max-height: 18vh;
        }
    }
</style>