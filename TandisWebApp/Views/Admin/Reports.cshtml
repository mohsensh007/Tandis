@{
    ViewData["Title"] = "گزارش‌ها";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-graph-up-arrow hd-icon"></i> گزارش‌های مدیریتی</h5>
    <a href="/Admin" class="purple-style btn-back-glass"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-3">
        <a href="/Admin/TrafficReport" class="text-decoration-none">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="rc-title">گزارش ترددها</div>
                <div class="rc-desc">ورود و خروج اعضای شیفت</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="/Admin/RegisterReport" class="text-decoration-none">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div class="rc-title">ثبت‌نام و تمدید</div>
                <div class="rc-desc">ثبت‌نام‌ها و تمدیدهای دوره</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="/Admin/OneSessionReport" class="text-decoration-none">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <div class="rc-title">تک‌جلسه‌ها</div>
                <div class="rc-desc">بلیت‌های جلسه آزاد</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="/Admin/FinanceReport" class="text-decoration-none">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="rc-title">گزارش صندوق</div>
                <div class="rc-desc">تراکنش‌های مالی شیفت</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>
</div>

<style>
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    .btn-back-glass {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .btn-back-glass i {
            color: #66d3e8;
            transition: transform .25s;
        }

        .btn-back-glass:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

            .btn-back-glass:hover i {
                transform: translateX(3px);
            }

    .report-card {
        position: relative;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        padding: 22px 18px;
        overflow: hidden;
        transition: transform .25s, border-color .25s;
        color: #fff;
    }

        .report-card:hover {
            transform: translateY(-4px);
            border-color: rgba(102,211,232,.5);
        }

        .report-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(102,211,232,.20), transparent 70%);
            pointer-events: none;
        }

    .rc-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.6rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.3);
        margin-bottom: 14px;
    }

    .rc-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 4px;
    }

    .rc-desc {
        font-size: .82rem;
        color: #9fb3c8;
        line-height: 1.5;
    }

    .rc-arrow {
        position: absolute;
        top: 20px;
        left: 20px;
        color: #66d3e8;
        font-size: 1.1rem;
        transition: transform .25s;
    }

    .report-card:hover .rc-arrow {
        transform: translateX(-4px);
    }
</style>