@{
    ViewData["Title"] = "گزارش‌ها";
    Layout = "_AdminLayout";
}

<div class="admin-reports-page">
<div class="d-flex justify-content-between align-items-center mb-3 admin-reports-header">
    <h5 class="mb-0"><i class="bi bi-graph-up-arrow hd-icon"></i> گزارش‌های مدیریتی</h5>
    <a href="/Admin" class="purple-style btn-back-glass"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

<div class="row g-3 admin-reports-grid">
    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/TrafficReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="rc-title">گزارش ترددها</div>
                <div class="rc-desc">ورود و خروج اعضای شیفت</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/RegisterReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div class="rc-title">ثبت‌نام و تمدید</div>
                <div class="rc-desc">ثبت‌نام‌ها و تمدیدهای دوره</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/FinanceReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="rc-title">گزارش صندوق</div>
                <div class="rc-desc">تراکنش‌های مالی شیفت</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/TicketSalesReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div class="rc-title">فروش بلیت</div>
                <div class="rc-desc">بلیت‌های فروخته‌شده شیفت</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/ServicesReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-tools"></i>
                </div>
                <div class="rc-title">فروش خدمات</div>
                <div class="rc-desc">خدمات ارائه‌شده به اعضا</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/GuestSessionReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div class="rc-title">تک‌جلسه (مهمان‌ها)</div>
                <div class="rc-desc">مهمان‌ها و سانس تک‌جلسه آنها</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3 admin-report-col">
        <a href="/Admin/ExpenseReport" class="text-decoration-none admin-report-link">
            <div class="purple-style report-card h-100">
                <div class="rc-icon" style="background: linear-gradient(135deg, #1E6FD9, #66D3E8);">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div class="rc-title">گزارش هزینه‌ها</div>
                <div class="rc-desc">اسناد هزینه</div>
                <div class="rc-arrow"><i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>
</div>
</div>

<style>
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    .admin-reports-page {
        width: 100%;
        min-width: 0;
    }

    .admin-reports-header {
        min-width: 0;
        gap: 12px;
        flex-wrap: wrap;
    }

    .admin-reports-header h5 {
        min-width: 0;
        line-height: 1.55;
    }

    .admin-reports-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem !important;
        margin: 0 !important;
    }

    .admin-reports-grid > .admin-report-col {
        display: flex;
        width: 100%;
        min-width: 0;
        max-width: none;
        padding: 0;
    }

    .admin-report-link {
        display: block;
        width: 100%;
        min-width: 0;
    }

    .btn-back-glass {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .btn-back-glass i {
            color: #66d3e8;
            transition: transform .25s;
        }

        .btn-back-glass:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

            .btn-back-glass:hover i {
                transform: translateX(3px);
            }

    .report-card {
        width: 100%;
        position: relative;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        padding: 22px 18px;
        overflow: hidden;
        transition: transform .25s, border-color .25s;
        color: #fff;
    }

        .report-card:hover {
            transform: translateY(-4px);
            border-color: rgba(102,211,232,.5);
        }

        .report-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(102,211,232,.20), transparent 70%);
            pointer-events: none;
        }

    .rc-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.6rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.3);
        margin-bottom: 14px;
    }

    .rc-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 4px;
    }

    .rc-desc {
        font-size: .82rem;
        color: #9fb3c8;
        line-height: 1.5;
    }

    .rc-arrow {
        position: absolute;
        top: 20px;
        left: 20px;
        color: #66d3e8;
        font-size: 1.1rem;
        transition: transform .25s;
    }

    .report-card:hover .rc-arrow {
        transform: translateX(-4px);
    }

    @@media (min-width: 768px) {
        .admin-reports-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (min-width: 1200px) {
        .admin-reports-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .admin-reports-header {
            align-items: stretch !important;
        }

        .admin-reports-header h5,
        .admin-reports-header .btn-back-glass {
            width: 100%;
        }

        .admin-reports-header .btn-back-glass {
            justify-content: center;
        }

        .report-card {
            min-height: 156px;
            padding: 20px 16px;
        }
    }
</style>
