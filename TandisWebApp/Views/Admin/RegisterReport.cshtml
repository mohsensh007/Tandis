@{
    ViewData["Title"] = "گزارش ثبت‌نام و تمدید";
    Layout = "_AdminLayout";
}

<div class="purple-style rep-filter mb-3">
    <div class="row g-2">
        <div class="col-6 col-md-3">
            <div class="rep-label">از تاریخ</div>
            <div class="rep-input-group">
                <input type="text" id="fromDate" class="rep-input" placeholder="1405/01/01" readonly />
                <button type="button" class="rep-btn-icon" onclick="openCalendar('fromDate','از تاریخ')"><i class="bi bi-calendar3"></i></button>
                <button type="button" class="rep-btn-icon danger" onclick="$('#fromDate').val('')"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="rep-label">تا تاریخ</div>
            <div class="rep-input-group">
                <input type="text" id="toDate" class="rep-input" placeholder="1405/03/31" readonly />
                <button type="button" class="rep-btn-icon" onclick="openCalendar('toDate','تا تاریخ')"><i class="bi bi-calendar3"></i></button>
                <button type="button" class="rep-btn-icon danger" onclick="$('#toDate').val('')"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="rep-label">نوع گزارش</div>
            <div class="rep-mode-group">
                <input type="radio" class="btn-check" name="modeRadio" id="modeBoth" value="both" checked autocomplete="off">
                <label class="rep-mode" for="modeBoth">همه</label>
                <input type="radio" class="btn-check" name="modeRadio" id="modeRegister" value="register" autocomplete="off">
                <label class="rep-mode" for="modeRegister">ثبت‌نام</label>
                <input type="radio" class="btn-check" name="modeRadio" id="modeRenew" value="renew" autocomplete="off">
                <label class="rep-mode" for="modeRenew">تمدید</label>
            </div>
        </div>
        <div class="col-6 col-md-3 d-grid gap-2">
            <button class="rep-btn-main" id="btnSearch"><i class="bi bi-search"></i> نمایش گزارش</button>
            <button class="rep-btn-excel" id="btnExport"><i class="bi bi-file-earmark-excel"></i> خروجی اکسل</button>
        </div>
    </div>
</div>

<div class="rep-summary mb-3" id="summaryCards" style="display:none;">
    <div class="purple-style rep-chip hl"><b id="summaryTotal">۰</b><span>مجموع</span></div>
    <div class="purple-style rep-chip"><b id="summaryRegister">۰</b><span>ثبت‌نام</span></div>
    <div class="purple-style rep-chip"><b id="summaryRenewal">۰</b><span>تمدید</span></div>
    <div class="purple-style rep-chip"><b id="summaryAmount">—</b><span>مجموع مبالغ</span></div>
</div>

<div class="rep-list-head">
    <span class="rep-count" id="rowCount">۰ رکورد</span>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <select id="sortKey" class="purple-style rep-search">
            <option value="">مرتب‌سازی: پیش‌فرض</option>
            <option value="date">تاریخ ثبت</option>
            <option value="amount">مبلغ پرداختی</option>
            <option value="name">نام شخص</option>
        </select>
        <button type="button" class="purple-style rep-btn-icon" id="sortDir" data-dir="desc" title="جهت مرتب‌سازی">
            <i class="bi bi-sort-down"></i>
        </button>
        <input type="text" id="searchInput" class="rep-search" placeholder="🔍 جستجو..." />
    </div>
</div>
<div id="repList">
    <div class="text-center text-muted py-4">فیلتر را تنظیم کرده و «نمایش گزارش» را بزنید.</div>
</div>

@section Scripts {
    <script>
        var lastRows = [];
        var csvColumns = [
            { t: 'نام', g: function (r) { return r.personName || ''; } },
            { t: 'کد عضویت', g: function (r) { return r.memberCode || ''; } },
            { t: 'ورزش', g: function (r) { return r.sportName || ''; } },
            { t: 'سانس', g: function (r) { return r.sanseName || ''; } },
            { t: 'مربی', g: function (r) { return r.coachName || ''; } },
            { t: 'نوع', g: function (r) { return r.isRevival ? 'تمدید' : 'ثبت‌نام'; } },
            { t: 'دوره', g: function (r) { return r.periodDesc || ''; } },
            { t: 'مبلغ', g: function (r) { return r.finalPaymentDisplay || ''; } },
            { t: 'شروع', g: function (r) { return r.startDate || ''; } },
            { t: 'پایان', g: function (r) { return r.endDate || ''; } },
            { t: 'تاریخ ثبت', g: function (r) { return (r.creationDate || '') + ' ' + (r.creationTime || ''); } }
        ];

        $('#btnSearch').click(function () {
            var from = $.trim($('#fromDate').val());
            var to = $.trim($('#toDate').val());
            if (from && to && from > to) { showToast('«از تاریخ» باید قبل از «تا تاریخ» باشد', 'error'); return; }
            var mode = $('input[name="modeRadio"]:checked').val();
            var qs = '?mode=' + mode;
            if (from) qs += '&from=' + encodeURIComponent(from);
            if (to) qs += '&to=' + encodeURIComponent(to);
            apiCall('/api/Admin/RegisterReport' + qs, 'GET', null, function (res) {
                if (res.success) renderList(res.data || [], res.summary);
            });
        });

        function renderList(rows, summary) {
            lastRows = rows;
            lastSummary = summary || null;
            if (summary) {
                $('#summaryTotal').text(faNum(summary.totalCount));
                $('#summaryRegister').text(faNum(summary.registerCount));
                $('#summaryRenewal').text(faNum(summary.renewalCount));
                $('#summaryAmount').text(summary.totalAmountDisplay || '—');
                $('#summaryCards').show();
            } else { $('#summaryCards').hide(); }

            $('#rowCount').text(faNum(rows.length) + ' رکورد');
            $('#searchInput').val('');
            var $box = $('#repList');
            if (!rows.length) { $box.html('<div class="text-center text-muted py-4">رکوردی در این بازه یافت نشد.</div>'); return; }

            var html = '';
            $.each(rows, function (i, r) {
                var badge = r.isRevival ? '<span class="rep-badge ren">تمدید</span>' : '<span class="rep-badge reg">ثبت‌نام</span>';
                html += '<div class="rep-card">' +
                    '<div class="rep-head">' +
                        '<div class="rep-num">' + faNum(i + 1) + '</div>' +
                        '<div class="rep-mid">' +
                            '<div class="rep-line"><b>' + esc(r.personName || '-') + '</b> ' + badge + '</div>' +
                            '<div class="rep-line">🏋️ ' + esc(r.sportName || '-') + ' - ' + esc(r.sanseName || '-') + '</div>' +
                            '<div class="rep-line">💰 <span class="amt">' + esc(r.finalPaymentDisplay || '-') + '</span></div>' +
                        '</div>' +
                        '<button type="button" class="rep-toggle"><i class="bi bi-chevron-left"></i></button>' +
                    '</div>' +
                    '<div class="rep-details">' +
                        '<div class="rep-drow"><span>کد عضویت</span><b>' + esc(r.memberCode || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>مربی</span><b>' + esc(r.coachName || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>دوره</span><b>' + esc(r.periodDesc || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>شروع</span><b>' + esc(r.startDate || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>پایان</span><b>' + esc(r.endDate || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>تاریخ ثبت</span><b>' + esc(r.creationDate || '-') + ' ' + esc(r.creationTime || '') + '</b></div>' +
                    '</div>' +
                '</div>';
            });
            $box.html(html);
        }

        $(document).on('click', '.rep-head', function () {
            var $c = $(this).closest('.rep-card');
            $c.toggleClass('open');
            $c.find('.rep-details').slideToggle(200);
        });

        $('#searchInput').on('keyup', function () {
            var v = $(this).val().toLowerCase(); var n = 0;
            $('.rep-card').each(function () {
                var m = $(this).text().toLowerCase().indexOf(v) > -1;
                $(this).toggle(m); if (m) n++;
            });
            $('#rowCount').text(faNum(n) + ' رکورد');
        });

        $('#btnExport').click(function () {
            if (!lastRows.length) { showToast('ابتدا گزارش را نمایش دهید', 'warning'); return; }
            var lines = [csvColumns.map(function (c) { return '"' + c.t + '"'; }).join(',')];
            lastRows.forEach(function (r) {
                lines.push(csvColumns.map(function (c) { return '"' + String(c.g(r)).replace(/"/g, '""') + '"'; }).join(','));
            });
            var blob = new Blob(['\uFEFF' + lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'گزارش-ثبت‌نام.csv';
            link.click();
            URL.revokeObjectURL(link.href);
        });
    </script>
}