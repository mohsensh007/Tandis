@{
    ViewData["Title"] = "گزارش ترددها";
    Layout = "_AdminLayout";
}

<div class="card mb-3">
    <div class="card-header"><i class="bi bi-funnel"></i> فیلتر بازه زمانی</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">از تاریخ</label>
                <div class="input-group">
                    <input type="text" id="fromDate" class="form-control" placeholder="مثلاً 1405/01/01" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="openCalendar('fromDate','از تاریخ')">
                        <i class="bi bi-calendar3"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="$('#fromDate').val('')" title="پاک کردن">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">تا تاریخ</label>
                <div class="input-group">
                    <input type="text" id="toDate" class="form-control" placeholder="مثلاً 1405/03/31" readonly />
                    <button type="button" class="btn btn-outline-secondary" onclick="openCalendar('toDate','تا تاریخ')">
                        <i class="bi bi-calendar3"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger" onclick="$('#toDate').val('')" title="پاک کردن">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" id="btnSearch"><i class="bi bi-search"></i> نمایش گزارش</button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" id="btnExport" onclick="exportTableToCSV('tblTraffic', 'گزارش-ترددها')">
                    <i class="bi bi-file-earmark-excel"></i> خروجی اکسل
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul"></i> لیست ترددها</span>
        <span class="badge bg-primary" id="rowCount">۰ رکورد</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0" id="tblTraffic">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>نام شخص</th>
                        <th>کد عضویت</th>
                        <th>تاریخ ورود</th>
                        <th>ساعت ورود</th>
                        <th>تاریخ خروج</th>
                        <th>ساعت خروج</th>
                        <th>توضیحات</th>
                        <th>نوع عضویت</th>
                    </tr>
                </thead>
                <tbody id="tbodyTraffic">
                    <tr><td colspan="9" class="text-center text-muted p-4">برای نمایش گزارش، فیلتر را تنظیم کرده و دکمه «نمایش گزارش» را بزنید.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#btnSearch').click(function () {
        var from = $.trim($('#fromDate').val());
        var to = $.trim($('#toDate').val());
        if (from && to && from > to) { showToast('«از تاریخ» باید قبل از «تا تاریخ» باشد', 'error'); return; }

        var qs = '?';
        if (from) qs += 'from=' + encodeURIComponent(from) + '&';
        if (to) qs += 'to=' + encodeURIComponent(to) + '&';

        apiCall('/api/Admin/TrafficReport' + qs, 'GET', null, function (res) {
            if (res.success) renderTable(res.data || []);
        });
    });

    function renderTable(rows) {
        $('#rowCount').text(faNum(rows.length) + ' رکورد');
        if (rows.length === 0) {
            $('#tbodyTraffic').html('<tr><td colspan="9" class="text-center text-muted p-4">ترددی در این بازه یافت نشد.</td></tr>');
            return;
        }
        var html = '';
        $.each(rows, function (i, r) {
            var typeBadge = r.isGuest
                ? '<span class="badge bg-warning text-dark">مهمان</span>'
                : '<span class="badge bg-success">ورزشکار</span>';
            html += '<tr>' +
                '<td>' + faNum(i + 1) + '</td>' +
                '<td>' + esc(r.personName || '-') + '</td>' +
                '<td>' + esc(r.memberCode || '-') + '</td>' +
                '<td>' + esc(r.entryDate || '-') + '</td>' +
                '<td>' + esc(r.entryTime || '-') + '</td>' +
                '<td>' + esc(r.exitDate || '-') + '</td>' +
                '<td>' + esc(r.exitTime || '-') + '</td>' +
                '<td>' + esc(r.entryDesc || '-') + '</td>' +
                '<td>' + typeBadge + '</td>' +
                '</tr>';
        });
        $('#tbodyTraffic').html(html);
    }

    // خروجی CSV
    function exportTableToCSV(tableId, fileName) {
        var rows = document.querySelectorAll('#' + tableId + ' tr');
        if (rows.length <= 1) { showToast('ابتدا گزارش را نمایش دهید', 'warning'); return; }
        var csv = [];
        for (var i = 0; i < rows.length; i++) {
            var cols = rows[i].querySelectorAll('td, th');
            var line = [];
            for (var j = 0; j < cols.length; j++) line.push('"' + cols[j].innerText.replace(/"/g, '""') + '"');
            csv.push(line.join(','));
        }
        var csvContent = '\uFEFF' + csv.join('\n'); // BOM برای فارسی
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = fileName + '.csv';
        link.click();
    }
</script>
}
