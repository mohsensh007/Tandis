@{
    ViewData["Title"] = "گزارش ترددها";
    Layout = "_AdminLayout";
}

<div class="purple-style rep-filter mb-3">
    <div class="row g-2">
        <div class="col-6 col-md-3">
            <div class="rep-label">از تاریخ</div>
            <div class="rep-input-group">
                <div class="rep-field">
                    <input type="text" id="fromDate" class="rep-input" placeholder="1405/01/01" readonly />
                    <button type="button" class="rep-clear" onclick="$('#fromDate').val('')" title="پاک کردن"><i class="bi bi-x-lg"></i></button>
                </div>
                <button type="button" class="rep-btn-icon" onclick="openCalendar('fromDate','از تاریخ')"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="rep-label">تا تاریخ</div>
            <div class="rep-input-group">
                <div class="rep-field">
                    <input type="text" id="toDate" class="rep-input" placeholder="1405/03/31" readonly />
                    <button type="button" class="rep-clear" onclick="$('#toDate').val('')" title="پاک کردن"><i class="bi bi-x-lg"></i></button>
                </div>
                <button type="button" class="rep-btn-icon" onclick="openCalendar('toDate','تا تاریخ')"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="rep-label">&nbsp;</div>
            <button class="rep-btn-main" id="btnSearch"><i class="bi bi-search"></i> نمایش گزارش</button>
        </div>
    </div>
</div>

<div class="rep-summary mb-3" id="summaryCards" style="display:none;">
    <div class="purple-style rep-chip hl"><b id="summaryTotal">۰</b><span>کل ترددها</span></div>
    <div class="purple-style rep-chip"><b id="summaryMembers">۰</b><span>اعضا</span></div>
    <div class="purple-style rep-chip"><b id="summaryGuests">۰</b><span>مهمانان</span></div>
</div>

<div class="rep-list-head" style="display:none;">
    <span class="rep-count" id="rowCount">۰ رکورد</span>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <select id="sortKey" class="purple-style rep-search">
            <option value="">مرتب‌سازی: پیش‌فرض</option>
            <option value="date">تاریخ ورود</option>
            <option value="name">نام شخص</option>
        </select>
        <button type="button" class="purple-style rep-btn-icon" id="sortDir" data-dir="desc" title="جهت مرتب‌سازی">
            <i class="bi bi-sort-down"></i>
        </button>
        <button type="button" class="rep-btn-excel" id="btnExport"><i class="bi bi-file-earmark-excel"></i> خروجی اکسل</button>
        <input type="text" id="searchInput" class="rep-search" placeholder="🔍 جستجو..." />
    </div>
</div>
<div id="repList" style="display:none;">
    <div class="text-center text-muted py-4">فیلتر را تنظیم کرده و «نمایش گزارش» را بزنید.</div>
</div>

<div id="trafficPager" class="traffic-report-pager" style="display:none;" aria-label="صفحه‌بندی گزارش تردد">
    <button type="button" class="purple-style rep-btn-icon" id="btnTrafficPrev" title="صفحه قبل" aria-label="صفحه قبل">
        <i class="bi bi-chevron-right"></i>
    </button>
    <span id="trafficPagerLabel" class="traffic-pager-label"></span>
    <button type="button" class="purple-style rep-btn-icon" id="btnTrafficNext" title="صفحه بعد" aria-label="صفحه بعد">
        <i class="bi bi-chevron-left"></i>
    </button>
</div>

<style>
    .traffic-report-pager {
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 16px 0 8px;
    }

    .traffic-pager-label {
        min-width: 150px;
        color: #c9d8ec;
        text-align: center;
        font-size: .82rem;
    }

    .traffic-report-pager button:disabled {
        opacity: .38;
        cursor: not-allowed;
    }
</style>

@section Scripts {
    <script>
        var lastRows = [];
        var lastSummary = null;
        var reportPage = 1;
        var reportPageSize = 50;
        var searchTimer = null;

        function reportQuery(includePaging) {
            var parts = [];
            var from = $.trim($('#fromDate').val());
            var to = $.trim($('#toDate').val());
            var search = $.trim($('#searchInput').val());
            var sort = $('#sortKey').val() || '';
            var direction = $('#sortDir').attr('data-dir') || 'desc';

            if (from) parts.push('from=' + encodeURIComponent(from));
            if (to) parts.push('to=' + encodeURIComponent(to));
            if (search) parts.push('search=' + encodeURIComponent(search));
            if (sort) parts.push('sort=' + encodeURIComponent(sort));
            if (direction) parts.push('direction=' + encodeURIComponent(direction));
            if (includePaging) {
                parts.push('page=' + reportPage);
                parts.push('pageSize=' + reportPageSize);
            }
            return parts.length ? '?' + parts.join('&') : '';
        }

        function renderPager(meta) {
            var totalPages = Number(meta && meta.totalPages || 0);
            if (totalPages <= 1) {
                $('#trafficPager').hide();
                return;
            }

            reportPage = Number(meta.page || 1);
            $('#trafficPagerLabel').text('صفحه ' + faNum(reportPage) + ' از ' + faNum(totalPages));
            $('#btnTrafficPrev').prop('disabled', !meta.hasPrevious);
            $('#btnTrafficNext').prop('disabled', !meta.hasNext);
            $('#trafficPager').css('display', 'flex');
        }

        function loadReport(resetPage) {
            if (resetPage) reportPage = 1;

            var from = $.trim($('#fromDate').val());
            var to = $.trim($('#toDate').val());
            if (from && to && from > to) {
                showToast('«از تاریخ» باید قبل از «تا تاریخ» باشد', 'error');
                return;
            }

            var $list = $('#repList');
            $list.show().html('<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> در حال دریافت صفحه...</div>');
            apiCall('/api/Admin/TrafficReport' + reportQuery(true), 'GET', null, function (res) {
                if (!res || !res.success) return;
                lastRows = res.data || [];
                lastSummary = res.summary || null;
                renderList(lastRows, lastSummary);
                renderPager(res);
            });
        }

        $('#btnSearch').click(function () {
            loadReport(true);
        });

        function renderList(rows, summary) {
            lastRows = rows;
            lastSummary = summary || null;
            $('.rep-list-head, #repList').show();
            if (summary) {
                $('#summaryTotal').text(faNum(summary.totalCount));
                $('#summaryMembers').text(faNum(summary.memberCount));
                $('#summaryGuests').text(faNum(summary.guestCount));
                $('#summaryCards').show();
            } else { $('#summaryCards').hide(); }

            var totalCount = summary && summary.totalCount != null ? Number(summary.totalCount) : rows.length;
            $('#rowCount').text(faNum(totalCount) + ' رکورد در نتیجهٔ فیلتر');
            var $box = $('#repList');
            if (!rows.length) { $box.html('<div class="text-center text-muted py-4">ترددی در این بازه یافت نشد.</div>'); return; }

            var html = '';
            $.each(rows, function (i, r) {
                var badge = r.isGuest ? '<span class="rep-badge guest">مهمان</span>' : '<span class="rep-badge member">ورزشکار</span>';
                html += '<div class="rep-card">' +
                    '<div class="rep-head">' +
                        '<div class="rep-num">' + faNum(i + 1) + '</div>' +
                        '<div class="rep-mid">' +
                            '<div class="rep-line"><b>' + esc(r.personName || '-') + '</b> ' + badge + '</div>' +
                            '<div class="rep-line">📥 ورود: ' + esc(r.entryDate || '-') + ' <b>' + esc(r.entryTime || '-') + '</b></div>' +
                            '<div class="rep-line">📤 خروج: ' + esc(r.exitDate || '-') + ' <b>' + esc(r.exitTime || '-') + '</b></div>' +
                        '</div>' +
                        '<button type="button" class="rep-toggle"><i class="bi bi-chevron-left"></i></button>' +
                    '</div>' +
                    '<div class="rep-details">' +
                        '<div class="rep-drow"><span>کد عضویت</span><b>' + esc(r.memberCode || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>کمد</span><b>' + esc(r.BoxID || '-') + '</b></div>' +
                        '<div class="rep-drow"><span>توضیحات</span><b>' + esc(r.entryDesc || '-') + '</b></div>' +
                    '</div>' +
                '</div>';
            });
            $box.html(html);
        }

        $(document).on('click', '.rep-head', function () {
            var $c = $(this).closest('.rep-card');
            $c.toggleClass('open');
            $c.find('.rep-details').slideToggle(200);
        });

        $('#searchInput').on('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () { loadReport(true); }, 350);
        });

        $('#sortKey').on('change', function () {
            loadReport(true);
        });

        $('#sortDir').on('click', function () {
            var next = ($(this).attr('data-dir') || 'desc') === 'desc' ? 'asc' : 'desc';
            $(this).attr('data-dir', next)
                .find('i')
                .attr('class', next === 'desc' ? 'bi bi-sort-down' : 'bi bi-sort-up');
            loadReport(true);
        });

        $('#btnTrafficPrev').on('click', function () {
            if (reportPage > 1) {
                reportPage--;
                loadReport(false);
            }
        });

        $('#btnTrafficNext').on('click', function () {
            reportPage++;
            loadReport(false);
        });

        $('#btnExport').click(function () {
            if (!lastSummary || Number(lastSummary.totalCount || 0) === 0) {
                showToast('ابتدا گزارش را نمایش دهید', 'warning');
                return;
            }
            showToast('خروجی کامل گزارش در حال آماده‌سازی است…', 'info');
            window.location.href = '/api/Admin/TrafficReport/Export' + reportQuery(false);
        });
    </script>
}
