@{
    Layout = null;
    var isAdminView = Context.Request.Path.StartsWithSegments("/Admin");
}
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#011C40" />
    <title>QR باشگاه شما</title>
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: calc(16px + env(safe-area-inset-top)) 14px calc(16px + env(safe-area-inset-bottom));
            background: radial-gradient(circle at 50% 0%, #023859 0%, #011C40 62%);
            color: #EAF7FA;
            font-family: 'Sahel', Tahoma, Arial, sans-serif;
        }

        .qr-card {
            width: 100%;
            max-width: 460px;
            text-align: center;
            padding: 26px 20px 22px;
            border-radius: 26px;
            background: rgba(2, 56, 89,.8);
            border: 1px solid rgba(84, 172, 191,.35);
            box-shadow: 0 22px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.07);
            -webkit-backdrop-filter: blur(16px);
            backdrop-filter: blur(16px);
        }

        .qr-title {
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0 0 4px;
        }

        .qr-sub {
            font-size: .78rem;
            color: #9FCBD8;
            margin: 0 0 18px;
        }

        .qr-box {
            display: inline-block;
            padding: 14px;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,.35);
        }

            .qr-box img {
                display: block;
                width: min(320px, 62vw);
                height: auto;
            }

        .qr-note {
            font-size: .8rem;
            color: #CDE9EF;
            line-height: 1.9;
            margin: 18px 0 0;
        }

            .qr-note b { color: #54ACBF; }

        .qr-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .qr-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: 14px;
            font-size: .85rem;
            font-weight: 700;
            text-decoration: none;
            border: 1px solid rgba(84, 172, 191,.55);
            color: #EAF7FA;
            background: rgba(84, 172, 191,.55);
            cursor: pointer;
            font-family: inherit;
        }

            .qr-btn.primary {
                background: #54ACBF;
                border-color: #54ACBF;
                color: #011C40;
            }

        @@media print {
            body { background: #fff; color: #000; }
            .qr-card { box-shadow: none; border-color: #ccc; background: #fff; }
            .qr-sub, .qr-note { color: #333; }
            .qr-actions { display: none; }
        }
    </style>
</head>
<body>
    <main class="qr-card">
        <h1 class="qr-title">QR باشگاه شما</h1>
        <p class="qr-sub">@(isAdminView ? "این QR را چاپ کنید یا روی مانیتور باشگاه نمایش دهید" : "برای ورود، QR را با دوربین موبایل اسکن کنید")</p>

        <div class="qr-box">
            <img src="/api/Security/QrCode" alt="QR ثابت باشگاه" width="320" height="320" />
        </div>

        <p class="qr-note">
            این QR <b>ثابت</b> است و منقضی نمی‌شود؛ اعضا همیشه با اسکن آن به صفحه ورود باشگاه می‌رسند.
        </p>

        <div class="qr-actions">
            <button type="button" class="qr-btn primary" onclick="window.print()">چاپ QR</button>
            @if (isAdminView)
            {
                <a class="qr-btn" href="/Admin">بازگشت به پنل</a>
            }
        </div>
    </main>
</body>
</html>
