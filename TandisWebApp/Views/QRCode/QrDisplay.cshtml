@{
    Layout = null;
    var isAdminView = Context.Request.Path.StartsWithSegments("/Admin");
}
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#DCE5F0" />
    <script>(function(){try{var t=localStorage.getItem('tandis-theme');if(!t)t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','light');}})();</script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme-cool-mist.css" asp-append-version="true" />
    <title>QR باشگاه شما</title>
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: calc(16px + env(safe-area-inset-top)) 14px calc(16px + env(safe-area-inset-bottom));
            background: radial-gradient(circle at 50% 0%, var(--g-surface-solid) 0%, var(--g-surface-solid) 62%);
            color: var(--g-text);
            font-family: 'Sahel', Tahoma, Arial, sans-serif;
        }

        .qr-card {
            width: 100%;
            max-width: 460px;
            text-align: center;
            padding: 26px 20px 22px;
            border-radius: 26px;
            background: color-mix(in srgb, var(--g-surface-solid) 80%, transparent);
            border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
            box-shadow: 0 22px 60px color-mix(in srgb, var(--g-text) 45%, transparent), inset 0 1px 0 color-mix(in srgb, var(--g-text) 7%, transparent);
            -webkit-backdrop-filter: blur(16px);
            backdrop-filter: blur(16px);
        }

        .qr-title {
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0 0 4px;
        }

        .qr-sub {
            font-size: .78rem;
            color: var(--g-text);
            margin: 0 0 18px;
        }

        .qr-box {
            display: inline-block;
            padding: 14px;
            border-radius: 20px;
            background: #EDF2F8;
            box-shadow: var(--g-shadow);
        }

            .qr-box img {
                display: block;
                width: min(320px, 62vw);
                height: auto;
            }

        .qr-note {
            font-size: .8rem;
            color: var(--g-text);
            line-height: 1.9;
            margin: 18px 0 0;
        }

            .qr-note b { color: var(--g-primary); }

        .qr-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .qr-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: 14px;
            font-size: .85rem;
            font-weight: 700;
            text-decoration: none;
            border: 1px solid color-mix(in srgb, var(--g-primary) 55%, transparent);
            color: var(--g-text);
            background: color-mix(in srgb, var(--g-primary) 55%, transparent);
            cursor: pointer;
            font-family: inherit;
        }

            .qr-btn.primary {
                background: var(--g-primary);
                border-color: var(--g-primary);
                color: var(--g-text);
            }

        @@media print {
            body { background: var(--g-surface-solid); color: var(--g-text); }
            .qr-card { box-shadow: none; border-color: var(--g-nested-solid); background: var(--g-surface-solid); }
            .qr-sub, .qr-note { color: var(--g-text); }
            .qr-actions { display: none; }
        }
    </style>
</head>
<body>
    <main class="qr-card">
        <h1 class="qr-title">QR باشگاه شما</h1>
        <p class="qr-sub">@(isAdminView ? "این QR را چاپ کنید یا روی مانیتور باشگاه نمایش دهید" : "برای ورود، QR را با دوربین موبایل اسکن کنید")</p>

        <div class="qr-box">
            <img src="/api/Security/QrCode" alt="QR ثابت باشگاه" width="320" height="320" />
        </div>

        <p class="qr-note">
            این QR <b>ثابت</b> است و منقضی نمی‌شود؛ اعضا همیشه با اسکن آن به صفحه ورود باشگاه می‌رسند.
        </p>

        <div class="qr-actions">
            <button type="button" class="qr-btn primary" onclick="window.print()">چاپ QR</button>
            @if (isAdminView)
            {
                <a class="qr-btn" href="/Admin">بازگشت به پنل</a>
            }
        </div>
    </main>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
