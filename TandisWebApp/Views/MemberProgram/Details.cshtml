@model TandisWebApp.DTOs.MemberProgramDto
@{
    ViewData["Title"] = "جزئیات برنامه";
    Layout = "_Layout";

    var pc = new System.Globalization.PersianCalendar();
    var today = $"{pc.GetYear(DateTime.Now):0000}/{pc.GetMonth(DateTime.Now):00}/{pc.GetDayOfMonth(DateTime.Now):00}";

    var typeLabels = new System.Collections.Generic.Dictionary<byte, string> {
        { 1, "عادی" }, { 2, "دراپ ست" }, { 3, "سوپرست" }, { 4, "تری‌ست" },
        { 5, "ست غول" }, { 6, "پیرامید" }, { 7, "استراحت-مکث" }, { 8, "تمپو دار" }
    };

    string DayIcon(string t)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var part in (t ?? "").Split('+'))
        {
            switch (part.Trim())
            {
                case "روز پا": sb.Append("🦵"); break;
                case "روز سینه": sb.Append("🏋️"); break;
                case "روز سرشانه": sb.Append("🤸"); break;
                case "روز زیر بغل": sb.Append("🚣"); break;
                case "روز جلو بازو": sb.Append("💪"); break;
                case "روز پشت بازو": sb.Append("🦾"); break;
                case "روز شکم": sb.Append("🧘"); break;
                case "روز پهلو": sb.Append("🌀"); break;
                case "روز هوازی": sb.Append("🏃"); break;
                case "روز فول بدن": sb.Append("⚡"); break;
            }
        }
        return sb.Length == 0 ? "📅" : sb.ToString();
    }

    var groups = new System.Collections.Generic.Dictionary<string, System.Collections.Generic.List<TandisWebApp.DTOs.ProgramItemEditDto>>();
    var groupKeys = new System.Collections.Generic.List<string>();
    foreach (var it in Model.Items)
    {
        if (string.IsNullOrWhiteSpace(it.DayTitle)) continue;
        if (!groups.ContainsKey(it.DayTitle))
        {
            groups[it.DayTitle] = new System.Collections.Generic.List<TandisWebApp.DTOs.ProgramItemEditDto>();
            groupKeys.Add(it.DayTitle);
        }
        groups[it.DayTitle].Add(it);
    }

    var singles = new System.Collections.Generic.List<string>();
    foreach (var k in groupKeys)
    {
        foreach (var part in k.Split('+'))
        {
            var p2 = part.Trim();
            if (!string.IsNullOrEmpty(p2) && !singles.Contains(p2)) singles.Add(p2);
        }
    }

    var isActive = string.CompareOrdinal(Model.EndDateShamsi, today) >= 0;
}

<!-- ===== هدر ===== -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-clipboard2-pulse mp-hd-icon"></i> جزئیات برنامه</h5>
    <a href="/MyProgram" class="mp-back-pill"><i class="bi bi-arrow-right"></i> برنامه‌های من</a>
</div>

<!-- ===== کارت اطلاعات برنامه ===== -->
<div class="purple-style mp-info mb-3">
    <div class="flex-grow-1" style="min-width:0">
        <div class="mp-coach"><i class="bi bi-person-badge-fill me-1"></i> مربی: @Model.CoachName</div>
        <div class="mp-period"><i class="bi bi-calendar-range me-1"></i> @Model.StartDateShamsi تا @Model.EndDateShamsi</div>
    </div>
    @if (isActive)
    {
        <span class="mp-badge mp-on">فعال</span>
    }
    else
    {

        <span class="mp-badge mp-off">پایان‌یافته</span>
    }
</div>

@if (groups.Count == 0)
{
    <div class="mp-empty">
        <div style="font-size:2.2rem" class="mb-2">📋</div>
        این برنامه روز بندی نشده است
    </div>
}
else
{
    <!-- ===== فیلتر روزها ===== -->
    <div class="mpf-bar">
        <button type="button" class="mpf-chip mpf-on" data-group=""><i class="bi bi-grid-3x3-gap-fill"></i> همه</button>
        @foreach (var s in singles)
        {
            <button type="button" class="mpf-chip" data-group="@s">@DayIcon(s) @s</button>
        }
    </div>

    <!-- ===== باکس‌های روز ===== -->
    @foreach (var g in groups)
    {
        <div class="purple-style mp-day" data-days="@g.Key">
            <div class="mp-day-head">
                <span class="mp-day-icon">@DayIcon(g.Key)</span>
                <span class="mp-day-title">@g.Key</span>
                <span class="mp-day-count">@g.Value.Count حرکت</span>
            </div>
            <div class="mp-day-body">
                @foreach (var it in g.Value)
                {
                    var extras = it.ExtraItems ?? new System.Collections.Generic.List<TandisWebApp.DTOs.ProgramSubItemDto>();
                    var hasCombo = extras.Count > 0;
                    var type = it.ExerciseType ?? 1;

                    <div class="mp-ex">
                        <div class="mp-ex-top">
                            <div class="mp-ex-name">@it.ItemDesc</div>
                            @if (type != 1 && typeLabels.ContainsKey((byte)type))
                            {
                                <span class="mp-type">@typeLabels[(byte)type]</span>
                            }
                        </div>

                        <!-- pillهای اصلی -->
                        <div class="mp-ex-pills">
                            @if (it.SetCount != null)
                            {
                                <span class="mp-pill"><i class="bi bi-layers-fill"></i> ست: @it.SetCount.Value</span>
                            }
                            @if (it.RepCount != null)
                            {
                                <span class="mp-pill"><i class="bi bi-repeat"></i> تکرار: @it.RepCount.Value</span>
                            }
                            @if (it.WCount != null)
                            {
                                <span class="mp-pill"><i class="bi bi-barbell-fill"></i> وزن: @it.WCount.Value کیلو</span>
                            }
                            @if (it.RestSeconds != null)
                            {
                                <span class="mp-pill"><i class="bi bi-stopwatch-fill"></i> استراحت: @it.RestSeconds.Value ثانیه</span>
                            }
                        </div>

                        <!-- ===== ✅ combo (حرکات هم‌گروه) ===== -->
                        @if (hasCombo)
                        {
                            <div class="mp-combo">
                                <div class="mp-combo-title">🔗 حرکات هم‌گروه (بدون استراحت بینشون):</div>
                                @for (var i = 0; i < extras.Count; i++)
                                {
                                    var ex = extras[i];
                                    <div class="mp-combo-row">
                                        <span class="mp-combo-num">@(i + 2)</span>
                                        <div class="mp-combo-body">
                                            <div class="mp-combo-name">@ex.ItemDesc</div>
                                            <div class="d-flex flex-wrap gap-2 mt-1">
                                                @if (ex.RepCount != null)
                                                {
                                                    <span class="mp-pill-sm"><i class="bi bi-repeat"></i> @ex.RepCount.Value</span>
                                                }
                                                @if (ex.WCount != null)
                                                {
                                                    <span class="mp-pill-sm"><i class="bi bi-barbell-fill"></i> @ex.WCount.Value کیلو</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- ===== ✅ تنظیمات تکنیک ===== -->
                        @if (type == 2 && it.DropCount != null)
                        {
                            <div class="mp-tech mp-tech-drop">
                                <i class="bi bi-arrow-down-circle-fill"></i>
                                <span>دراپ ست: <b>@it.DropCount.Value</b> بار کاهش وزن</span>
                                @if (it.DropWeightPct != null)
                                {
                                    <span class="mp-tech-sep">•</span>
                                    <span>هر بار حدود <b>@it.DropWeightPct.Value٪</b> سبک‌تر</span>
                                }
                            </div>
                        }
                        @if (type == 6 && it.PyramidDir != null)
                        {
                            var dirName = it.PyramidDir.Value == 1 ? "صعودی" : it.PyramidDir.Value == 2 ? "معکوس (سنگین اول)" : "کامل";
                            <div class="mp-tech mp-tech-pyramid">
                                <i class="bi bi-triangle-fill"></i>
                                <span>پیرامید <b>@dirName</b></span>
                                @if (it.WeightStep != null)
                                {
                                    <span class="mp-tech-sep">•</span>
                                    <span>پله وزن: <b>@it.WeightStep.Value کیلو</b></span>
                                }
                            </div>
                        }
                        @if (type == 7 && it.PauseCount != null)
                        {
                            <div class="mp-tech mp-tech-pause">
                                <i class="bi bi-pause-circle-fill"></i>
                                <span>استراحت-مکث: <b>@it.PauseCount.Value</b> مینی‌ست</span>
                                @if (it.PauseRest != null)
                                {
                                    <span class="mp-tech-sep">•</span>
                                    <span>مکث: <b>@it.PauseRest.Value ثانیه</b></span>
                                }
                            </div>
                        }
                        @if (type == 8 && !string.IsNullOrEmpty(it.Tempo))
                        {
                            var tp = it.Tempo.Split('-');
                            <div class="mp-tech mp-tech-tempo">
                                <i class="bi bi-clock-fill"></i>
                                <span>تمپو: <b class="mp-tempo-code">@it.Tempo</b></span>
                                @if (tp.Length >= 4)
                                {
                                    <span class="mp-tempo-desc">
                                        (@tp[0]ث پایین‌آوردن، @tp[1]ث مکث، @tp[2]ث بالا‌بردن، @tp[3]ث مکث)
                                    </span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(it.Note))
                        {
                            <div class="mp-note"><i class="bi bi-info-circle-fill"></i><span>@it.Note</span></div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}



@section Scripts {
    <script>
        $(document).on('click', '.mpf-chip', function () {
            $('.mpf-chip').removeClass('mpf-on');
            $(this).addClass('mpf-on');
            var g = String($(this).attr('data-group') || '');
            if (!g) { $('.mp-day').show(); return; }
            $('.mp-day').each(function () {
                var days = String($(this).attr('data-days') || '');
                $(this).toggle(days.indexOf(g) > -1);
            });
        });
    </script>
}