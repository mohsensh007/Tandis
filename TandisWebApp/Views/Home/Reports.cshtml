@{
    ViewData["Title"] = "گزارش‌ها";
    var pc = new System.Globalization.PersianCalendar();
    var jY = pc.GetYear(DateTime.Now);
    var jM = pc.GetMonth(DateTime.Now);
    var jD = pc.GetDayOfMonth(DateTime.Now);
}

<link rel="stylesheet" href="~/css/member-reports.css" asp-append-version="true" />

<section class="member-reports" aria-labelledby="memberReportsTitle">
    <div class="member-reports-heading mb-3">
        <h1 class="h5 mb-0" id="memberReportsTitle"><i class="bi bi-bar-chart-fill hd-icon" aria-hidden="true"></i> گزارش‌های من</h1>
        <a href="/Home" class="btn btn-outline-secondary btn-sm btn-back-glass"><i class="bi bi-arrow-right" aria-hidden="true"></i> داشبورد</a>
    </div>

    <div class="card member-reports-card">
        <!-- هدر گزارش‌ها و تقویم حضور -->
        <div class="card-header coach-list-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-bar-chart-fill hd-icon" aria-hidden="true"></i> گزارش‌ها</span>
            <button type="button" class="att-cal-btn" id="btnAttCal" title="تقویم حضور" aria-label="نمایش تقویم حضور" aria-haspopup="dialog" aria-controls="attCalOverlay" aria-expanded="false">
                <i class="bi bi-calendar2-week-fill" aria-hidden="true"></i>
            </button>
        </div>
        <div class="purple-style card-body">
            <ul class="nav nav-tabs nav-tabs-custom mb-3" id="reportTabs" role="tablist" aria-label="نوع گزارش">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="finance-tab" data-bs-toggle="tab" data-bs-target="#financePane" type="button" role="tab" aria-controls="financePane" aria-selected="true" tabindex="0"><i class="bi bi-cash-coin" aria-hidden="true"></i><span>گزارش مالی</span></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="traffic-tab" data-bs-toggle="tab" data-bs-target="#trafficPane" type="button" role="tab" aria-controls="trafficPane" aria-selected="false" tabindex="-1"><i class="bi bi-door-closed-fill" aria-hidden="true"></i><span>گزارش تردد</span></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#registerPane" type="button" role="tab" aria-controls="registerPane" aria-selected="false" tabindex="-1"><i class="bi bi-card-list" aria-hidden="true"></i><span>سوابق ثبت‌نام</span></button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- ========== تب مالی ========== -->
                <div class="tab-pane fade show active" id="financePane" role="tabpanel" aria-labelledby="finance-tab" tabindex="0">
                    <div class="member-finance-list">
                        <table class="table report-table member-finance-table" role="table">
                            <caption class="visually-hidden">تراکنش‌های مالی؛ مبالغ به ریال</caption>
                            <thead role="rowgroup">
                                <tr role="row">
                                    <th scope="col" id="financeDate" role="columnheader">تاریخ</th>
                                    <th scope="col" id="financeType" role="columnheader">نوع</th>
                                    <th scope="col" id="financeDescription" role="columnheader">شرح</th>
                                    <th scope="col" id="financeAmount" role="columnheader">مبلغ (ریال)</th>
                                </tr>
                            </thead>
                            <tbody id="financeRows" role="rowgroup" aria-busy="true">
                                <tr class="finance-state-row" role="row"><td colspan="4" role="cell"><div class="member-report-state" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i><p>در حال بارگذاری...</p></div></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ========== تب تردد ========== -->
                <div class="tab-pane fade" id="trafficPane" role="tabpanel" aria-labelledby="traffic-tab" tabindex="0">
                    <div id="trafficRows" aria-busy="true">
                        <div class="member-report-state" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i><p>در حال بارگذاری...</p></div>
                    </div>
                </div>

                <!-- ========== سوابق ثبت‌نام ========== -->
                <div class="tab-pane fade" id="registerPane" role="tabpanel" aria-labelledby="register-tab" tabindex="0">
                    <!-- خلاصه ثبت‌نام‌ها -->
                    <div class="rgh-summary">
                        <div class="rgh-stat"><span class="rgh-num" id="rghTotal">۰</span><span class="rgh-lbl">کل ثبت‌نام‌ها</span></div>
                        <div class="rgh-stat"><span class="rgh-num rgh-green" id="rghActive">۰</span><span class="rgh-lbl">فعال</span></div>
                        <div class="rgh-stat"><span class="rgh-num rgh-red" id="rghExpired">۰</span><span class="rgh-lbl">منقضی</span></div>
                        <div class="rgh-stat"><span class="rgh-num rgh-blue" id="rghSum">۰</span><span class="rgh-lbl">مجموع پرداخت (ریال)</span></div>
                    </div>
                    <!-- کارت‌ها با دکمه نمایش جزئیات -->
                    <div id="registerRows" aria-busy="true">
                        <div class="member-report-state" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i><p>در حال بارگذاری...</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- تقویم حضور؛ هنگام باز شدن به انتهای body منتقل می‌شود -->
<div id="attCalOverlay" class="member-reports-calendar" hidden aria-hidden="true">
    <div class="att-cal-backdrop" id="attCalBackdrop" aria-hidden="true"></div>
    <div class="att-cal-panel purple-style" role="dialog" aria-modal="true" aria-labelledby="attCalLabel calTitle" aria-describedby="attCalHelp" tabindex="-1">
        <span class="visually-hidden" id="attCalLabel">تقویم حضور</span>
        <p class="visually-hidden" id="attCalHelp">با دکمه‌های ماه قبل و ماه بعد تقویم را مرور کنید. برای بستن، کلید Escape یا دکمه بستن را بزنید.</p>
        <div class="att-cal-head">
            <button type="button" class="att-nav" id="calPrev" title="ماه قبل" aria-label="ماه قبل"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            <h2 class="att-cal-title" id="calTitle" aria-live="polite"></h2>
            <button type="button" class="att-nav" id="calNext" title="ماه بعد" aria-label="ماه بعد"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="att-close" id="calClose" title="بستن" aria-label="بستن تقویم حضور"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="att-cal-body">
            <div class="att-week" aria-hidden="true">
                <span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span>ج</span>
            </div>
            <div class="att-grid" id="calGrid" role="list" aria-label="روزهای ماه و وضعیت حضور"></div>
            <div class="att-legend">
                <span class="att-lg att-on">حاضر</span>
                <span class="att-lg att-off">غایب</span>
                <span class="att-lg att-future">پیش‌رو</span>
            </div>
            <div class="att-stats">
                <span class="att-chip att-chip-on" id="calOnCount"></span>
                <span class="att-chip att-chip-off" id="calOffCount"></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        (function () {
            var ov = document.getElementById('attCalOverlay');
            if (ov && ov.parentNode !== document.body) document.body.appendChild(ov);
        })();
        var faDigits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
        function toFa(n) { return String(n).replace(/[0-9]/g, function(d){ return faDigits[d]; }); }
        function fmtNum(n) { return Number(n || 0).toLocaleString('fa-IR'); }
        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function reportState(icon, message, retry) {
            return '<div class="member-report-state" role="status"><i class="bi ' + icon + '" aria-hidden="true"></i><p>' + esc(message) + '</p>' +
                (retry ? '<button type="button" class="member-report-retry" data-report-retry="' + retry + '"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> تلاش دوباره</button>' : '') + '</div>';
        }
        function financeState(icon, message, retry) {
            $('#financeRows').html('<tr class="finance-state-row" role="row"><td colspan="4" role="cell">' + reportState(icon, message, retry) + '</td></tr>');
        }
        function reportDate(value) {
            return '<bdi dir="ltr">' + esc(value || '-') + '</bdi>';
        }

        // ========== تقویم حضور: وضعیت روزها ==========
        var calY = @jY, calM = @jM;
        var todayKey = @jY * 10000 + @jM * 100 + @jD;
        var attended = {};  // کلید: سال*10000 + ماه*100 + روز
        var trafficLoaded = false;
        var calIsOpen = false;
        var calReturnFocus = null;
        var calBackground = [];
        var calOverlay = document.getElementById('attCalOverlay');
        var monthNames = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];

        // تبدیل جلالی → میلادی (برای محاسبه روز هفته و طول ماه)
        function jalaliToGregorian(jy, jm, jd) {
            var gy = (jy <= 979) ? 621 : 1600;
            jy -= (jy <= 979) ? 0 : 979;
            var days = (365 * jy) + Math.floor(jy / 33) * 8 + Math.floor(((jy % 33) + 3) / 4) + 78 + jd +
                ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
            gy += 400 * Math.floor(days / 146097);
            days %= 146097;
            if (days > 36524) { gy += 100 * Math.floor(--days / 36524); days %= 36524; if (days >= 365) days++; }
            gy += 4 * Math.floor(days / 1461);
            days %= 1461;
            if (days > 366) { gy += Math.floor((days - 1) / 365); days = (days - 1) % 365; }
            var gd = days + 1;
            var sal_a = [0, 31, ((gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
            var gm = 0;
            for (gm = 0; gm < 13 && gd > sal_a[gm]; gm++) gd -= sal_a[gm];
            return { gy: gy, gm: gm, gd: gd };
        }
        function monthLength(jy, jm) {
            var a = jalaliToGregorian(jy, jm, 1);
            var ny = jy, nm = jm + 1;
            if (nm > 12) { nm = 1; ny++; }
            var b = jalaliToGregorian(ny, nm, 1);
            return Math.round((Date.UTC(b.gy, b.gm - 1, b.gd) - Date.UTC(a.gy, a.gm - 1, a.gd)) / 86400000);
        }
        function firstWeekday(jy, jm) {
            var g = jalaliToGregorian(jy, jm, 1);
            return (new Date(Date.UTC(g.gy, g.gm - 1, g.gd)).getUTCDay() + 1) % 7; // شنبه = 0
        }

        function renderAttCal() {
            var len = monthLength(calY, calM);
            var start = firstWeekday(calY, calM);
            var html = '';
            for (var i = 0; i < start; i++) html += '<span class="att-day att-empty" aria-hidden="true"></span>';
            var on = 0, off = 0;
            for (var d = 1; d <= len; d++) {
                var key = calY * 10000 + calM * 100 + d;
                var cls = 'att-future';
                var status = trafficLoaded ? 'پیش‌رو' : 'وضعیت حضور دریافت نشده';
                if (attended[key]) { cls = 'att-on'; status = 'حاضر'; on++; }
                else if (trafficLoaded && key <= todayKey) { cls = 'att-off'; status = 'غایب'; off++; }
                var label = toFa(d) + ' ' + monthNames[calM - 1] + ' ' + toFa(calY) + '، ' + status;
                html += '<span class="att-day ' + cls + '" role="listitem" aria-label="' + label + '">' + toFa(d) + '</span>';
            }
            $('#calGrid').html(html);
            $('#calTitle').text(monthNames[calM - 1] + ' ' + toFa(calY));
            $('#calOnCount').text(trafficLoaded ? 'حضور: ' + toFa(on) + ' روز' : 'وضعیت حضور هنوز دریافت نشده');
            $('#calOffCount').text('غیبت: ' + toFa(off) + ' روز').prop('hidden', !trafficLoaded);
        }

        function openAttCal() {
            if (calIsOpen) return;
            calReturnFocus = document.activeElement;
            calIsOpen = true;
            renderAttCal();
            calOverlay.hidden = false;
            calOverlay.setAttribute('aria-hidden', 'false');
            $('#btnAttCal').attr('aria-expanded', 'true');
            document.body.classList.add('att-open');
            document.getElementById('calClose').focus();
            calBackground = [];
            if ('inert' in document.body) {
                Array.prototype.forEach.call(document.body.children, function (el) {
                    if (el === calOverlay || /^(SCRIPT|STYLE|LINK)$/.test(el.tagName)) return;
                    calBackground.push({ element: el, inert: el.inert });
                    el.inert = true;
                });
            }
            requestAnimationFrame(function () {
                if (calIsOpen) calOverlay.classList.add('open');
            });
        }
        function closeAttCal() {
            if (!calIsOpen) return;
            calIsOpen = false;
            calOverlay.classList.remove('open');
            calOverlay.hidden = true;
            calOverlay.setAttribute('aria-hidden', 'true');
            $('#btnAttCal').attr('aria-expanded', 'false');
            document.body.classList.remove('att-open');
            calBackground.forEach(function (item) { item.element.inert = item.inert; });
            calBackground = [];
            if (calReturnFocus && document.documentElement.contains(calReturnFocus)) calReturnFocus.focus();
        }

        $('#btnAttCal').on('click', openAttCal);
        $('#calClose').on('click', closeAttCal);
        $('#attCalBackdrop').on('click', closeAttCal);
        document.addEventListener('keydown', function (e) {
            if (!calIsOpen) return;
            if (e.key === 'Escape') {
                e.preventDefault();
                e.stopPropagation();
                closeAttCal();
            } else if (e.key === 'Tab') {
                var first = document.getElementById('calPrev');
                var last = document.getElementById('calClose');
                if (!calOverlay.contains(document.activeElement) || (e.shiftKey && document.activeElement === first) || (!e.shiftKey && document.activeElement === last)) {
                    e.preventDefault();
                    (e.shiftKey ? last : first).focus();
                }
            }
        }, true);
        document.addEventListener('focusin', function (e) {
            if (calIsOpen && !calOverlay.contains(e.target)) document.getElementById('calClose').focus();
        });
        $('#calPrev').on('click', function () { calM--; if (calM < 1) { calM = 12; calY--; } renderAttCal(); });
        $('#calNext').on('click', function () { calM++; if (calM > 12) { calM = 1; calY++; } renderAttCal(); });

        // ========== نام روز هفته کنار تاریخ (برای گزارش تردد) ==========
        var weekNames = ['یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنج‌شنبه', 'جمعه', 'شنبه'];
        function dayName(dateStr) {
            var p = String(dateStr || '').trim().split('/');
            if (p.length !== 3) return '';
            var jy = +p[0], jm = +p[1], jd = +p[2];
            if (!jy || !jm || !jd) return '';
            try {
                var g = jalaliToGregorian(jy, jm, jd);
                return weekNames[new Date(Date.UTC(g.gy, g.gm - 1, g.gd)).getUTCDay()];
            } catch (e) { return ''; }
        }
        // ========== گزارش مالی ==========
        function loadFinance() {
            $('#financeRows').attr('aria-busy', 'true');
            financeState('bi-hourglass-split', 'در حال بارگذاری...');
            function failed() {
                $('#financeRows').attr('aria-busy', 'false');
                financeState('bi-exclamation-circle', 'دریافت گزارش مالی انجام نشد.', 'finance');
            }
            apiCall('/api/Accounting/FinanceDocs', 'GET', null, function (res) {
                $('#financeRows').attr('aria-busy', 'false');
                if (!res || !res.success) { failed(); return; }
                if (!res.data || res.data.length === 0) {
                    financeState('bi-cash-coin', 'هیچ تراکنشی یافت نشد');
                    return;
                }
                var html = '';
                $.each(res.data, function (i, d) {
                    var isCredit = d.docType === 'بستانکار';
                    var sign = isCredit ? '+' : '-';
                    var colorClass = isCredit ? 'finance-credit' : 'finance-debit';
                    var badge = isCredit ? 'badge-credit' : 'badge-debit';
                    var dateStr = d.creationDateDisplay || '-';
                    html += '<tr class="finance-record" role="row">' +
                        '<td class="finance-date" headers="financeDate" role="cell"><span class="finance-label" aria-hidden="true">تاریخ</span>' + reportDate(dateStr) + '</td>' +
                        '<td class="finance-type" headers="financeType" role="cell"><span class="finance-label" aria-hidden="true">نوع</span><span class="' + badge + '">' + esc(d.docType || '-') + '</span></td>' +
                        '<td class="finance-description" headers="financeDescription" role="cell"><span class="finance-label" aria-hidden="true">شرح</span>' + esc(d.docDesc || '-') + '</td>' +
                        '<td class="finance-amount" headers="financeAmount" role="cell"><span class="finance-label" aria-hidden="true">مبلغ</span><span class="finance-amount-value ' + colorClass + '"><bdi dir="ltr">' + sign + ' ' + fmtNum(d.amount) + '</bdi><span class="finance-currency">ریال</span></span></td>' +
                    '</tr>';
                });
                $('#financeRows').html(html);
            }, failed);
        }
        loadFinance();

        // ========== محاسبه مدت حضور ==========
        function calcDuration(inT, outT) {
            if (!inT || !outT) return '';
            function toMin(s) {
                var p = String(s).split(':');
                return (+p[0]) * 60 + (+p[1]);
            }
            var d = toMin(outT) - toMin(inT);
            if (d < 0 || isNaN(d)) return '';
            var h = Math.floor(d / 60), m = d % 60;
            return (h ? toFa(h) + ' ساعت و ' : '') + toFa(m) + ' دقیقه';
        }

        // ========== گزارش تردد و روزهای حضور ==========
        function loadTraffic() {
            var $box = $('#trafficRows');
            $box.attr('aria-busy', 'true').html(reportState('bi-hourglass-split', 'در حال بارگذاری...'));
            function failed() {
                $box.attr('aria-busy', 'false').html(reportState('bi-exclamation-circle', 'دریافت گزارش تردد انجام نشد.', 'traffic'));
            }
            apiCall('/api/Accounting/TrafficReport', 'GET', null, function (res) {
                $box.attr('aria-busy', 'false');
                if (!res || !res.success) { failed(); return; }

                // داده کامل گزارش مبنای تقویم است، نه فقط صفحه فعلی.
                attended = {};
                trafficLoaded = true;
                if (res.data) {
                    $.each(res.data, function (i, t) {
                        if (!t.entryDate) return;
                        var p = String(t.entryDate).split('/');
                        if (p.length === 3) attended[(+p[0]) * 10000 + (+p[1]) * 100 + (+p[2])] = true;
                    });
                }
                if (calIsOpen) renderAttCal();

                if (!res.data || res.data.length === 0) {
                    $box.html(reportState('bi-door-closed-fill', 'هیچ ترددی ثبت نشده'));
                    return;
                }
                var html = '';
                $.each(res.data, function (i, t) {
                    var rowNo = toFa(i + 1);
                    var dur = calcDuration(t.entryTime, t.exitTime);
                    var detailsId = 'traffic-details-' + i;
                    var toggleId = 'traffic-toggle-' + i;
                    html +=
                        '<div class="trf-card">' +
                            '<button type="button" class="trf-head" id="' + toggleId + '" aria-expanded="false" aria-controls="' + detailsId + '">' +
                                '<span class="visually-hidden">جزئیات تردد شماره </span><span class="trf-num">' + rowNo + '</span>' +
                                '<span class="trf-mid">' +
                                    '<span class="trf-line"><i class="bi bi-box-arrow-in-left" aria-hidden="true"></i><span>ورود:</span> ' + reportDate(t.entryDate) + ' <b>' + reportDate(t.entryTime) + '</b></span>' +
                                    '<span class="trf-line"><i class="bi bi-box-arrow-left" aria-hidden="true"></i><span>خروج:</span> ' + reportDate(t.exitDate) + ' <b>' + reportDate(t.exitTime) + '</b></span>' +
                                '</span>' +
                                '<span class="trf-toggle" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>' +
                            '</button>' +
                            '<div class="trf-details" id="' + detailsId + '" role="region" aria-labelledby="' + toggleId + '" hidden>' +
                                '<div class="trf-drow"><span><i class="bi bi-archive hd-icon" aria-hidden="true"></i> شماره کمد</span><b>' + (t.boxID != null ? esc(toFa(t.boxID)) : 'بدون کمد') + '</b></div>' +
                                '<div class="trf-drow"><span>تاریخ ورود</span><b>' + reportDate(t.entryDate) + ' <span class="trf-day">' + dayName(t.entryDate) + '</span></b></div>' +
                                '<div class="trf-drow"><span>ساعت ورود</span><b>' + reportDate(t.entryTime) + '</b></div>' +
                                '<div class="trf-drow"><span>تاریخ خروج</span><b>' + reportDate(t.exitDate) + ' <span class="trf-day">' + dayName(t.exitDate) + '</span></b></div>' +
                                '<div class="trf-drow"><span>ساعت خروج</span><b>' + reportDate(t.exitTime) + '</b></div>' +
                                (dur ? '<div class="trf-drow"><span><i class="bi bi-stopwatch hd-icon" aria-hidden="true"></i> مدت حضور</span><b>' + dur + '</b></div>' : '') +
                            '</div>' +
                        '</div>';
                });
                $box.html(html);
            }, failed);
        }
        loadTraffic();

        // ========== سوابق ثبت‌نام: گزارش کلی و جزئیات ==========
        function loadRegisterHistory() {
            var $box = $('#registerRows');
            $box.attr('aria-busy', 'true').html(reportState('bi-hourglass-split', 'در حال بارگذاری...'));
            function failed() {
                $box.attr('aria-busy', 'false').html(reportState('bi-exclamation-circle', 'دریافت سوابق ثبت‌نام انجام نشد.', 'register'));
                $('#rghTotal, #rghActive, #rghExpired, #rghSum').text('—');
            }
            apiCall('/api/Register/History', 'GET', null, function (res) {
                $box.attr('aria-busy', 'false');
                if (!res || !res.success) { failed(); return; }
                var data = res.data || [];

                // خلاصه بر اساس همه سوابق؛ مستقل از صفحه‌بندی.
                var total = data.length;
                var active = data.filter(function (x) { return x.isActive; }).length;
                var expired = total - active;
                var sum = 0;
                $.each(data, function (i, x) { sum += Number(x.finalPayment || 0); });

                $('#rghTotal').text(toFa(total));
                $('#rghActive').text(toFa(active));
                $('#rghExpired').text(toFa(expired));
                $('#rghSum').text(fmtNum(sum));

                if (total === 0) {
                    $box.html(reportState('bi-card-list', 'هیچ سابقه ثبت‌نامی یافت نشد'));
                    return;
                }

                // کارت‌های سازگار با report-pager.js
                var html = '';
                $.each(data, function (i, r) {
                    var rowNo = toFa(i + 1);
                    var statusBadge = r.isActive
                        ? '<span class="badge-credit">فعال</span>'
                        : '<span class="badge-debit">منقضی</span>';
                    var totalS = Number(r.sessionCount || 0);
                    var remainS = (r.remainingSessions == null) ? totalS : Number(r.remainingSessions);
                    var usedS = Math.max(0, totalS - remainS);
                    var detailsId = 'register-details-' + i;
                    var toggleId = 'register-toggle-' + i;

                    html +=
                        '<div class="trf-card">' +
                            '<button type="button" class="trf-head" id="' + toggleId + '" aria-expanded="false" aria-controls="' + detailsId + '">' +
                                '<span class="visually-hidden">جزئیات ثبت‌نام شماره </span><span class="trf-num">' + rowNo + '</span>' +
                                '<span class="trf-mid">' +
                                    '<span class="trf-line"><b>' + esc(r.sportSanseName || '-') + '</b> ' + statusBadge + '</span>' +
                                    '<span class="trf-line"><i class="bi bi-calendar3" aria-hidden="true"></i> ' + reportDate(r.startDate) + ' <span>تا</span> ' + reportDate(r.endDate) + '</span>' +
                                '</span>' +
                                '<span class="trf-toggle" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>' +
                            '</button>' +
                            '<div class="trf-details" id="' + detailsId + '" role="region" aria-labelledby="' + toggleId + '" hidden>' +
                                '<div class="trf-drow"><span><i class="bi bi-trophy-fill hd-icon" aria-hidden="true"></i> ورزش / سانس</span><b>' + esc(r.sportSanseName || '-') + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-person-fill hd-icon" aria-hidden="true"></i> مربی</span><b>' + esc(r.coachName || '-') + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-info-circle-fill hd-icon" aria-hidden="true"></i> وضعیت</span><b>' + (r.isActive ? 'فعال' : 'منقضی') + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-calendar3 hd-icon" aria-hidden="true"></i> تاریخ شروع</span><b>' + reportDate(r.startDate) + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-calendar3 hd-icon" aria-hidden="true"></i> تاریخ پایان</span><b>' + reportDate(r.endDate) + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-list-ol hd-icon" aria-hidden="true"></i> کل جلسات</span><b>' + toFa(totalS) + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-check2-circle hd-icon" aria-hidden="true"></i> جلسات مصرف‌شده</span><b>' + toFa(usedS) + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-hourglass-split hd-icon" aria-hidden="true"></i> جلسات باقی‌مانده</span><b>' + toFa(remainS) + '</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-cash-coin hd-icon" aria-hidden="true"></i> مبلغ پرداختی</span><b><bdi dir="ltr">' + fmtNum(r.finalPayment || 0) + '</bdi> ریال</b></div>' +
                                '<div class="trf-drow"><span><i class="bi bi-calendar2-plus hd-icon" aria-hidden="true"></i> تاریخ ثبت‌نام</span><b>' + reportDate(r.creationDate) + '</b></div>' +
                            '</div>' +
                        '</div>';
                });
                $box.html(html);
            }, failed);
        }
        loadRegisterHistory();

        // ========== باز/بسته کردن جزئیات (تردد + سوابق ثبت‌نام) ==========
        $(function () {
            $('#trafficRows, #registerRows').on('click', '.trf-head', function () {
                var $card = $(this).closest('.trf-card');
                var expanded = this.getAttribute('aria-expanded') !== 'true';
                this.setAttribute('aria-expanded', String(expanded));
                $card.toggleClass('open', expanded);
                document.getElementById(this.getAttribute('aria-controls')).hidden = !expanded;
            });
            $('.member-reports').on('click', '[data-report-retry]', function () {
                var report = this.getAttribute('data-report-retry');
                var pane = this.closest('[role="tabpanel"]');
                if (pane) pane.focus();
                if (report === 'finance') loadFinance();
                else if (report === 'traffic') loadTraffic();
                else if (report === 'register') loadRegisterHistory();
            });

            // منطق Bootstrap و صفحه‌بندی حفظ می‌شود؛ کلیدهای جهت با RTL هماهنگ‌اند.
            var tabs = document.getElementById('reportTabs');
            var buttons = Array.prototype.slice.call(tabs.querySelectorAll('[role="tab"]'));
            tabs.addEventListener('shown.bs.tab', function (e) {
                buttons.forEach(function (button) {
                    button.setAttribute('tabindex', button === e.target ? '0' : '-1');
                    button.setAttribute('aria-selected', String(button === e.target));
                });
            });
            tabs.addEventListener('keydown', function (e) {
                var index = buttons.indexOf(e.target);
                if (index < 0) return;
                if (e.key === 'ArrowLeft') index = (index + 1) % buttons.length;
                else if (e.key === 'ArrowRight') index = (index + buttons.length - 1) % buttons.length;
                else if (e.key === 'Home') index = 0;
                else if (e.key === 'End') index = buttons.length - 1;
                else return;
                e.preventDefault();
                e.stopPropagation();
                var button = buttons[index];
                var tab = bootstrap.Tab.getInstance(button) || new bootstrap.Tab(button);
                tab.show();
                button.focus();
            }, true);
        });
    </script>
}
