@{
    ViewData["Title"] = "گزارش‌ها";
    var pc = new System.Globalization.PersianCalendar();
    var jY = pc.GetYear(DateTime.Now);
    var jM = pc.GetMonth(DateTime.Now);
    var jD = pc.GetDayOfMonth(DateTime.Now);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-bar-chart-fill hd-icon"></i> گزارش‌های من</h5>
    <a href="/Home" class="btn btn-outline-secondary btn-sm btn-back-glass"><i class="bi bi-arrow-right hd-icon"></i> داشبورد</a>
</div>

<div class="card">
    <!-- ===== هدر بنفش + ✅ دکمه تقویم حضور ===== -->
    <div class="card-header coach-list-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-bar-chart-fill hd-icon"></i> گزارش‌ها</span>
        <button type="button" class="att-cal-btn" id="btnAttCal" title="تقویم حضور">
            <i class="bi bi-calendar2-week-fill"></i>
        </button>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs nav-tabs-custom mb-3" id="reportTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="finance-tab" data-bs-toggle="tab" data-bs-target="#financePane" type="button" role="tab"><i class="bi bi-cash-coin hd-icon"></i> گزارش مالی</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="traffic-tab" data-bs-toggle="tab" data-bs-target="#trafficPane" type="button" role="tab"><i class="bi bi-door-closed-fill hd-icon"></i> گزارش تردد</button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- ========== تب مالی ========== -->
            <div class="tab-pane fade show active" id="financePane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table report-table">
                        <thead>
                            <tr>
                                <th>تاریخ</th>
                                <th>نوع</th>
                                <th>شرح</th>
                                <th class="text-end">مبلغ</th>
                            </tr>
                        </thead>
                        <tbody id="financeRows">
                            <tr><td colspan="4" class="empty-state">⏳ در حال بارگذاری...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ========== تب تردد ========== -->
            <div class="tab-pane fade" id="trafficPane" role="tabpanel">
                <div id="trafficRows">
                    <div class="text-center text-muted py-4">⏳ در حال بارگذاری...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== ✅ اورلی تقویم حضور (صفحه blur + پنل شیشه‌ای) ========== -->
<div id="attCalOverlay">
    <div class="att-cal-backdrop" id="attCalBackdrop"></div>
    <div class="att-cal-panel purple-style">
        <div class="att-cal-head">
            <button type="button" class="att-nav" id="calPrev" title="ماه قبل"><i class="bi bi-chevron-right"></i></button>
            <div class="att-cal-title" id="calTitle"></div>
            <button type="button" class="att-nav" id="calNext" title="ماه بعد"><i class="bi bi-chevron-left"></i></button>
            <button type="button" class="att-close" id="calClose" title="بستن"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="att-cal-body">
            <div class="att-week">
                <span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span>ج</span>
            </div>
            <div class="att-grid" id="calGrid"></div>
            <div class="att-legend">
                <span class="att-lg att-on">حاضر</span>
                <span class="att-lg att-off">غایب</span>
                <span class="att-lg att-future">پیش‌رو</span>
            </div>
            <div class="att-stats">
                <span class="att-chip att-chip-on" id="calOnCount"></span>
                <span class="att-chip att-chip-off" id="calOffCount"></span>
            </div>
        </div>
    </div>
</div>

<style>
    .coach-list-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 800;
        font-size: 1rem;
        padding: 13px 20px;
    }

    /* ===== ✅ دکمه تقویم روی هدر بنفش ===== */
    .att-cal-btn {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.30);
        color: #fff;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: all .25s;
    }

        .att-cal-btn:hover {
            background: rgba(255,255,255,.28);
            transform: translateY(-1px);
        }

        .att-cal-btn:active {
            transform: scale(.92);
        }

    /* ===== ✅ بلور کل صفحه وقتی تقویم بازه ===== */
    body > * {
        transition: filter .35s ease;
    }

    body.att-open {
        overflow: hidden;
    }

        body.att-open > *:not(#attCalOverlay) {
            filter: blur(10px) saturate(.85);
            pointer-events: none;
        }

    /* ===== اورلی تقویم ===== */
    #attCalOverlay {
        position: fixed;
        inset: 0;
        z-index: 1080;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .att-cal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(8,12,24,.45);
        opacity: 0;
        transition: opacity .3s;
    }

    #attCalOverlay.open .att-cal-backdrop {
        opacity: 1;
    }

    .att-cal-panel {
        position: relative;
        width: 100%;
        max-width: 420px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.15);
        box-shadow: 0 20px 60px rgba(0,0,0,.6);
        transform: scale(.85) translateY(24px);
        opacity: 0;
        transition: transform .4s cubic-bezier(.22,.9,.35,1.15), opacity .3s;
    }

    #attCalOverlay.open .att-cal-panel {
        transform: none;
        opacity: 1;
    }

    .att-cal-head {
        display: flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 10px 14px;
        color: #fff;
    }

    .att-cal-title {
        flex: 1 1 auto;
        text-align: center;
        font-weight: 800;
        font-size: .95rem;
    }

    .att-nav, .att-close {
        background: rgba(255,255,255,.15);
        border: none;
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background .2s;
    }

        .att-nav:hover, .att-close:hover {
            background: rgba(255,255,255,.3);
        }

    .att-cal-body {
        padding: 14px;
    }

    .att-week {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        margin-bottom: 6px;
    }

        .att-week span {
            text-align: center;
            font-size: .68rem;
            color: #9fb3c8;
            font-weight: 700;
        }

    .att-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }

    .att-day {
        border-radius: 10px;
        padding: 8px 0;
        text-align: center;
        font-size: .78rem;
        font-weight: 700;
    }

    /* ===== ✅ روزها: سبز / قرمز / خاکستری ===== */
    .att-on {
        background: rgba(56,217,169,.18);
        border: 1px solid rgba(56,217,169,.45);
        color: #38d9a9;
    }

    .att-off {
        background: rgba(255,107,129,.14);
        border: 1px solid rgba(255,107,129,.40);
        color: #ff8fa3;
    }

    .att-future {
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        color: #8a93a6;
    }

    .att-empty {
        background: transparent;
        border: none;
    }

    .att-legend {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
    }

    .att-lg {
        border-radius: 999px;
        padding: 3px 12px;
        font-size: .68rem;
        font-weight: 800;
    }

    .att-stats {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
    }

    .att-chip {
        border-radius: 999px;
        padding: 4px 14px;
        font-size: .72rem;
        font-weight: 800;
    }

    .att-chip-on {
        background: rgba(56,217,169,.14);
        border: 1px solid rgba(56,217,169,.35);
        color: #38d9a9;
    }

    .att-chip-off {
        background: rgba(255,107,129,.12);
        border: 1px solid rgba(255,107,129,.35);
        color: #ff8fa3;
    }

    /* ===== کارت‌های سلولی تردد ===== */
    .trf-card {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 14px;
        margin-bottom: 10px;
        overflow: hidden;
    }

    .trf-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        cursor: pointer;
    }

    .trf-num {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        box-shadow: 0 4px 10px rgba(30,111,217,.35);
    }

    .trf-mid {
        flex: 1 1 auto;
        min-width: 0;
    }

    .trf-line {
        font-size: .8rem;
        color: #cbd3da;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .trf-line b {
            color: #fff;
        }

    .trf-toggle {
        flex: 0 0 auto;
        background: rgba(255,255,255,.08);
        border: none;
        color: #9bd7f7;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        transition: transform .25s, background .25s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .trf-card.open .trf-toggle {
        transform: rotate(-90deg);
        background: rgba(13,110,253,.35);
        color: #fff;
    }

    .trf-details {
        display: none;
        padding: 10px 12px 12px;
        border-top: 1px dashed rgba(255,255,255,.15);
        background: rgba(0,0,0,.15);
    }

    .trf-drow {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .78rem;
        padding: 6px 0;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

        .trf-drow:last-child {
            border-bottom: none;
        }

        .trf-drow span {
            color: #8a93a6;
        }

        .trf-drow b {
            color: #e9ecef;
            font-weight: 700;
        }

    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
        font-size: 1rem;
    }

    .hd-badge {
        background: rgba(13,110,253,.25);
        border: 1px solid rgba(102,211,232,.45);
        color: #dce9ff;
        font-weight: 700;
    }

    .btn-back-glass {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .btn-back-glass i {
            color: #66d3e8;
            transition: transform .25s;
        }

        .btn-back-glass:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
            border-color: rgba(102,211,232,.45);
        }

            .btn-back-glass:hover i {
                transform: translateX(3px);
            }

        .btn-back-glass:active {
            transform: scale(.95);
        }
</style>

@section Scripts {
    <script>
                
        (function () {
            var ov = document.getElementById('attCalOverlay');
            if (ov && ov.parentNode !== document.body) document.body.appendChild(ov);
        })();
        var faDigits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
        function toFa(n) { return String(n).replace(/[0-9]/g, function(d){ return faDigits[d]; }); }
        function fmtNum(n) { return Number(n || 0).toLocaleString('fa-IR'); }
        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ========== ✅ تقویم حضور: وضعیت روزها ==========
        var calY = @jY, calM = @jM;
        var todayKey = @jY * 10000 + @jM * 100 + @jD;
        var attended = {};  // کلید: سال*10000 + ماه*100 + روز
        var monthNames = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];

        // تبدیل جلالی → میلادی (برای محاسبه روز هفته و طول ماه)
        function jalaliToGregorian(jy, jm, jd) {
            var gy = (jy <= 979) ? 621 : 1600;
            jy -= (jy <= 979) ? 0 : 979;
            var days = (365 * jy) + Math.floor(jy / 33) * 8 + Math.floor(((jy % 33) + 3) / 4) + 78 + jd +
                ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
            gy += 400 * Math.floor(days / 146097);
            days %= 146097;
            if (days > 36524) { gy += 100 * Math.floor(--days / 36524); days %= 36524; if (days >= 365) days++; }
            gy += 4 * Math.floor(days / 1461);
            days %= 1461;
            if (days > 366) { gy += Math.floor((days - 1) / 365); days = (days - 1) % 365; }
            var gd = days + 1;
            var sal_a = [0, 31, ((gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
            var gm = 0;
            for (gm = 0; gm < 13 && gd > sal_a[gm]; gm++) gd -= sal_a[gm];
            return { gy: gy, gm: gm, gd: gd };
        }
        function monthLength(jy, jm) {
            var a = jalaliToGregorian(jy, jm, 1);
            var ny = jy, nm = jm + 1;
            if (nm > 12) { nm = 1; ny++; }
            var b = jalaliToGregorian(ny, nm, 1);
            return Math.round((Date.UTC(b.gy, b.gm - 1, b.gd) - Date.UTC(a.gy, a.gm - 1, a.gd)) / 86400000);
        }
        function firstWeekday(jy, jm) {
            var g = jalaliToGregorian(jy, jm, 1);
            return (new Date(Date.UTC(g.gy, g.gm - 1, g.gd)).getUTCDay() + 1) % 7; // شنبه = 0
        }

        function renderAttCal() {
            var len = monthLength(calY, calM);
            var start = firstWeekday(calY, calM);
            var html = '';
            for (var i = 0; i < start; i++) html += '<span class="att-day att-empty"></span>';
            var on = 0, off = 0;
            for (var d = 1; d <= len; d++) {
                var key = calY * 10000 + calM * 100 + d;
                var cls = 'att-future';
                if (attended[key]) { cls = 'att-on'; on++; }
                else if (key <= todayKey) { cls = 'att-off'; off++; }
                html += '<span class="att-day ' + cls + '">' + toFa(d) + '</span>';
            }
            $('#calGrid').html(html);
            $('#calTitle').text(monthNames[calM - 1] + ' ' + toFa(calY));
            $('#calOnCount').text('حضور: ' + toFa(on) + ' روز');
            $('#calOffCount').text('غیبت: ' + toFa(off) + ' روز');
        }

        function openAttCal() {
            renderAttCal();
            document.body.classList.add('att-open');
            $('#attCalOverlay').css('display', 'flex');
            requestAnimationFrame(function () {
                requestAnimationFrame(function () { $('#attCalOverlay').addClass('open'); });
            });
        }
        function closeAttCal() {
            $('#attCalOverlay').removeClass('open');
            document.body.classList.remove('att-open');
            setTimeout(function () { $('#attCalOverlay').css('display', 'none'); }, 350);
        }

        $('#btnAttCal').on('click', openAttCal);
        $('#calClose').on('click', closeAttCal);
        $('#attCalBackdrop').on('click', closeAttCal);
        $(document).on('keydown', function (e) { if (e.key === 'Escape') closeAttCal(); });
        $('#calPrev').on('click', function () { calM--; if (calM < 1) { calM = 12; calY--; } renderAttCal(); });
        $('#calNext').on('click', function () { calM++; if (calM > 12) { calM = 1; calY++; } renderAttCal(); });

        // ========== گزارش مالی ==========
        function loadFinance() {
            apiCall('/api/Accounting/FinanceDocs', 'GET', null, function (res) {
                var $rows = $('#financeRows');
                if (!res.success || !res.data || res.data.length === 0) {
                    $rows.html('<tr><td colspan="4" class="empty-state"><div class="empty-icon">💰</div>هیچ تراکنشی یافت نشد</td></tr>');
                    return;
                }
                var html = '';
                $.each(res.data, function (i, d) {
                    var isCredit = d.docType === 'بستانکار';
                    var sign = isCredit ? '+' : '-';
                    var colorClass = isCredit ? 'text-success' : 'text-danger';
                    var badge = isCredit ? 'badge-credit' : 'badge-debit';
                    var dateStr = d.creationDateDisplay || '-';
                    html += '<tr>' +
                        '<td>' + esc(dateStr) + '</td>' +
                        '<td><span class="' + badge + '">' + esc(d.docType) + '</span></td>' +
                        '<td>' + esc(d.docDesc || '-') + '</td>' +
                        '<td class="text-end fw-bold ' + colorClass + '">' + sign + ' ' + fmtNum(d.amount) + ' ریال</td>' +
                    '</tr>';
                });
                $rows.html(html);
            });
        }
        loadFinance();

        // ========== محاسبه مدت حضور ==========
        function calcDuration(inT, outT) {
            if (!inT || !outT) return '';
            function toMin(s) {
                var p = String(s).split(':');
                return (+p[0]) * 60 + (+p[1]);
            }
            var d = toMin(outT) - toMin(inT);
            if (d < 0 || isNaN(d)) return '';
            var h = Math.floor(d / 60), m = d % 60;
            return (h ? toFa(h) + ' ساعت و ' : '') + toFa(m) + ' دقیقه';
        }

        // ========== گزارش تردد + ✅ ساخت مجموعه روزهای حضور ==========
        function loadTraffic() {
            apiCall('/api/Accounting/TrafficReport', 'GET', null, function (res) {
                var $box = $('#trafficRows');

                // ✅ روزهای حضور از روی همین داده‌ها ساخته می‌شه
                attended = {};
                if (res.success && res.data) {
                    $.each(res.data, function (i, t) {
                        if (!t.entryDate) return;
                        var p = String(t.entryDate).split('/');
                        if (p.length === 3) attended[(+p[0]) * 10000 + (+p[1]) * 100 + (+p[2])] = true;
                    });
                }

                if (!res.success || !res.data || res.data.length === 0) {
                    $box.html('<div class="text-center text-muted py-4"><div style="font-size:2.5rem">🚪</div>هیچ ترددی ثبت نشده</div>');
                    return;
                }
                var html = '';
                $.each(res.data, function (i, t) {
                    var rowNo = toFa(i + 1);
                    var dur = calcDuration(t.entryTime, t.exitTime);
                    html +=
                        '<div class="trf-card">' +
                            '<div class="trf-head">' +
                                '<div class="trf-num">' + rowNo + '</div>' +
                                '<div class="trf-mid">' +
                                    '<div class="trf-line">📥 ورود: ' + esc(t.entryDate || '-') + ' <b>' + esc(t.entryTime || '-') + '</b></div>' +
                                    '<div class="trf-line">📤 خروج: ' + esc(t.exitDate || '-') + ' <b>' + esc(t.exitTime || '-') + '</b></div>' +
                                '</div>' +
                                '<button type="button" class="trf-toggle"><i class="bi bi-chevron-left"></i></button>' +
                            '</div>' +
                            '<div class="trf-details">' +
                                '<div class="trf-drow"><span>🗄️ شماره کمد</span><b>' + (t.boxID != null ? toFa(t.boxID) : 'بدون کمد') + '</b></div>' +
                                '<div class="trf-drow"><span>تاریخ ورود</span><b>' + esc(t.entryDate || '-') + '</b></div>' +
                                '<div class="trf-drow"><span>ساعت ورود</span><b>' + esc(t.entryTime || '-') + '</b></div>' +
                                '<div class="trf-drow"><span>تاریخ خروج</span><b>' + esc(t.exitDate || '-') + '</b></div>' +
                                '<div class="trf-drow"><span>ساعت خروج</span><b>' + esc(t.exitTime || '-') + '</b></div>' +
                                (dur ? '<div class="trf-drow"><span>⏱️ مدت حضور</span><b>' + dur + '</b></div>' : '') +
                            '</div>' +
                        '</div>';
                });
                $box.html(html);
            });
        }
        loadTraffic();

        // ========== باز/بسته کردن جزئیات تردد ==========
        $(function () {
            $('#trafficRows').off('click', '.trf-head').on('click', '.trf-head', function () {
                var $card = $(this).closest('.trf-card');
                $card.toggleClass('open');
                $card.find('.trf-details').slideToggle(200);
            });
        });
    </script>
}