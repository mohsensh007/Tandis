@{
    ViewData["Title"] = "داشبورد";
}

<div id="profileBar" class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <strong id="dashFullName">در حال بارگذاری...</strong>
            <span class="text-muted me-3" id="dashMemberId"></span>
        </div>
        <div class="d-flex gap-3">
            <span class="badge bg-success fs-6" id="dashSportCredit">-</span>
            <span class="badge bg-info fs-6" id="dashBuffetCredit">-</span>
            <span class="badge bg-warning text-dark fs-6" id="dashServiceCredit">-</span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div id="dashCards" class="col-12"></div>
</div>

@section Scripts {
<script>
    $(function () {
        // بارگذاری پروفایل سریع
        apiCall('/api/Profile/GetProfile', 'GET', null, function (res) {
            if (res.success) {
                var d = res.data;
                $('#dashFullName').text(d.fullName);
                $('#dashMemberId').text('کد عضویت: ' + d.memberID);
                $('#dashSportCredit').text('اعتبار ورزشی: ' + Number(d.sportCredit).toLocaleString() + ' ریال');
                $('#dashBuffetCredit').text('اعتبار فروشگاه: ' + Number(d.buffetCredit).toLocaleString() + ' ریال');
                $('#dashServiceCredit').text('اعتبار سرویس: ' + Number(d.serviceCredit).toLocaleString() + ' ریال');
            }
        });

        // کارت‌های داشبورد
        var cards = [
            { icon: '🏃', title: 'ثبت‌نام دوره', color: '#667eea', href: '/Register' },
            { icon: '🔄', title: 'تمدید دوره', color: '#764ba2', href: '/Register/Renew' },
            { icon: '🎫', title: 'خرید بلیت', color: '#f093fb', href: '/Ticket' },
            { icon: '🛒', title: 'فروشگاه', color: '#11998e', href: '/Shop' },
            { icon: '☕', title: 'بوفه', color: '#fc5c7d', href: '/Shop/Buffet' },
            { icon: '💆', title: 'سرویس', color: '#f7971e', href: '/Service' },
            { icon: '💰', title: 'شارژ اعتبار', color: '#56ab2f', href: '/Accounting/AddMoney' },
            { icon: '👤', title: 'پروفایل', color: '#2193b0', href: '/Profile' }
        ];
        var html = '<div class="row g-3">';
        $.each(cards, function (i, c) {
            html += '<a href="' + c.href + '" class="col-6 col-md-3 text-decoration-none">' +
                '<div class="card dash-card"><div class="icon" style="font-size:2.5rem">' + c.icon + '</div>' +
                '<div class="title">' + c.title + '</div></div></a>';
        });
        html += '</div>';
        $('#dashCards').html(html);
    });
</script>
}
