        }

    .allmenu-overlay {
        position: fixed;
        inset: 0;
        z-index: 1055;
        display: none;
    }

    .allmenu-backdrop {
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, var(--g-surface-solid) 45%, transparent);
        opacity: 0;
        transition: opacity .3s;
    }

