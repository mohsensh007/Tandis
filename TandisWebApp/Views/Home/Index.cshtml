@{
    ViewData["Title"] = "داشبورد";
}

<!-- ========== هدر پروفایل ========== -->
<div class="card mb-3">
    <div class="purple-style card-body">
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative" style="width:88px;height:88px;flex:0 0 auto;">
                <div id="homeAvatar" class="avatar-circle w-100 h-100">👤</div>
                <img id="homeFaceImg" src="/Profile/MyFace" alt=""
                     style="position:absolute; top:0; right:0; width:100%; height:100%;
                object-fit:cover; border-radius:50%; display:none;"
                     onload="this.style.display='block';"
                     onerror="this.style.display='none';" />
            </div>
            <div class="flex-grow-1" style="min-width:0">
                <h5 class="mb-2 text-truncate" id="dashFullName">در حال بارگذاری...</h5>
                <div class="mb-2">
                    <span class="membership-chip">
                        <i class="bi bi-person-vcard-fill"></i>
                        <span id="dashMemberId">کد عضویت: -</span>
                    </span>
                </div>
                <!-- ✅ چیپ‌های وضعیت -->
                <div class="d-flex gap-2 flex-wrap">
                    <span class="status-chip status-active">
                        <i class="bi bi-bullseye"></i>
                        <span id="dashActiveCount">۰ سانس فعال</span>
                    </span>
                    <span class="status-chip status-remain">
                        <i class="bi bi-hourglass-split"></i>
                        <span id="dashRemainSessions">۰ جلسه مانده</span>
                    </span>
                </div>
            </div>
            <!-- ✅ ساعت آنالوگ + باکس دیجیتال/تاریخ (سمت چپ هدر) -->
            <div class="dash-clockbox ms-auto">
                <div class="dc-face">
                    <span class="dc-tick dc-t12"></span>
                    <span class="dc-tick dc-t3"></span>
                    <span class="dc-tick dc-t6"></span>
                    <span class="dc-tick dc-t9"></span>
                    <div class="dc-hand dc-hour" id="dcHour"></div>
                    <div class="dc-hand dc-min" id="dcMin"></div>
                    <div class="dc-hand dc-sec" id="dcSec"></div>
                    <div class="dc-center"></div>
                </div>
                <!-- ✅ باکس زیر ساعت: دیجیتال + تاریخ -->
                <div class="dc-infobox">
                    <div class="dc-digitaltime" id="dcTime">--:--:--</div>
                    <div class="dc-date" id="dashClockDate">-</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== منوی ناوبری کارت‌دار (فقط دسکتاپ) ========== -->
