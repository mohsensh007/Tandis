<!-- ========== کاروسل سه‌بعدی (فقط موبایل) ========== -->
<div id="navCarousel" class="d-md-none mb-3">
    <div class="cf-stage" id="cfStage"></div>
    <div id="cfLabel" class="fw-bold text-center mt-2"></div>
    <div id="cfDots" class="d-flex justify-content-center gap-1 mt-2"></div>
</div>
<div class="text-center mt-2 mb-3 d-md-none">
    <button type="button" class="btn btn-sm btn-all-menu" id="btnAllMenu">
        <i class="bi bi-grid-3x3-gap-fill me-1"></i> نمایش همه
    </button>
</div>

<!-- ========== منوی همه بخش‌ها ========== -->
<div class="allmenu-overlay" id="allMenuOverlay">
    <div class="allmenu-backdrop"></div>
    <div class="allmenu-panel">
        <div class="allmenu-header">
            <span class="fw-bold">همه بخش‌ها</span>
            <button type="button" class="allmenu-close" id="btnCloseMenu" title="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="allmenu-grid" id="allMenuGrid"></div>
    </div>
</div>

<!-- ========== ✅ مودال تک جلسه ========== -->
<div class="modal fade" id="singleSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content purple-style" style="border-radius:20px; overflow:hidden; border:1px solid rgba(102,211,232,.35);">
            <div class="modal-header border-0" style="padding:18px 20px;">
                <h5 class="modal-title fw-bold text-white">
                    <i class="bi bi-lightning-charge-fill" style="color:#66d3e8"></i>
                    خرید تک جلسه
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:16px 20px 20px;">
                <div class="ss-tabs">
                    <button type="button" class="ss-tab active" data-mode="today">⚡ امروز</button>
                    <button type="button" class="ss-tab" data-mode="week">📅 تا ۷ روز آینده</button>
                </div>
                <div class="ss-days" id="ssDays" style="display:none;"></div>
                <div id="singleSessionList">
                    <div class="text-center py-4" style="color:#9fb3c8;">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        در حال بارگذاری...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== ✅ اورلی تأیید تک جلسه ========== -->
<div class="ss-confirm-overlay" id="ssConfirmOverlay">
    <div class="ss-confirm-backdrop"></div>
    <div class="ss-confirm-panel">
        <div class="ss-confirm-icon">⚡</div>
        <div class="ss-confirm-text" id="ssConfirmText"></div>
        <div class="ss-confirm-btns">
            <button type="button" class="ss-btn-cancel" id="ssConfirmCancel">انصراف</button>
            <button type="button" class="ss-btn" id="ssConfirmOk">تأیید و ثبت</button>
        </div>
    </div>
</div>

<!-- ========== ✅ مودال تعرفه‌ها (۴ تب) ========== -->
<div class="modal fade" id="tarefeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content purple-style" style="border-radius:20px; overflow:hidden; border:1px solid rgba(102,211,232,.35);">
            <div class="modal-header border-0" style="padding:18px 20px;">
                <h5 class="modal-title fw-bold text-white">
                    <i class="bi bi-credit-card-2-front-fill" style="color:#66d3e8"></i>
                    تعرفه‌ها
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:16px 20px 20px;">
                <div class="tf-tabs">
                    <button type="button" class="tf-tab active" data-tf="shahriye">📚 شهریه</button>
                    <button type="button" class="tf-tab" data-tf="ticket">🎟️ بلیط</button>
                    <button type="button" class="tf-tab" data-tf="service">💆 خدمات</button>
                    <button type="button" class="tf-tab" data-tf="single">⚡ تک جلسه</button>
                </div>
                <div class="tf-filterbar" id="tfFilterBar" style="display:none;">
                    <button type="button" class="tf-filterbtn" id="btnTfFilter">
                        <i class="bi bi-funnel-fill"></i>
                        فیلتر رشته‌ها
                        <span class="tf-filtercount" id="tfFilterCount" style="display:none">۰</span>
                    </button>
                    <span class="tf-filterlabel" id="tfFilterLabel">نمایش: همه رشته‌ها</span>
                </div>
                <div class="tf-filterpanel" id="tfFilterPanel" style="display:none;">
                    <div class="tf-fp-head">
                        <span class="fw-bold text-white" style="font-size:.85rem;">انتخاب رشته‌ها</span>
                        <div class="d-flex gap-1">
                            <button type="button" class="tf-fp-link" id="tfSelAll">همه</button>
                            <button type="button" class="tf-fp-link" id="tfSelNone">هیچ‌کدام</button>
                        </div>
                    </div>
                    <div class="tf-fp-list" id="tfFilterList"></div>
                    <button type="button" class="ss-btn w-100 mt-2" id="btnTfApply" style="justify-content:center;">
                        <i class="bi bi-check2"></i> اعمال و بستن
                    </button>
                </div>
                <div id="tarefeList">
                    <div class="text-center py-4" style="color:#9fb3c8;">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        در حال بارگذاری...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== ✅ کارت برنامه تمرینی من ========== -->
<a href="/MyProgram" class="mp-entry mb-3">
    <div class="mp-entry-inner">
        <div class="mp-entry-icon">
            <i class="bi bi-clipboard2-pulse-fill"></i>
        </div>
        <div class="mp-entry-info">
            <div class="mp-entry-title">برنامه تمرینی من</div>
            <div class="mp-entry-sub" id="mpEntrySub">برنامه‌های مربی</div>
        </div>
        <div class="mp-entry-right">
            <span class="mp-entry-count" id="myProgramCount" style="display:none">۰</span>
            <i class="bi bi-arrow-left"></i>
        </div>
    </div>
</a>

<style>
    /* ===== هدر پروفایل ===== */
    .avatar-circle {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: linear-gradient(135deg,#6f42c1,#0d6efd);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        overflow: hidden;
        flex: 0 0 auto;
        box-shadow: 0 8px 24px rgba(118,75,162,.35);
    }

        .avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* ===== ✅ کادر کد عضویت (مثل چیپ‌های وضعیت) ===== */
    .membership-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: .78rem;
        font-weight: 700;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(13,110,253,.35);
        color: #dce9ff;
        white-space: nowrap;
    }

        .membership-chip i {
            color: #66d3e8;
            font-size: .95rem;
        }

    /* ===== ✅ چیپ‌های وضعیت (جایگزین چیپ‌های اعتبار) ===== */
    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .74rem;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

        .status-chip i {
            font-size: .9rem;
        }

    .status-date {
        background: rgba(13,110,253,.14);
        border-color: rgba(13,110,253,.35);
        color: #dce9ff;
    }

        .status-date i {
            color: #66d3e8;
        }

    .status-active {
        background: rgba(25,135,84,.14);
        border-color: rgba(25,135,84,.35);
        color: #b8f0d0;
    }

        .status-active i {
            color: #6aeaa2;
        }

    .status-remain {
        background: rgba(118,75,162,.14);
        border-color: rgba(118,75,162,.40);
        color: #e6d9ff;
    }

        .status-remain i {
            color: #c9a6ff;
        }

    /* ===== ✅ ساعت آنالوگ شیشه‌ای (تم بنفش-فیروزه‌ای) ===== */
    .dash-clockbox {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .dc-face {
        position: relative;
        width: 118px;
        height: 118px;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 25%, rgba(255,255,255,.10), rgba(255,255,255,.02) 62%), rgba(13,17,30,.55);
        border: 1px solid rgba(102,211,232,.35);
        box-shadow: 0 8px 24px rgba(0,0,0,.35), inset 0 0 18px rgba(13,110,253,.10);
    }
    /* علامت‌های ۱۲/۳/۶/۹ */
    .dc-tick {
        position: absolute;
        background: rgba(255,255,255,.40);
        border-radius: 2px;
    }

    .dc-t12 {
        top: 5px;
        left: 50%;
        width: 2px;
        height: 9px;
        margin-left: -1px;
    }

    .dc-t6 {
        bottom: 5px;
        left: 50%;
        width: 2px;
        height: 9px;
        margin-left: -1px;
    }

    .dc-t3 {
        right: 5px;
        top: 50%;
        width: 9px;
        height: 2px;
        margin-top: -1px;
    }

    .dc-t9 {
        left: 5px;
        top: 50%;
        width: 9px;
        height: 2px;
        margin-top: -1px;
    }
    /* عقربه‌ها */
    .dc-hand {
        position: absolute;
        left: 50%;
        bottom: 50%;
        transform-origin: 50% 100%;
        border-radius: 4px;
    }

    .dc-hour {
        width: 4px;
        height: 26%;
        margin-left: -2px;
        background: #dce9ff;
        box-shadow: 0 0 6px rgba(220,233,255,.45);
        z-index: 2;
    }

    .dc-min {
        width: 3px;
        height: 36%;
        margin-left: -1.5px;
        background: rgba(220,233,255,.60);
        z-index: 3;
    }

    .dc-sec {
        width: 2px;
        height: 42%;
        margin-left: -1px;
        background: #ff6b81;
        box-shadow: 0 0 8px rgba(255,107,129,.55);
        z-index: 4;
    }

    .dc-center {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 12px;
        height: 12px;
        margin: -6px 0 0 -6px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        box-shadow: 0 0 10px rgba(118,75,162,.8);
        z-index: 5;
    }
    /* ===== ✅ باکس زیر ساعت: دیجیتال + تاریخ ===== */
    .dc-infobox {
        background: rgba(13,110,253,.10);
        border: 1px solid rgba(13,110,253,.30);
        border-radius: 12px;
        padding: 6px 14px;
        text-align: center;
        min-width: 118px; 
        width: auto; 
        box-shadow: 0 4px 14px rgba(13,110,253,.12);
    }

    .dc-digitaltime {
        font-size: 1.15rem;
        font-weight: 800;
        color: #fff;
        font-variant-numeric: tabular-nums;
        direction: ltr;
        letter-spacing: 1px;
        line-height: 1.2;
    }

    .dc-date {
        font-size: .66rem;
        color: #9fb3c8;
        font-weight: 700;
        white-space: nowrap;
        margin-top: 2px;
    }

    @@media (max-width: 576px) {
        .dc-face {
            width: 94px;
            height: 94px;
        }

        .dc-infobox {
            min-width: 94px;
            width: auto;
            padding: 5px 10px;
        }

        .dc-digitaltime {
            font-size: .95rem;
        }

        .dc-date {
            font-size: .56rem;
        }
    }

    /* ===== کارت برنامه تمرینی ===== */
    .mp-entry {
        display: block;
        text-decoration: none;
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(102,126,234,.22), rgba(118,75,162,.18));
        border: 1px solid rgba(102,211,232,.35);
        transition: transform .25s, border-color .25s, box-shadow .25s;
    }

        .mp-entry:hover {
            transform: translateY(-3px);
            border-color: rgba(102,211,232,.65);
            box-shadow: 0 10px 28px rgba(118,75,162,.30);
        }

        .mp-entry::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 160px;
            height: 160px;
            background: radial-gradient(circle, rgba(102,211,232,.25), transparent 70%);
            pointer-events: none;
        }

        .mp-entry::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -30px;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, rgba(118,75,162,.25), transparent 70%);
            pointer-events: none;
        }

    .mp-entry-inner {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
    }

    .mp-entry-icon {
        flex: 0 0 auto;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        box-shadow: 0 8px 20px rgba(118,75,162,.45);
    }

    .mp-entry-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    .mp-entry-title {
        font-weight: 800;
        font-size: 1rem;
        color: #fff;
        margin-bottom: 3px;
    }

    .mp-entry-sub {
        font-size: .76rem;
        color: #9fb3c8;
    }

    .mp-entry-right {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #66d3e8;
        font-size: 1.1rem;
    }

    .mp-entry-count {
        background: rgba(102,211,232,.16);
        border: 1px solid rgba(102,211,232,.40);
        color: #66d3e8;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .74rem;
        font-weight: 800;
        white-space: nowrap;
    }

    /* ===== کاروسل ===== */
    .cf-stage {
        position: relative;
        height: 200px;
        perspective: 900px;
        overflow: hidden;
        touch-action: pan-y;
    }

    .cf-card {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 150px;
        height: 150px;
        margin: -75px 0 0 -75px;
        border-radius: 18px;
        background: linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.05));
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(8px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #fff;
        text-decoration: none;
        transition: transform .55s cubic-bezier(.22,.9,.35,1.1), opacity .45s;
        transform-style: preserve-3d;
        box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }

        .cf-card.cf-active {
            background: linear-gradient(145deg, rgba(13,110,253,.55), rgba(111,66,193,.45));
            border-color: rgba(255,255,255,.35);
            box-shadow: 0 16px 40px rgba(13,110,253,.35);
        }

    .cf-icon {
        font-size: 2.6rem;
        line-height: 1;
    }

    .cf-title {
        font-weight: 700;
        font-size: .95rem;
    }

    .cf-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,.25);
        transition: all .3s;
        cursor: pointer;
    }

        .cf-dot.on {
            background: #0d6efd;
            transform: scale(1.3);
        }

    /* ===== کارت‌های اعتبار (پایین صفحه) ===== */
    .credit-card {
        background: linear-gradient(160deg, rgba(255,255,255,.09), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
    }

        .credit-card .card-body {
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

    .credit-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .credit-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
        border-radius: 12px;
        overflow: hidden;
        background: #DCE9F2;
        box-shadow: 0 4px 12px rgba(0,0,0,.3);
    }

        .credit-icon img {
            width: 100%;
