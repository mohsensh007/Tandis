@{
    ViewData["Title"] = "داشبورد";
}

<!-- ========== هدر پروفایل ========== -->
<div class="card mb-3">
    <div class="purple-style card-body">
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative" style="width:56px;height:56px;flex:0 0 auto;">
                <div id="homeAvatar" class="avatar-circle w-100 h-100">👤</div>
                <img id="homeFaceImg" src="/Profile/MyFace" alt=""
                     style="position:absolute; top:0; right:0; width:100%; height:100%;
                object-fit:cover; border-radius:50%; display:none;"
                     onload="this.style.display='block';"
                     onerror="this.style.display='none';" />
            </div>
            <div class="flex-grow-1" style="min-width:0">
                <h5 class="mb-1 text-truncate" id="dashFullName">در حال بارگذاری...</h5>
                <div class="text-muted small" id="dashMemberId"></div>
            </div>
        </div>
        <!-- ✅ چیپ‌های اعتبار با عبارت «اعتبار» در اول -->
        <div class="d-flex gap-2 flex-wrap mt-3">
            <span class="credit-chip"><span class="dot"></span><span id="dashSportCredit">اعتبار ورزشی: -</span></span>
            <span class="credit-chip"><span class="dot"></span><span id="dashBuffetCredit">اعتبار فروشگاه: -</span></span>
            <span class="credit-chip"><span class="dot"></span><span id="dashServiceCredit">اعتبار خدمات: -</span></span>
        </div>
    </div>
</div>

<!-- ========== منوی ناوبری کارت‌دار (فقط دسکتاپ) ========== -->
<div class="row g-2 mb-3 d-none d-md-flex" id="navMenu">
    <div class="col-4 col-md-2">
        <a href="/Register/Renew" class="purple-style nav-card">
            <div class="nav-icon">🔄</div>
            <div class="nav-title">تمدید دوره</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Ticket" class="purple-style nav-card">
            <div class="nav-icon">🎟️</div>
            <div class="nav-title">بلیط</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Shop" class="purple-style nav-card">
            <div class="nav-icon">🛒</div>
            <div class="nav-title">فروشگاه</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Shop/Buffet" class="purple-style nav-card">
            <div class="nav-icon">🍔</div>
            <div class="nav-title">بوفه</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Service" class="purple-style nav-card">
            <div class="nav-icon">💆</div>
            <div class="nav-title">خدمات</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Accounting" class="purple-style nav-card">
            <div class="nav-icon">💰</div>
            <div class="nav-title">مالی</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Home/Reports" class="purple-style nav-card">
            <div class="nav-icon">📊</div>
            <div class="nav-title">گزارش‌ها</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Profile" class="purple-style nav-card">
            <div class="nav-icon">👤</div>
            <div class="nav-title">پروفایل</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Home/ScanQr" class="purple-style nav-card">
            <div class="nav-icon">🚪</div>
            <div class="nav-title">ورود / خروج</div>
        </a>
    </div>
</div>

<!-- ========== کاروسل سه‌بعدی (فقط موبایل) - بدون فلش ========== -->
<div id="navCarousel" class="d-md-none mb-3">
    <div class="cf-stage" id="cfStage"></div>
    <div id="cfLabel" class="fw-bold text-center mt-2"></div>
    <div id="cfDots" class="d-flex justify-content-center gap-1 mt-2"></div>
</div>
<!-- ✅ دکمه نمایش همه (فقط موبایل) -->
<div class="text-center mt-2 mb-3 d-md-none">
    <button type="button" class="btn btn-sm btn-all-menu" id="btnAllMenu">
        <i class="bi bi-grid-3x3-gap-fill me-1"></i> نمایش همه
    </button>
</div>

<!-- ========== منوی همه بخش‌ها (اورلی تمام‌صفحه) ========== -->
<div class="allmenu-overlay" id="allMenuOverlay">
    <div class="allmenu-backdrop"></div>
    <div class="allmenu-panel">
        <div class="allmenu-header">
            <span class="fw-bold">همه بخش‌ها</span>
            <button type="button" class="allmenu-close" id="btnCloseMenu" title="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="allmenu-grid" id="allMenuGrid"></div>
    </div>
</div>

<!-- ========== ✅ کارت برنامه تمرینی من (دسکتاپ + موبایل) ========== -->
<a href="/MyProgram" class="mp-entry mb-3">
    <div class="mp-entry-inner">
        <div class="mp-entry-icon">
            <i class="bi bi-clipboard2-pulse-fill"></i>
        </div>
        <div class="mp-entry-info">
            <div class="mp-entry-title">برنامه تمرینی من</div>
            <div class="mp-entry-sub" id="mpEntrySub">برنامه‌های مربی</div>
        </div>
        <div class="mp-entry-right">
            <span class="mp-entry-count" id="myProgramCount" style="display:none">۰</span>
            <i class="bi bi-arrow-left"></i>
        </div>
    </div>
</a>

<style>
    /* ===== هدر پروفایل ===== */
    
    .avatar-circle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg,#6f42c1,#0d6efd);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        overflow: hidden;
        flex: 0 0 auto;
    }

        .avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* ===== چیپ‌های اعتبار ===== */
    .credit-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(140,190,255,.10);
        border: 1px solid rgba(140,190,255,.30);
        border-radius: 999px;
        padding: 5px 14px;
        font-size: .78rem;
        font-weight: 600;
        color: #dce9ff;
    }

        .credit-chip .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: linear-gradient(135deg,#0d6efd,#9bd7f7);
            box-shadow: 0 0 8px rgba(13,110,253,.7);
            flex: 0 0 auto;
        }

    /* ===== ✅ کارت برنامه تمرینی (دسکتاپ + موبایل) ===== */
    
    .mp-entry {
        display: block;
        text-decoration: none;
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(102,126,234,.22), rgba(118,75,162,.18));
        border: 1px solid rgba(102,211,232,.35);
        transition: transform .25s, border-color .25s, box-shadow .25s;
    }

        .mp-entry:hover {
            transform: translateY(-3px);
            border-color: rgba(102,211,232,.65);
            box-shadow: 0 10px 28px rgba(118,75,162,.30);
        }

        .mp-entry::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 160px;
            height: 160px;
            background: radial-gradient(circle, rgba(102,211,232,.25), transparent 70%);
            pointer-events: none;
        }

        .mp-entry::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -30px;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, rgba(118,75,162,.25), transparent 70%);
            pointer-events: none;
        }

    .mp-entry-inner {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
    }

    .mp-entry-icon {
        flex: 0 0 auto;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        box-shadow: 0 8px 20px rgba(118,75,162,.45);
    }

    .mp-entry-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    .mp-entry-title {
        font-weight: 800;
        font-size: 1rem;
        color: #fff;
        margin-bottom: 3px;
    }

    .mp-entry-sub {
        font-size: .76rem;
        color: #9fb3c8;
    }

    .mp-entry-right {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #66d3e8;
        font-size: 1.1rem;
    }

    .mp-entry-count {
        background: rgba(102,211,232,.16);
        border: 1px solid rgba(102,211,232,.40);
        color: #66d3e8;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .74rem;
        font-weight: 800;
        white-space: nowrap;
    }

    /* ===== آیکن‌های سه‌بعدی آبی-سفید کارت‌های اعتبار ===== */
    .stat-icon.stat-icon-light {
        background: #DCE9F2;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex: 0 0 auto;
    }

        .stat-icon.stat-icon-light img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* ===== کاروسل سه‌بعدی منوی موبایل ===== */
    .cf-stage {
        position: relative;
        height: 200px;
        perspective: 900px;
        overflow: hidden;
        touch-action: pan-y;
    }

    .cf-card {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 150px;
        height: 150px;
        margin: -75px 0 0 -75px;
        border-radius: 18px;
        background: linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.05));
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(8px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #fff;
        text-decoration: none;
        transition: transform .55s cubic-bezier(.22,.9,.35,1.1), opacity .45s;
        transform-style: preserve-3d;
        box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }

        .cf-card.cf-active {
            background: linear-gradient(145deg, rgba(13,110,253,.55), rgba(111,66,193,.45));
            border-color: rgba(255,255,255,.35);
            box-shadow: 0 16px 40px rgba(13,110,253,.35);
        }

    .cf-icon {
        font-size: 2.6rem;
        line-height: 1;
    }

    .cf-title {
        font-weight: 700;
        font-size: .95rem;
    }

    .cf-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,.25);
        transition: all .3s;
        cursor: pointer;
    }

        .cf-dot.on {
            background: #0d6efd;
            transform: scale(1.3);
        }
    /* ===== کارت‌های اعتبار مرتب ===== */
    .credit-card {
        background: linear-gradient(160deg, rgba(255,255,255,.09), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
    }

        .credit-card .card-body {
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

    .credit-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .credit-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
        border-radius: 12px;
        overflow: hidden;
        background: #DCE9F2;
        box-shadow: 0 4px 12px rgba(0,0,0,.3);
    }

        .credit-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .credit-label {
        font-size: .8rem;
        font-weight: 700;
        color: #bcd0e4;
        line-height: 1.3;
    }
    /* کادر شیشه‌ای عدد — هیچ‌وقت نمی‌شکنه */
    .credit-amount {
        display: flex;
        align-items: baseline;
        gap: 6px;
        background: rgba(13,110,253,.12);
        border: 1px solid rgba(13,110,253,.25);
        border-radius: 12px;
        padding: 8px 12px;
        margin-top: auto;
    }

    .credit-value {
        flex: 1 1 auto;
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        font-variant-numeric: tabular-nums;
    }

    .credit-unit {
        flex: 0 0 auto;
        font-size: .68rem;
        font-weight: 600;
        color: #8fb6e8;
    }
    /* حالت بدهی (قرمز) */
    .credit-amount.is-debit {
        background: rgba(220,53,69,.12);
        border-color: rgba(220,53,69,.3);
    }

        .credit-amount.is-debit .credit-value {
            color: #ff8f98;
        }

        .credit-amount.is-debit .credit-unit {
            color: #d99aa0;
        }
    /* حالت بستانکار (سبز) */
    .credit-amount.is-credit {
        background: rgba(25,135,84,.12);
        border-color: rgba(25,135,84,.3);
    }

        .credit-amount.is-credit .credit-value {
            color: #8fe3b0;
        }

        .credit-amount.is-credit .credit-unit {
            color: #9ed4b4;
        }
    /* ===== دکمه نمایش همه ===== */
    .btn-all-menu {
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 6px 18px;
        font-weight: 700;
        backdrop-filter: blur(8px);
    }

        .btn-all-menu:active {
            transform: scale(.95);
        }

    /* ===== بلور کل صفحه وقتی منو بازه ===== */
    body > * {
        transition: filter .35s ease;
    }

    body.menu-open {
        overflow: hidden;
    }

        body.menu-open > *:not(#allMenuOverlay) {
            filter: blur(10px) saturate(.85);
            pointer-events: none;
        }

    /* ===== اورلی منوی همه بخش‌ها ===== */
    .allmenu-overlay {
        position: fixed;
        inset: 0;
        z-index: 1055;
        display: none;
    }

    .allmenu-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(8,12,24,.45);
        opacity: 0;
        transition: opacity .3s;
    }

    .allmenu-overlay.open .allmenu-backdrop {
        opacity: 1;
    }

    .allmenu-panel {
        position: absolute;
        inset: 0;
        padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
        overflow-y: auto;
    }

    .allmenu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #fff;
        font-size: 1rem;
        margin-bottom: 16px;
    }

    .allmenu-close {
        background: rgba(255,255,255,.12);
        border: none;
        color: #fff;
        width: 36px;
        height: 36px;
        border-radius: 50%;
    }

    .allmenu-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    @@media (min-width: 576px) {
        .allmenu-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    /* آیتم‌ها: خط‌به‌خط از پایین میان بالا */
    .allmenu-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 16px 6px;
        border-radius: 16px;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.14);
        color: #e9ecef;
        text-decoration: none;
        font-size: .78rem;
        font-weight: 600;
        backdrop-filter: blur(6px);
        opacity: 0;
        transform: translateY(28px) scale(.95);
        transition: opacity .4s ease, transform .45s cubic-bezier(.22,.9,.35,1.15);
    }

    .allmenu-overlay.open .allmenu-item {
        opacity: 1;
        transform: none;
    }

    .allmenu-item .am-icon {
        font-size: 1.9rem;
        line-height: 1;
    }

    .allmenu-item:active {
        transform: scale(.94);
    }
    /* ===== استیکرها: تک‌رنگ آبی ===== */
    .am-icon, .cf-icon, .nav-icon {
        filter: grayscale(1) sepia(1) hue-rotate(190deg) saturate(4) brightness(1.05);
    }
    /* ===== کارت سانس فعال (طراحی جدید) ===== */
    .sans-card {
        position: relative;
        border-radius: 20px;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        padding: 16px;
        overflow: hidden;
    }

        .sans-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.30), transparent 70%);
            pointer-events: none;
        }

    .sans-name {
        font-weight: 800;
        font-size: 1.02rem;
        color: #fff;
    }

    .sans-coach {
        font-size: .8rem;
        color: #9fb3c8;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
    }

        .sans-coach i {
            color: #66d3e8;
        }

    .sans-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(13,110,253,.30);
        color: #dce9ff;
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .75rem;
        font-weight: 700;
    }

        .sans-pill i {
            color: #66d3e8;
            font-size: .85rem;
        }

    .sans-meta {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        font-size: .78rem;
        color: #9fb3c8;
    }

        .sans-meta i {
            color: #66d3e8;
            margin-left: 4px;
        }

    .sans-remain {
        font-weight: 800;
        color: #fff;
    }
    /* ===== آیکن و بج هدر سانس‌ها: آبی یکدست ===== */
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
        font-size: 1rem;
    }

    .hd-badge {
        background: rgba(13,110,253,.25);
        border: 1px solid rgba(102,211,232,.45);
        color: #dce9ff;
        font-weight: 700;
    }
</style>

