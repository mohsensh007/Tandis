@{
    ViewData["Title"] = "داشبورد";
}

<div class="member-home">
<!-- ========== هدر پروفایل ========== -->
<div class="card mb-3 home-profile-card">
    <div class="purple-style card-body">
        <div class="d-flex align-items-center gap-3 home-profile-summary">
            <div class="position-relative home-avatar-wrap">
                <div id="homeAvatar" class="avatar-circle w-100 h-100"><i class="bi bi-person-fill" aria-hidden="true"></i></div>
                <img id="homeFaceImg" src="/Profile/MyFace" alt="" width="88" height="88" decoding="async"
                     style="position:absolute; top:0; right:0; width:100%; height:100%;
                object-fit:cover; border-radius:50%; display:none;"
                     onload="this.style.display='block';"
                     onerror="this.style.display='none';" />
            </div>
            <div class="flex-grow-1" style="min-width:0">
                <h5 class="mb-2" id="dashFullName">در حال بارگذاری...</h5>
                <div class="mb-2">
                    <span class="membership-chip">
                        <i class="bi bi-person-vcard-fill"></i>
                        <span id="dashMemberId">کد عضویت: -</span>
                    </span>
                </div>
                <!-- ✅ چیپ‌های وضعیت -->
                <div class="d-flex gap-2 flex-wrap">
                    <span class="status-chip status-active">
                        <i class="bi bi-bullseye"></i>
                        <span id="dashActiveCount">۰ سانس فعال</span>
                    </span>
                    <span class="status-chip status-remain">
                        <i class="bi bi-hourglass-split"></i>
                        <span id="dashRemainSessions">۰ جلسه مانده</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== منوی ناوبری کارت‌دار (فقط دسکتاپ) ========== -->
<div class="row g-2 mb-3 d-none d-md-flex" id="navMenu">
    <div class="col-4 col-md-2">
        <a href="/Register/Renew" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></div>
            <div class="nav-title">ثبت‌نام / تمدید دوره</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Ticket" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i></div>
            <div class="nav-title">بلیط</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="#" class="purple-style nav-card" id="navSingleSession" data-action="singleSession">
            <div class="nav-icon"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i></div>
            <div class="nav-title">تک جلسه</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="#" class="purple-style nav-card" id="navTarefe" data-action="tarefe">
            <div class="nav-icon"><i class="bi bi-credit-card-2-front-fill" aria-hidden="true"></i></div>
            <div class="nav-title">تعرفه‌ها</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Shop" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-cart3" aria-hidden="true"></i></div>
            <div class="nav-title">فروشگاه</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Shop/Buffet" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-cup-hot-fill" aria-hidden="true"></i></div>
            <div class="nav-title">بوفه</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Service" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-flower1" aria-hidden="true"></i></div>
            <div class="nav-title">خدمات</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Accounting" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></div>
            <div class="nav-title">مالی</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Home/Reports" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i></div>
            <div class="nav-title">گزارش‌ها</div>
        </a>
    </div>
    <div class="col-4 col-md-2">
        <a href="/Profile" class="purple-style nav-card">
            <div class="nav-icon"><i class="bi bi-person-circle" aria-hidden="true"></i></div>
            <div class="nav-title">پروفایل</div>
        </a>
    </div>
    <!-- ✅ موقتاً حذف شد (درخواست کاربر): کارت «ورود / خروج» و صفحه ScanQr.
         ورود/خروج با دستگاه تردد باشگاه ثبت می‌شود و لازم نیست از اپ زده شود. -->
</div>

<!-- ========== کاروسل سه‌بعدی (فقط موبایل) ========== -->
<div id="navCarousel" class="d-md-none mb-3" role="region" aria-label="بخش‌های باشگاه">
    <div class="cf-stage" id="cfStage"></div>
</div>
<div class="text-center mt-2 mb-3 d-md-none">
    <button type="button" class="btn btn-sm btn-all-menu" id="btnAllMenu" aria-controls="allMenuOverlay" aria-expanded="false" aria-haspopup="dialog">
        <i class="bi bi-grid-3x3-gap-fill me-1"></i> نمایش همه
    </button>
</div>

<!-- ========== منوی همه بخش‌ها ========== -->
<div class="allmenu-overlay" id="allMenuOverlay" role="dialog" aria-modal="true" aria-labelledby="allMenuTitle" aria-hidden="true">
    <div class="allmenu-backdrop"></div>
    <div class="allmenu-panel">
        <div class="allmenu-header">
            <span class="fw-bold" id="allMenuTitle">همه بخش‌ها</span>
            <button type="button" class="allmenu-close" id="btnCloseMenu" title="بستن" aria-label="بستن منو">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="allmenu-grid" id="allMenuGrid"></div>
    </div>
</div>

<!-- ========== ✅ مودال تک جلسه ========== -->
<div class="modal fade" id="singleSessionModal" tabindex="-1" aria-hidden="true" aria-labelledby="singleSessionTitle">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content purple-style" style="border-radius:20px; overflow:hidden; border:1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);">
            <div class="modal-header border-0" style="padding:18px 20px;">
                <h5 class="modal-title fw-bold text-white" id="singleSessionTitle">
                    <i class="bi bi-lightning-charge-fill" style="color:var(--g-primary)"></i>
                    خرید تک جلسه
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" style="padding:16px 20px 20px;">
                <div class="ss-tabs">
                    <button type="button" class="ss-tab active" data-mode="today"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> امروز</button>
                    @* ✅ تک‌جلسه فقط امروز — کد و تب روزهای آینده کامنت شد
                    <button type="button" class="ss-tab" data-mode="week"><i class="bi bi-calendar-week" aria-hidden="true"></i> تا ۷ روز آینده</button>
                    *@
                </div>
                <div class="ss-days" id="ssDays" style="display:none;"></div>
                <div id="singleSessionList">
                    <div class="text-center py-4" style="color:var(--g-text);">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        در حال بارگذاری...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== ✅ اورلی تأیید تک جلسه ========== -->
<div class="ss-confirm-overlay" id="ssConfirmOverlay">
    <div class="ss-confirm-backdrop"></div>
    <div class="ss-confirm-panel">
        <div class="ss-confirm-icon"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i></div>
        <div class="ss-confirm-text" id="ssConfirmText"></div>
        <div class="ss-confirm-btns">
            <button type="button" class="ss-btn-cancel" id="ssConfirmCancel">انصراف</button>
            <button type="button" class="ss-btn" id="ssConfirmOk">تأیید و ثبت</button>
        </div>
    </div>
</div>

<!-- ========== ✅ مودال تعرفه‌ها (۴ تب) ========== -->
<div class="modal fade" id="tarefeModal" tabindex="-1" aria-hidden="true" aria-labelledby="tarefeTitle">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content purple-style" style="border-radius:20px; overflow:hidden; border:1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);">
            <div class="modal-header border-0" style="padding:18px 20px;">
                <h5 class="modal-title fw-bold text-white" id="tarefeTitle">
                    <i class="bi bi-credit-card-2-front-fill" style="color:var(--g-primary)"></i>
                    تعرفه‌ها
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" style="padding:16px 20px 20px;">
                <div class="tf-tabs">
                    <button type="button" class="tf-tab active" data-tf="shahriye"><i class="bi bi-journal-text" aria-hidden="true"></i> شهریه</button>
                    <button type="button" class="tf-tab" data-tf="ticket"><i class="bi bi-ticket-perforated-fill" aria-hidden="true"></i> بلیط</button>
                    <button type="button" class="tf-tab" data-tf="service"><i class="bi bi-flower1" aria-hidden="true"></i> خدمات</button>
                    <button type="button" class="tf-tab" data-tf="single"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> تک جلسه</button>
                </div>
                <div class="tf-filterbar" id="tfFilterBar" style="display:none;">
                    <button type="button" class="tf-filterbtn" id="btnTfFilter">
                        <i class="bi bi-funnel-fill"></i>
                        فیلتر رشته‌ها
                        <span class="tf-filtercount" id="tfFilterCount" style="display:none">۰</span>
                    </button>
                    <span class="tf-filterlabel" id="tfFilterLabel">نمایش: همه رشته‌ها</span>
                </div>
                <div class="tf-filterpanel" id="tfFilterPanel" style="display:none;">
                    <div class="tf-fp-head">
                        <span class="fw-bold text-white" style="font-size:.85rem;">انتخاب رشته‌ها</span>
                        <div class="d-flex gap-1">
                            <button type="button" class="tf-fp-link" id="tfSelAll">همه</button>
                            <button type="button" class="tf-fp-link" id="tfSelNone">هیچ‌کدام</button>
                        </div>
                    </div>
                    <div class="tf-fp-list" id="tfFilterList"></div>
                    <button type="button" class="ss-btn w-100 mt-2" id="btnTfApply" style="justify-content:center;">
                        <i class="bi bi-check2"></i> اعمال و بستن
                    </button>
                </div>
                <div id="tarefeList">
                    <div class="text-center py-4" style="color:var(--g-text);">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        در حال بارگذاری...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== ✅ کارت برنامه تمرینی من ========== -->
<a href="/MyProgram" class="mp-entry mb-3">
    <div class="mp-entry-inner">
        <div class="mp-entry-icon">
            <i class="bi bi-clipboard2-pulse-fill"></i>
        </div>
        <div class="mp-entry-info">
            <div class="mp-entry-title">برنامه تمرینی من</div>
            <div class="mp-entry-sub" id="mpEntrySub">برنامه‌های مربی</div>
        </div>
        <div class="mp-entry-right">
            <span class="mp-entry-count" id="myProgramCount" style="display:none">۰</span>
            <i class="bi bi-arrow-left"></i>
        </div>
    </div>
</a>

<!-- ========== ✅ کارت «شروع تمرین» (برنامه تمرینی روز + کمد من) ========== -->
<a href="/Athlete" class="mp-entry mb-3">
    <div class="mp-entry-inner">
        <div class="mp-entry-icon">
            <i class="bi bi-person-arms-up"></i>
        </div>
        <div class="mp-entry-info">
            <div class="mp-entry-title">شروع تمرین</div>
            <div class="mp-entry-sub">قبل از شروع تمرین روی این قسمت کلیک کنید</div>
        </div>
        <div class="mp-entry-right">
            <i class="bi bi-arrow-left"></i>
        </div>
    </div>
</a>

<!-- ========== ✅ کارت «تحلیل بدن» ========== -->
<a href="/BodyAnalysis" class="mp-entry mb-3">
    <div class="mp-entry-inner">
        <div class="mp-entry-icon" style="background:linear-gradient(135deg,var(--g-primary) 0%,var(--g-primary) 100%);">
            <i class="bi bi-clipboard2-data-fill"></i>
        </div>
        <div class="mp-entry-info">
            <div class="mp-entry-title">تحلیل بدن</div>
            <div class="mp-entry-sub">BMI، کالری روزانه، پروتئین و نمودار تغییرات وزن و دور بدن</div>
        </div>
        <div class="mp-entry-right">
            <i class="bi bi-arrow-left"></i>
        </div>
    </div>
</a>

<style>
    /* ===== هدر پروفایل ===== */
    .avatar-circle {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: linear-gradient(135deg,var(--g-primary),var(--g-primary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        overflow: hidden;
        flex: 0 0 auto;
        box-shadow: 0 8px 24px color-mix(in srgb, var(--g-primary) 35%, transparent);
    }

        .avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* ===== ✅ کادر کد عضویت (مثل چیپ‌های وضعیت) ===== */
    .membership-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 14px;
        font-size: .78rem;
        font-weight: 700;
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        color: var(--g-text);
        white-space: nowrap;
    }

        .membership-chip i {
            color: var(--g-primary);
            font-size: .95rem;
        }

    /* ===== ✅ چیپ‌های وضعیت (جایگزین چیپ‌های اعتبار) ===== */
    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .74rem;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

        .status-chip i {
            font-size: .9rem;
        }

    .status-date {
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border-color: color-mix(in srgb, var(--g-primary) 35%, transparent);
        color: var(--g-text);
    }

        .status-date i {
            color: var(--g-primary);
        }

    .status-active {
        background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
        border-color: color-mix(in srgb, var(--g-text) 35%, transparent);
        /* حداقل ۴.۵:۱ روی پس‌زمینهٔ چیپ (WCAG 1.4.3) */
        color: color-mix(in srgb, var(--g-primary) 78%, var(--g-text));
    }

        .status-active i {
            color: var(--g-text);
        }

    .status-remain {
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border-color: color-mix(in srgb, var(--g-primary) 40%, transparent);
        color: var(--g-text);
    }

        .status-remain i {
            color: color-mix(in srgb, var(--g-text) 62%, transparent);
        }

    /* ===== ✅ ساعت آنالوگ شیشه‌ای (تم بنفش-فیروزه‌ای) ===== */
    .dash-clockbox {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .dc-face {
        position: relative;
        width: 118px;
        height: 118px;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 2%, transparent) 62%), color-mix(in srgb, var(--g-text) 70%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        box-shadow: 0 8px 24px color-mix(in srgb, var(--g-text) 35%, transparent), inset 0 0 18px color-mix(in srgb, var(--g-primary) 10%, transparent);
    }
    /* علامت‌های ۱۲/۳/۶/۹ */
    .dc-tick {
        position: absolute;
        background: color-mix(in srgb, var(--g-nested-solid) 40%, transparent);
        border-radius: 2px;
    }

    .dc-t12 {
        top: 5px;
        left: 50%;
        width: 2px;
        height: 9px;
        margin-left: -1px;
    }

    .dc-t6 {
        bottom: 5px;
        left: 50%;
        width: 2px;
        height: 9px;
        margin-left: -1px;
    }

    .dc-t3 {
        right: 5px;
        top: 50%;
        width: 9px;
        height: 2px;
        margin-top: -1px;
    }

    .dc-t9 {
        left: 5px;
        top: 50%;
        width: 9px;
        height: 2px;
        margin-top: -1px;
    }
    /* عقربه‌ها */
    .dc-hand {
        position: absolute;
        left: 50%;
        bottom: 50%;
        transform-origin: 50% 100%;
        border-radius: 4px;
    }

    .dc-hour {
        width: 4px;
        height: 26%;
        margin-left: -2px;
        background: var(--g-surface-solid);
        box-shadow: 0 0 6px color-mix(in srgb, var(--g-surface-solid) 45%, transparent);
        z-index: 2;
    }

    .dc-min {
        width: 3px;
        height: 36%;
        margin-left: -1.5px;
        background: color-mix(in srgb, var(--g-surface-solid) 60%, transparent);
        z-index: 3;
    }

    .dc-sec {
        width: 2px;
        height: 42%;
        margin-left: -1px;
        background: var(--g-surface-solid);
        box-shadow: 0 0 8px color-mix(in srgb, var(--g-text) 55%, transparent);
        z-index: 4;
    }

    .dc-center {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 12px;
        height: 12px;
        margin: -6px 0 0 -6px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--g-primary), var(--g-surface-solid));
        box-shadow: 0 0 10px color-mix(in srgb, var(--g-primary) 80%, transparent);
        z-index: 5;
    }
    /* ===== ✅ باکس زیر ساعت: دیجیتال + تاریخ ===== */
    .dc-infobox {
        background: color-mix(in srgb, var(--g-primary) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
        border-radius: 12px;
        padding: 6px 14px;
        text-align: center;
        min-width: 118px; 
        width: auto; 
        box-shadow: 0 4px 14px color-mix(in srgb, var(--g-primary) 12%, transparent);
    }

    .dc-digitaltime {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--g-text);
        font-variant-numeric: tabular-nums;
        direction: ltr;
        letter-spacing: 1px;
        line-height: 1.2;
    }

    .dc-date {
        font-size: .66rem;
        color: var(--g-text);
        font-weight: 700;
        white-space: nowrap;
        margin-top: 2px;
    }

    @@media (max-width: 576px) {
        .dc-face {
            width: 94px;
            height: 94px;
        }

        .dc-infobox {
            min-width: 94px;
            width: auto;
            padding: 5px 10px;
        }

        .dc-digitaltime {
            font-size: .95rem;
        }

        .dc-date {
            font-size: .56rem;
        }
    }

    /* ===== کارت برنامه تمرینی ===== */
    .mp-entry {
        display: block;
        text-decoration: none;
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, color-mix(in srgb, var(--g-surface-solid) 22%, transparent), color-mix(in srgb, var(--g-primary) 18%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        transition: transform .25s, border-color .25s, box-shadow .25s;
    }

        .mp-entry:hover {
            transform: translateY(-3px);
            border-color: color-mix(in srgb, var(--g-primary) 65%, transparent);
            box-shadow: 0 10px 28px color-mix(in srgb, var(--g-primary) 30%, transparent);
        }

        .mp-entry::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 160px;
            height: 160px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-primary) 25%, transparent), transparent 70%);
            pointer-events: none;
        }

        .mp-entry::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -30px;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-primary) 25%, transparent), transparent 70%);
            pointer-events: none;
        }

    .mp-entry-inner {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
    }

    .mp-entry-icon {
        flex: 0 0 auto;
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--g-text);
        box-shadow: 0 8px 20px color-mix(in srgb, var(--g-primary) 45%, transparent);
    }

    .mp-entry-info {
        flex: 1 1 auto;
        min-width: 0;
    }

    .mp-entry-title {
        font-weight: 800;
        font-size: 1rem;
        color: var(--g-text);
        margin-bottom: 3px;
    }

