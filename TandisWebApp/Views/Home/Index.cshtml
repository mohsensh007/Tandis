<!-- ========== کارت‌های آمار مالی ========== -->
<div class="row g-3 mb-3 home-credit-grid">
    <div class="col-6 col-md-3">
        <div class="card credit-card h-100">
            <div class="purple-style card-body">
                <div class="credit-top">
                    <div class="credit-icon"><i class="bi bi-activity" aria-hidden="true"></i></div>
                    <div class="credit-label">اعتبار ورزشی</div>
                </div>
                <div class="credit-amount">
                    <span class="credit-value" id="statSport">-</span>
                    <span class="credit-unit">ریال</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card credit-card h-100">
            <div class="purple-style card-body">
                <div class="credit-top">
                    <div class="credit-icon"><i class="bi bi-bag-check" aria-hidden="true"></i></div>
                    <div class="credit-label">اعتبار فروشگاه</div>
                </div>
                <div class="credit-amount">
                    <span class="credit-value" id="statBuffet">-</span>
                    <span class="credit-unit">ریال</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card credit-card h-100">
            <div class="purple-style card-body">
                <div class="credit-top">
                    <div class="credit-icon"><i class="bi bi-flower1" aria-hidden="true"></i></div>
                    <div class="credit-label">اعتبار خدمات</div>
                </div>
                <div class="credit-amount">
                    <span class="credit-value" id="statService">-</span>
                    <span class="credit-unit">ریال</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card credit-card h-100">
            <div class="purple-style card-body">
                <div class="credit-top">
                    <div class="credit-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></div>
                    <div class="credit-label" id="debitLabel">بدهی</div>
                </div>
                <div class="credit-amount" id="debitAmountBox">
                    <span class="credit-value" id="statDebit">-</span>
                    <span class="credit-unit">ریال</span>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
