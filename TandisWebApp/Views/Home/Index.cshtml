                            '<div class="tf-row" style="margin-top:8px;">' +
                                '<div></div>' +
                                '<div class="tf-price">' + esc(item.amountDisplay) + '</div>' +
                            '</div>' +
                        '</div>';
                } else if (tab === 'service') {
                    html +=
                        '<div class="tf-card">' +
                            '<div class="tf-title">' + esc(item.serviceDesc) + '</div>' +
                            '<div class="tf-row" style="margin-top:8px;">' +
                                '<div></div>' +
                                '<div class="tf-price">' + esc(item.amountDisplay) + '</div>' +
