@{
    ViewData["Title"] = "ورود و خروج";
}

<!-- ✅ محافظ از له شدن صفحه در موبایل -->
<style>
    #reader img, #reader canvas, #reader video {
        max-width: 100% !important;
        height: auto !important;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">📱 ورود و خروج از باشگاه</h5>
            </div>
            <div class="card-body text-center">

                <!-- ✅ کارت وضعیت فعلی -->
                <div id="statusCard" class="alert alert-secondary" style="display:none">
                    <div id="statusText"></div>
                    <button class="btn btn-danger mt-2" id="btnExit" style="display:none">
                        🚪 ثبت خروج از باشگاه
                    </button>
                </div>

                <!-- ناحیه اسکنر -->
                <div id="reader" style="max-width: 400px; margin: 0 auto;"></div>

                <!-- نتیجه -->
                <div id="result" class="mt-3" style="display:none">
                    <div class="alert" id="resultAlert"></div>
                </div>

                <!-- دکمه‌ها -->
                <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                    <!-- ✅ دوربین خود گوشی (اپ دوربین باز می‌شه) -->
                    <label class="btn btn-success mb-0">
                        <i class="bi bi-camera"></i> عکس با دوربین گوشی
                        <input type="file" id="qrCaptureInput" accept="image/*" capture="environment"
                               style="display:none" onchange="scanFromImage(event)" />
                    </label>

                    <!-- آپلود از گالری -->
                    <label class="btn btn-outline-primary mb-0">
                        <i class="bi bi-image"></i> آپلود از گالری
                        <input type="file" id="qrFileInput" accept="image/*"
                               style="display:none" onchange="scanFromImage(event)" />
                    </label>

                    <!-- اسکن داخل مرورگر (فقط وقتی HTTPS باشه) -->
                    <button class="btn btn-primary" id="startScan" onclick="startScanner()">
                        <i class="bi bi-camera-video"></i> اسکن زنده
                    </button>
                </div>

                <div class="text-muted small mt-3">
                    💡 با دکمه سبز، دوربین خود گوشی باز می‌شه؛ عکس بگیر و برگرد — بقیه‌اش خودکار!
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال تأیید خروج -->
<div class="modal fade" id="confirmExitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تأیید خروج</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                آیا می‌خواهید خروج خود را از باشگاه ثبت کنید؟
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="btnConfirmExit">ثبت خروج</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <script>
        var html5QrcodeScanner;
        var isScanning = false;

        // ========== ✅ اسکن زنده (دوربین داخل مرورگر) ==========
        function startScanner() {
            if (isScanning) return;

            if (typeof Html5Qrcode === 'undefined') {
                showToast('کتابخانه اسکنر لود نشده. صفحه رو رفرش کن.', 'error');
                return;
            }

            isScanning = true;
            html5QrcodeScanner = new Html5Qrcode("reader");

            Html5Qrcode.getCameras().then(function (devices) {
                if (devices && devices.length) {
                    html5QrcodeScanner.start(
                        devices[0].id,
                        { fps: 10, qrbox: { width: 250, height: 250 } },
                        onScanSuccess,
                        function (error) { }
                    ).catch(function (err) {
                        console.error("خطا در شروع اسکنر:", err);
                        showToast('خطا در دسترسی به دوربین. از گزینه عکس استفاده کنید.', 'warning');
                        isScanning = false;
                    });
                } else {
                    showToast('دوربینی یافت نشد. از گزینه عکس استفاده کنید.', 'warning');
                    isScanning = false;
                }
            }).catch(function (err) {
                console.error("خطا در دریافت لیست دوربین‌ها:", err);
                showToast('دسترسی به دوربین ممکن نیست. از گزینه عکس استفاده کنید.', 'warning');
                isScanning = false;
            });

            $('#startScan').html('<i class="bi bi-camera-video"></i> در حال اسکن...');
        }

        // ========== ✅ بارگذاری وضعیت فعلی (داخل/خارج) ==========
        function loadStatus() {
            fetch('/api/Security/OpenTraffic')
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (!res.success) return;
                    var card = document.getElementById('statusCard');
                    var text = document.getElementById('statusText');
                    var btnExit = document.getElementById('btnExit');

                    card.style.display = 'block';
                    if (res.isInside) {
                        var boxTxt = res.boxNo ? ' | 🗄️ کمد: ' + res.boxNo : '';
                        text.innerHTML = '🟢 شما داخل باشگاه هستید.<br>' +
                            '<small>ورود: ' + (res.entryDate || '-') + ' ' + (res.entryTime || '-') + boxTxt + '</small>';
                        card.className = 'alert alert-success';
                        btnExit.style.display = 'inline-block';
                    } else {
                        text.innerHTML = '⚪ شما داخل باشگاه نیستید. برای ورود، QR را اسکن کنید.';
                        card.className = 'alert alert-secondary';
                        btnExit.style.display = 'none';
                    }
                })
                .catch(function () { });
        }

        // ========== ✅ ثبت خروج ==========
        $('#btnExit').click(function () {
            new bootstrap.Modal(document.getElementById('confirmExitModal')).show();
        });

        $('#btnConfirmExit').click(function () {
            bootstrap.Modal.getInstance(document.getElementById('confirmExitModal')).hide();
            showLoading();

            fetch('/api/Security/Exit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                hideLoading();
                showToast(res.message, res.success ? 'success' : 'error');
                loadStatus();
            })
            .catch(function () {
                hideLoading();
                showToast('خطا در ارتباط با سرور', 'error');
            });
        });

        // ========== ✅ تشخیص QR از عکس — چند مرحله‌ای ==========
        var decodeAttempts = [
            { type: 'full', max: 2000 },
            { type: 'full', max: 1200 },
            { type: 'crop', max: 1600 },
            { type: 'full', max: 800 }
        ];

        function scanFromImage(event) {
            var file = event.target.files[0];
            if (!file) return;

            if (typeof jsQR === 'undefined') {
                showToast('کتابخانه تشخیص QR لود نشده. صفحه رو رفرش کن.', 'error');
                event.target.value = '';
                return;
            }

            // ✅ پاک کردن هر اثر قبلی
            document.getElementById('reader').innerHTML = '';

            showLoading();
            var url = URL.createObjectURL(file);
            var img = new Image();
            img.onload = function () { runAttempt(img, 0); };
            img.onerror = function () {
                hideLoading();
                URL.revokeObjectURL(url);
                showToast('فرمت عکس پشتیبانی نمی‌شود.', 'error');
            };
            img.src = url;
            event.target.value = '';
        }

        function runAttempt(img, i) {
            if (i >= decodeAttempts.length) {
                hideLoading();
                showToast('QR Code در عکس پیدا نشد. طوری عکس بگیر که QR بیشتر کادر رو پر کنه.', 'error');
                return;
            }

            var a = decodeAttempts[i];
            var canvas = document.createElement('canvas');
            var ctx = canvas.getContext('2d', { willReadFrequently: true });

            var sx = 0, sy = 0;
            var sw = img.naturalWidth, sh = img.naturalHeight;

            if (a.type === 'crop') {
                sw = Math.round(sw * 0.6);
                sh = Math.round(sh * 0.6);
                sx = Math.round((img.naturalWidth - sw) / 2);
                sy = Math.round((img.naturalHeight - sh) / 2);
            }

            var scale = Math.min(1, a.max / Math.max(sw, sh));
            var dw = Math.max(1, Math.round(sw * scale));
            var dh = Math.max(1, Math.round(sh * scale));
            canvas.width = dw;
            canvas.height = dh;
            ctx.drawImage(img, sx, sy, sw, sh, 0, 0, dw, dh);

            var imageData = ctx.getImageData(0, 0, dw, dh);
            var code = jsQR(imageData.data, dw, dh, { inversionAttempts: 'attemptBoth' });

            if (code && code.data) {
                hideLoading();
                showToast('QR Code شناسایی شد', 'success');
                validateQrCode(code.data);
            } else {
                setTimeout(function () { runAttempt(img, i + 1); }, 0);
            }
        }

        function onScanSuccess(decodedText, decodedResult) {
            if (html5QrcodeScanner) html5QrcodeScanner.stop();
            isScanning = false;
            $('#startScan').html('<i class="bi bi-camera-video"></i> اسکن زنده');
            validateQrCode(decodedText);
        }

        function validateQrCode(qrData) {
            showLoading();

            fetch('/api/Security/ValidateAndEnter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ qrData: qrData })
            })
            .then(function (response) { return response.json(); })
            .then(function (res) {
                hideLoading();
                showResult(res.success, res.message);
                loadStatus();
            })
            .catch(function (err) {
                hideLoading();
                console.error(err);
                showToast('خطا در ارتباط با سرور', 'error');
            });
        }

        function showResult(success, message) {
            var alert = document.getElementById('resultAlert');
            var resultDiv = document.getElementById('result');

            resultDiv.style.display = 'block';
            alert.className = 'alert ' + (success ? 'alert-success' : 'alert-danger');
            alert.textContent = message;

            if (!success) {
                setTimeout(function () {
                    resultDiv.style.display = 'none';
                }, 4000);
            }
        }

        // شروع
        $(function () {
            loadStatus();
        });

        $(window).on('beforeunload', function () {
            if (html5QrcodeScanner && isScanning) {
                html5QrcodeScanner.stop();
            }
        });
    </script>
}