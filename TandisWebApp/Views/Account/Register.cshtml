@{
    ViewData["Title"] = "ثبت‌نام";
    Layout = "_LoginLayout";
}

<style>
   
    #authCard {
        position: relative;
    }

    .reg-steps {
        display: flex;
        align-items: center; /* ✅ هم‌ترازی عمودی با فلش‌های بین مراحل */
        gap: 6px;
        margin-bottom: 16px;
    }

    .reg-step {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center; /* ✅ وسط عمودی */
        justify-content: center;
        text-align: center;
        white-space: nowrap; /* ✅ هیچ‌وقت ۲ خطی نمی‌شه */
        font-size: clamp(.6rem, 2.6vw, .72rem);
        font-weight: 700;
        color: #9fb3c8;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 999px;
        padding: 8px 6px;
        line-height: 1;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .reg-step.on {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: transparent;
            color: #fff;
        }

        .reg-step.done {
            background: linear-gradient(135deg, #38d9a9 0%, #2bbfa0 100%);
            border-color: transparent;
            color: #fff;
        }

    .rules-box {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(102,211,232,.30);
        border-radius: 14px;
        padding: 14px;
        max-height: 260px;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        white-space: pre-wrap;
        font-size: .82rem;
        line-height: 1.9;
        color: #dce9ff;
        margin-bottom: 14px;
    }

        .rules-box::-webkit-scrollbar {
            display: none;
        }

    .reg-title {
        font-weight: 800;
        font-size: .95rem;
        color: #fff;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .reg-title i {
            color: #66d3e8;
        }

    .done-info-box {
        background: rgba(13,110,253,.10);
        border: 1px solid rgba(13,110,253,.30);
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .done-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: .82rem;
        color: #dce9ff;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

        .done-row:last-child {
            border-bottom: none;
        }

        .done-row b {
            font-weight: 800;
            color: #fff;
        }

    .alert-warning-text {
        font-size: .74rem;
        color: #ffa94d;
        padding: 8px;
        background: rgba(255,169,77,.08);
        border: 1px solid rgba(255,169,77,.25);
        border-radius: 8px;
    }

    /* ===== تقویم لمسی ===== */
    .bd-picker {
        position: relative;
        display: flex;
        gap: 6px;
    }

        .bd-picker .form-control {
            flex: 1;
        }

    .bd-cal-btn {
        flex: 0 0 auto;
        width: 46px;
        border-radius: 10px;
        border: 1px solid rgba(102,211,232,.35);
        background: rgba(13,110,253,.12);
        font-size: 1.15rem;
    }

    /* ===== ✅ بک‌دراپ تیره پشت پنل تقویم ===== */
    .bd-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1070;
        background: rgba(6,9,18,.65);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: none;
    }

        .bd-backdrop.show {
            display: block;
            animation: bdFsIn .2s ease;
        }

    /* ===== ✅ پنل تقویم: همیشه وسط صفحه (مودال) ===== */
    .bd-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1075;
        width: min(92vw, 380px);
        background: rgba(20,24,42,.98);
        border: 1px solid rgba(102,211,232,.35);
        border-radius: 16px;
        padding: 14px 10px 12px;
        box-shadow: 0 18px 50px rgba(0,0,0,.55);
        animation: bdPanelIn .25s cubic-bezier(.22,.9,.35,1.15);
    }
    /* ✅ کارت باید relative باشه تا فلش گوشه‌ش بشینه */
    #authCard {
        position: relative;
    }

    /* ✅ فلش بازگشت: گوشه بالا-راست + داخل پررنگ */
    .reg-back-arrow {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 6;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.15rem;
        text-decoration: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: 1px solid rgba(255,255,255,.25);
        box-shadow: 0 4px 14px rgba(118,75,162,.45);
        transition: all .2s;
    }

        .reg-back-arrow:hover {
            filter: brightness(1.12);
            transform: translateY(-1px);
        }

        .reg-back-arrow:active {
            transform: scale(.94);
        }

    /* ✅ فلش بین مراحل */
    .reg-arrow {
        flex: 0 0 auto;
        color: rgba(255,255,255,.20);
        font-size: .8rem;
        transition: all .3s;
    }

        .reg-arrow.lit {
            color: #66d3e8;
            text-shadow: 0 0 10px rgba(102,211,232,.7);
        }

    @@keyframes bdPanelIn {
        from {
            opacity: 0;
            transform: translate(-50%, -46%) scale(.94);
        }

        to {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }
    }

    .bd-tiles {
        display: flex;
        gap: 8px;
    }

    .bd-tile {
        flex: 1;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 14px;
        padding: 12px 6px;
        text-align: center;
        transition: all .2s;
    }

        .bd-tile:active {
            transform: scale(.96);
        }

        .bd-tile:hover {
            border-color: rgba(102,211,232,.5);
        }

    .bd-tile-val {
        display: block;
        font-size: 1.15rem;
        font-weight: 800;
        color: #fff;
    }

    .bd-tile-lbl {
        display: block;
        font-size: .68rem;
        color: #9fb3c8;
        font-weight: 700;
        margin-top: 3px;
    }

    .bd-selected {
        text-align: center;
        margin-top: 10px;
        font-size: .82rem;
        font-weight: 800;
        color: #66d3e8;
        direction: ltr;
    }

    .bd-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
    }

    .bd-ok {
        flex: 1;
        background: linear-gradient(135deg,#667eea,#764ba2);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 9px;
        font-weight: 700;
    }

    .bd-cancel {
        flex: 1;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 10px;
        padding: 9px;
        font-weight: 700;
    }

    /* ===== قوس تمام‌صفحه ===== */
    .bd-fs {
        position: fixed;
        inset: 0;
        z-index: 1080;
        display: none;
        flex-direction: column;
        overflow: hidden;
        background: rgba(6,9,18,.80);
        backdrop-filter: blur(30px) saturate(.8);
        -webkit-backdrop-filter: blur(30px) saturate(.8);
        --arcR: min(350px, 46vh);
    }

        .bd-fs.open {
            display: flex;
            animation: bdFsIn .28s ease;
        }

            .bd-fs.open .bd-fs-head {
                animation: bdFsDown .34s cubic-bezier(.22,.9,.35,1.15);
            }

            .bd-fs.open .bd-fs-arc {
                animation: bdFsZoom .38s cubic-bezier(.22,.9,.35,1.15);
            }

            .bd-fs.open .bd-hint {
                animation: bdFsUp .34s cubic-bezier(.22,.9,.35,1.15);
            }

        .bd-fs.closing {
            animation: bdFsOut .18s ease forwards;
        }

    @@keyframes bdFsIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes bdFsOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    @@keyframes bdFsDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes bdFsUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes bdFsZoom {
        from {
            opacity: 0;
            transform: scale(.86);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .bd-fs-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: calc(12px + env(safe-area-inset-top)) 16px 0;
    }

        .bd-fs-head .bd-back, .bd-fs-head .bd-done {
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.22);
            color: #fff;
            padding: 10px 18px;
            font-size: .88rem;
            font-weight: 700;
            border-radius: 12px;
        }

        .bd-fs-head .bd-s2-title {
            font-weight: 800;
            color: #66d3e8;
            font-size: 1.05rem;
        }

    .bd-fs-arc {
        flex: 1;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bd-fs .arc-wrap {
        height: calc(var(--arcR) - 10px);
        width: 100%;
        max-width: 560px;
    }

    .bd-fs .arc-pivot {
        bottom: -40px;
    }

    .bd-fs .arc-it {
        height: var(--arcR);
        width: 96px;
        margin-left: -48px;
    }

        .bd-fs .arc-it b {
            font-size: 1.1rem;
        }

        .bd-fs .arc-it.on b {
            font-size: clamp(1.7rem, 6.5vh, 2.4rem);
        }

    .bd-fs .arc-marker {
        top: 6px;
        width: 84px;
        margin-left: -42px;
        height: 5px;
    }

    .bd-fs .bd-hint {
        text-align: center;
        font-size: .72rem;
        color: #8fa6c4;
        padding-bottom: calc(14px + env(safe-area-inset-bottom));
    }

    .arc-wrap {
        position: relative;
        height: 205px;
        overflow: hidden;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        cursor: grab;
    }

    .arc-pivot {
        position: absolute;
        left: 50%;
        bottom: -60px;
        width: 0;
        height: 0;
    }

    .arc-it {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 70px;
        margin-left: -35px;
        height: 240px;
        transform-origin: 50% 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        will-change: transform, opacity;
        cursor: pointer;
        opacity: 0;
    }

        .arc-it b {
            display: block;
            font-size: .95rem;
            font-weight: 700;
            color: #7d92b0;
            transition: color .15s, font-size .15s;
        }

        .arc-it.on b {
            color: #fff;
            font-size: 1.6rem;
            font-weight: 800;
            text-shadow: 0 0 18px rgba(102,211,232,.65);
        }

    .arc-marker {
        position: absolute;
        top: 4px;
        left: 50%;
        width: 60px;
        height: 4px;
        margin-left: -30px;
        border-radius: 2px;
        background: linear-gradient(90deg, #66d3e8, #667eea);
        box-shadow: 0 0 12px rgba(102,211,232,.7);
        pointer-events: none;
        z-index: 5;
    }

    .bd-hint {
        text-align: center;
        font-size: .66rem;
        color: #6d82a0;
        margin-top: 2px;
    }

    /* ===== باکس وضعیت چهره ===== */
    .face-status-box {
        background: rgba(255,169,77,.08);
        border: 1px solid rgba(255,169,77,.30);
        border-radius: 14px;
        padding: 16px;
        margin: 14px 0 8px;
        text-align: center;
        transition: all .4s;
    }

        .face-status-box.done {
            background: rgba(106,234,162,.10);
            border-color: rgba(106,234,162,.35);
        }

        .face-status-box.existed {
            background: rgba(102,211,232,.08);
            border-color: rgba(102,211,232,.35);
        }

        .face-status-box.timeout {
            background: rgba(255,107,129,.08);
            border-color: rgba(255,107,129,.35);
        }

    .face-icon-pending {
        font-size: 2.5rem;
        color: #ffa94d;
        margin-bottom: 8px;
        animation: pulse 1.6s ease-in-out infinite;
    }

    .face-status-box.done .face-icon-pending, .face-status-box.existed .face-icon-pending, .face-status-box.timeout .face-icon-pending {
        animation: none;
    }

    .face-status-box.done .face-icon-pending {
        color: #6aeaa2;
    }

    .face-status-box.existed .face-icon-pending {
        color: #66d3e8;
    }

    .face-status-box.timeout .face-icon-pending {
        color: #ff6b81;
    }

    .face-status-text {
        font-size: .88rem;
        font-weight: 700;
        color: #ffa94d;
        margin-bottom: 4px;
    }

    .face-status-box.done .face-status-text {
        color: #6aeaa2;
    }

    .face-status-box.existed .face-status-text {
        color: #66d3e8;
    }

    .face-status-box.timeout .face-status-text {
        color: #ff6b81;
    }

    .face-hint {
        font-size: .72rem;
        color: #9fb3c8;
        margin-bottom: 6px;
    }

    .face-device-info {
        font-size: .66rem;
        color: #6d82a0;
        margin-top: 4px;
    }

    .face-timer {
        font-size: .68rem;
        color: #ffa94d;
        margin-top: 4px;
        font-variant-numeric: tabular-nums;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.08);
            opacity: .7;
        }
    }
</style>

<div>
    
    <!-- ✅ نشانگر مراحل -->
    <div class="reg-steps">
        <span class="reg-step on" id="stepBadge1">۱. شرایط باشگاه</span>
        <i class="bi bi-arrow-left reg-arrow" id="regArrow1"></i>
        <span class="reg-step" id="stepBadge2">۲. اطلاعات شخصی</span>
        <i class="bi bi-arrow-left reg-arrow" id="regArrow2"></i>
        <span class="reg-step" id="stepBadge3">۳. ثبت چهره</span>
    </div>

    <!-- ========== مرحله ۱ ========== -->
    <div id="stepRules">
        <div class="reg-title"><i class="bi bi-shield-check"></i> شرایط و تعهدات باشگاه</div>
        <div class="rules-box" id="rulesBox">در حال بارگذاری...</div>
        <button id="btnAcceptRules" class="btn btn-primary w-100 py-2" disabled>
            <i class="bi bi-check2-circle"></i> شرایط را می‌پذیرم و ادامه می‌دهم
        </button>
    </div>

    <!-- ========== مرحله ۲ ========== -->
    <div id="stepInfo" style="display:none;">
        <div class="reg-title"><i class="bi bi-person-vcard"></i> اطلاعات شخصی</div>
        <div class="mb-2">
            <label class="form-label">نام <span class="text-danger">*</span></label>
            <input type="text" id="txtFirstName" class="form-control" placeholder="نام" />
        </div>
        <div class="mb-2">
            <label class="form-label">نام خانوادگی <span class="text-danger">*</span></label>
            <input type="text" id="txtLastName" class="form-control" placeholder="نام خانوادگی" />
        </div>
        <div class="mb-2">
            <label class="form-label">کد ملی <span class="text-danger">*</span></label>
            <input type="text" id="txtRegNationalCode" class="form-control" maxlength="10" placeholder="کد ملی ۱۰ رقم" inputmode="numeric" />
        </div>
        <div class="mb-2">
            <label class="form-label">تاریخ تولد (شمسی) <span class="text-danger">*</span></label>
            <div class="bd-picker">
                <input type="text" id="txtBirthDate" class="form-control" maxlength="10" placeholder="مثال: 1368/04/12" inputmode="numeric" />
                <button type="button" class="bd-cal-btn" id="btnBirthCal" title="انتخاب تاریخ">📅</button>
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label">شماره موبایل <span class="text-danger">*</span></label>
            <input type="text" id="txtMobile" class="form-control" maxlength="11" placeholder="مثال: 09123456789" inputmode="numeric" />
        </div>
        <div class="mb-3">
            <label class="form-label">جنسیت <span class="text-danger">*</span></label>
            <div class="d-flex gap-3">
                <label class="d-flex align-items-center gap-2" style="cursor:pointer; color:#dce9ff;"><input type="radio" name="gender" value="true" checked /> <span>آقا</span></label>
                <label class="d-flex align-items-center gap-2" style="cursor:pointer; color:#dce9ff;"><input type="radio" name="gender" value="false" /> <span>خانم</span></label>
            </div>
        </div>
        <button id="btnNextStep" class="btn btn-primary w-100 py-2">مرحله بعد <i class="bi bi-arrow-left"></i></button>
        <button id="btnBackToRules" class="btn btn-outline-secondary w-100 py-2 mt-2"><i class="bi bi-arrow-right"></i> بازگشت</button>
    </div>

    <!-- ========== ✅ پنل تقویم + بک‌دراپ (با JS به body منتقل می‌شن) ========== -->
    <div class="bd-backdrop" id="bdBackdrop"></div>
    <div class="bd-panel" id="bdPanel" style="display:none;">
        <div class="bd-stage" id="bdStage1">
            <div class="bd-tiles">
                <button type="button" class="bd-tile" data-unit="day"><span class="bd-tile-val" id="bdTileDay">15</span><span class="bd-tile-lbl">روز</span></button>
                <button type="button" class="bd-tile" data-unit="month"><span class="bd-tile-val" id="bdTileMonth">مرداد</span><span class="bd-tile-lbl">ماه</span></button>
                <button type="button" class="bd-tile" data-unit="year"><span class="bd-tile-val" id="bdTileYear">1368</span><span class="bd-tile-lbl">سال</span></button>
            </div>
            <div class="bd-selected" id="bdSelected">-</div>
            <div class="bd-actions">
                <button type="button" class="bd-ok" id="bdOk">تأیید</button>
                <button type="button" class="bd-cancel" id="bdCancel">انصراف</button>
            </div>
        </div>
    </div>

    <!-- ========== قوس تمام‌صفحه ========== -->
    <div class="bd-fs" id="bdStage2">
        <div class="bd-fs-head">
            <button type="button" class="bd-back" id="bdBack">→ بازگشت</button>
            <span class="bd-s2-title" id="bdS2Title">ماه</span>
            <button type="button" class="bd-done" id="bdDone">✓ تأیید</button>
        </div>
        <div class="bd-fs-arc">
            <div class="arc-wrap" id="arcWrap">
                <div class="arc-pivot" id="arcPivot"></div>
                <div class="arc-marker"></div>
            </div>
        </div>
        <div class="bd-hint">با انگشت بکشید ← → یا روی عدد بزنید</div>
    </div>

    <!-- ========== مرحله ۳ ========== -->
    <div id="stepDone" style="display:none;" class="text-center py-3">
        <div style="font-size:3rem; color:#6aeaa2;">✅</div>
        <div class="fw-bold text-white mb-2" style="font-size:1.1rem;">ثبت‌نام با موفقیت انجام شد</div>
        <div class="mb-3 small" style="color:#9fb3c8;">اطلاعات ورود شما:</div>
        <div class="done-info-box">
            <div class="done-row"><span>کد عضویت:</span><b id="doneMemberID">-</b></div>
            <div class="done-row"><span>نام کاربری:</span><b id="doneNationalCode">-</b></div>
            <div class="done-row"><span>رمز عبور اولیه:</span><b id="donePassword" style="color:#ffa94d;">-</b></div>
        </div>

        <!-- ✅ دکمه ثبت چهره (دستی) -->
        <button id="btnSendFace" class="btn btn-primary w-100 py-2 mt-2">
            <i class="bi bi-camera-fill"></i> ثبت چهره با دستگاه
        </button>

        <!-- ✅ باکس وضعیت چهره -->
        <div id="faceStatusBox" class="face-status-box" style="display:none;">
            <div class="face-icon-pending" id="faceIcon"><i class="bi bi-hourglass-split"></i></div>
            <div class="face-status-text" id="faceStatusText"></div>
            <div class="face-hint" id="faceHint"></div>
            <div class="face-device-info" id="faceDeviceInfo"></div>
            <div class="face-timer" id="faceTimer"></div>
        </div>

        <div class="alert-warning-text mt-2">⚠️ در اولین ورود، <b>مجبور به تغییر رمز عبور</b> خواهید بود.</div>

        <!-- ✅ دکمه ورود — فقط بعد از ثبت چهره -->
        <a id="btnGoLogin" href="/Account/Login" class="btn btn-primary w-100 py-2 mt-3" style="display:none;">
            <i class="bi bi-box-arrow-in-right"></i> ورود به حساب
        </a>
    </div>
</div> <!-- /authCard -->
@section Scripts {
    <script>
        var faDigits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
        function toFa(n) { return String(n).replace(/[0-9]/g, function (d) { return faDigits[d]; }); }
        function isValidNationalCode(code) { return /^\d{10}$/.test(code); }
        function isValidJalali(d) {
            var m = /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(d);
            if (!m) return false;
            var mm = +m[2], dd = +m[3];
            if (mm < 1 || mm > 12) return false;
            if (dd < 1 || dd > 31) return false;
            if (mm > 6 && dd > 30) return false;
            return true;
        }

        // ========== مرحله ۱ ==========
        apiCall('/api/Account/ClubRules', 'GET', null, function (res) {
            var text = (res && res.success && res.data) ? res.data : '';
            $('#rulesBox').text(text || 'شرایطی از سمت باشگاه ثبت نشده است.');
            $('#btnAcceptRules').prop('disabled', false);
        });
                $('#btnAcceptRules').click(function () {
            $('#stepRules').hide(); $('#stepInfo').show();
            $('#stepBadge1').removeClass('on').addClass('done');
            $('#stepBadge2').addClass('on');
            $('#regArrow1').addClass('lit');      // ✅ فلش ۱→۲ روشن
        });
                $('#btnBackToRules').click(function () {
            $('#stepInfo').hide(); $('#stepRules').show();
            $('#stepBadge2').removeClass('on');
            $('#stepBadge1').removeClass('done').addClass('on');
            $('#regArrow1').removeClass('lit');   // ✅ فلش خاموش
        });

                // ========== مرحله ۲ ==========
        $('#btnNextStep').click(function () {
            var fn = $.trim($('#txtFirstName').val());
            var ln = $.trim($('#txtLastName').val());
            var nc = $.trim($('#txtRegNationalCode').val());
            var bd = $.trim($('#txtBirthDate').val());
            var mb = $.trim($('#txtMobile').val());
            var gender = $('input[name="gender"]:checked').val() === 'true';

            if (!fn) { showToast('نام را وارد کنید', 'error'); return; }
            if (!ln) { showToast('نام خانوادگی را وارد کنید', 'error'); return; }
            if (!isValidNationalCode(nc)) { showToast('کد ملی معتبر نیست', 'error'); return; }
            if (!isValidJalali(bd)) { showToast('تاریخ تولد را به صورت 1375/04/12 وارد کنید', 'error'); return; }
            if (!/^09\d{9}$/.test(mb)) { showToast('شماره موبایل باید با 09 شروع و ۱۱ رقم باشد', 'error'); return; }

            var $btn = $('#btnNextStep');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> در حال ثبت...');

            apiCall('/api/Account/Register', 'POST', { firstName: fn, lastName: ln, nationalCode: nc, birthDate: bd, mobile: mb, gender: gender }, function (res) {
                if (res.success) {
                    registeredMemberID = res.data.memberID;
                    $('#doneMemberID').text(toFa(res.data.memberID));
                    $('#doneNationalCode').text(res.data.nationalCode);
                    $('#donePassword').text(res.data.defaultPassword);
                    $('#stepInfo').hide();
                    $('#stepDone').show();
                    $('#stepBadge2').removeClass('on').addClass('done');
                    $('#stepBadge3').addClass('on');
                    $('#regArrow2').addClass('lit');
                    $('#regBackArrow').hide();   // ✅ فلش بازگشت مخفی
                     sessionStorage.setItem('regDone', JSON.stringify({
                        memberID: res.data.memberID,
                        nationalCode: res.data.nationalCode,
                        password: res.data.defaultPassword
                    }));
                    showToast('ثبت‌نام با موفقیت انجام شد', 'success');
                } else {
                    showToast(res.message, 'error');
                    $btn.prop('disabled', false).html('مرحله بعد <i class="bi bi-arrow-left"></i>');
                }
            });
        });

        // ========== ✅ مرحله ۳: ثبت چهره (دستی + مهلت ۲۰ ثانیه) ==========
        var registeredMemberID = 0;
        var facePollTimer = null, faceTimerInterval = null;
        var faceDeadline = 0, faceDone = false;
        var FACE_TIMEOUT_MS = 20000;

        function stopFacePoll() {
            if (facePollTimer) { clearInterval(facePollTimer); facePollTimer = null; }
            if (faceTimerInterval) { clearInterval(faceTimerInterval); faceTimerInterval = null; }
        }
        function setFaceBox(state, icon, text, hint, deviceInfo) {
            $('#faceStatusBox').show().removeClass('done existed timeout').addClass(state);
            $('#faceIcon').html('<i class="bi ' + icon + '"></i>');
            $('#faceStatusText').text(text);
            $('#faceHint').text(hint || '');
            $('#faceDeviceInfo').html(deviceInfo || '');
        }
        function startFaceTimer() {
            $('#faceTimer').show();
            faceTimerInterval = setInterval(function () {
                var remain = Math.max(0, Math.ceil((faceDeadline - Date.now()) / 1000));
                $('#faceTimer').text('زمان باقی‌مانده: ' + toFa(remain) + ' ثانیه');
                if (remain <= 0) { clearInterval(faceTimerInterval); faceTimerInterval = null; }
            }, 1000);
        }
        function faceSuccess(hadBefore) {
            faceDone = true;
            stopFacePoll();
            $('#btnSendFace').hide();
            setFaceBox(hadBefore ? 'existed' : 'done', 'bi-check-circle-fill',
                hadBefore ? 'چهره قبلاً ثبت شده بود' : 'چهره با موفقیت ثبت شد',
                'اکنون می‌توانید وارد حساب خود شوید');
            $('#faceTimer').hide();
            $('#btnGoLogin').show();
            showToast('چهره با موفقیت ثبت شد', 'success');
        }
        function showSendFaceBtn() {
            $('#btnSendFace').prop('disabled', false)
                .html('<i class="bi bi-camera-fill"></i> ثبت چهره با دستگاه');
        }
        function sendFaceCommand() {
            faceDone = false;
            $('#btnGoLogin').hide();
            $('#btnSendFace').prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm"></span> در حال ارسال...');
            setFaceBox('', 'bi-hourglass-split', 'در حال ارسال دستور به دستگاه...', 'لطفاً صبر کنید');

            apiCall('/api/Face/Send?memberID=' + registeredMemberID, 'POST', {}, function (res) {
                if (res.data && res.data.hadFaceBefore) { faceSuccess(true); return; }

                if (!res.success) {
                    stopFacePoll();
                    setFaceBox('timeout', 'bi-exclamation-triangle-fill', 'ارسال دستور با خطا مواجه شد', res.message || 'دوباره تلاش کنید');
                    $('#faceTimer').hide();
                    showSendFaceBtn();
                    showToast(res.message, 'error');
                    return;
                }

                faceDeadline = Date.now() + FACE_TIMEOUT_MS;
                var devInfo = '';
                if (res.data) {
                    devInfo = 'دستگاه: ' + (res.data.deviceIp || '-') + ' | پورت: ' + (res.data.devicePort || '-');
                    if (res.data.deviceReachable === false)
                        devInfo += '<br><span style="color:#ffa94d;">⚠️ دستگاه در شبکه پاسخ نمی‌دهد</span>';
                }
                setFaceBox('', 'bi-person-bounding-box', 'دستور ارسال شد — مقابل دستگاه بایستید', 'چهره شما به‌صورت خودکار ثبت می‌شود', devInfo);
                startFaceTimer();
                showToast('دستور ثبت چهره ارسال شد', 'success');
                facePollTimer = setInterval(checkFaceStatus, 2000);
                setTimeout(checkFaceStatus, 1000);
            });
        }
        function checkFaceStatus() {
            if (faceDone) { stopFacePoll(); return; }

            if (Date.now() > faceDeadline) {
                faceDone = true;
                stopFacePoll();
                setFaceBox('timeout', 'bi-exclamation-triangle-fill', 'چهره در ۲۰ ثانیه ثبت نشد', 'دکمه ثبت چهره را دوباره بزنید');
                $('#faceTimer').hide();
                showSendFaceBtn();
                showToast('مهلت ثبت چهره تمام شد؛ دوباره تلاش کنید', 'warning');
                return;
            }

            apiCall('/api/Face/Status?memberID=' + registeredMemberID, 'GET', null, function (res) {
                if (!res.success || !res.data) return;
                if (res.data.hasFace) { faceSuccess(false); return; }
                $('#faceHint').text(res.data.commandPending
                    ? 'در انتظار سرویس تردد... مقابل دستگاه بایستید'
                    : 'لطفاً مقابل دستگاه بایستید تا چهره ثبت شود');
            });
        }
        $('#btnSendFace').click(function () {
            if (!registeredMemberID) { showToast('ابتدا ثبت‌نام را انجام دهید', 'error'); return; }
            sendFaceCommand();
        });
                $('#btnGoLogin').on('click', function () {
            sessionStorage.removeItem('regDone');
        });
                // ✅✅ اگه کاربر مرحله ۳ رو refresh کرد، همون‌جا بمونه
        (function restoreStep3() {
            var raw = sessionStorage.getItem('regDone');
            if (!raw) return;
            var d; try { d = JSON.parse(raw); } catch (e) { return; }
            if (!d || !d.memberID) return;

            registeredMemberID = d.memberID;
            $('#doneMemberID').text(toFa(d.memberID));
            $('#doneNationalCode').text(d.nationalCode || '-');
            $('#donePassword').text(d.password || '-');
            $('#stepRules').hide(); $('#stepInfo').hide(); $('#stepDone').show();
            $('#stepBadge1').removeClass('on').addClass('done');
            $('#stepBadge2').removeClass('on').addClass('done');
            $('#stepBadge3').addClass('on');
            $('#regArrow1').addClass('lit'); $('#regArrow2').addClass('lit');
            $('#regBackArrow').hide();

            // وضعیت چهره رو هم چک کن
            apiCall('/api/Face/Status?memberID=' + d.memberID, 'GET', null, function (res2) {
                if (res2 && res2.success && res2.data && res2.data.hasFace) { faceSuccess(true); }
                else {
                    setFaceBox('', 'bi-person-bounding-box', 'در انتظار ثبت چهره', 'دکمه ثبت چهره را بزنید و مقابل دستگاه بایستید');
                    showSendFaceBtn();
                }
            });
        })();

        // ========== ✅ تقویم لمسی (پنل وسط صفحه) ==========
        (function () {
            function faToEn(s) { return String(s).replace(/[۰-۹]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d); }); }
            var curJY = parseInt(faToEn(new Date().toLocaleDateString('fa-IR', { year: 'numeric' })));
            var monthNames = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
            function pad2(x) { x = +x; return (x < 10 ? '0' : '') + x; }
            function maxDay(m) { return m <= 6 ? 31 : (m <= 11 ? 30 : 29); }
            var sel = { day: 15, month: 5, year: 1368 };
            function refreshTiles() {
                $('#bdTileDay').text(String(sel.day));
                $('#bdTileMonth').text(monthNames[sel.month - 1]);
                $('#bdTileYear').text(String(sel.year));
                $('#bdSelected').text(sel.year + '/' + pad2(sel.month) + '/' + pad2(sel.day));
            }

            // ✅ انتقال پنل و بک‌دراپ به body (تا fixed درست کار کنه)
            $('#bdBackdrop').appendTo(document.body);
            $('#bdPanel').appendTo(document.body);
            $('#bdStage2').appendTo(document.body);

            function openBdPanel() {
                refreshTiles();
                $('#bdBackdrop').addClass('show');
                $('#bdPanel').show();
            }
            function closeBdPanel() {
                $('#bdBackdrop').removeClass('show');
                $('#bdPanel').hide();
            }

            var STEP = 14, PXI = 60;
            var arc = { unit: null, items: [], pos: 0, idx: -1, raf: 0, dragging: false };
            var $wrap = $('#arcWrap'), $pivot = $('#arcPivot');
            function itemsFor(unit) {
                if (unit === 'year') { var a = []; for (var y = 1300; y <= curJY + 1; y++) a.push(String(y)); return a; }
                if (unit === 'month') return monthNames.slice();
                var arr = []; for (var d = 1; d <= maxDay(sel.month); d++) arr.push(String(d)); return arr;
            }
            function clampPos(p) { return Math.min(Math.max(p, 0), arc.items.length - 1); }
            function buildArc(unit) {
                arc.unit = unit; arc.items = itemsFor(unit);
                var html = '';
                for (var i = 0; i < arc.items.length; i++) html += '<span class="arc-it"><b>' + arc.items[i] + '</b></span>';
                $pivot.html(html);
                arc.idx = -1;
                arc.lastLo = undefined; arc.lastHi = undefined;
                arc.pos = clampPos(unit === 'year' ? arc.items.indexOf(String(sel.year)) : unit === 'month' ? sel.month - 1 : sel.day - 1);
                stopAnim(); paintArc(true);
            }
             function paintArc(force) {
                var n = arc.items.length;
                var lo = Math.max(0, Math.floor(arc.pos) - 4);
                var hi = Math.min(n - 1, Math.ceil(arc.pos) + 4);
                var $its = $pivot.children();

                // ✅ پاک‌کردن «اعداد شبح» پنجره قبلی که بیرون پنجره جدید موندن
                if (arc.lastLo !== undefined) {
                    for (var g = arc.lastLo; g <= arc.lastHi; g++) {
                        if (g < lo || g > hi) $its.eq(g).css({ opacity: 0 });
                    }
                }

                for (var i = lo; i <= hi; i++) {
                    var rel = i - arc.pos, theta = rel * STEP;
                    var op = Math.max(0, 1 - Math.abs(rel) * 0.28);
                    var $it = $its.eq(i);
                    $it.css({ transform: 'rotate(' + theta + 'deg)', opacity: op });
                    $it.children('b').css('transform', 'rotate(' + (-theta) + 'deg)');
                }
                arc.lastLo = lo; arc.lastHi = hi;

                var ci = clampPos(Math.round(arc.pos));
                if (force || ci !== arc.idx) { arc.idx = ci; $its.removeClass('on').eq(ci).addClass('on'); commitIdx(); }
            }
            function commitIdx() {
                var v = arc.items[arc.idx];
                if (arc.unit === 'year') sel.year = +v;
                else if (arc.unit === 'month') { sel.month = arc.idx + 1; if (sel.day > maxDay(sel.month)) sel.day = maxDay(sel.month); }
                else sel.day = +v;
                refreshTiles();
            }
            function stopAnim() { if (arc.raf) { cancelAnimationFrame(arc.raf); arc.raf = 0; } }
            var startX = 0, basePos = 0, lastX = 0, lastT = 0, vel = 0, movedFar = false;
            function onDown(x) { stopAnim(); arc.dragging = true; movedFar = false; startX = x; basePos = arc.pos; lastX = x; lastT = performance.now(); vel = 0; $wrap.css('cursor', 'grabbing'); }
            function onMove(x) {
                if (!arc.dragging) return;
                if (Math.abs(x - startX) > 8) movedFar = true;
                var p = basePos - (x - startX) / PXI;
                var maxP = arc.items.length - 1;
                if (p < 0) p = p * 0.35;
                if (p > maxP) p = maxP + (p - maxP) * 0.35;
                arc.pos = p;
                var now = performance.now(), dt = now - lastT;
                if (dt > 0) vel = 0.8 * vel + 0.2 * (-(x - lastX) / PXI / dt);
                lastX = x; lastT = now;
                paintArc();
            }
            function onUp() {
                if (!arc.dragging) return;
                arc.dragging = false; $wrap.css('cursor', 'grab');
                var v = vel * 16;
                function frame() {
                    if (Math.abs(v) > 0.004) {
                        arc.pos += v; v *= 0.94;
                        if (arc.pos < 0) { arc.pos = 0; v = 0; }
                        if (arc.pos > arc.items.length - 1) { arc.pos = arc.items.length - 1; v = 0; }
                        paintArc(); arc.raf = requestAnimationFrame(frame);
                    } else snap();
                }
                arc.raf = requestAnimationFrame(frame);
            }
            function snap(target) {
                var t = (target == null) ? clampPos(Math.round(arc.pos)) : target;
                var from = arc.pos, t0 = performance.now(), dur = 280;
                function ease(x) { return 1 - Math.pow(1 - x, 3); }
                function frame() {
                    var k = Math.min(1, (performance.now() - t0) / dur);
                    arc.pos = from + (t - from) * ease(k);
                    paintArc();
                    if (k < 1) arc.raf = requestAnimationFrame(frame); else arc.raf = 0;
                }
                arc.raf = requestAnimationFrame(frame);
            }
            $wrap.on('touchstart', function (e) { onDown(e.originalEvent.touches[0].clientX); });
            $wrap.on('touchmove', function (e) { e.preventDefault(); onMove(e.originalEvent.touches[0].clientX); });
            $wrap.on('touchend touchcancel', onUp);
            $wrap.on('mousedown', function (e) { e.preventDefault(); onDown(e.clientX); });
            $(document).on('mousemove.bdarc', function (e) { onMove(e.clientX); });
            $(document).on('mouseup.bdarc', onUp);
            $(document).on('click', '.arc-it', function () { if (movedFar) return; snap($pivot.children().index(this)); });

            function openUnit(unit) {
                $('#bdS2Title').text(unit === 'year' ? 'سال' : (unit === 'month' ? 'ماه' : 'روز'));
                buildArc(unit);
                closeBdPanel();
                $('#bdStage2').addClass('open');
            }
            function backToTiles() {
                commitIdx();
                var $fs = $('#bdStage2');
                $fs.addClass('closing');
                setTimeout(function () {
                    $fs.removeClass('open closing');
                    openBdPanel();   // ✅ پنل + بک‌دراپ با هم برمی‌گردن
                }, 180);
            }

            $(document).on('click', '.bd-tile', function () { openUnit($(this).data('unit')); });
            $(document).on('click', '#bdBack, #bdDone', backToTiles);
            $(document).on('click', '#btnBirthCal', function (e) {
                e.stopPropagation();
                if ($('#bdPanel').is(':visible')) closeBdPanel(); else openBdPanel();
            });
            $(document).on('click', '#bdCancel', closeBdPanel);
            $(document).on('click', '#bdBackdrop', closeBdPanel);
            $(document).on('click', '#bdOk', function () {
                $('#txtBirthDate').val(sel.year + '/' + pad2(sel.month) + '/' + pad2(sel.day));
                closeBdPanel();
            });

            refreshTiles();
        })();
    </script>
}