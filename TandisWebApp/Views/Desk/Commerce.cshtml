@using TandisWebApp.Services
@{
    Layout = null;
    var deskUser = ViewData["DeskUser"]?.ToString() ?? "کاربر";
    var clubName = ViewData["ClubName"]?.ToString() ?? "باشگاه";
    var kind = ViewData["Kind"]?.ToString() ?? "shop";
    var member = ViewData["MemberCard"] as DeskMemberDto;

    var isService = kind == "services";
    var isBuffet = kind == "buffet";
    var title = isService ? "خدمات" : (isBuffet ? "بوفه" : "فروشگاه");
    var icon = isService ? "bi-spa" : (isBuffet ? "bi-cup-hot" : "bi-bag-heart");
    var backUrl = "/Desk";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#EFF6FF" />
    <title>@title | میز خدمت @clubName</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('tandis-theme');
                if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luna.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member-commerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-arctic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-glass.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; font-family: inherit; }
        .dk-commerce-head {
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            flex-wrap: wrap; max-width: 1240px; margin: 0 auto; padding: 16px 12px 0;
        }
        .dk-back {
            display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
            white-space: nowrap; line-height: 1.5; flex: 0 0 auto;
            padding: 9px 16px; border-radius: 999px; font-size: .82rem; font-weight: 700;
        }
        .dk-commerce-title {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 1.05rem; font-weight: 800;
        }
        .dk-open-strip {
            max-width: 1240px; margin: 10px auto 0; padding: 0 12px;
        }
        .dk-open-inner {
            display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
            padding: 11px 16px; border-radius: 18px; font-size: .8rem; line-height: 1.9;
        }
        .dk-open-inner b { font-size: .85rem; }
        .dk-member-inner {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            flex-wrap: wrap; padding: 12px 16px; border-radius: 18px;
        }
        .dk-member-inner b { font-size: .95rem; }
        .dk-member-inner span { font-size: .74rem; display: block; }
        .dk-credits { display: flex; gap: 8px; flex-wrap: wrap; }
        .dk-credits em {
            font-style: normal; font-size: .7rem; padding: 4px 10px; border-radius: 999px;
        }
        .dk-pay-modal {
            position: fixed; inset: 0; z-index: 1080; display: none;
            align-items: center; justify-content: center; padding: 16px;
        }
        .dk-pay-modal.open { display: flex; }
        .dk-pay-box {
            width: 100%; max-width: 430px; padding: 22px; border-radius: 24px;
            max-height: 94vh; overflow-y: auto;
        }
        .dk-pay-box h2 { font-size: .98rem; font-weight: 800; margin-bottom: 4px; }
        .dk-pay-amount { font-size: 1.45rem; font-weight: 800; margin: 6px 0 6px; }
        .dk-pay-help { font-size: .74rem; line-height: 1.9; margin-bottom: 14px; }
        .dk-field { margin-bottom: 10px; }
        .dk-field label { display: block; font-size: .74rem; font-weight: 700; margin-bottom: 5px; }
        .dk-field .form-control {
            width: 100%; border-radius: 12px; padding: 11px 13px; font-size: .9rem;
        }
        .dk-field-row { display: flex; gap: 8px; }
        .dk-field-row .dk-field { flex: 1 1 0; min-width: 0; }
        .dk-pay-btn {
            width: 100%; padding: 13px; border-radius: 16px; margin-top: 8px;
            font-size: .9rem; font-weight: 800; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        }
        .dk-pay-btn:disabled { opacity: .55; cursor: default; }
        .dk-pay-note { font-size: .74rem; margin-top: 10px; line-height: 1.9; min-height: 18px; }
        .dk-toast {
            position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%);
            z-index: 1200; max-width: 92vw; padding: 12px 20px; border-radius: 16px;
            font-size: .82rem; font-weight: 700; display: none;
        }
        .dk-toast.show { display: block; }
        @@media (max-width: 720px) {
            .dk-commerce-head { padding: 12px 10px 0; }
            .dk-field-row { flex-direction: column; }
        }
    </style>
</head>
<body class="member-ui">
    <div class="dk-commerce-head">
        <div class="dk-commerce-title">
            <i class="bi @icon"></i>
            <span>@title — میز خدمت</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="تغییر حالت روشن و تاریک">
                <i class="bi bi-sun-fill" aria-hidden="true"></i>
            </button>
            <span class="dk-credits"><em><i class="bi bi-person-badge"></i> @deskUser</em></span>
            <a class="dk-back" href="@backUrl"><i class="bi bi-arrow-right"></i> بازگشت به میز خدمت</a>
        </div>
    </div>

    @if (member != null)
    {
        <div class="dk-open-strip">
            <div class="dk-member-inner glass-surface">
                <div>
                    <b>@member.FullName</b>
                    <span>کد ملی @member.NationalCode</span>
                </div>
                <div class="dk-credits">
                    <em>فروشگاه: @member.ShopCredit.ToString("N0")</em>
                    <em>خدمات: @member.ServiceCredit.ToString("N0")</em>
                    <em>ورزشی: @member.SportCredit.ToString("N0")</em>
                </div>
                <a class="dk-back" href="@backUrl/@(kind == "buffet" ? "Buffet" : kind == "services" ? "Services" : "Shop")">
                    <i class="bi bi-arrow-repeat"></i> تغییر عضو
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="dk-open-strip">
            <div class="dk-open-inner glass-surface">
                <i class="bi bi-unlock-fill"></i>
                <span>
                    خرید برای همه باز است. اگر عضو باشگاه هستید، در پنجرهٔ پرداخت دکمهٔ «پرداخت از اعتبار» را بزنید و
                    <b>کد ملی و رمز خود</b> را وارد کنید؛ در غیر این صورت با دکمهٔ «پرداخت با کارت‌خوان» خرید به‌نام
                    <b>مهمان</b> ثبت می‌شود.
                </span>
            </div>
        </div>
    }

    @if (isService)
    {
        @await Html.PartialAsync("~/Views/Service/Index.cshtml")
    }
    else if (isBuffet)
    {
        @await Html.PartialAsync("~/Views/Shop/Buffet.cshtml")
    }
    else
    {
        @await Html.PartialAsync("~/Views/Shop/Index.cshtml")
    }

    <div class="dk-pay-modal dk-glass-backdrop" id="dkPayModal">
        <div class="dk-pay-box glass-strong">
            <h2 id="dkPayTitle">پرداخت</h2>
            <div class="dk-pay-amount" id="dkPayAmount">0 ریال</div>
            <div class="dk-pay-help">
                برای کسر از اعتبار، کد ملی و رمز عضو را وارد کنید. برای پرداخت با کارت‌خوان نیازی به این اطلاعات
                نیست و خرید به‌عنوان مهمان ثبت می‌شود (نام مهمان اختیاری است).
            </div>

            <div class="dk-field">
                <label for="dkPayNational">کد ملی عضو <span style="opacity:.65">(برای پرداخت از اعتبار)</span></label>
                <input type="text" id="dkPayNational" class="form-control" inputmode="numeric" maxlength="10"
                       placeholder="مثلاً 0012345678" autocomplete="off" dir="ltr" />
            </div>
            <div class="dk-field">
                <label for="dkPayPassword">رمز عضو</label>
                <input type="password" id="dkPayPassword" class="form-control" placeholder="رمز عبور عضو" autocomplete="off" dir="ltr" />
            </div>
            <div class="dk-field">
                <label for="dkPayGuest">نام مهمان <span style="opacity:.65">(اختیاری)</span></label>
                <input type="text" id="dkPayGuest" class="form-control" maxlength="50" placeholder="نام و نام خانوادگی مهمان" />
            </div>

            <button type="button" class="dk-pay-btn btn-primary" id="dkPayCredit">
                <i class="bi bi-wallet2"></i> پرداخت از اعتبار عضو
            </button>
            <button type="button" class="dk-pay-btn btn-glass" id="dkPayPos">
                <i class="bi bi-credit-card-2-front"></i> پرداخت با کارت‌خوان (مهمان)
            </button>
            <button type="button" class="dk-pay-btn btn-glass" id="dkPayCancel">انصراف</button>
            <div class="dk-pay-note" id="dkPayNote"></div>
        </div>
    </div>

    <div class="dk-toast" id="dkToast"></div>

    <script>
        window.DESK_CTX = {
            kind: '@kind',
            isBuffet: @(isBuffet ? "true" : "false"),
            isService: @(isService ? "true" : "false"),
            memberID: @(member?.MemberID ?? 0)
        };
    </script>
    <script src="~/js/desk-commerce.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
