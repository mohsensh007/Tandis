@using TandisWebApp.Services
@{
    Layout = null;
    var deskUser = ViewData["DeskUser"]?.ToString() ?? "کاربر";
    var clubName = ViewData["ClubName"]?.ToString() ?? "باشگاه";
    var kind = ViewData["Kind"]?.ToString() ?? "shop";
    var member = ViewData["MemberCard"] as DeskMemberDto;

    var isService = kind == "services";
    var isBuffet = kind == "buffet";
    var title = isService ? "خدمات" : (isBuffet ? "بوفه" : "فروشگاه");
    var icon = isService ? "bi-tools" : (isBuffet ? "bi-cup-hot" : "bi-bag-heart");
    var backUrl = "/Desk";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#DCE5F0" />
    <title>@title | میز خدمات @clubName</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('tandis-theme');
                if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luna.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member-commerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-arctic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-cool-mist.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; font-family: inherit; }
        .dk-commerce-head {
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            flex-wrap: wrap; max-width: 1240px; margin: 0 auto; padding: 16px 12px 0;
        }
        .dk-back {
            display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
            white-space: nowrap; line-height: 1.5; flex: 0 0 auto;
            padding: 9px 16px; border-radius: 999px; font-size: .82rem; font-weight: 700;
        }
        .dk-commerce-title {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 1.05rem; font-weight: 800;
        }
        .dk-open-strip {
            max-width: 1240px; margin: 10px auto 0; padding: 0 12px;
        }
        .dk-open-inner {
            display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
            padding: 11px 16px; border-radius: 18px; font-size: .8rem; line-height: 1.9;
        }
        .dk-open-inner b { font-size: .85rem; }
        .dk-member-inner {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            flex-wrap: wrap; padding: 12px 16px; border-radius: 18px;
        }
        .dk-member-inner b { font-size: .95rem; }
        .dk-member-inner span { font-size: .74rem; display: block; }
        .dk-credits { display: flex; gap: 8px; flex-wrap: wrap; }
        .dk-credits em {
            font-style: normal; font-size: .7rem; padding: 4px 10px; border-radius: 999px;
        }
        .dk-pay-modal {
            position: fixed; inset: 0; z-index: 1080; display: none;
            align-items: center; justify-content: center; padding: 16px;
        }
        .dk-pay-modal.open { display: flex; }
        .dk-pay-box {
            width: 100%; max-width: 430px; padding: 22px; border-radius: 24px;
            max-height: 94vh; overflow-y: auto;
        }
        .dk-pay-box h2 { font-size: .98rem; font-weight: 800; margin-bottom: 4px; }
        .dk-pay-amount { font-size: 1.45rem; font-weight: 800; margin: 6px 0 6px; }
        .dk-pay-help { font-size: .74rem; line-height: 1.9; margin-bottom: 14px; }
        .dk-field { margin-bottom: 10px; }
        .dk-field label { display: block; font-size: .74rem; font-weight: 700; margin-bottom: 5px; }
        .dk-field .form-control {
            width: 100%; border-radius: 12px; padding: 11px 13px; font-size: .9rem;
        }
        .dk-field-row { display: flex; gap: 8px; }
        .dk-field-row .dk-field { flex: 1 1 0; min-width: 0; }
        .dk-pay-btn {
            width: 100%; padding: 13px; border-radius: 16px; margin-top: 8px;
            font-size: .9rem; font-weight: 800; cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        }
        .dk-pay-btn:disabled { opacity: .55; cursor: default; }
        .dk-pay-note { font-size: .74rem; margin-top: 10px; line-height: 1.9; min-height: 18px; }
        .dk-toast {
            position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%);
            z-index: 1200; max-width: 92vw; padding: 12px 20px; border-radius: 16px;
            font-size: .82rem; font-weight: 700; display: none;
        }
        .dk-toast.show { display: block; }
        @@media (max-width: 720px) {
            .dk-commerce-head { padding: 12px 10px 0; }
            .dk-field-row { flex-direction: column; }
        }
        /* ============================================================
           هم‌ساخت‌سازی فروشگاه / بوفه / خدمات با پنل اصلی میز
           ۳ لایه: پس‌زمینهٔ صفحه / باکس شیشه‌ای / کارت ۳بعدی + فاصلهٔ مطمئن
           ============================================================ */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-page {
            max-width: 1240px;
            margin-inline: auto;
            padding-inline: 12px;
            padding-top: 2px;
        }

        /* هدر صفحه: نوار شیشه‌ای مثل هدر پنل میز */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-head {
            max-width: 1240px;
            margin: 14px auto 12px;
            padding: 12px 16px;
            border-radius: 22px;
            border: 1px solid color-mix(in srgb, var(--g-primary) 24%, transparent);
            background-color: color-mix(in srgb, var(--g-card-solid) 60%, transparent);
            background-image:
                radial-gradient(120% 150% at 0% 0%, color-mix(in srgb, var(--g-surface-solid) 70%, transparent), transparent 60%),
                linear-gradient(125deg, color-mix(in srgb, var(--g-primary) 20%, transparent), transparent 58%);
            box-shadow:
                0 20px 40px -28px color-mix(in srgb, var(--g-text) 66%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 86%, transparent);
            -webkit-backdrop-filter: blur(16px) saturate(1.14);
            backdrop-filter: blur(16px) saturate(1.14);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-title {
            color: var(--g-text);
            gap: 9px;
            font-size: 1rem;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-title > i {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 13px;
            font-size: 1.04rem;
            color: color-mix(in srgb, var(--g-primary) 88%, var(--g-text));
            border: 1px solid color-mix(in srgb, var(--g-primary) 32%, transparent);
            background-image: linear-gradient(148deg, color-mix(in srgb, var(--g-surface-solid) 94%, transparent), color-mix(in srgb, var(--g-primary) 26%, transparent));
            box-shadow:
                0 9px 16px -10px color-mix(in srgb, var(--g-text) 66%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-name {
            color: var(--g-text);
            font-size: .98rem;
            font-weight: 800;
            line-height: 1.6;
        }

        /* دکمه‌های شیشه‌ای هدر */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-head .dk-back,
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-head .dk-credits em {
            padding: 9px 15px;
            border-radius: 999px;
            font-size: .77rem;
            font-weight: 750;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 26%, transparent);
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 56%, transparent), transparent 82%);
            border: 1px solid color-mix(in srgb, var(--g-primary) 26%, transparent);
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 78%, transparent);
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-commerce-head .dk-back:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--g-primary) 46%, transparent);
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 90%, transparent),
                0 14px 24px -18px color-mix(in srgb, var(--g-primary) 70%, transparent);
        }

        /* نوار عضو / نوار مهمان: باکس شیشه‌ای لایهٔ دوم */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.dk-member-inner, .dk-open-inner) {
            padding: 16px 18px !important;
            border-radius: 24px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 44%, transparent) !important;
            background-image: radial-gradient(100% 120% at 0% 0%, color-mix(in srgb, var(--g-surface-solid) 62%, transparent), transparent 62%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 26%, transparent) !important;
            box-shadow:
                0 20px 38px -26px color-mix(in srgb, var(--g-text) 62%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 90%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-open-strip {
            margin-bottom: 16px;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.dk-member-inner, .dk-open-inner) b,
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.dk-member-inner, .dk-open-inner) span {
            color: var(--g-text) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-member-inner span {
            color: color-mix(in srgb, var(--g-text) 72%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-member-inner .dk-credits em {
            padding: 5px 11px;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 750;
            color: var(--g-text) !important;
            background: color-mix(in srgb, var(--g-primary) 16%, transparent);
            border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 70%, transparent);
        }

        /* لایهٔ دوم: باکس‌های شیشه‌ای فروشگاه/سبد و بنر بالا */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-panel, .commerce-cart-panel, .commerce-hero) {
            position: relative;
            padding: 20px !important;
            border-radius: 30px !important;
            background-color: color-mix(in srgb, var(--g-primary) 14%, transparent) !important;
            background-image:
                radial-gradient(120% 100% at 0% 0%, color-mix(in srgb, var(--g-surface-solid) 56%, transparent), transparent 62%),
                linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 30%, transparent), transparent 78%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 26%, transparent) !important;
            box-shadow:
                0 26px 54px -30px color-mix(in srgb, var(--g-text) 58%, transparent),
                inset 0 2px 14px color-mix(in srgb, var(--g-text) 10%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 76%, transparent) !important;
            -webkit-backdrop-filter: blur(14px) saturate(1.08) !important;
            backdrop-filter: blur(14px) saturate(1.08) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-panel, .commerce-cart-panel) {
            margin-bottom: 16px !important;
        }

        /* خط داخلی نازک: مرزِ قاب */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-panel, .commerce-cart-panel)::before {
            content: "";
            position: absolute;
            inset: 9px;
            border-radius: 22px;
            border: 1px solid color-mix(in srgb, var(--g-primary) 13%, transparent);
            pointer-events: none;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-hero {
            margin-bottom: 16px !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-hero h1,
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-hero p,
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-kicker {
            color: var(--g-text) !important;
        }

        /* فاصلهٔ مطمئن بین باکس‌ها و کارت‌ها */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-store-layout {
            gap: 16px !important;
            align-items: start;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-grid {
            gap: 16px !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-cart-list {
            gap: 12px !important;
        }

        /* لایهٔ سوم: کارت شیشه‌ای براق با برجستگی ۳بعدی */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-card, .commerce-card) {
            position: relative;
            padding: 16px !important;
            border-radius: 22px !important;
            color: var(--g-text) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 46%, transparent) !important;
            background-image:
                radial-gradient(92% 72% at 20% -22%, color-mix(in srgb, var(--g-surface-solid) 86%, transparent), transparent 62%),
                radial-gradient(120% 90% at 100% 118%, color-mix(in srgb, var(--g-primary) 30%, transparent), transparent 66%),
                linear-gradient(158deg,
                    color-mix(in srgb, var(--g-card-solid) 72%, transparent) 0%,
                    color-mix(in srgb, var(--g-nested-solid) 60%, transparent) 58%,
                    color-mix(in srgb, var(--g-primary) 20%, transparent) 100%) !important;
            box-shadow:
                0 22px 36px -20px color-mix(in srgb, var(--g-text) 58%, transparent),
                0 8px 16px -10px color-mix(in srgb, var(--g-text) 40%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 94%, transparent),
                inset 0 -20px 32px -24px color-mix(in srgb, var(--g-primary) 70%, transparent) !important;
            -webkit-backdrop-filter: blur(16px) saturate(1.3) !important;
            backdrop-filter: blur(16px) saturate(1.3) !important;
            transform: perspective(1000px) translateY(0) rotateX(0deg);
            transition: transform .24s cubic-bezier(.2, .8, .3, 1), box-shadow .24s ease, border-color .24s ease, background-color .24s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-card, .commerce-card):hover {
            transform: perspective(1000px) translateY(-6px) rotateX(5deg) scale(1.01);
            border-color: color-mix(in srgb, var(--g-primary) 56%, transparent) !important;
            box-shadow:
                0 36px 50px -22px color-mix(in srgb, var(--g-text) 58%, transparent),
                0 12px 22px -12px color-mix(in srgb, var(--g-primary) 58%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent),
                inset 0 -22px 34px -24px color-mix(in srgb, var(--g-primary) 86%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-product-card.is-out:hover {
            transform: perspective(1000px) translateY(0) rotateX(0deg);
            border-color: color-mix(in srgb, var(--g-primary) 20%, transparent) !important;
        }

        /* آیکون کارت‌ها: قاب شیشه‌ای برجسته */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-icon, .commerce-card-icon) {
            border-radius: 16px;
            color: color-mix(in srgb, var(--g-primary) 88%, var(--g-text)) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 34%, transparent);
            background-image: linear-gradient(148deg, color-mix(in srgb, var(--g-surface-solid) 96%, transparent), color-mix(in srgb, var(--g-primary) 26%, transparent));
            box-shadow:
                0 10px 18px -10px color-mix(in srgb, var(--g-text) 66%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent),
                inset 0 -8px 14px -10px color-mix(in srgb, var(--g-primary) 70%, transparent);
        }

        /* خوانایی نوشته روی شیشه */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-title, .commerce-card-title, .commerce-price, .commerce-cart-item-name, .commerce-panel-title, .commerce-cart-title) {
            color: var(--g-text) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-subtitle, .commerce-stock) {
            color: color-mix(in srgb, var(--g-text) 78%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-panel-title i,
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-cart-title i {
            color: color-mix(in srgb, var(--g-primary) 84%, var(--g-text)) !important;
        }

        /* آیتم سبد: لایهٔ تودرتو با فاصله */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-cart-item {
            padding: 12px !important;
            border-radius: 16px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 26%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 60%, transparent), transparent 84%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 22%, transparent) !important;
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 72%, transparent) !important;
        }

        /* دکمه‌های کارت: شیشه‌ای با عمق */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-add, .commerce-buy, .commerce-checkout, .commerce-remove) {
            min-height: 44px;
            border-radius: 14px !important;
            font-weight: 800;
            color: var(--g-text) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-primary) 30%, transparent), color-mix(in srgb, var(--g-surface-solid) 46%, transparent)) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 38%, transparent) !important;
            box-shadow:
                0 12px 22px -16px color-mix(in srgb, var(--g-primary) 66%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 84%, transparent) !important;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-add, .commerce-buy, .commerce-checkout, .commerce-remove):hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--g-primary) 56%, transparent) !important;
            box-shadow:
                0 16px 26px -16px color-mix(in srgb, var(--g-primary) 72%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 92%, transparent) !important;
        }

        /* فیلد تعداد و چیپ دسته‌بندی */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-quantity {
            min-height: 44px;
            border-radius: 14px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 24%, transparent) !important;
            border: 1px solid color-mix(in srgb, var(--g-text) 28%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-category-button {
            min-height: 44px;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 40%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 54%, transparent), transparent 84%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 24%, transparent) !important;
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 74%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-category-button.active, .commerce-category-button:hover) {
            color: var(--g-text) !important;
            border-color: color-mix(in srgb, var(--g-primary) 52%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-primary) 42%, transparent), color-mix(in srgb, var(--g-surface-solid) 38%, transparent)) !important;
            box-shadow:
                0 14px 24px -18px color-mix(in srgb, var(--g-primary) 70%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 86%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-notice {
            padding: 12px 16px !important;
            border-radius: 18px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 26%, transparent) !important;
            background-image: none !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 22%, transparent) !important;
        }

        @@media (prefers-reduced-motion: reduce) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-card, .commerce-card),
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-card, .commerce-card):hover {
                transform: none;
                transition: box-shadow .2s ease, border-color .2s ease;
            }
        }

        @@media (max-width: 720px) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-panel, .commerce-cart-panel, .commerce-hero) {
                padding: 14px !important;
                border-radius: 24px !important;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-panel, .commerce-cart-panel)::before {
                inset: 6px;
                border-radius: 18px;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-card, .commerce-card) {
                border-radius: 18px !important;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) :is(.commerce-product-card, .commerce-card):hover {
                transform: perspective(1000px) translateY(-3px) rotateX(3deg);
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .commerce-grid {
                gap: 12px !important;
            }
        }

    </style>
</head>
<body class="member-ui">
    <div class="dk-commerce-head">
        <div class="dk-commerce-title">
            <i class="bi @icon"></i>
            <span class="dk-commerce-name">@title</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <span class="dk-credits"><em><i class="bi bi-person-badge"></i> @deskUser</em></span>
            <a class="dk-back" href="@backUrl"><i class="bi bi-arrow-right"></i> بازگشت به میز خدمات</a>
        </div>
    </div>

    @if (member != null)
    {
        <div class="dk-open-strip">
            <div class="dk-member-inner glass-surface">
                <div>
                    <b>@member.FullName</b>
                    <span>کد ملی @member.NationalCode</span>
                </div>
                <div class="dk-credits">
                    <em>فروشگاه: @member.ShopCredit.ToString("N0")</em>
                    <em>خدمات: @member.ServiceCredit.ToString("N0")</em>
                    <em>ورزشی: @member.SportCredit.ToString("N0")</em>
                </div>
                <a class="dk-back" href="@backUrl/@(kind == "buffet" ? "Buffet" : kind == "services" ? "Services" : "Shop")">
                    <i class="bi bi-arrow-repeat"></i> تغییر عضو
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="dk-open-strip">
            <div class="dk-open-inner glass-surface">
                <i class="bi bi-unlock-fill"></i>
                <span>
                    خرید برای همه باز است. اگر عضو باشگاه هستید، در پنجرهٔ پرداخت دکمهٔ «پرداخت از اعتبار» را بزنید و
                    <b>کد ملی و رمز خود</b> را وارد کنید؛ در غیر این صورت با دکمهٔ «پرداخت با کارت‌خوان» خرید به‌نام
                    <b>مهمان</b> ثبت می‌شود.
                </span>
            </div>
        </div>
    }

    @if (isService)
    {
        @await Html.PartialAsync("~/Views/Service/Index.cshtml")
    }
    else if (isBuffet)
    {
        @await Html.PartialAsync("~/Views/Shop/Buffet.cshtml")
    }
    else
    {
        @await Html.PartialAsync("~/Views/Shop/Index.cshtml")
    }

    <div class="dk-pay-modal dk-glass-backdrop" id="dkPayModal">
        <div class="dk-pay-box glass-strong">
            <h2 id="dkPayTitle">پرداخت</h2>
            <div class="dk-pay-amount" id="dkPayAmount">0 ریال</div>
            <div class="dk-pay-help">
                برای کسر از اعتبار، کد ملی و رمز عضو را وارد کنید. برای پرداخت با کارت‌خوان نیازی به این اطلاعات
                نیست و خرید به‌عنوان مهمان ثبت می‌شود (نام مهمان اختیاری است).
            </div>

            <div class="dk-field">
                <label for="dkPayNational">کد ملی عضو <span style="opacity:.65">(برای پرداخت از اعتبار)</span></label>
                <input type="text" id="dkPayNational" class="form-control" inputmode="numeric" maxlength="10"
                       placeholder="مثلاً 0012345678" autocomplete="off" dir="ltr" readonly onfocus="this.removeAttribute('readonly')" />
            </div>
            <div class="dk-field">
                <label for="dkPayPassword">رمز عضو</label>
                <input type="password" id="dkPayPassword" class="form-control" placeholder="رمز عبور عضو" autocomplete="off" dir="ltr" />
            </div>
            <div class="dk-field">
                <label for="dkPayGuest">نام مهمان <span style="opacity:.65">(اختیاری)</span></label>
                <input type="text" id="dkPayGuest" class="form-control" maxlength="50" placeholder="نام و نام خانوادگی مهمان" />
            </div>

            <button type="button" class="dk-pay-btn btn-primary" id="dkPayCredit">
                <i class="bi bi-wallet2"></i> پرداخت از اعتبار عضو
            </button>
            <button type="button" class="dk-pay-btn btn-glass" id="dkPayPos">
                <i class="bi bi-credit-card-2-front"></i> پرداخت با کارت‌خوان
            </button>
            <button type="button" class="dk-pay-btn btn-glass" id="dkPayCancel">انصراف</button>
            <div class="dk-pay-note" id="dkPayNote"></div>
        </div>
    </div>

    <!-- ✅ مرحلهٔ احراز هویت برای پرداخت با کارت‌خوان -->
    <div class="dk-pay-modal dk-glass-backdrop" id="dkPosAuth">
        <div class="dk-pay-box glass-strong">
            <h2>ورود با کارت‌خوان</h2>
            <div class="dk-pay-help">
                اگر این خرید برای یک عضو باشگاه است، کد ملی و رمز او را وارد کنید تا خرید به حساب همان عضو ثبت شود.
                اگر عضو نیست، بدون وارد کردن اطلاعات روی «ادامه به‌عنوان مهمان» بزنید.
            </div>
            <div class="dk-field">
                <label for="dkPosNational">کد ملی عضو</label>
                <input type="text" id="dkPosNational" class="form-control" inputmode="numeric" maxlength="10"
                       placeholder="۱۰ رقم" autocomplete="off" dir="ltr" readonly onfocus="this.removeAttribute('readonly')" />
            </div>
            <div class="dk-field">
                <label for="dkPosPassword">رمز عضو</label>
                <input type="password" id="dkPosPassword" class="form-control" placeholder="رمز عبور عضو" autocomplete="off" dir="ltr" />
            </div>
            <button type="button" class="dk-pay-btn btn-primary" id="dkPosAuthGo">
                <i class="bi bi-check2-circle"></i> تأیید و ارسال به کارت‌خوان
            </button>
            <button type="button" class="dk-pay-btn btn-glass" id="dkPosAuthGuest">
                <i class="bi bi-person-walking"></i> ادامه به‌عنوان مهمان
            </button>
            <button type="button" class="dk-pay-btn btn-glass" id="dkPosAuthCancel">انصراف</button>
            <div class="dk-pay-note" id="dkPosAuthNote"></div>
        </div>
    </div>

    <div class="dk-toast" id="dkToast"></div>

    <script>
        window.DESK_CTX = {
            kind: '@kind',
            isBuffet: @(isBuffet ? "true" : "false"),
            isService: @(isService ? "true" : "false"),
            memberID: @(member?.MemberID ?? 0),
            club: '@clubName'
        };
    </script>
    <script src="~/js/desk-receipt.js" asp-append-version="true"></script>
    <script src="~/js/desk-commerce.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
