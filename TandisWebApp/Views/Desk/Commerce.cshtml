@using TandisWebApp.Services
@{
    Layout = null;
    var deskUser = ViewData["DeskUser"]?.ToString() ?? "کاربر";
    var clubName = ViewData["ClubName"]?.ToString() ?? "باشگاه";
    var kind = ViewData["Kind"]?.ToString() ?? "shop";
    var member = ViewData["MemberCard"] as DeskMemberDto;

    var isService = kind == "services";
    var isBuffet = kind == "buffet";
    var title = isService ? "خدمات" : (isBuffet ? "بوفه" : "فروشگاه");
    var icon = isService ? "bi-spa" : (isBuffet ? "bi-cup-hot" : "bi-bag-heart");
    var backUrl = "/Desk";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#011C40" />
    <title>@title | میز خدمت @clubName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luna.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member-commerce.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; font-family: inherit; }
        .dk-commerce-head {
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            flex-wrap: wrap; max-width: 1240px; margin: 0 auto; padding: 16px 12px 0;
        }
        .dk-back {
            display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
            white-space: nowrap; line-height: 1.5; flex: 0 0 auto;
            padding: 9px 16px; border-radius: 999px; font-size: .82rem; font-weight: 700;
            color: #EAF7FA; background: rgba(167, 235, 242, .14);
            border: 1px solid rgba(167, 235, 242, .32);
        }
        .dk-back:hover { color: #fff; background: rgba(167, 235, 242, .22); }
        .dk-commerce-title {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 1.05rem; font-weight: 800; color: #EAF7FA;
        }
        .dk-member-bar {
            max-width: 1240px; margin: 10px auto 0; padding: 0 12px;
        }
        .dk-member-inner {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            flex-wrap: wrap; padding: 12px 16px; border-radius: 18px;
            background: rgba(1, 28, 64, .38); border: 1px solid rgba(167, 235, 242, .26);
        }
        .dk-member-inner b { font-size: .95rem; color: #EAF7FA; }
        .dk-member-inner span { font-size: .74rem; color: #CBE9EF; display: block; }
        .dk-credits { display: flex; gap: 8px; flex-wrap: wrap; }
        .dk-credits em {
            font-style: normal; font-size: .7rem; padding: 4px 10px; border-radius: 999px;
            background: rgba(167, 235, 242, .12); border: 1px solid rgba(167, 235, 242, .22);
            color: #EAF7FA;
        }
        .dk-picker {
            max-width: 560px; margin: 40px auto; padding: 22px; border-radius: 26px;
            background: rgba(1, 28, 64, .42); border: 1px solid rgba(167, 235, 242, .28);
        }
        .dk-picker h1 { font-size: 1.05rem; font-weight: 800; color: #EAF7FA; margin-bottom: 6px; }
        .dk-picker p { font-size: .78rem; color: #CBE9EF; margin-bottom: 16px; line-height: 1.9; }
        .dk-picker .form-control {
            background: rgba(1, 28, 64, .55); border: 1px solid rgba(167, 235, 242, .30);
            color: #EAF7FA; border-radius: 14px; padding: 12px 14px; font-size: .92rem;
            text-align: center; letter-spacing: 1px;
        }
        .dk-picker .form-control::placeholder { color: rgba(234, 247, 250, .55); }
        .dk-pay-modal {
            position: fixed; inset: 0; z-index: 1080; display: none;
            align-items: center; justify-content: center; padding: 16px;
            background: rgba(1, 28, 64, .45);
        }
        .dk-pay-modal.open { display: flex; }
        .dk-pay-box {
            width: 100%; max-width: 420px; padding: 20px; border-radius: 24px;
            background: linear-gradient(160deg, rgba(38, 101, 140, .96), rgba(1, 28, 64, .98));
            border: 1px solid rgba(167, 235, 242, .28); color: #EAF7FA;
        }
        .dk-pay-box h2 { font-size: .95rem; font-weight: 800; margin-bottom: 4px; }
        .dk-pay-amount { font-size: 1.5rem; font-weight: 800; color: #A7EBF2; margin: 6px 0 14px; }
        .dk-pay-btn {
            width: 100%; padding: 13px; border-radius: 16px; margin-top: 8px;
            font-size: .9rem; font-weight: 800; color: #fff; border: 1px solid rgba(255, 255, 255, .3);
            background: linear-gradient(135deg, #54ACBF 0%, #26658C 60%, #023859 100%);
        }
        .dk-pay-btn.ghost { background: rgba(167, 235, 242, .14); color: #EAF7FA; }
        .dk-pay-btn:disabled { opacity: .55; }
        .dk-pay-note { font-size: .74rem; color: #CBE9EF; margin-top: 10px; line-height: 1.9; }
        .dk-toast {
            position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%);
            z-index: 1200; max-width: 92vw; padding: 12px 20px; border-radius: 16px;
            font-size: .82rem; font-weight: 700; color: #fff; display: none;
            background: linear-gradient(135deg, #26658C, #011C40);
            box-shadow: 0 16px 36px rgba(1, 28, 64, .4);
        }
        .dk-toast.err { background: linear-gradient(135deg, #d13b4a, #7c1020); }
        .dk-toast.show { display: block; }
        @@media (max-width: 720px) {
            .dk-picker { margin: 18px 12px; padding: 18px; }
        }
    </style>
</head>
<body class="member-ui">
    <div class="dk-commerce-head">
        <div class="dk-commerce-title">
            <i class="bi @icon"></i>
            <span>@title — میز خدمت</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
            <span class="dk-credits"><em><i class="bi bi-person-badge"></i> @deskUser</em></span>
            <a class="dk-back" href="@backUrl"><i class="bi bi-arrow-right"></i> بازگشت به میز خدمت</a>
        </div>
    </div>

    @if (member == null)
    {
        <div class="dk-picker">
            <h1>انتخاب عضو برای @title</h1>
            <p>کد ملی یا شماره موبایل عضو را وارد کنید تا محصولات و اعتبارهای همان عضو نمایش داده شود.</p>
            <input type="text" id="dkFindInput" class="form-control" inputmode="numeric"
                   placeholder="کد ملی ۱۰ رقمی یا موبایل ۱۱ رقمی" autocomplete="off" />
            <button type="button" class="dk-pay-btn" id="dkFindBtn" style="margin-top:14px;">
                <i class="bi bi-search"></i> جستجوی عضو
            </button>
        </div>
    }
    else
    {
        <div class="dk-member-bar">
            <div class="dk-member-inner">
                <div>
                    <b>@member.FullName</b>
                    <span>کد ملی @member.NationalCode</span>
                </div>
                <div class="dk-credits">
                    <em>فروشگاه: @member.ShopCredit.ToString("N0")</em>
                    <em>خدمات: @member.ServiceCredit.ToString("N0")</em>
                    <em>ورزشی: @member.SportCredit.ToString("N0")</em>
                </div>
                <a class="dk-back" href="@backUrl/@(kind == "buffet" ? "Buffet" : kind == "services" ? "Services" : "Shop")">
                    <i class="bi bi-arrow-repeat"></i> تغییر عضو
                </a>
            </div>
        </div>

        @if (isService)
        {
            @await Html.PartialAsync("~/Views/Service/Index.cshtml")
        }
        else if (isBuffet)
        {
            @await Html.PartialAsync("~/Views/Shop/Buffet.cshtml")
        }
        else
        {
            @await Html.PartialAsync("~/Views/Shop/Index.cshtml")
        }
    }

    <div class="dk-pay-modal" id="dkPayModal">
        <div class="dk-pay-box">
            <h2 id="dkPayTitle">پرداخت</h2>
            <div class="dk-pay-amount" id="dkPayAmount">0 ریال</div>
            <button type="button" class="dk-pay-btn" id="dkPayCredit">
                <i class="bi bi-wallet2"></i> پرداخت از اعتبار عضو
            </button>
            <button type="button" class="dk-pay-btn ghost" id="dkPayPos">
                <i class="bi bi-credit-card-2-front"></i> پرداخت با کارت‌خوان
            </button>
            <button type="button" class="dk-pay-btn ghost" id="dkPayCancel">انصراف</button>
            <div class="dk-pay-note" id="dkPayNote"></div>
        </div>
    </div>

    <div class="dk-toast" id="dkToast"></div>

    <script>
        window.DESK_CTX = {
            kind: '@kind',
            isBuffet: @(isBuffet ? "true" : "false"),
            isService: @(isService ? "true" : "false"),
            memberID: @(member?.MemberID ?? 0)
        };
    </script>
    <script src="~/js/desk-commerce.js" asp-append-version="true"></script>
</body>
</html>
