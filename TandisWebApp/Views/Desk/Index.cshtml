@{
    Layout = null;
    var deskUser = ViewData["DeskUser"]?.ToString() ?? "کاربر";
    var clubName = ViewData["ClubName"]?.ToString() ?? "باشگاه";
    // ✅ تنظیمات پنل: فقط کارت‌هایی که مدیر فعال کرده نمایش داده می‌شوند
    var deskCards = ViewData["DeskCards"] as List<string>
                    ?? new List<string> { "charge", "ticket", "single", "register", "renew", "shop", "buffet", "services" };
    Func<string, bool> showCard = k => deskCards.Contains(k);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
    <script>(function(){try{var t=localStorage.getItem("tandis-theme");if(!t)t=window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","light");}})();</script>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#DCE5F0" />
    <title>میز خدمات | @clubName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luna.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-arctic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-cool-mist.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; font-family: inherit; }
        .dk-modal {
            position: fixed; inset: 0; z-index: 1080; display: none;
            align-items: center; justify-content: center; padding: 16px;
            background: color-mix(in srgb, var(--g-surface-solid) 38%, transparent);
            -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
        }
        .dk-modal.open { display: flex; }
        .dk-box {
            width: 100%; max-width: 460px; max-height: 92vh; overflow-y: auto;
            padding: 18px; border-radius: 26px;
        }
        .dk-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
        .dk-head b { font-size: 1rem; color: var(--g-text); }
        .dk-x {
            width: 34px; height: 34px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--g-text) 35%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent); color: var(--g-text); font-size: 1.1rem; line-height: 1;
        }
        .dk-box label { display: block; font-size: .76rem; margin-bottom: 5px; color: color-mix(in srgb, var(--g-text) 82%, transparent); }
        .dk-box .form-control {
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent); border: 1px solid color-mix(in srgb, var(--g-text) 30%, transparent);
            color: var(--g-text); border-radius: 14px; padding: 11px 13px; font-size: .88rem;
        }
        .dk-box .form-control::placeholder { color: color-mix(in srgb, var(--g-text) 62%, transparent); }
        .dk-btn {
            width: 100%; padding: 13px; border-radius: 16px; border: 1px solid color-mix(in srgb, var(--g-text) 35%, transparent);
            font-size: .9rem; font-weight: 800; color: var(--g-text);
            background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-primary) 55%, var(--g-surface-solid) 100%);
            box-shadow: 0 12px 26px color-mix(in srgb, var(--g-surface-solid) 32%, transparent), inset 0 1px 0 color-mix(in srgb, var(--g-text) 40%, transparent);
        }
        .dk-btn.ghost { background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent); box-shadow: none; }
        .dk-btn:disabled { opacity: .55; }
        .dk-note {
            font-size: .74rem; line-height: 1.8; color: color-mix(in srgb, var(--g-text) 75%, transparent);
            background: color-mix(in srgb, var(--g-surface-solid) 34%, transparent); border: 1px solid color-mix(in srgb, var(--g-text) 22%, transparent);
            border-radius: 14px; padding: 10px 12px; margin-bottom: 12px;
        }
        .dk-member {
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            padding: 12px 14px; border-radius: 16px; margin-bottom: 12px;
            background: color-mix(in srgb, var(--g-nested-solid) 13%, transparent); border: 1px solid color-mix(in srgb, var(--g-text) 26%, transparent);
        }
        .dk-member b { font-size: .92rem; }
        .dk-member span { font-size: .72rem; color: color-mix(in srgb, var(--g-text) 72%, transparent); display: block; }
        .dk-credits { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
        .dk-credits em {
            font-style: normal; font-size: .68rem; padding: 3px 8px; border-radius: 999px;
            background: color-mix(in srgb, var(--g-surface-solid) 35%, transparent); border: 1px solid color-mix(in srgb, var(--g-text) 20%, transparent);
        }
        .dk-spin {
            width: 42px; height: 42px; margin: 6px auto 14px; border-radius: 50%;
            border: 3px solid color-mix(in srgb, var(--g-text) 30%, transparent); border-top-color: var(--g-text);
            animation: dkspin .9s linear infinite;
        }
        @@keyframes dkspin { to { transform: rotate(360deg); } }
        .dk-center { text-align: center; }
        .dk-toast {
            position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%);
            z-index: 1200; max-width: 92vw; padding: 12px 20px; border-radius: 16px;
            font-size: .82rem; font-weight: 700; color: var(--g-text); display: none;
            background: linear-gradient(135deg, var(--g-primary), var(--g-surface-solid));
            box-shadow: 0 16px 36px color-mix(in srgb, var(--g-surface-solid) 40%, transparent);
        }
        .dk-toast.err { background: linear-gradient(135deg, var(--g-surface-solid), var(--g-text)); }
        .dk-toast.show { display: block; }
        .dk-qty { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 12px 0; }
        .dk-qty button {
            width: 46px; height: 46px; border-radius: 14px; font-size: 1.25rem; font-weight: 800; line-height: 1;
            color: var(--g-text); border: 1px solid color-mix(in srgb, var(--g-text) 35%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
        }
        .dk-qty input {
            width: 84px; height: 46px; text-align: center; font-size: 1.1rem; font-weight: 800;
            color: var(--g-text); border-radius: 14px; border: 1px solid color-mix(in srgb, var(--g-text) 30%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
        }
        .dk-chosen {
            display: flex; align-items: center; justify-content: space-between; gap: 8px;
            padding: 12px 14px; border-radius: 16px; margin-bottom: 12px;
            background: linear-gradient(135deg, color-mix(in srgb, var(--g-primary) 34%, transparent), color-mix(in srgb, var(--g-surface-solid) 28%, transparent));
            border: 1px solid color-mix(in srgb, var(--g-text) 30%, transparent); font-size: .84rem;
        }
        /* ✅ کارت‌های میز خدمات: آیکون و عنوان وسط کارت (اندازهٔ کارت تغییر نمی‌کند) */
        .desk-grid .desk-card {
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 12px;
        }
        .desk-grid .desk-card > span:not(.dc-icon):not(.dc-go) {
            display: flex;
            justify-content: center;
            width: 100%;
        }
        .desk-grid .desk-card .dc-icon {
            align-self: center;
            margin: 0 auto;
            flex: 0 0 auto;
        }
        .desk-grid .desk-card .dc-title {
            display: block;
            text-align: center;
            font-size: 1.02rem;
            line-height: 1.5;
        }
        .desk-grid .desk-card .dc-go {
            align-self: center;
            margin-top: 2px;
        }

        /* ============================================================
           سه لایهٔ پنل: پس‌زمینهٔ صفحه / باکس کارت‌ها / خود کارت
           ============================================================ */

        /* ۲) باکسِ کارت‌ها: شیشهٔ فرورفته و رنگی‌تر از پس‌زمینهٔ صفحه + پدینگ */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid {
            position: relative;
            padding: 22px;
            border-radius: 34px !important;
            background-color: color-mix(in srgb, var(--g-primary) 16%, transparent) !important;
            background-image:
                radial-gradient(120% 100% at 0% 0%, color-mix(in srgb, var(--g-surface-solid) 62%, transparent), transparent 62%),
                linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 34%, transparent), transparent 78%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 26%, transparent) !important;
            box-shadow:
                0 26px 54px -30px color-mix(in srgb, var(--g-text) 60%, transparent),
                inset 0 2px 14px color-mix(in srgb, var(--g-text) 12%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 78%, transparent) !important;
            -webkit-backdrop-filter: blur(14px) saturate(1.08) !important;
            backdrop-filter: blur(14px) saturate(1.08) !important;
        }

        /* خط داخلی نازک: مرزِ «قاب» کارت‌ها */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid::before {
            content: "";
            position: absolute;
            inset: 9px;
            border-radius: 26px;
            border: 1px solid color-mix(in srgb, var(--g-primary) 14%, transparent);
            pointer-events: none;
        }

        /* ۳) کارت‌ها: شیشهٔ براق با رنگ تم، لبهٔ نور، سایهٔ رنگی و برجستگی ۳بعدی */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card {
            position: relative;
            border-radius: 24px !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 46%, transparent) !important;
            background-image:
                radial-gradient(92% 72% at 20% -22%, color-mix(in srgb, var(--g-surface-solid) 88%, transparent), transparent 62%),
                radial-gradient(120% 90% at 100% 118%, color-mix(in srgb, var(--g-primary) 34%, transparent), transparent 66%),
                linear-gradient(158deg,
                    color-mix(in srgb, var(--g-card-solid) 74%, transparent) 0%,
                    color-mix(in srgb, var(--g-nested-solid) 62%, transparent) 58%,
                    color-mix(in srgb, var(--g-primary) 22%, transparent) 100%) !important;
            -webkit-backdrop-filter: blur(16px) saturate(1.35) !important;
            backdrop-filter: blur(16px) saturate(1.35) !important;
            box-shadow:
                0 24px 38px -20px color-mix(in srgb, var(--g-text) 62%, transparent),
                0 8px 16px -10px color-mix(in srgb, var(--g-text) 44%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 96%, transparent),
                inset 0 -22px 34px -24px color-mix(in srgb, var(--g-primary) 78%, transparent) !important;
            transform: perspective(1000px) translateY(0) rotateX(0deg);
            transition: transform .24s cubic-bezier(.2, .8, .3, 1), box-shadow .24s ease, border-color .24s ease, background-color .24s ease;
            will-change: transform;
        }

        /* ✅ هر کارت فقط یک باکس است: لایهٔ براقِ داخلی (باکس دوم) حذف شد */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card::after {
            content: none !important;
            display: none !important;
            background: none !important;
        }

        /* ============================================================
           هدر پنل: یک نوار شیشه‌ای یکپارچه با لوگو، نام باشگاه و کاربر
           ============================================================ */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head {
            position: relative;
            padding: 13px 18px;
            margin-bottom: 20px;
            border-radius: 24px !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 24%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 62%, transparent) !important;
            background-image:
                radial-gradient(120% 150% at 0% 0%, color-mix(in srgb, var(--g-surface-solid) 72%, transparent), transparent 60%),
                linear-gradient(125deg, color-mix(in srgb, var(--g-primary) 22%, transparent), transparent 58%),
                linear-gradient(150deg, color-mix(in srgb, var(--g-nested-solid) 30%, transparent), transparent 78%) !important;
            box-shadow:
                0 22px 44px -28px color-mix(in srgb, var(--g-text) 68%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 88%, transparent),
                inset 0 -18px 30px -26px color-mix(in srgb, var(--g-primary) 70%, transparent) !important;
            -webkit-backdrop-filter: blur(16px) saturate(1.16) !important;
            backdrop-filter: blur(16px) saturate(1.16) !important;
        }

        /* لوگو در قاب شیشه‌ای */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand {
            gap: 12px;
            min-width: 0;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand img {
            width: 50px;
            height: 50px;
            padding: 7px;
            border-radius: 16px;
            border: 1px solid color-mix(in srgb, var(--g-primary) 32%, transparent);
            background-image: linear-gradient(150deg,
                color-mix(in srgb, var(--g-surface-solid) 96%, transparent),
                color-mix(in srgb, var(--g-primary) 30%, transparent));
            box-shadow:
                0 12px 22px -14px color-mix(in srgb, var(--g-text) 72%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent),
                inset 0 -8px 14px -10px color-mix(in srgb, var(--g-primary) 70%, transparent);
            filter: none;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand b {
            font-size: 1.06rem;
            font-weight: 800;
            line-height: 1.5;
            letter-spacing: -.01em;
            color: var(--g-text) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand span {
            display: block;
            margin-top: 2px;
            font-size: .71rem;
            font-weight: 700;
            line-height: 1.6;
            color: color-mix(in srgb, var(--g-text) 62%, transparent) !important;
        }

        /* چیپ‌های باشگاه / کاربر / اثر انگشت / خروج */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user {
            gap: 7px;
            padding: 9px 15px;
            border-radius: 999px !important;
            font-size: .79rem;
            font-weight: 750;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 26%, transparent) !important;
            background-image: linear-gradient(150deg,
                color-mix(in srgb, var(--g-surface-solid) 58%, transparent),
                transparent 82%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 26%, transparent) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 80%, transparent),
                0 10px 20px -16px color-mix(in srgb, var(--g-text) 62%, transparent) !important;
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user i {
            font-size: 1.02rem;
            color: color-mix(in srgb, var(--g-primary) 88%, var(--g-text)) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user .bi-fingerprint {
            font-size: 1.2rem !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--g-primary) 46%, transparent) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 90%, transparent),
                0 14px 24px -16px color-mix(in srgb, var(--g-primary) 70%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout {
            background-image: linear-gradient(150deg,
                color-mix(in srgb, var(--g-primary) 36%, transparent),
                transparent 86%) !important;
            border-color: color-mix(in srgb, var(--g-primary) 42%, transparent) !important;
        }

        @@media (max-width: 700px) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head {
                padding: 11px 13px;
                gap: 10px;
                border-radius: 20px !important;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand img {
                width: 42px;
                height: 42px;
                padding: 6px;
                border-radius: 13px;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand b {
                font-size: .94rem;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand span {
                display: none;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head > div:last-child {
                width: 100%;
                flex-wrap: wrap;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user {
                padding: 8px 12px;
                font-size: .73rem;
            }
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card:hover {
            transform: perspective(1000px) translateY(-7px) rotateX(6deg) scale(1.012);
            border-color: color-mix(in srgb, var(--g-primary) 58%, transparent) !important;
            box-shadow:
                0 38px 54px -22px color-mix(in srgb, var(--g-text) 60%, transparent),
                0 12px 22px -12px color-mix(in srgb, var(--g-primary) 60%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent),
                inset 0 -24px 36px -24px color-mix(in srgb, var(--g-primary) 88%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card:active {
            transform: perspective(1000px) translateY(-1px) rotateX(2deg) scale(.998);
        }

        /* آیکون و برچسب‌ها: برجستگی و خوانایی روی شیشه */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card .dc-icon {
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--g-primary) 34%, transparent);
            background-image: linear-gradient(148deg,
                color-mix(in srgb, var(--g-surface-solid) 96%, transparent),
                color-mix(in srgb, var(--g-primary) 26%, transparent));
            box-shadow:
                0 10px 18px -10px color-mix(in srgb, var(--g-text) 70%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent),
                inset 0 -8px 14px -10px color-mix(in srgb, var(--g-primary) 70%, transparent);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card .dc-icon i {
            color: color-mix(in srgb, var(--g-primary) 88%, var(--g-text)) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card .dc-title {
            color: var(--g-text) !important;
            text-shadow: 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 70%, transparent);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card .dc-go {
            background: color-mix(in srgb, var(--g-primary) 18%, transparent);
            border: 1px solid color-mix(in srgb, var(--g-primary) 40%, transparent);
            color: color-mix(in srgb, var(--g-primary) 92%, var(--g-text));
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 80%, transparent);
        }

        /* کاهش حرکت برای کاربرانی که انیمیشن کمتر می‌خواهند */
        @@media (prefers-reduced-motion: reduce) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card,
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card:hover {
                transform: none;
                transition: box-shadow .2s ease, border-color .2s ease;
            }
        }

        @@media (max-width: 760px) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid {
                padding: 14px;
                border-radius: 26px !important;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid::before {
                inset: 6px;
                border-radius: 21px;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-grid .desk-card:hover {
                transform: perspective(1000px) translateY(-3px) rotateX(3deg);
            }
        }
        /* ============================================================
           هدر: چیپ‌ها در همان سطرِ نام «ایمن تردد» (نه زیر آن) + حفظ زیرنویس
           ============================================================ */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head {
            flex-wrap: nowrap !important;
            align-items: center;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand {
            flex: 1 1 auto;
            min-width: 0;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand > div {
            min-width: 0;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand span {
            display: block !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head > div:last-child {
            display: flex !important;
            align-items: center;
            justify-content: flex-end;
            gap: 7px;
            flex: 0 0 auto;
            width: auto !important;
            flex-wrap: nowrap !important;
        }

        @@media (max-width: 700px) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head {
                padding: 10px 11px;
                gap: 8px;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand b {
                font-size: .86rem;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-brand span {
                display: block !important;
                font-size: .6rem;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user {
                padding: 7px 10px;
                font-size: .68rem;
                max-width: 34vw;
                overflow: hidden;
                white-space: nowrap;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user:not(#btnDeskBio) i {
                display: none;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head .desk-user .bi-fingerprint {
                display: inline-flex !important;
            }
        }

        /* ============================================================
           مودال‌های پنل میز (کد ملی/رمز، تمدید، بلیت، اعتبار، خروج)
           ۳ لایه: پس‌زمینهٔ تاریک‌شده / باکس شیشه‌ای / کارت‌های داخلی
           ============================================================ */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-modal {
            padding: 16px;
            background:
                radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--g-primary) 20%, transparent), transparent 62%),
                color-mix(in srgb, var(--g-surface-solid) 58%, transparent) !important;
            -webkit-backdrop-filter: blur(9px) saturate(1.06) !important;
            backdrop-filter: blur(9px) saturate(1.06) !important;
        }

        /* باکس مودال: شیشهٔ براق سه‌لایه با لبهٔ نور و سایهٔ عمیق (همان «صفحه»ای که کد ملی/رمز می‌خواهد) */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box {
            position: relative;
            width: 100%;
            max-width: 480px;
            padding: 22px !important;
            border-radius: 30px !important;
            color: var(--g-text) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 32%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 80%, transparent) !important;
            background-image:
                radial-gradient(110% 90% at 12% -10%, color-mix(in srgb, var(--g-surface-solid) 84%, transparent), transparent 64%),
                radial-gradient(120% 90% at 100% 112%, color-mix(in srgb, var(--g-primary) 28%, transparent), transparent 68%),
                linear-gradient(160deg,
                    color-mix(in srgb, var(--g-card-solid) 84%, transparent) 0%,
                    color-mix(in srgb, var(--g-nested-solid) 72%, transparent) 100%) !important;
            box-shadow:
                0 34px 64px -28px color-mix(in srgb, var(--g-text) 68%, transparent),
                0 12px 24px -14px color-mix(in srgb, var(--g-text) 46%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 96%, transparent),
                inset 0 0 0 1px color-mix(in srgb, var(--g-primary) 12%, transparent),
                inset 0 -26px 44px -30px color-mix(in srgb, var(--g-primary) 72%, transparent) !important;
            -webkit-backdrop-filter: blur(20px) saturate(1.2) !important;
            backdrop-filter: blur(20px) saturate(1.2) !important;
        }

        /* سر مودال: نوار جدا با خط و فاصلهٔ مطمئن */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-head {
            gap: 10px;
            padding: 0 2px 12px;
            margin-bottom: 16px;
            border-bottom: 1px solid color-mix(in srgb, var(--g-text) 16%, transparent);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-head b {
            color: var(--g-text) !important;
            font-size: 1.04rem;
            font-weight: 800;
            line-height: 1.7;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-x {
            width: 40px;
            height: 40px;
            flex: 0 0 auto;
            border-radius: 14px !important;
            color: var(--g-text) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 34%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 30%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 66%, transparent), transparent 84%) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 86%, transparent),
                0 8px 16px -10px color-mix(in srgb, var(--g-text) 60%, transparent) !important;
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-x:hover {
            transform: translateY(-2px) rotate(90deg);
            border-color: color-mix(in srgb, var(--g-primary) 58%, transparent) !important;
        }

        /* برچسب و فیلدها: فاصله، خوانایی و تضاد کافی روی شیشه */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box label {
            display: block;
            margin-bottom: 6px;
            font-size: .77rem;
            font-weight: 700;
            line-height: 1.7;
            color: color-mix(in srgb, var(--g-text) 86%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .form-control {
            min-height: 46px;
            padding: 11px 14px;
            border-radius: 14px !important;
            font-size: .9rem;
            color: var(--g-text) !important;
            -webkit-text-fill-color: var(--g-text);
            background-color: color-mix(in srgb, var(--g-nested-solid) 28%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 40%, transparent), transparent 88%) !important;
            border: 1px solid color-mix(in srgb, var(--g-text) 30%, transparent) !important;
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 70%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .form-control::placeholder {
            color: color-mix(in srgb, var(--g-text) 52%, transparent) !important;
            -webkit-text-fill-color: color-mix(in srgb, var(--g-text) 52%, transparent);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .form-control:focus {
            border-color: color-mix(in srgb, var(--g-primary) 66%, transparent) !important;
            box-shadow:
                0 0 0 3px color-mix(in srgb, var(--g-primary) 26%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 80%, transparent) !important;
            outline: none;
        }

        /* باکس‌های داخلی: یادداشت، کارت عضو، خلاصهٔ مبلغ */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box :is(.dk-note, .dk-member, .dk-chosen) {
            padding: 13px 15px !important;
            margin-bottom: 12px !important;
            border-radius: 18px !important;
            font-size: .77rem;
            line-height: 1.9;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 26%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 46%, transparent), transparent 86%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 22%, transparent) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 76%, transparent),
                0 10px 18px -16px color-mix(in srgb, var(--g-text) 58%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box :is(.dk-member, .dk-chosen) b {
            color: var(--g-text) !important;
            font-size: .93rem;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-member span {
            color: color-mix(in srgb, var(--g-text) 74%, transparent) !important;
        }

        /* چیپ‌های اعتبار داخل مودال */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-credits {
            gap: 8px;
            margin-top: 6px;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-credits em {
            padding: 6px 12px !important;
            border-radius: 999px !important;
            font-size: .7rem;
            font-weight: 750;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-primary) 15%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 44%, transparent), transparent 86%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent) !important;
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 74%, transparent) !important;
        }

        /* لیست تعرفه بلیت / سانس‌های تمدید: کارت‌های ۳بعدی با فاصلهٔ مطمئن */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-list {
            gap: 10px !important;
            padding: 4px !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-item {
            padding: 13px 15px !important;
            border-radius: 18px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 48%, transparent) !important;
            background-image:
                radial-gradient(100% 80% at 100% -20%, color-mix(in srgb, var(--g-surface-solid) 62%, transparent), transparent 62%),
                linear-gradient(152deg, color-mix(in srgb, var(--g-card-solid) 66%, transparent), color-mix(in srgb, var(--g-nested-solid) 56%, transparent)) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 26%, transparent) !important;
            box-shadow:
                0 16px 26px -20px color-mix(in srgb, var(--g-text) 60%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 82%, transparent) !important;
            transform: perspective(900px) translateY(0) rotateX(0deg);
            transition: transform .22s cubic-bezier(.2, .8, .3, 1), box-shadow .22s ease, border-color .22s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-item:hover {
            transform: perspective(900px) translateY(-3px) rotateX(2.5deg);
            border-color: color-mix(in srgb, var(--g-primary) 54%, transparent) !important;
            box-shadow:
                0 26px 36px -20px color-mix(in srgb, var(--g-text) 58%, transparent),
                0 8px 16px -12px color-mix(in srgb, var(--g-primary) 60%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 94%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-item b {
            color: var(--g-text) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-item small {
            color: color-mix(in srgb, var(--g-text) 76%, transparent) !important;
        }

        /* چیپ‌های انتخاب رشته/نوع اعتبار و مبالغ سریع */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box :is(.desk-chip, .desk-amount) {
            gap: 8px;
            margin-bottom: 12px;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box :is(.desk-chip, .desk-amount) button {
            min-height: 44px;
            padding: 10px 12px;
            border-radius: 14px !important;
            font-size: .8rem;
            font-weight: 750;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 44%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 48%, transparent), transparent 86%) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 24%, transparent) !important;
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 78%, transparent) !important;
            transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box :is(.desk-chip, .desk-amount) button:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--g-primary) 48%, transparent) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 88%, transparent),
                0 12px 20px -14px color-mix(in srgb, var(--g-text) 58%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-chip button.on {
            color: var(--g-text) !important;
            border-color: color-mix(in srgb, var(--g-primary) 52%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-primary) 40%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-primary) 52%, transparent), color-mix(in srgb, var(--g-surface-solid) 34%, transparent)) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 86%, transparent),
                0 12px 22px -16px color-mix(in srgb, var(--g-primary) 70%, transparent) !important;
        }

        /* دکمه‌های اصلی مودال: ۳بعدی، با پدینگ و فاصلهٔ مطمئن */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn {
            min-height: 48px;
            padding: 13px 16px;
            border-radius: 16px !important;
            font-size: .9rem;
            font-weight: 800;
            color: var(--g-text) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 46%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-primary) 34%, transparent) !important;
            background-image: linear-gradient(152deg, color-mix(in srgb, var(--g-surface-solid) 50%, transparent), color-mix(in srgb, var(--g-primary) 44%, transparent)) !important;
            box-shadow:
                0 16px 28px -18px color-mix(in srgb, var(--g-primary) 70%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 86%, transparent),
                inset 0 -12px 20px -16px color-mix(in srgb, var(--g-primary) 80%, transparent) !important;
            transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, filter .16s ease;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--g-primary) 62%, transparent) !important;
            box-shadow:
                0 22px 34px -18px color-mix(in srgb, var(--g-primary) 72%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 94%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn:active:not(:disabled) {
            transform: translateY(1px) scale(.995);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn:focus-visible {
            outline: 2px solid color-mix(in srgb, var(--g-primary) 80%, transparent);
            outline-offset: 2px;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn.ghost {
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 26%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 44%, transparent), transparent 86%) !important;
            border-color: color-mix(in srgb, var(--g-primary) 28%, transparent) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 78%, transparent),
                0 10px 20px -16px color-mix(in srgb, var(--g-text) 56%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn + .dk-btn {
            margin-top: 10px;
        }

        /* تعداد بلیت */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-qty {
            gap: 12px;
            margin: 14px 0;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-qty button,
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-qty input {
            min-height: 48px;
            height: 48px;
            border-radius: 15px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-nested-solid) 28%, transparent) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 28%, transparent) !important;
            box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 78%, transparent),
                0 10px 18px -14px color-mix(in srgb, var(--g-text) 56%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-qty button:hover {
            transform: translateY(-2px);
            border-color: color-mix(in srgb, var(--g-primary) 50%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-qty button {
            transition: transform .16s ease, border-color .16s ease;
        }

        /* ✅ دکمهٔ خروج هدر: همان شیشهٔ برجستهٔ ۳بعدی با تأکید رنگی */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout {
            color: var(--g-text) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 46%, transparent) !important;
            background-color: color-mix(in srgb, var(--g-primary) 22%, transparent) !important;
            background-image: linear-gradient(150deg,
                color-mix(in srgb, var(--g-surface-solid) 64%, transparent),
                color-mix(in srgb, var(--g-primary) 32%, transparent)) !important;
            box-shadow:
                0 12px 22px -14px color-mix(in srgb, var(--g-primary) 72%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 92%, transparent),
                inset 0 -10px 16px -13px color-mix(in srgb, var(--g-primary) 82%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout i {
            color: color-mix(in srgb, var(--g-primary) 92%, var(--g-text)) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout:hover {
            transform: translateY(-2px) scale(1.015);
            border-color: color-mix(in srgb, var(--g-primary) 66%, transparent) !important;
            box-shadow:
                0 18px 28px -14px color-mix(in srgb, var(--g-primary) 76%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 100%, transparent) !important;
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout:active {
            transform: translateY(1px) scale(.99);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout:focus-visible {
            outline: 2px solid color-mix(in srgb, var(--g-primary) 80%, transparent);
            outline-offset: 2px;
        }

        /* پیام کوتاه: خوانا و بدون تداخل متن با پس‌زمینه */
        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-toast {
            padding: 13px 20px;
            border-radius: 18px !important;
            color: var(--g-text) !important;
            background-color: color-mix(in srgb, var(--g-card-solid) 86%, transparent) !important;
            background-image: linear-gradient(150deg, color-mix(in srgb, var(--g-surface-solid) 62%, transparent), color-mix(in srgb, var(--g-primary) 26%, transparent)) !important;
            border: 1px solid color-mix(in srgb, var(--g-primary) 34%, transparent) !important;
            box-shadow:
                0 22px 38px -20px color-mix(in srgb, var(--g-text) 66%, transparent),
                inset 0 1px 0 color-mix(in srgb, var(--g-surface-solid) 90%, transparent) !important;
            -webkit-backdrop-filter: blur(14px) saturate(1.1);
            backdrop-filter: blur(14px) saturate(1.1);
        }

        html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-toast.err {
            background-color: color-mix(in srgb, #b91c1c 18%, var(--g-card-solid)) !important;
            border-color: color-mix(in srgb, #b91c1c 52%, transparent) !important;
            color: var(--g-text) !important;
        }

        @@media (max-width: 620px) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-modal {
                padding: 12px;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box {
                padding: 16px !important;
                border-radius: 24px !important;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-item:hover,
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn:hover:not(:disabled) {
                transform: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .desk-item:hover,
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-btn:hover:not(:disabled),
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .desk-head #btnDeskLogout:hover {
                transform: none;
                transition: box-shadow .2s ease, border-color .2s ease;
            }
            html[data-theme] body:not(#lu):not(#mt-theme):not(#app) .dk-box .dk-x:hover {
                transform: none;
            }
        }

    </style>
</head>
<body data-bio-type="desk">
    <div class="desk-wrap">
        <div class="desk-head">
            <div class="desk-brand">
                <img src="/images/logo2.png" alt="ایمن تردد تندیس" />
                <div>
                    <b>ایمن تردد تندیس</b>
                    <span>نرم افزار جامع اتوماسیون مراکز ورزشی</span>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <!-- ✅ اسم باشگاه (از دیتابیس) — سمت چپ هدر -->
                <div class="desk-user" title="@clubName"><i class="bi bi-building"></i> @clubName</div>
                <div class="desk-user"><i class="bi bi-person-badge"></i> @deskUser</div>
                <button type="button" id="btnDeskBio" class="desk-user" data-bio-enroll="password"
                        style="border:1px solid color-mix(in srgb, var(--g-text) 35%, transparent);cursor:pointer;"
                        title="ثبت/ورود با اثر انگشت یا چهره">
                    <i class="bi bi-fingerprint"></i>
                </button>
                <button type="button" id="btnDeskLogout" class="desk-user"
                        style="border:1px solid color-mix(in srgb, var(--g-text) 45%, transparent);cursor:pointer;">
                    <i class="bi bi-box-arrow-right"></i> خروج
                </button>
            </div>
        </div>

        <div class="desk-grid">
            <button type="button" class="desk-card" data-act="charge" style="@(showCard("charge") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-wallet2"></i></span>
                <span>
                    <span class="dc-title">افزایش اعتبار</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="ticket" style="@(showCard("ticket") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-ticket-perforated"></i></span>
                <span>
                    <span class="dc-title">خرید بلیت</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="single" style="@(showCard("single") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-lightning-charge"></i></span>
                <span>
                    <span class="dc-title">تک جلسه</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="register" style="@(showCard("register") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-person-plus"></i></span>
                <span>
                    <span class="dc-title">ثبت‌نام</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="renew" style="@(showCard("renew") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-arrow-repeat"></i></span>
                <span>
                    <span class="dc-title">تمدید دوره</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="shop" style="@(showCard("shop") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-bag-heart"></i></span>
                <span>
                    <span class="dc-title">فروشگاه</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="buffet" style="@(showCard("buffet") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-cup-hot"></i></span>
                <span>
                    <span class="dc-title">بوفه</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>

            <button type="button" class="desk-card" data-act="services" style="@(showCard("services") ? "" : "display:none")">
                <span class="dc-icon"><i class="bi bi-tools"></i></span>
                <span>
                    <span class="dc-title">خدمات</span>
                    
                </span>
                <span class="dc-go">شروع <i class="bi bi-arrow-left"></i></span>
            </button>
        </div>
    </div>

    <div class="dk-modal" id="dkModal">
        <div class="dk-box glass-card">
            <div class="dk-head">
                <b id="dkTitle">—</b>
                <button type="button" class="dk-x" id="dkClose">×</button>
            </div>
            <div id="dkBody"></div>
        </div>
    </div>

    <div class="dk-toast" id="dkToast"></div>

    <script>
        (function () {
            var DESK_RETURN = '/Desk';
            var CLUB = '@clubName';
            var modal = document.getElementById('dkModal');
            var body = document.getElementById('dkBody');
            var titleEl = document.getElementById('dkTitle');
            var toastEl = document.getElementById('dkToast');
            var pollTimer = null, pollCount = 0, currentTxn = null;
            var form = {};          // state بین مراحل

            function money(n) { return Number(n || 0).toLocaleString('en-US'); }

            function toast(msg, isErr) {
                toastEl.textContent = msg || '';
                toastEl.className = 'dk-toast show' + (isErr ? ' err' : '');
                clearTimeout(toastEl._t);
                toastEl._t = setTimeout(function () { toastEl.className = 'dk-toast'; }, 4200);
            }

            function openModal(title, html) {
                titleEl.textContent = title;
                body.innerHTML = html;
                modal.classList.add('open');
            }

            function stopPoll() {
                if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
                pollCount = 0;
            }

            function closeModal(cancel) {
                stopPoll();
                if (cancel && currentTxn) {
                    var id = currentTxn;
                    currentTxn = null;
                    fetch('/api/Desk/Cancel?txnId=' + id, { method: 'POST' }).catch(function () { });
                }
                currentTxn = null;
                modal.classList.remove('open');
                body.innerHTML = '';
            }

            document.getElementById('dkClose').addEventListener('click', function () { closeModal(true); });
            modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(true); });

            function api(url, data) {
                return fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data || {})
                }).then(function (r) { return r.json(); });
            }

            function loading(text, sub) {
                openModal(titleEl.textContent, '');
                body.innerHTML = '<div class="dk-center"><div class="dk-spin"></div>' +
                    '<div style="font-size:.88rem;font-weight:700" id="dkWait">' + (text || 'در حال انجام...') + '</div>' +
                    (sub ? '<div class="dk-note" style="margin-top:10px">' + sub + '</div>' : '') + '</div>';
            }

            function waitText(t, sub) {
                var w = document.getElementById('dkWait');
                if (w) w.textContent = t;
                if (sub === null) {
                    var n = body.querySelector('.dk-note');
                    if (n) n.remove();
                } else if (sub) {
                    var note = body.querySelector('.dk-note');
                    if (!note) {
                        body.querySelector('.dk-center').insertAdjacentHTML('beforeend', '<div class="dk-note" style="margin-top:10px"></div>');
                        note = body.querySelector('.dk-note');
                    }
                    note.innerHTML = sub;
                }
            }

            function errorScreen(msg, retry) {
                stopPoll();
                openModal(titleEl.textContent, '');
                body.innerHTML =
                    '<div class="dk-center" style="padding:6px 0 2px">' +
                    '<i class="bi bi-x-octagon" style="font-size:2rem;color:var(--g-primary)"></i>' +
                    '<div style="margin:10px 0 14px;font-size:.85rem;line-height:1.9">' + (msg || 'خطا') + '</div>' +
                    '<button type="button" class="dk-btn ghost" id="dkBack">بستن</button></div>';
                document.getElementById('dkBack').addEventListener('click', function () { closeModal(false); });
                toast(msg, true);
                if (retry) { /* retry توسط دکمهٔ اختصاصی هر مرحله */ }
            }

            // ✅ اگر فیش داشته باشیم: نمایش فیش + چاپ خودکار روی پرینتر POS
            function successScreen(msg, receipt) {
                stopPoll();
                openModal(titleEl.textContent, '');

                if (receipt && window.DeskReceipt) {
                    receipt.club = receipt.club || CLUB;
                    receipt.message = msg || receipt.message;
                    window.DeskReceipt.show(receipt, function () { closeModal(false); });
                    return;
                }

                body.innerHTML =
                    '<div class="dk-center" style="padding:8px 0 2px">' +
                    '<i class="bi bi-check2-circle" style="font-size:2.3rem;color:var(--g-primary)"></i>' +
                    '<div style="margin:10px 0 16px;font-size:.88rem;line-height:1.9">' + (msg || 'انجام شد') + '</div>' +
                    '<button type="button" class="dk-btn" id="dkDone">پایان</button></div>';
                document.getElementById('dkDone').addEventListener('click', function () { closeModal(false); });
                toast(msg);
            }

            // ---- ارسال به POS و انتظار کارت ----
            // receiptOf(res) اختیاری است: فیش تراکنش را از پاسخ نهایی می‌سازد
            function startPos(prepare, confirm, receiptOf) {
                loading('در حال ارسال مبلغ به دستگاه...', 'کارت‌خوان را به مشتری بدهید');
                prepare().then(function (r) {
                    if (!r) return errorScreen('خطا در ارتباط با سرور');
                    if (!r.success) return errorScreen(r.message);
                    if (!r.paymentPending) {
                        // پرداخت از اعتبار یا انجام مستقیم (مبلغ صفر)
                        return successScreen(r.message, receiptOf ? receiptOf(r) : null);
                    }
                    currentTxn = r.posTxnId;
                    waitForCard(confirm, r.posAmount, receiptOf);
                });
            }

            function waitForCard(confirm, amount, receiptOf) {
                loading('مبلغ ' + money(amount) + ' ریال — منتظر کشیدن کارت...', 'پرداخت در صف دستگاه است');
                var go = function () {
                    fetch('/api/Desk/Status?txnId=' + currentTxn).then(function (r) { return r.json(); }).then(function (res) {
                        var d = res && res.data;
                        if (!d) { pollTimer = setTimeout(go, 2200); return; }

                        if (d.status === 'pending') {
                            pollCount++;
                            if (pollCount > 150) { errorScreen('مهلت پرداخت به پایان رسید'); return; }
                            if (d.deviceBusy) waitText('دستگاه برای مراجع دیگر مشغول است...', 'لطفاً چند لحظه صبر کنید');
                            else if (d.processing) waitText('مبلغ روی دستگاه است — کارت بکشید', 'مبلغ ' + money(d.amount) + ' ریال');
                            else if (d.queuePosition > 0) waitText('در نوبت پرداخت (' + d.queuePosition + ' نفر جلوتر)', null);
                            else waitText('نوبت شماست — مبلغ روی دستگاه نمایش داده می‌شود', null);
                            pollTimer = setTimeout(go, 2200);
                            return;
                        }

                        if (d.status === 'success') {
                            stopPoll();
                            loading('پرداخت انجام شد — در حال ثبت...', null);
                            confirm(currentTxn).then(function (c) {
                                if (c && c.success) successScreen(c.message, receiptOf ? receiptOf(c) : null);
                                else errorScreen((c && c.message) || 'ثبت نهایی انجام نشد');
                            });
                            return;
                        }

                        errorScreen(d.message || 'پرداخت ناموفق بود');
                    }).catch(function () { pollTimer = setTimeout(go, 2600); });
                };
                pollTimer = setTimeout(go, 1400);
            }

            // ============================================================
            //  ۱) افزایش اعتبار
            // ============================================================
            // ✅ سه گزینهٔ افزایش اعتبار: ورزشی / فروشگاه و بوفه (یک اعتبار مشترک) / خدمات
            function creditTypesHtml() {
                return '<div class="desk-chip" id="dkTypes">' +
                    '<button type="button" data-t="11" data-l="ورزشی" class="on">ورزشی</button>' +
                    '<button type="button" data-t="2" data-l="فروشگاه و بوفه">فروشگاه و بوفه</button>' +
                    '<button type="button" data-t="3" data-l="خدمات">خدمات</button>' +
                    '</div>';
            }

            function openCharge() {
                form = { creditType: 11, creditLabel: 'ورزشی' };
                openModal('افزایش اعتبار', '' +
                    '<div class="dk-note">کد ملی و رمز عبور عضو را وارد کنید، سپس نوع اعتبار و مبلغ را انتخاب کنید.</div>' +
                    '<div style="margin-bottom:10px"><label>کد ملی</label>' +
                    '<input class="form-control" id="dkNc" name="deskNationalCode" inputmode="numeric" maxlength="10" placeholder="۱۰ رقم" autocomplete="off" autocapitalize="off" spellcheck="false" dir="ltr" readonly onfocus="this.removeAttribute(\'readonly\')" /></div>' +
                    '<div style="margin-bottom:14px"><label>رمز عبور</label>' +
                    '<input class="form-control" id="dkPw" type="password" placeholder="رمز عضو" autocomplete="new-password" dir="ltr" /></div>' +
                    '<button type="button" class="dk-btn" id="dkNext">ادامه</button>');

                document.getElementById('dkNext').addEventListener('click', function () {
                    var nc = (document.getElementById('dkNc').value || '').trim();
                    var pw = document.getElementById('dkPw').value || '';
                    if (nc.length !== 10) return toast('کد ملی باید ۱۰ رقم باشد', true);
                    if (!pw) return toast('رمز عبور را وارد کنید', true);
                    loading('در حال بررسی عضو...', null);
                    api('/api/Desk/FindMember', { nationalCode: nc, password: pw, requirePassword: true }).then(function (r) {
                        if (!r.success) return errorScreen(r.message);
                        form.nc = nc; form.pw = pw; form.name = r.data.fullName; form.before = r.data;
                        openModal('افزایش اعتبار', '' +
                            '<div class="dk-member"><div><b>' + r.data.fullName + '</b>' +
                            '<span>' + r.data.nationalCode + '</span></div></div>' +
                            '<div class="dk-credits" style="margin-bottom:12px">' +
                            '<em>ورزشی: ' + money(r.data.sportCredit) + '</em>' +
                            '<em>فروشگاه: ' + money(r.data.shopCredit) + '</em>' +
                            '<em>خدمات: ' + money(r.data.serviceCredit) + '</em></div>' +
                            creditTypesHtml() +
                            '<div style="margin-bottom:12px"><label>مبلغ (ریال)</label>' +
                            '<input class="form-control" id="dkAmt" inputmode="numeric" placeholder="مثلاً 500000" /></div>' +
                            '<div class="desk-amount" id="dkQuick">' +
                            '<button type="button" data-a="100000">۱۰۰٬۰۰۰</button>' +
                            '<button type="button" data-a="200000">۲۰۰٬۰۰۰</button>' +
                            '<button type="button" data-a="500000">۵۰۰٬۰۰۰</button>' +
                            '<button type="button" data-a="1000000">۱٬۰۰۰٬۰۰۰</button></div>' +
                            '<button type="button" class="dk-btn" id="dkPay">ارسال مبلغ به کارت‌خوان</button>');

                        document.getElementById('dkTypes').addEventListener('click', function (e) {
                            var b = e.target.closest('button'); if (!b) return;
                            [].forEach.call(this.querySelectorAll('button'), function (x) { x.classList.remove('on'); });
                            b.classList.add('on');
                            form.creditType = Number(b.dataset.t);
                            form.creditLabel = b.dataset.l || '';
                        });
                        document.getElementById('dkQuick').addEventListener('click', function (e) {
                            var b = e.target.closest('button'); if (!b) return;
                            document.getElementById('dkAmt').value = b.dataset.a;
                        });
                        document.getElementById('dkPay').addEventListener('click', function () {
                            var amt = Number((document.getElementById('dkAmt').value || '').replace(/[^0-9]/g, ''));
                            if (!amt || amt < 1000) return toast('مبلغ را صحیح وارد کنید', true);
                            form.amount = amt;
                            startPos(
                                function () {
                                    return api('/api/Desk/Charge', {
                                        nationalCode: form.nc, password: form.pw,
                                        amount: form.amount, creditType: form.creditType, label: form.creditLabel
                                    });
                                },
                                function (txn) {
                                    return api('/api/Desk/Charge', {
                                        nationalCode: form.nc, password: form.pw,
                                        amount: form.amount, creditType: form.creditType, label: form.creditLabel, posTxnId: txn
                                    });
                                },
                                function () {
                                    return {
                                        title: 'رسید دریافت وجه',
                                        party: form.name,
                                        rows: [{ name: 'افزایش اعتبار ' + (form.creditLabel || 'ورزشی'), qty: 1, amount: form.amount }],
                                        total: form.amount,
                                        paymentMethod: 'کارتخوان',
                                        section: 'charge',
                                        note: 'اعتبار به حساب عضو اضافه شد'
                                    };
                                });
                        });
                    });
                });
            }

            // ============================================================
            //  ۲) بلیت
            // ============================================================
            function openTicket() {
                loading('در حال دریافت تعرفه‌ها...', null);
                api('/api/Desk/Tarefe', {}).then(function (r) {
                    if (!r.success) return errorScreen(r.message);
                    var list = r.data || [];
                    if (!list.length) return errorScreen('تعرفهٔ فعالی برای این شیفت تعریف نشده است');

                    var html = '<div class="dk-note">تعرفه را انتخاب کنید؛ مبلغ مستقیم روی کارت‌خوان ارسال می‌شود.</div><div class="desk-list">';
                    list.forEach(function (t) {
                        html += '<button type="button" class="desk-item" data-id="' + t.tarefeID + '" data-amt="' + t.amount + '" data-name="' + (t.tarefe || 'بلیت') + '">' +
                            '<span><b>' + t.tarefe + '</b><small>' + (t.sans || '') + '</small></span>' +
                            '<b>' + t.amountDisplay + '</b></button>';
                    });
                    html += '</div>';
                    openModal('خرید بلیت', html);

                    body.querySelector('.desk-list').addEventListener('click', function (e) {
                        var b = e.target.closest('.desk-item'); if (!b) return;
                        var id = Number(b.dataset.id), amt = Number(b.dataset.amt), tname = b.dataset.name || 'بلیت';
                        var qty = 1;

                        openModal('خرید بلیت', '<div class="dk-chosen"><span>مبلغ هر بلیت</span><b>' + money(amt) + ' ریال</b></div>' +
                            '<div class="dk-note">تعداد بلیت را مشخص کنید؛ برای هر بلیت یک شمارهٔ جداگانه صادر می‌شود.</div>' +
                            '<div class="dk-qty">' +
                            '<button type="button" id="dkQtyMinus" aria-label="کاهش تعداد">−</button>' +
                            '<input id="dkQty" inputmode="numeric" maxlength="2" value="1" autocomplete="off" />' +
                            '<button type="button" id="dkQtyPlus" aria-label="افزایش تعداد">+</button></div>' +
                            '<div class="dk-chosen" style="margin-top:6px"><span>مبلغ قابل پرداخت</span><b id="dkLineTotal">' + money(amt) + ' ریال</b></div>' +
                            '<div class="dk-note">پس از تأیید، مبلغ روی دستگاه ارسال می‌شود. بعد از کشیدن کارت، بلیت‌ها صادر و ثبت می‌شوند.</div>' +
                            '<button type="button" class="dk-btn" id="dkPay">ارسال به کارت‌خوان</button>');

                        var qtyInput = document.getElementById('dkQty');
                        var qtyTotal = document.getElementById('dkLineTotal');

                        function readQty() {
                            var n = parseInt((qtyInput.value || '').replace(/[^0-9]/g, ''), 10);
                            if (!n || n < 1) n = 1;
                            if (n > 50) n = 50;
                            return n;
                        }
                        function setQty(n) {
                            qty = Math.max(1, Math.min(50, n || 1));
                            qtyInput.value = qty;
                            qtyTotal.textContent = money(amt * qty) + ' ریال';
                        }

                        document.getElementById('dkQtyMinus').addEventListener('click', function () { setQty(qty - 1); });
                        document.getElementById('dkQtyPlus').addEventListener('click', function () { setQty(qty + 1); });
                        qtyInput.addEventListener('input', function () { setQty(readQty()); });
                        qtyInput.addEventListener('blur', function () { setQty(readQty()); });

                        document.getElementById('dkPay').addEventListener('click', function () {
                            setQty(readQty());
                            startPos(
                                function () { return api('/api/Desk/BuyTicket', { tarefeID: id, qty: qty }); },
                                function (txn) { return api('/api/Desk/BuyTicket', { tarefeID: id, qty: qty, posTxnId: txn }); },
                                function () {
                                    return {
                                        title: 'فیش خرید بلیت',
                                        partySub: qty > 1 ? ('تعداد: ' + money(qty) + ' عدد') : null,
                                        rows: [{ name: tname, qty: qty, amount: amt }],
                                        total: amt * qty,
                                        paymentMethod: amt > 0 ? 'کارتخوان' : 'رایگان',
                                        section: 'ticket',
                                        note: 'این بلیت فقط برای همان سانس معتبر است'
                                    };
                                });
                        });
                    });
                });
            }

            // ============================================================
            //  ۳) تک جلسه
            // ============================================================
            function openSingle() {
                loading('در حال دریافت سانس‌های امروز...', null);
                api('/api/Desk/Sessions', {}).then(function (r) {
                    if (!r.success) return errorScreen(r.message);
                    var list = r.data || [];
                    if (!list.length) return errorScreen('امروز سانس تک‌جلسه‌ای تعریف نشده است');

                    var html = '<div class="dk-note">سانس امروز را انتخاب کنید.</div><div class="desk-list">';
                    list.forEach(function (s) {
                        html += '<button type="button" class="desk-item" data-id="' + s.sportSanseID + '" data-amt="' + s.sessionAmount + '" data-name="' + ((s.sportName || '') + ' — ' + (s.sanseName || '')) + '">' +
                            '<span><b>' + (s.sportName || '') + ' — ' + (s.sanseName || '') + '</b>' +
                            '<small>' + (s.startTime || '') + ' تا ' + (s.endTime || '') + (s.coachName ? ' | ' + s.coachName : '') + '</small></span>' +
                            '<b>' + s.sessionAmountDisplay + '</b></button>';
                    });
                    html += '</div>';
                    openModal('تک جلسه امروز', html);

                    body.querySelector('.desk-list').addEventListener('click', function (e) {
                        var b = e.target.closest('.desk-item'); if (!b) return;
                        var id = Number(b.dataset.id), amt = Number(b.dataset.amt), sname = b.dataset.name || 'تک جلسه';
                        // ✅ تک جلسهٔ مهمان: کد ملی لازم نیست — فقط نام و موبایل
                        openModal('تک جلسهٔ مهمان', '<div class="dk-chosen"><span>مبلغ تک جلسه</span><b>' + money(amt) + ' ریال</b></div>' +
                            '<div class="dk-note">کد ملی لازم نیست. نام و شمارهٔ موبایل مهمان را وارد کنید؛ پس از پرداخت موفق، تردد به نام «مهمان» در سوابق باشگاه ثبت می‌شود.</div>' +
                            '<div style="margin-bottom:10px"><label>نام و نام خانوادگی مهمان</label>' +
                            '<input class="form-control" id="dkGName" placeholder="مثلاً علی رضایی" /></div>' +
                            '<div style="margin-bottom:14px"><label>شمارهٔ موبایل</label>' +
                            '<input class="form-control" id="dkGMobile" inputmode="numeric" maxlength="11" placeholder="۰۹xxxxxxxxx" /></div>' +
                            '<button type="button" class="dk-btn" id="dkPay">ارسال به کارت‌خوان</button>');
                        document.getElementById('dkPay').addEventListener('click', function () {
                            var gn = (document.getElementById('dkGName').value || '').trim();
                            var gm = (document.getElementById('dkGMobile').value || '').replace(/[^0-9]/g, '');
                            if (gn.length < 3) return toast('نام و نام خانوادگی مهمان را وارد کنید', true);
                            if (!/^09\d{9}$/.test(gm)) return toast('شمارهٔ موبایل باید با 09 شروع و ۱۱ رقم باشد', true);
                            startPos(
                                function () { return api('/api/Desk/BuySingleGuest', { sportSanseID: id, guestName: gn, guestMobile: gm }); },
                                function (txn) { return api('/api/Desk/BuySingleGuest', { sportSanseID: id, guestName: gn, guestMobile: gm, posTxnId: txn }); },
                                function () {
                                    return {
                                        title: 'فیش تک جلسه',
                                        party: gn,
                                        partySub: 'موبایل: ' + gm,
                                        rows: [{ name: sname, qty: 1, amount: amt }],
                                        total: amt,
                                        paymentMethod: amt > 0 ? 'کارتخوان' : 'رایگان',
                                        section: 'single',
                                        note: 'این رسید فقط برای همین جلسه معتبر است'
                                    };
                                });
                        });
                    });
                });
            }

            // ============================================================
            //  ۵) ثبت‌نام / تمدید دوره — انتخاب رشته و سانس‌های همان رشته
            // ============================================================
            function openRenew() {
                form = {};
                openModal('ثبت‌نام و تمدید دوره', '' +
                    '<div class="dk-note">کد ملی و رمز عبور عضو را وارد کنید تا رشته‌ها و سانس‌های همان رشته نمایش داده شود.</div>' +
                    '<div style="margin-bottom:10px"><label>کد ملی</label>' +
                    '<input class="form-control" id="dkNc" name="deskNationalCode" inputmode="numeric" maxlength="10" placeholder="۱۰ رقم" autocomplete="off" autocapitalize="off" spellcheck="false" dir="ltr" readonly onfocus="this.removeAttribute(\'readonly\')" /></div>' +
                    '<div style="margin-bottom:14px"><label>رمز عبور</label>' +
                    '<input class="form-control" id="dkPw" type="password" placeholder="رمز عضو" autocomplete="new-password" dir="ltr" /></div>' +
                    '<button type="button" class="dk-btn" id="dkNext">مشاهدهٔ رشته‌ها</button>');

                document.getElementById('dkNext').addEventListener('click', function () {
                    var nc = (document.getElementById('dkNc').value || '').trim();
                    var pw = document.getElementById('dkPw').value || '';
                    if (nc.length !== 10) return toast('کد ملی باید ۱۰ رقم باشد', true);
                    if (!pw) return toast('رمز عبور را وارد کنید', true);
                    form.nc = nc; form.pw = pw;
                    loading('در حال بررسی عضو...', null);
                    api('/api/Desk/FindMember', { nationalCode: nc, password: pw, requirePassword: true }).then(function (r) {
                        if (!r.success) return errorScreen(r.message);
                        form.name = r.data.fullName;
                        form.credit = r.data.sportCredit;
                        loadDeskCategories();
                    });
                });
            }

            function loadDeskCategories() {
                api('/api/Desk/SportCategories', {}).then(function (res) {
                    var cats = (res && res.success && res.data) ? res.data : [];
                    var chips = '<div class="desk-chip" id="dkCats" style="margin-bottom:10px">' +
                        '<button type="button" data-id="0" class="on">همه رشته‌ها</button>';
                    cats.forEach(function (c) {
                        chips += '<button type="button" data-id="' + c.sportCatID + '">' + (c.sportName || '') + '</button>';
                    });
                    chips += '</div>';

                    openModal('ثبت‌نام / تمدید دوره', '' +
                        '<div class="dk-member"><div><b>' + form.name + '</b>' +
                        '<span>اعتبار ورزشی: ' + money(form.credit) + ' ریال</span></div></div>' +
                        '<div class="dk-note">اول رشته را انتخاب کنید؛ سپس سانس‌های همان رشته را می‌بینید. دورهٔ فعال «تمدید» و دورهٔ جدید «ثبت‌نام» دارد.</div>' +
                        chips + '<div id="dkSanses"><div class="dk-center"><div class="dk-spin"></div></div></div>');

                    document.getElementById('dkCats').addEventListener('click', function (e) {
                        var b = e.target.closest('button'); if (!b) return;
                        [].forEach.call(this.querySelectorAll('button'), function (x) { x.classList.remove('on'); });
                        b.classList.add('on');
                        loadDeskSanses(Number(b.dataset.id));
                    });

                    loadDeskSanses(0);
                });
            }

            function loadDeskSanses(catId) {
                var box = document.getElementById('dkSanses');
                if (box) box.innerHTML = '<div class="dk-center"><div class="dk-spin"></div></div>';

                api('/api/Desk/Periods', { nationalCode: form.nc, password: form.pw, sportCatID: catId || 0 }).then(function (r) {
                    box = document.getElementById('dkSanses');
                    if (!r.success) return errorScreen(r.message);

                    var list = r.data.periods || [];
                    form.periods = list;
                    if (!box) return;

                    if (!list.length) {
                        box.innerHTML = '<div class="dk-note">برای این رشته سانس فعالی تعریف نشده است.</div>';
                        return;
                    }

                    var html = '<div class="desk-list">';
                    list.forEach(function (p, i) {
                        var isRenew = p.hasActiveRegister === true;
                        html += '<button type="button" class="desk-item" data-i="' + i + '">' +
                            '<span><b>' + (p.sportName || '') + ' — ' + (p.sanseName || '') + '</b>' +
                            '<small>' + (p.periodDesc || '') + ' | ' + (p.sessionCountInPeriod || 0) + ' جلسه' +
                            (p.coachName ? ' | ' + p.coachName : '') +
                            (isRenew ? ' | فعال تا ' + (p.endDate || '') : '') + '</small></span>' +
                            '<b>' + (p.totalAmountDisplay || '') + '<br><small style="font-weight:600">' +
                            (isRenew ? 'تمدید' : 'ثبت‌نام') + '</small></b></button>';
                    });
                    html += '</div>';
                    box.innerHTML = html;

                    box.querySelector('.desk-list').addEventListener('click', function (e) {
                        var b = e.target.closest('.desk-item'); if (!b) return;
                        var p = form.periods[Number(b.dataset.i)];
                        if (p) openCoursePay(p, p.hasActiveRegister === true);
                    });
                });
            }

            function openCoursePay(p, isRenew) {
                form.sanse = p.sportSanseID;
                form.amount = p.totalAmount || 0;
                form.sportName = (p.sportName || '') + ' — ' + (p.sanseName || '');

                function receiptOf(res, method) {
                    return {
                        title: isRenew ? 'رسید تمدید دوره' : 'رسید ثبت‌نام دوره',
                        party: form.name,
                        rows: [{ name: form.sportName, qty: 1, amount: form.amount }],
                        total: form.amount,
                        paymentMethod: method,
                        section: isRenew ? 'renew' : 'register',
                        refNo: (res && res.register && res.register.sportMemberID) ? String(res.register.sportMemberID) : null,
                        note: (res && res.register && res.register.endDate) ? ('اعتبار تا ' + res.register.endDate) : null
                    };
                }

                var head = '<div class="dk-chosen"><span>' + form.sportName + '</span><b>' + money(form.amount) + ' ریال</b></div>';
                var title = isRenew ? 'تمدید دوره' : 'ثبت‌نام دوره';

                // ✅ مبلغ صفر → بدون ارسال به کارت‌خوان، همان لحظه ثبت می‌شود
                if (form.amount <= 0) {
                    openModal(title, head +
                        '<div class="dk-note">مبلغ این دوره صفر است؛ به کارت‌خوان ارسال نمی‌شود و همان لحظه برای عضو ثبت می‌شود.</div>' +
                        '<button type="button" class="dk-btn" id="dkFree">ثبت ' + (isRenew ? 'تمدید' : 'ثبت‌نام') + '</button>');

                    document.getElementById('dkFree').addEventListener('click', function () {
                        loading('در حال ثبت...', null);
                        api('/api/Desk/RegisterCourse', { nationalCode: form.nc, password: form.pw, sportSanseID: form.sanse, method: 'credit' })
                            .then(function (rr) {
                                if (!rr.success) return errorScreen(rr.message);
                                successScreen(rr.message, receiptOf(rr, 'رایگان'));
                            });
                    });
                    return;
                }

                openModal(title, head +
                    '<div class="dk-note">روش پرداخت را انتخاب کنید. ' + (isRenew ? 'تمدید' : 'ثبت‌نام') + ' بعد از پرداخت ثبت می‌شود.</div>' +
                    '<button type="button" class="dk-btn" id="dkPos" style="margin-bottom:10px">پرداخت با کارت‌خوان</button>' +
                    '<button type="button" class="dk-btn ghost" id="dkCredit">پرداخت از اعتبار ورزشی</button>');

                document.getElementById('dkPos').addEventListener('click', function () {
                    startPos(
                        function () { return api('/api/Desk/RegisterCourse', { nationalCode: form.nc, password: form.pw, sportSanseID: form.sanse, method: 'pos' }); },
                        function (txn) { return api('/api/Desk/RegisterCourse', { nationalCode: form.nc, password: form.pw, sportSanseID: form.sanse, method: 'pos', posTxnId: txn }); },
                        function (res) { return receiptOf(res, 'کارت‌خوان'); });
                });

                document.getElementById('dkCredit').addEventListener('click', function () {
                    loading('در حال ثبت از اعتبار...', null);
                    api('/api/Desk/RegisterCourse', { nationalCode: form.nc, password: form.pw, sportSanseID: form.sanse, method: 'credit' })
                        .then(function (rr) {
                            if (!rr.success) return errorScreen(rr.message);
                            successScreen(rr.message, receiptOf(rr, 'اعتبار ورزشی'));
                        });
                });
            }

            // ============================================================
            //  کارت‌ها
            // ============================================================
            document.querySelectorAll('.desk-card').forEach(function (c) {
                c.addEventListener('click', function () {
                    var act = c.dataset.act;
                    if (act === 'charge') openCharge();
                    else if (act === 'ticket') openTicket();
                    else if (act === 'single') openSingle();
                    else if (act === 'renew') openRenew();
                    else if (act === 'register') window.location.href = '/Account/Register?desk=1';
                    else if (act === 'shop') window.location.href = '/Desk/Shop';
                    else if (act === 'buffet') window.location.href = '/Desk/Buffet';
                    else if (act === 'services') window.location.href = '/Desk/Services';
                });
            });

            // ============================================================
            //  ✅ خروج امن — همیشه با رمز عبور (یا اثر انگشت ثبت‌شده)
            // ============================================================
            function openLogout() {
                openModal('خروج از حساب', '' +
                    '<div class="dk-note">برای خروج، رمز عبور خود را وارد کنید. کسی نمی‌تواند بدون رمز شما از حساب خارج شود.</div>' +
                    '<div style="margin-bottom:14px"><label>رمز عبور</label>' +
                    '<input class="form-control" id="dkOutPw" type="password" placeholder="رمز عبور شما" /></div>' +
                    '<button type="button" class="dk-btn" id="dkOutGo">خروج</button>' +
                    '<button type="button" class="dk-btn ghost" id="dkOutBio" style="margin-top:8px">' +
                    '<i class="bi bi-fingerprint"></i> ورود با اثر انگشت / چهره</button>');

                document.getElementById('dkOutGo').addEventListener('click', function () {
                    var pw = document.getElementById('dkOutPw').value || '';
                    if (!pw) return toast('رمز عبور را وارد کنید', true);
                    loading('در حال بررسی...', null);
                    api('/api/Desk/Logout', { password: pw }).then(function (r) {
                        if (!r.success) return errorScreen(r.message);
                        window.location.href = r.redirect || '/Account/Login';
                    });
                });

                document.getElementById('dkOutBio').addEventListener('click', function () {
                    if (!window.TandisBio) return toast('احراز هویت بیومتریک در دسترس نیست', true);
                    loading('در حال بررسی اثر انگشت / چهره...', 'انگشت خود را روی سنسور دستگاه بگذارید');
                    window.TandisBio.verify('desk-logout').then(function (ticket) {
                        api('/api/Desk/Logout', { password: '', biometricTicket: ticket }).then(function (r) {
                            if (!r.success) return errorScreen(r.message);
                            window.location.href = r.redirect || '/Account/Login';
                        });
                    }).catch(function (e) {
                        errorScreen((e && e.message) || 'تأیید بیومتریک انجام نشد');
                    });
                });
            }

            document.getElementById('btnDeskLogout').addEventListener('click', openLogout);

            // ✅ خروج خودکار از پروفایل عضو: ۶۰ ثانیه بدون کلیک/لمس
            (function () {
                var last = Date.now();
                ['pointerdown', 'mousedown', 'touchstart', 'keydown', 'wheel', 'scroll'].forEach(function (ev) {
                    document.addEventListener(ev, function () { last = Date.now(); }, { passive: true });
                });
                setInterval(function () {
                    var profileOpen = modal.classList.contains('open') && body.querySelector('.dk-member');
                    if (!profileOpen) { last = Date.now(); return; }
                    if (Date.now() - last < 60000) return;
                    closeModal(false);
                    last = Date.now();
                    toast('به دلیل ۱ دقیقه بی‌کاری از پروفایل عضو خارج شد');
                }, 5000);
            })();
        })();
    </script>
    <script src="~/js/desk-receipt.js" asp-append-version="true"></script>
    <script src="~/js/biometric.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
