@{
    ViewData["Title"] = "پیام‌های من";
    var coaches = ViewBag.Coaches as List<TandisWebApp.DTOs.MemberCoachDto> ?? new List<TandisWebApp.DTOs.MemberCoachDto>();
    var chat = ViewBag.Chat as TandisWebApp.DTOs.CoachChatDto;
    var currentCoachID = (int)(ViewBag.CurrentCoachID ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0">
        <i class="bi bi-chat-dots-fill hd-icon"></i> پیام‌های من
        <span class="ms-unread ms-unread-static" id="unreadBadge" style="display:none">۰</span>
    </h5>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="purple-style coach-back-pill" id="btnMarkAll"><i class="bi bi-check2-all"></i> خواندن همه</button>
        <a href="/Home" class="purple-style coach-back-pill"><i class="bi bi-arrow-right"></i> داشبورد</a>
    </div>
</div>

<p class="small mb-3" style="color:#9fb3c8">
    <i class="bi bi-info-circle me-1"></i>
    در این بخش پیام‌هایی که مدیریت برای شما فرستاده نمایش داده می‌شود. برای خواندن متن کامل روی پیام بزنید.
</p>

<div class="row g-3" id="adminMsgsList">
    <div class="col-12">
        <div class="ms-empty">در حال بارگذاری پیام‌ها...</div>
    </div>
</div>

@* ⛔ محدودسازی پیام‌رسانی (غیرفعال شده — فقط کامنت شده، حذف نشده):
   فقط ادمین اجازه‌ی ارسال پیام دارد؛ ارسال عضو به مدیریت و گفتگوی عضو با مربی غیرفعال شد.
   برای فعال‌سازی دوباره کافی است کامنت‌های زیر برداشته شود. *@
@*
<div class="row g-3 mt-2">
    <div class="col-md-6">
        <div class="purple-style ms-card">
            <div class="ms-name mb-2">✉️ پیام به مدیریت</div>
            <input type="text" id="txtAdminTitle" class="form-control mb-2" placeholder="عنوان (اختیاری)" maxlength="200" />
            <textarea id="txtAdminBody" class="form-control mb-2" rows="3" placeholder="متن پیام..."></textarea>
            <button type="button" class="btn btn-primary btn-sm w-100" id="btnSendAdmin">📤 ارسال به مدیریت</button>
        </div>
    </div>
    <div class="col-md-6">
        <div class="purple-style ms-card">
            <div class="ms-name mb-2">🏋️ مربی‌های من</div>
            @foreach (var c in coaches)
            {
                <a href="/Profile/Messages?coachID=@c.CoachMemberID" class="d-block text-decoration-none coach-item">
                    @c.CoachName — @c.LastMessage
                </a>
            }
        </div>
    </div>
</div>
*@

<style>
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: #66d3e8;
        }

        .coach-back-pill:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

    .ms-empty {
        background: linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: #9fb3c8;
        font-size: .9rem;
    }

    .ms-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 18px;
        padding: 16px;
        cursor: pointer;
        transition: transform .25s, border-color .25s;
        -webkit-tap-highlight-color: transparent;
    }

        .ms-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.25), transparent 70%);
            pointer-events: none;
        }

    .ms-card-unread {
        border-color: rgba(102,211,232,.45);
        box-shadow: 0 6px 18px rgba(46,134,222,.18);
    }

    .ms-avatar {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
        background: linear-gradient(135deg, #667eea, #764ba2);
        box-shadow: 0 5px 14px rgba(118,75,162,.4);
    }

    /* آواتار پیام‌های ارسالی — آبی تا از دریافتی متمایز شود */
    .ms-avatar-out {
        background: linear-gradient(135deg, #2196f3, #2172d6);
        box-shadow: 0 5px 14px rgba(33,114,214,.4);
    }

    .ms-name {
        font-weight: 800;
        color: #fff;
        font-size: .95rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ms-unread {
        flex: 0 0 auto;
        background: #ff6b81;
        color: #fff;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: .68rem;
        font-weight: 800;
        box-shadow: 0 2px 8px rgba(255,107,129,.5);
        white-space: nowrap;
    }

    .ms-unread-static {
        font-size: .7rem;
        vertical-align: middle;
        margin-right: 6px;
    }

    /* چیپ «ارسالی» برای پیام‌های خروجی */
    .ms-chip-out {
        flex: 0 0 auto;
        background: rgba(33,146,246,.25);
        border: 1px solid rgba(33,146,246,.45);
        color: #9fd0ff;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .ms-arrow {
        flex: 0 0 auto;
        color: #66d3e8;
        transition: transform .25s;
        margin-top: 4px;
    }

    .ms-card.open .ms-arrow {
        transform: rotate(180deg);
    }

    .ms-preview {
        margin-top: 12px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 9px 12px;
        color: #cbd3da;
        font-size: .8rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ms-card.open .ms-preview {
        display: none;
    }

    .ms-full {
        margin-top: 12px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 11px 13px;
        color: #e9ecef;
        font-size: .85rem;
        line-height: 1.9;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ms-date {
        font-size: .68rem;
        color: #8a93a6;
        margin-top: 6px;
    }
</style>

@section Scripts {
    <script>
        var adminMsgs = [];

        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ✅ ساخت HTML یک کارت پیام — استایل کارت‌های پنل مربی
        function msgCardHtml(m) {
            var isIn = m.direction === 'in';
            var unread = isIn && !m.isRead;
            var title = m.title ? esc(m.title) : (isIn ? '(بدون عنوان)' : 'پیام به مدیریت');
            var body = esc(m.body || '');
            var date = esc(m.creationDate || '') + ' - ' + esc(m.creationTime || '');

            return '<div class="col-12">' +
                '<div class="ms-card ' + (unread ? 'ms-card-unread' : '') + '" data-id="' + m.messageID + '" data-dir="' + m.direction + '" data-read="' + (unread ? '0' : '1') + '" onclick="toggleMsg(this)">' +
                    '<div class="d-flex align-items-start gap-3">' +
                        '<div class="ms-avatar ' + (isIn ? '' : 'ms-avatar-out') + '"><i class="bi ' + (isIn ? 'bi-envelope-fill' : 'bi-send-fill') + '"></i></div>' +
                        '<div class="flex-grow-1" style="min-width:0">' +
                            '<div class="d-flex align-items-center justify-content-between gap-2">' +
                                '<div class="ms-name">' + (isIn ? title : '📤 ' + title) + '</div>' +
                                (unread ? '<span class="ms-unread ms-dot">جدید</span>'
                                        : (!isIn ? '<span class="ms-chip-out">ارسالی</span>' : '')) +
                            '</div>' +
                            '<div class="ms-preview">' + body + '</div>' +
                            '<div class="ms-full" style="display:none">' + body + '</div>' +
                            '<div class="ms-date">' + date + '</div>' +
                        '</div>' +
                        '<i class="bi bi-chevron-down ms-arrow"></i>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }

        function renderMsgs() {
            var $box = $('#adminMsgsList');
            if (!$box.length) return;
            if (!adminMsgs.length) {
                $box.html('<div class="col-12"><div class="ms-empty">' +
                    '<div style="font-size:2.4rem" class="mb-2">📭</div>' +
                    'هنوز پیامی از طرف مدیریت برای شما ارسال نشده است</div></div>');
                return;
            }
            var html = '';
            adminMsgs.forEach(function (m) { html += msgCardHtml(m); });
            $box.html(html);
            renderBadge();
        }

        function renderBadge() {
            var badge = document.getElementById('unreadBadge');
            if (!badge) return;
            var n = adminMsgs.filter(function (m) { return m.direction === 'in' && !m.isRead; }).length;
            if (n > 0) {
                badge.style.display = '';
                badge.textContent = n.toLocaleString('fa-IR');
            } else {
                badge.style.display = 'none';
            }
        }

        // ========== بارگذاری پیام‌های مدیریت ==========
        function loadAdminMsgs() {
            apiCall('/api/Account/Messages', 'GET', null, function (res) {
                var $box = $('#adminMsgsList');
                if (!$box.length) return;
                if (!res.success) {
                    $box.html('<div class="col-12"><div class="ms-empty">خطا در بارگذاری پیام‌ها</div></div>');
                    return;
                }
                // فقط پیام‌های سیستمی/مدیریت (بدون گفتگوی مربی)
                adminMsgs = (res.data || []).filter(function (m) { return !m.peerMemberID; });
                renderMsgs();
            });
        }

        // ✅ باز/بسته کردن پیام + علامت‌گذاری خوانده‌شده (فقط خواندنی — امکان پاسخ وجود ندارد)
        function toggleMsg(el) {
            var open = el.classList.toggle('open');
            var full = el.querySelector('.ms-full');
            if (full) full.style.display = open ? 'block' : 'none';

            if (!open) return;
            if (el.getAttribute('data-dir') !== 'in') return;
            if (el.getAttribute('data-read') === '1') return;

            var id = parseInt(el.getAttribute('data-id'), 10);
            if (!id) return;
            el.setAttribute('data-read', '1');
            el.classList.remove('ms-card-unread');

            var dot = el.querySelector('.ms-dot');
            if (dot) dot.remove();

            adminMsgs.forEach(function (m) {
                if (m.messageID === id) m.isRead = true;
            });
            renderBadge();

            apiCall('/api/Account/Messages/Read', 'POST', id, function () { });
        }

        $(function () {
            loadAdminMsgs();

            /* ⛔ محدودسازی پیام‌رسانی (غیرفعال شده — فقط کامنت شده، حذف نشده):
               فقط ادمین اجازه‌ی ارسال پیام دارد؛ ارسال عضو به مدیریت غیرفعال شد.
               برای فعال‌سازی دوباره کافی است کامنت زیر برداشته شود. */
            /*
            $('#btnSendAdmin').off('click').on('click', function () {
                var title = $('#txtAdminTitle').val();
                var body = $('#txtAdminBody').val();
                if (!body || !body.trim()) { showToast('متن پیام را وارد کنید', 'error'); return; }

                apiCall('/api/Account/Messages/Send', 'POST', { title: title, body: body }, function (res) {
                    if (res.success) {
                        showToast(res.message || 'پیام شما برای مدیریت ارسال شد', 'success');
                        $('#txtAdminTitle').val('');
                        $('#txtAdminBody').val('');
                        loadAdminMsgs();
                    } else {
                        showToast(res.message || 'خطا در ارسال پیام', 'error');
                    }
                });
            });
            */

            // ========== ✅ خواندن همه پیام‌ها ==========
            $('#btnMarkAll').off('click').on('click', function () {
                var unread = adminMsgs.filter(function (m) { return m.direction === 'in' && !m.isRead; });
                if (!unread.length) { showToast('پیام خوانده‌نشده‌ای ندارید', 'info'); return; }

                var done = 0;
                unread.forEach(function (m) {
                    apiCall('/api/Account/Messages/Read', 'POST', m.messageID, function () {
                        done++;
                        m.isRead = true;
                        if (done === unread.length) {
                            showToast('همه پیام‌ها خوانده شد', 'success');
                            renderMsgs();
                        }
                    });
                });
            });
        });
    </script>
}
