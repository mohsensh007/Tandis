@{
    ViewData["Title"] = "پروفایل";
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-header">تصویر پروفایل</div>
            <div class="card-body">
                <div id="avatar" class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width:120px;height:120px;font-size:2.5rem">👤</div>
                <div class="mt-3">
                    <input type="file" id="photoInput" accept="image/*" class="form-control form-control-sm" style="display:none" />
                    <button class="btn btn-sm btn-outline-primary" onclick="$('#photoInput').click()">آپلود عکس</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">اطلاعات پروفایل</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">نام</label>
                        <input type="text" id="txtFirstName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">نام خانوادگی</label>
                        <input type="text" id="txtLastName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">کد ملی</label>
                        <input type="text" id="txtNationalCode" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">شماره موبایل</label>
                        <input type="text" id="txtMobile" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">تاریخ تولد</label>
                        <input type="text" id="txtBirthDate" class="form-control" placeholder="1400/01/01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">کد عضویت</label>
                        <input type="text" id="txtMemberID" class="form-control" readonly />
                    </div>
                </div>
                <button class="btn btn-primary mt-3" id="btnSaveProfile">ذخیره تغییرات</button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">اعتبار ورزشی</div>
            <div class="fw-bold text-success fs-5" id="creditSport">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">اعتبار فروشگاه</div>
            <div class="fw-bold text-info fs-5" id="creditBuffet">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">اعتبار سرویس</div>
            <div class="fw-bold text-warning fs-5" id="creditService">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">بدهی</div>
            <div class="fw-bold text-danger fs-5" id="totalDebit">-</div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        apiCall('/api/Profile/GetProfile', 'GET', null, function (res) {
            if (!res.success) return;
            var d = res.data;
            var names = (d.fullName || '').split(' ');
            $('#txtFirstName').val(names[0] || '');
            $('#txtLastName').val(names.slice(1).join(' ') || '');
            $('#txtNationalCode').val(d.nationalCode || '');
            $('#txtMobile').val(d.mobile || '');
            $('#txtBirthDate').val(d.birthDate || '');
            $('#txtMemberID').val(d.memberID);
            $('#creditSport').text(Number(d.sportCredit).toLocaleString() + ' ریال');
            $('#creditBuffet').text(Number(d.buffetCredit).toLocaleString() + ' ریال');
            $('#creditService').text(Number(d.serviceCredit).toLocaleString() + ' ریال');
            $('#totalDebit').text(Number(d.totalDebit).toLocaleString() + ' ریال');
        });
    });

    $('#photoInput').change(function () {
        var file = this.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function (e) {
            var base64 = e.target.result.split(',')[1];
            apiCall('/api/Profile/UpdatePhoto', 'POST', { photoBase64: base64 }, function (res) {
                if (res.success) {
                    showToast(res.message, 'success');
                    $('#avatar').html('<img src="' + e.target.result + '" class="rounded-circle" style="width:120px;height:120px;object-fit:cover" />');
                } else { showToast(res.message, 'error'); }
            });
        };
        reader.readAsDataURL(file);
    });

    $('#btnSaveProfile').click(function () {
        var data = {
            firstName: $.trim($('#txtFirstName').val()),
            lastName: $.trim($('#txtLastName').val()),
            mobile: $.trim($('#txtMobile').val()),
            birthDate: $.trim($('#txtBirthDate').val())
        };
        apiCall('/api/Profile/UpdateInfo', 'POST', data, function (res) {
            if (res.success) { showToast(res.message, 'success'); }
            else { showToast(res.message, 'error'); }
        });
    });
</script>
}
