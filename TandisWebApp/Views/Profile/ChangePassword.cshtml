@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="card" style="max-width:500px;margin:auto">
    <div class="card-header">تغییر رمز عبور</div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">رمز قدیم</label>
            <input type="password" id="txtOldPass" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">رمز جدید</label>
            <input type="password" id="txtNewPass" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">تکرار رمز جدید</label>
            <input type="password" id="txtConfirmPass" class="form-control" />
        </div>
        <button class="btn btn-primary w-100" id="btnChange">تغییر رمز</button>
    </div>
</div>

@section Scripts {
<script>
    $('#btnChange').click(function () {
        var data = {
            oldPassword: $('#txtOldPass').val(),
            newPassword: $('#txtNewPass').val(),
            confirmPassword: $('#txtConfirmPass').val()
        };
        if (!data.oldPassword || !data.newPassword || !data.confirmPassword) { showToast('همه فیلدها الزامی است', 'error'); return; }
        if (data.newPassword !== data.confirmPassword) { showToast('رمز جدید و تکرار مطابقت ندارد', 'error'); return; }
        apiCall('/api/Account/ChangePassword', 'POST', data, function (res) {
            if (res.success) { showToast(res.message, 'success'); }
            else { showToast(res.message, 'error'); }
        });
    });
</script>
}
