@{
    ViewData["Title"] = "بوفه";
}

<div class="commerce-page" data-commerce-page="buffet">
    <section class="commerce-hero" aria-labelledby="buffetPageTitle">
        <div class="commerce-hero-content">
            <span class="commerce-kicker"><i class="bi bi-cup-hot" aria-hidden="true"></i> خوراکی و نوشیدنی</span>
            <h1 id="buffetPageTitle">بوفه باشگاه</h1>
            <p>نوشیدنی و خوراکی موردنظرتان را انتخاب کنید و خرید را از داخل پنل انجام دهید.</p>
        </div>
        <div class="commerce-hero-icon" aria-hidden="true"><i class="bi bi-cup-hot"></i></div>
    </section>

   

    <div class="commerce-store-layout">
        <aside class="commerce-panel commerce-category-panel" aria-labelledby="buffetCategoryTitle">
            <div class="commerce-panel-head">
                <h2 class="commerce-panel-title" id="buffetCategoryTitle"><i class="bi bi-tags" aria-hidden="true"></i> دسته‌بندی</h2>
            </div>
            <div id="catList" class="commerce-category-list" aria-label="دسته‌بندی کالاهای بوفه">
                <button type="button" class="commerce-category-button active" data-commerce-action="category" data-category-id="0">همه</button>
            </div>
        </aside>

        <section class="commerce-panel" aria-labelledby="buffetProductsTitle">
            <div class="commerce-panel-head">
                <h2 class="commerce-panel-title" id="buffetProductsTitle"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> کالاهای بوفه</h2>
                <span class="commerce-count" id="productCount" aria-label="تعداد کالاها">۰</span>
            </div>
            <div id="stuffList" class="commerce-grid" aria-live="polite">
                <div class="commerce-status"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>در حال بارگذاری کالاها…</span></div>
            </div>
        </section>
    </div>

    <section class="commerce-cart-panel" aria-labelledby="buffetCartTitle">
        <div class="commerce-cart-head">
            <h2 class="commerce-cart-title" id="buffetCartTitle"><i class="bi bi-cart3" aria-hidden="true"></i> سبد خرید بوفه</h2>
            <span class="commerce-count" id="basketCount" aria-label="تعداد کالاهای سبد">۰</span>
        </div>
        <div id="basketList" class="commerce-cart-list" aria-live="polite"></div>
        <div id="basketTotal" class="commerce-cart-footer" style="display:none;">
            <div class="commerce-total">جمع کل: <strong id="totalAmount">۰ ریال</strong></div>
            <button type="button" class="commerce-checkout" id="btnBuyBasket"><i class="bi bi-credit-card" aria-hidden="true"></i> ادامه پرداخت</button>
        </div>
    </section>
</div>
