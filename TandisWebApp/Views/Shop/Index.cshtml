@{
    ViewData["Title"] = "فروشگاه";
}

<div class="commerce-page" data-commerce-page="shop">
    <section class="commerce-hero" aria-labelledby="shopPageTitle">
        <div class="commerce-hero-content">
            <span class="commerce-kicker"><i class="bi bi-bag-heart" aria-hidden="true"></i> خرید روزمره باشگاه</span>
            <h1 id="shopPageTitle">فروشگاه تندیس</h1>
            <p>محصولات را به سبد اضافه کنید، تعداد را تنظیم کنید و با اعتبار فروشگاه یا POS پرداخت کنید.</p>
        </div>
        <div class="commerce-hero-icon" aria-hidden="true"><i class="bi bi-bag-check"></i></div>
    </section>

    <div class="commerce-notice" role="note">
        <i class="bi bi-shield-check" aria-hidden="true"></i>
        <span>قیمت نهایی و نوع کالا در سرور بررسی می‌شود؛ مبلغ ارسالی مرورگر مبنای ثبت خرید نیست.</span>
    </div>

    <div class="commerce-store-layout">
        <aside class="commerce-panel commerce-category-panel" aria-labelledby="shopCategoryTitle">
            <div class="commerce-panel-head">
                <h2 class="commerce-panel-title" id="shopCategoryTitle"><i class="bi bi-tags" aria-hidden="true"></i> دسته‌بندی</h2>
            </div>
            <div id="catList" class="commerce-category-list" aria-label="دسته‌بندی کالاها">
                <button type="button" class="commerce-category-button active" data-commerce-action="category" data-category-id="0">همه</button>
            </div>
        </aside>

        <section class="commerce-panel" aria-labelledby="shopProductsTitle">
            <div class="commerce-panel-head">
                <h2 class="commerce-panel-title" id="shopProductsTitle"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> کالاهای فروشگاه</h2>
                <span class="commerce-count" id="productCount" aria-label="تعداد کالاها">۰</span>
            </div>
            <div id="stuffList" class="commerce-grid" aria-live="polite">
                <div class="commerce-status"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>در حال بارگذاری کالاها…</span></div>
            </div>
        </section>
    </div>

    <section class="commerce-cart-panel" aria-labelledby="shopCartTitle">
        <div class="commerce-cart-head">
            <h2 class="commerce-cart-title" id="shopCartTitle"><i class="bi bi-cart3" aria-hidden="true"></i> سبد خرید</h2>
            <span class="commerce-count" id="basketCount" aria-label="تعداد کالاهای سبد">۰</span>
        </div>
        <div id="basketList" class="commerce-cart-list" aria-live="polite"></div>
        <div id="basketTotal" class="commerce-cart-footer" style="display:none;">
            <div class="commerce-total">جمع کل: <strong id="totalAmount">۰ ریال</strong></div>
            <button type="button" class="commerce-checkout" id="btnBuyBasket"><i class="bi bi-credit-card" aria-hidden="true"></i> ادامه پرداخت</button>
        </div>
    </section>
</div>
