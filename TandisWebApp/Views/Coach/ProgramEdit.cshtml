@model TandisWebApp.DTOs.CoachProgramEditDto
@{
    ViewData["Title"] = Model.PrgID > 0 ? "ویرایش برنامه" : "برنامه جدید";
    Layout = "_CoachLayout";
    var students = (List<TandisWebApp.DTOs.StudentOptionDto>)ViewBag.Students;
    var itemOptions = (List<TandisWebApp.DTOs.ProgramItemEditDto>)ViewBag.ItemOptions;

    var pc = new System.Globalization.PersianCalendar();
    var nowDt = DateTime.Now;
    var plusDt = nowDt.AddMonths(1);
    var defStart = $"{pc.GetYear(nowDt):0000}/{pc.GetMonth(nowDt):00}/{pc.GetDayOfMonth(nowDt):00}";
    var defEnd = $"{pc.GetYear(plusDt):0000}/{pc.GetMonth(plusDt):00}/{pc.GetDayOfMonth(plusDt):00}";
    var startVal = Model.PrgID > 0 && !string.IsNullOrEmpty(Model.StartDateShamsi) ? Model.StartDateShamsi : defStart;
    var endVal = Model.PrgID > 0 && !string.IsNullOrEmpty(Model.EndDateShamsi) ? Model.EndDateShamsi : defEnd;

    var typeOptions = new Dictionary<byte, string> {
        { 1, "عادی" }, { 2, "دراپ ست" }, { 3, "سوپرست" }, { 4, "تری‌ست" },
        { 5, "ست غول" }, { 6, "پیرامید" }, { 7, "استراحت-مکث" }, { 8, "تمپو دار" }
    };

    var fixedDays = new (string Icon, string Key)[] {
        ("🦵", "روز پا"),
        ("🏋️", "روز سینه"),
        ("🤸", "روز سرشانه"),
        ("🚣", "روز زیر بغل"),
        ("💪", "روز جلو بازو"),
        ("🦾", "روز پشت بازو"),
        ("🧘", "روز شکم"),
        ("🌀", "روز پهلو"),
        ("🏃", "روز هوازی"),
        ("⚡", "روز فول بدن")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard2-pulse hd-icon"></i> @ViewData["Title"]</h5>
    <a href="/Coach/Programs" class="purple-style coach-back-pill"><i class="bi bi-arrow-right"></i> برنامه‌ها</a>
</div>

<div class="purple-style pe-card">
    <!-- ===== اطلاعات اصلی ===== -->
    <div class="row g-3">
        <div class="col-md-4">
            <label class="pe-lbl">شاگرد</label>
            <div class="d-flex gap-2">
                <input type="text" id="txtStudentName" class="pe-input" readonly
                       placeholder="انتخاب شاگرد..." value="@Model.StudentName" />
                <button type="button" class="pe-cal-btn" id="btnOpenStudents" title="انتخاب شاگرد">
                    <i class="bi bi-person-lines-fill"></i>
                </button>
            </div>
            <input type="hidden" id="selStudentID" value="@Model.MemberID" />
        </div>
        <div class="col-6 col-md-4">
            <label class="pe-lbl">تاریخ شروع</label>
            <div class="d-flex gap-2">
                <input type="text" id="txtStart" class="pe-input" readonly value="@startVal" />
                <button type="button" class="pe-cal-btn" onclick="openCal('txtStart')"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <label class="pe-lbl">تاریخ پایان</label>
            <div class="d-flex gap-2">
                <input type="text" id="txtEnd" class="pe-input" readonly value="@endVal" />
                <button type="button" class="pe-cal-btn" onclick="openCal('txtEnd')"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
    </div>

    <!-- ===== انتخاب روزهای تمرین ===== -->
    <div class="day-select-box mt-4">
        <div class="ds-title"><i class="bi bi-calendar-week"></i> روزهای تمرین این برنامه را انتخاب کنید (چند روز قابل انتخابه):</div>
        <div class="ds-chips" id="dayChips">
            @foreach (var d in fixedDays)
            {
                <button type="button" class="ds-chip" data-day="@d.Key">@d.Icon @d.Key</button>
            }
        </div>
        <div class="ds-hint" id="dsHint">⚠️ برای افزودن حرکت، ابتدا حداقل یک روز را انتخاب کنید</div>
        <div class="ds-selected" id="dsSelectedWrap" style="display:none">
            حرکات جدید به این روز اضافه می‌شن: <b id="dsSelected"></b>
        </div>
    </div>

    <!-- ===== حرکات ===== -->
    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
        <div class="pe-lbl mb-0" style="font-size:.85rem"><i class="bi bi-list-check"></i> حرکات برنامه</div>
        <button type="button" class="pe-add-btn" id="btnAddItem" disabled><i class="bi bi-plus-lg"></i> افزودن حرکت</button>
    </div>

    <div id="itemsBox">
        @foreach (var it in Model.Items)
        {
            var extras = it.ExtraItems ?? new List<TandisWebApp.DTOs.ProgramSubItemDto>();
            <div class="pe-item-card">
                <input type="hidden" class="inpDay" value="@it.DayTitle" />
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <span class="pe-day-badge">@it.DayTitle</span>
                    <button type="button" class="pe-del-item"><i class="bi bi-trash3"></i></button>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-md-8">
                        <label class="pe-lbl">حرکت</label>
                        <select class="pe-input selItem">
                            <option value="0">+ حرکت جدید (دستی بنویس)...</option>
                            @foreach (var o in itemOptions)
                            {
                                if (o.ItemID == it.ItemID)
                                {
                                    <option value="@o.ItemID" selected>@o.ItemDesc</option>
                                }
                                else
                                {
                                    <option value="@o.ItemID">@o.ItemDesc</option>
                                }
                            }
                        </select>
                        <input type="text" class="pe-input txtNewItem mt-2" style="display:@(it.ItemID == 0 ? "block" : "none")"
                               placeholder="شرح حرکت جدید (مثلاً: پرس سینه با هالتر)" value="@(it.ItemID == 0 ? it.ItemDesc : "")" />
                    </div>
                    <div class="col-md-4">
                        <label class="pe-lbl">نوع حرکت</label>
                        <select class="pe-input inpType">
                            @foreach (var t in typeOptions)
                            {
                                if ((int)t.Key == (it.ExerciseType ?? 1))
                                {
                                    <option value="@t.Key" selected>@t.Value</option>
                                }
                                else
                                {
                                    <option value="@t.Key">@t.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-3"><label class="pe-lbl">ست</label><input type="number" min="1" class="pe-input inpSets" value="@it.SetCount" /></div>
                    <div class="col-3"><label class="pe-lbl">تکرار</label><input type="number" min="0" class="pe-input inpReps" value="@it.RepCount" /></div>
                    <div class="col-3"><label class="pe-lbl">وزن (kg)</label><input type="number" min="0" class="pe-input inpW" value="@it.WCount" /></div>
                    <div class="col-3"><label class="pe-lbl">استراحت (ثانیه)</label><input type="number" min="0" step="5" class="pe-input inpRest" value="@it.RestSeconds" /></div>
                    <div class="col-12"><label class="pe-lbl">توضیح (اختیاری)</label><input type="text" class="pe-input inpNote" placeholder="مثلاً: کنترل فاز منفی حرکت..." value="@it.Note" /></div>

                    <!-- ===== دراپ ست ===== -->
                    <div class="col-12 tech-fields tech-drop" style="display:@(it.ExerciseType == 2 ? "block" : "none")">
                        <div class="tech-head"><i class="bi bi-arrow-down-circle-fill"></i> تنظیمات دراپ ست</div>
                        <div class="row g-2">
                            <div class="col-6"><label class="pe-lbl">تعداد دراپ (۱ تا ۶)</label><input type="number" min="1" max="6" class="pe-input inpDropCount" value="@it.DropCount" /></div>
                            <div class="col-6"><label class="pe-lbl">کاهش وزن هر دراپ (٪)</label><input type="number" min="5" max="50" class="pe-input inpDropPct" value="@it.DropWeightPct" placeholder="مثلاً 20" /></div>
                        </div>
                    </div>

                    <!-- ===== پیرامید ===== -->
                    <div class="col-12 tech-fields tech-pyramid" style="display:@(it.ExerciseType == 6 ? "block" : "none")">
                        <div class="tech-head"><i class="bi bi-triangle-fill"></i> تنظیمات پیرامید</div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="pe-lbl">جهت</label>
                                <select class="pe-input inpPyramidDir">
                                    @{
                                        var pdir = it.PyramidDir ?? 0;
                                    }
                                    @if (pdir == 1)
                                    {
                                        <option value="1" selected>صعودی (وزن زیاد → کم)</option>
                                    }
                                    else
                                    {
                                        <option value="1">صعودی (وزن زیاد → کم)</option>
                                    }
                                    @if (pdir == 2)
                                    {
                                        <option value="2" selected>معکوس (سنگین اول)</option>
                                    }
                                    else
                                    {
                                        <option value="2">معکوس (سنگین اول)</option>
                                    }
                                    @if (pdir == 3)
                                    {
                                        <option value="3" selected>کامل (صعود + نزول)</option>
                                    }
                                    else
                                    {
                                        <option value="3">کامل (صعود + نزول)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6"><label class="pe-lbl">پله وزن هر ست (kg)</label><input type="number" min="0" class="pe-input inpWeightStep" value="@it.WeightStep" /></div>
                        </div>
                    </div>

                    <!-- ===== استراحت-مکث ===== -->
                    <div class="col-12 tech-fields tech-pause" style="display:@(it.ExerciseType == 7 ? "block" : "none")">
                        <div class="tech-head"><i class="bi bi-pause-circle-fill"></i> تنظیمات استراحت-مکث</div>
                        <div class="row g-2">
                            <div class="col-6"><label class="pe-lbl">تعداد مینی‌ست (۱ تا ۵)</label><input type="number" min="1" max="5" class="pe-input inpPauseCount" value="@it.PauseCount" /></div>
                            <div class="col-6"><label class="pe-lbl">مکث بین مینی‌ست (ثانیه)</label><input type="number" min="5" max="60" class="pe-input inpPauseRest" value="@it.PauseRest" /></div>
                        </div>
                    </div>

                    <!-- ===== تمپو ===== -->
                    <div class="col-12 tech-fields tech-tempo" style="display:@(it.ExerciseType == 8 ? "block" : "none")">
                        <div class="tech-head"><i class="bi bi-clock-fill"></i> تمپو (کد ۴ رقمی: پایین / مکث / بالا / مکث)</div>
                        <input type="text" class="pe-input inpTempo" value="@it.Tempo" placeholder="مثال: 3-1-2-0" maxlength="15" />
                    </div>

                    <!-- ===== combo ===== -->
                    <div class="col-12 tech-fields tech-combo" style="display:@(it.ExerciseType >= 3 && it.ExerciseType <= 5 ? "block" : "none")">
                        <div class="tech-head"><i class="bi bi-link-45deg"></i> حرکات هم‌گروه (پشت‌سرهم بدون استراحت)</div>
                        <div class="combo-slots" data-max="@(it.ExerciseType == 3 ? 1 : it.ExerciseType == 4 ? 2 : 5)">
                            @for (var i = 0; i < extras.Count; i++)
                            {
                                var ex = extras[i];
                                <div class="combo-slot">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="pe-lbl">حرکت @(i + 2)</label>
                                            <select class="pe-input comboSelItem">
                                                <option value="0">+ حرکت جدید...</option>
                                                @foreach (var o in itemOptions)
                                                {
                                                    if (o.ItemID == ex.ItemID)
                                                    {
                                                        <option value="@o.ItemID" selected>@o.ItemDesc</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@o.ItemID">@o.ItemDesc</option>
                                                    }
                                                }
                                            </select>
                                            <input type="text" class="pe-input comboTxtNewItem mt-1" style="display:@(ex.ItemID == 0 ? "block" : "none")"
                                                   value="@(ex.ItemID == 0 ? ex.ItemDesc : "")" placeholder="شرح حرکت جدید" />
                                        </div>
                                        <div class="col-3"><label class="pe-lbl">تکرار</label><input type="number" min="0" class="pe-input comboReps" value="@ex.RepCount" /></div>
                                        <div class="col-3"><label class="pe-lbl">وزن (kg)</label><input type="number" min="0" class="pe-input comboW" value="@ex.WCount" /></div>
                                    </div>
                                    <button type="button" class="combo-del" title="حذف"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                        </div>
                        <button type="button" class="combo-add-btn"><i class="bi bi-plus"></i> افزودن حرکت هم‌گروه</button>
                    </div>
                </div>
            </div>
        }

        <!-- ===== قالب ردیف جدید (مخفی) ===== -->
        <div class="pe-item-card template" id="rowTemplate" style="display:none">
            <input type="hidden" class="inpDay" value="" />
            <div class="d-flex justify-content-between align-items-center gap-2">
                <span class="pe-day-badge"></span>
                <button type="button" class="pe-del-item"><i class="bi bi-trash3"></i></button>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-8">
                    <label class="pe-lbl">حرکت</label>
                    <select class="pe-input selItem">
                        <option value="0">+ حرکت جدید (دستی بنویس)...</option>
                        @foreach (var o in itemOptions)
                        {
                            <option value="@o.ItemID">@o.ItemDesc</option>
                        }
                    </select>
                    <input type="text" class="pe-input txtNewItem mt-2" style="display:none" placeholder="شرح حرکت جدید (مثلاً: پرس سینه با هالتر)" />
                </div>
                <div class="col-md-4">
                    <label class="pe-lbl">نوع حرکت</label>
                    <select class="pe-input inpType">
                        @foreach (var t in typeOptions)
                        {
                            if (t.Key == 1)
                            {
                                <option value="@t.Key" selected>@t.Value</option>
                            }
                            else
                            {
                                <option value="@t.Key">@t.Value</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-3"><label class="pe-lbl">ست</label><input type="number" min="1" class="pe-input inpSets" /></div>
                <div class="col-3"><label class="pe-lbl">تکرار</label><input type="number" min="0" class="pe-input inpReps" /></div>
                <div class="col-3"><label class="pe-lbl">وزن (kg)</label><input type="number" min="0" class="pe-input inpW" /></div>
                <div class="col-3"><label class="pe-lbl">استراحت (ثانیه)</label><input type="number" min="0" step="5" class="pe-input inpRest" placeholder="90" /></div>
                <div class="col-12"><label class="pe-lbl">توضیح (اختیاری)</label><input type="text" class="pe-input inpNote" placeholder="مثلاً: کنترل فاز منفی حرکت..." /></div>

                <div class="col-12 tech-fields tech-drop" style="display:none">
                    <div class="tech-head"><i class="bi bi-arrow-down-circle-fill"></i> تنظیمات دراپ ست</div>
                    <div class="row g-2">
                        <div class="col-6"><label class="pe-lbl">تعداد دراپ (۱ تا ۶)</label><input type="number" min="1" max="6" class="pe-input inpDropCount" /></div>
                        <div class="col-6"><label class="pe-lbl">کاهش وزن هر دراپ (٪)</label><input type="number" min="5" max="50" class="pe-input inpDropPct" placeholder="20" /></div>
                    </div>
                </div>
                <div class="col-12 tech-fields tech-pyramid" style="display:none">
                    <div class="tech-head"><i class="bi bi-triangle-fill"></i> تنظیمات پیرامید</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="pe-lbl">جهت</label>
                            <select class="pe-input inpPyramidDir">
                                <option value="1">صعودی (وزن زیاد → کم)</option>
                                <option value="2">معکوس (سنگین اول)</option>
                                <option value="3">کامل (صعود + نزول)</option>
                            </select>
                        </div>
                        <div class="col-md-6"><label class="pe-lbl">پله وزن هر ست (kg)</label><input type="number" min="0" class="pe-input inpWeightStep" /></div>
                    </div>
                </div>
                <div class="col-12 tech-fields tech-pause" style="display:none">
                    <div class="tech-head"><i class="bi bi-pause-circle-fill"></i> تنظیمات استراحت-مکث</div>
                    <div class="row g-2">
                        <div class="col-6"><label class="pe-lbl">تعداد مینی‌ست (۱ تا ۵)</label><input type="number" min="1" max="5" class="pe-input inpPauseCount" /></div>
                        <div class="col-6"><label class="pe-lbl">مکث بین مینی‌ست (ثانیه)</label><input type="number" min="5" max="60" class="pe-input inpPauseRest" /></div>
                    </div>
                </div>
                <div class="col-12 tech-fields tech-tempo" style="display:none">
                    <div class="tech-head"><i class="bi bi-clock-fill"></i> تمپو (کد ۴ رقمی)</div>
                    <input type="text" class="pe-input inpTempo" placeholder="مثال: 3-1-2-0" maxlength="15" />
                </div>
                <div class="col-12 tech-fields tech-combo" style="display:none">
                    <div class="tech-head"><i class="bi bi-link-45deg"></i> حرکات هم‌گروه (پشت‌سرهم بدون استراحت)</div>
                    <div class="combo-slots" data-max="5"></div>
                    <button type="button" class="combo-add-btn"><i class="bi bi-plus"></i> افزودن حرکت هم‌گروه</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="button" class="pe-save-btn" id="btnSave">
            <i class="bi bi-check-lg"></i> ذخیره برنامه
        </button>
    </div>
</div>

<!-- ========== اورلی انتخاب شاگرد ========== -->
<div class="stu-overlay" id="stuOverlay" style="display:none">
    <div class="stu-panel">
        <div class="stu-head">
            <span><i class="bi bi-person-lines-fill me-2"></i>انتخاب شاگرد</span>
            <button type="button" class="stu-close" id="stuClose"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="stu-body">
            <input type="text" id="stuSearch" class="pe-input" placeholder="🔍 جستجوی نام شاگرد..." />
            <div class="row g-2">
                <div class="col-6"><select id="stuSport" class="pe-input"></select></div>
                <div class="col-6"><select id="stuSanse" class="pe-input"></select></div>
            </div>
            <div class="stu-list" id="stuList"></div>
        </div>
    </div>
</div>

<!-- ===== تقویم شمسی ===== -->
<div class="modal fade" id="datePickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pe-modal">
            <div class="modal-header pe-modal-head">
                <h5 class="modal-title"><i class="bi bi-calendar3"></i> <span id="calendarTitle">انتخاب تاریخ</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="prevMonth">›</button>
                    <strong id="currentMonthLabel" class="fs-5"></strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="nextMonth">‹</button>
                </div>
                <table class="cal-table">
                    <thead class="text-center">
                        <tr>
                            <th>شنبه</th>
                            <th>یک شنبه</th>
                            <th>دو شنبه</th>
                            <th>سه شنبه</th>
                            <th>چهار شنبه</th>
                            <th>پنج شنبه</th>
                            <th>جمعه</th>
                        </tr>
                    </thead>
                    <tbody id="calendarBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: #66d3e8;
            transition: transform .25s;
        }

        .coach-back-pill:hover {
            color: #fff;
        }

            .coach-back-pill:hover i {
                transform: translateX(3px);
            }

    .pe-card {
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        padding: 18px;
    }

    .pe-lbl {
        display: block;
        font-size: .72rem;
        color: #9fb3c8;
        font-weight: 700;
        margin-bottom: 4px;
    }

        .pe-lbl i {
            color: #66d3e8;
        }

    .pe-input {
        width: 100%;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #fff;
        border-radius: 12px;
        padding: 9px 12px;
        font-size: .85rem;
    }

        .pe-input:focus {
            outline: none;
            background: rgba(255,255,255,.12);
            border-color: rgba(102,211,232,.5);
        }

        .pe-input[readonly] {
            cursor: pointer;
        }

    select.pe-input option {
        background: #101424;
        color: #fff;
    }

    .pe-cal-btn {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.16);
        color: #66d3e8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pe-cal-btn:hover {
