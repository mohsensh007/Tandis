</style>

@section Scripts {
    <script type="application/json" id="studentsJson">@Json.Serialize(students)</script>

    <script>
        var students = [];
        try {
            var studentsEl = document.getElementById('studentsJson');
            if (studentsEl) students = JSON.parse(studentsEl.textContent);
        } catch (e) { students = []; }

        var FIXED_DAYS = ['روز پا', 'روز سینه', 'روز سرشانه', 'روز زیر بغل', 'روز جلو بازو', 'روز پشت بازو', 'روز شکم', 'روز پهلو', 'روز هوازی', 'روز فول بدن'];

        function selectedDays() {
            var arr = [];
            $('#dayChips .ds-chip.ds-on').each(function () { arr.push(String($(this).data('day'))); });
            arr.sort(function (a, b) { return FIXED_DAYS.indexOf(a) - FIXED_DAYS.indexOf(b); });
            return arr;
        }
        function currentDayTitle() { return selectedDays().join(' + '); }

        $(document).on('click', '.ds-chip', function () {
            $(this).toggleClass('ds-on');
            applyDayFilter();
            updateAddState();
        });

        function applyDayFilter() {
            var sel = selectedDays();
            $('.pe-item-card:not(.template)').each(function () {
                var dt = String($(this).find('.inpDay').val() || '');
                if (!sel.length) { $(this).show(); return; }
                var show = false;
                for (var i = 0; i < sel.length; i++) {
                    if (dt.indexOf(sel[i]) > -1) { show = true; break; }
                }
                $(this).toggle(show);
            });
        }

        function updateAddState() {
            var sel = selectedDays();
            var has = sel.length > 0;
            $('#btnAddItem').prop('disabled', !has);
            $('#dsHint').toggle(!has);
            $('#dsSelectedWrap').toggle(has);
            if (has) $('#dsSelected').text(currentDayTitle());
        }

        // ===== شاگرد =====
        function gId(s) { return s.memberID || s.MemberID || 0; }
        function gName(s) { return s.fullName || s.FullName || ''; }
        function gSport(s) { return s.sportName || s.SportName || ''; }
        function gSanse(s) { return s.sanseName || s.SanseName || ''; }

        function fillFilters() {
            var sports = [], sanses = [];
            students.forEach(function (s) {
                var sp = gSport(s), sn = gSanse(s);
                if (sp && sports.indexOf(sp) === -1) sports.push(sp);
                if (sn && sanses.indexOf(sn) === -1) sanses.push(sn);
            });
            sports.sort(); sanses.sort();
            var hSp = '<option value="">همه رشته‌ها</option>';
            sports.forEach(function (x) { hSp += '<option>' + esc(x) + '</option>'; });
            $('#stuSport').html(hSp);
            var hSn = '<option value="">همه سانس‌ها</option>';
            sanses.forEach(function (x) { hSn += '<option>' + esc(x) + '</option>'; });
            $('#stuSanse').html(hSn);
        }

        function renderStudents() {
            var q = $.trim($('#stuSearch').val()).toLowerCase();
            var sp = $('#stuSport').val();
            var sn = $('#stuSanse').val();
            var html = '', count = 0;
            students.forEach(function (s) {
                if (q && gName(s).toLowerCase().indexOf(q) === -1) return;
                if (sp && gSport(s) !== sp) return;
                if (sn && gSanse(s) !== sn) return;
                count++;
                html += '<div class="stu-row" data-id="' + gId(s) + '" data-name="' + esc(gName(s)) + '">' +
                    '<div class="stu-name">' + esc(gName(s)) + '</div>' +
                    '<div class="stu-sub">' + esc(gSport(s) || '-') + ' - ' + esc(gSanse(s) || '-') + '</div>' +
                '</div>';
            });
            if (!count) html = '<div class="stu-empty">شاگردی با این مشخصات یافت نشد</div>';
            $('#stuList').html(html);
        }

        $('#btnOpenStudents').click(function () {
            fillFilters(); renderStudents();
            $('#stuOverlay').fadeIn(150);
            setTimeout(function () { $('#stuSearch').trigger('focus'); }, 200);
        });
        function closeOverlay() { $('#stuOverlay').fadeOut(150); }
        $('#stuClose').click(closeOverlay);
        $('#stuOverlay').on('click', function (e) { if (e.target === this) closeOverlay(); });
        $(document).on('keyup', '#stuSearch', renderStudents);
        $('#stuSport, #stuSanse').on('change', renderStudents);
        $(document).on('click', '.stu-row', function () {
            $('#selStudentID').val($(this).data('id'));
            $('#txtStudentName').val($(this).data('name'));
            closeOverlay();
        });

        // ===== تقویم =====
        function openCal(inputId) {
            initCalendar(inputId, null, true);
            new bootstrap.Modal('#datePickerModal').show();
        }
        $('#prevMonth').click(function () {
            calendarDate.m++;
            if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
            renderCalendar();
        });
        $('#nextMonth').click(function () {
            calendarDate.m--;
            if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
            renderCalendar();
        });

        // ===== حرکت جدید =====
        function syncNewItem($row) {
            var isnew = String($row.find('.selItem').val() || '0') === '0';
            $row.find('.txtNewItem').css('display', isnew ? 'block' : 'none');
        }
        $(document).on('change', '.selItem', function () {
            syncNewItem($(this).closest('.pe-item-card'));
        });

        // ===== ✅ فیلدهای تکنیک =====
        function syncTechFields($r) {
            var t = parseInt($r.find('.inpType').val() || '1');
            $r.find('.tech-drop').toggle(t === 2);
            $r.find('.tech-pyramid').toggle(t === 6);
            $r.find('.tech-pause').toggle(t === 7);
            $r.find('.tech-tempo').toggle(t === 8);
            var isCombo = (t === 3 || t === 4 || t === 5);
            $r.find('.tech-combo').toggle(isCombo);
            if (isCombo) {
                var need = (t === 3 ? 1 : t === 4 ? 2 : 3);
                $r.find('.combo-slots').attr('data-max', (t === 5 ? 5 : need));
                ensureMinSlots($r, need);
            }
        }
        $(document).on('change', '.inpType', function () {
            syncTechFields($(this).closest('.pe-item-card'));
        });

        // ===== ✅ اسلات combo =====
        function comboSlotHtml() {
            var opts = '';
            $('#rowTemplate .selItem option').each(function (i) {
                if (i === 0) return;
                opts += '<option value="' + this.value + '">' + esc(this.text) + '</option>';
            });
            return '<div class="combo-slot">' +
                '<div class="row g-2">' +
                    '<div class="col-md-6">' +
                        '<label class="pe-lbl">حرکت هم‌گروه</label>' +
                        '<select class="pe-input comboSelItem"><option value="0">+ حرکت جدید...</option>' + opts + '</select>' +
                        '<input type="text" class="pe-input comboTxtNewItem mt-1" style="display:none" placeholder="شرح حرکت جدید" />' +
                    '</div>' +
                    '<div class="col-3"><label class="pe-lbl">تکرار</label><input type="number" min="0" class="pe-input comboReps" /></div>' +
                    '<div class="col-3"><label class="pe-lbl">وزن (kg)</label><input type="number" min="0" class="pe-input comboW" /></div>' +
                '</div>' +
                '<button type="button" class="combo-del" title="حذف"><i class="bi bi-x-lg"></i></button>' +
            '</div>';
        }
        function ensureMinSlots($r, need) {
            var $box = $r.find('.combo-slots');
            while ($box.find('.combo-slot').length < need) $box.append(comboSlotHtml());
        }
        $(document).on('click', '.combo-add-btn', function (e) {
            e.preventDefault();
            var $r = $(this).closest('.pe-item-card');
            var max = parseInt($r.find('.combo-slots').attr('data-max') || '5');
            var cur = $r.find('.combo-slots .combo-slot').length;
            if (cur >= max) { showToast('حداکثر تعداد حرکت هم‌گروه برای این نوع پر شده', 'error'); return; }
            $r.find('.combo-slots').append(comboSlotHtml());
        });
        $(document).on('click', '.combo-del', function () { $(this).closest('.combo-slot').remove(); });
        $(document).on('change', '.comboSelItem', function () {
            var isnew = String($(this).val() || '0') === '0';
            $(this).closest('.combo-slot').find('.comboTxtNewItem').css('display', isnew ? 'block' : 'none');
        });

        // ===== افزودن / حذف ردیف =====
        $('#btnAddItem').click(function () {
            var sel = selectedDays();
            if (!sel.length) { showToast('ابتدا حداقل یک روز تمرین انتخاب کنید', 'error'); return; }
            var title = sel.join(' + ');
            var $t = $('#rowTemplate').clone().removeAttr('id').removeClass('template').css('display', 'block');
            $t.find('.inpDay').val(title);
            $t.find('.pe-day-badge').text(title);
            $('#itemsBox').append($t);
            syncNewItem($t);
            syncTechFields($t);
            applyDayFilter();
            $t[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(function () {
                if ($t.find('.txtNewItem').is(':visible')) $t.find('.txtNewItem').trigger('focus');
            }, 200);
        });
        $(document).on('click', '.pe-del-item', function () {
            $(this).closest('.pe-item-card').remove();
        });

        // ===== ذخیره =====
        $('#btnSave').click(function () {
            var memberID = parseInt($('#selStudentID').val() || '0');
            if (memberID <= 0) { showToast('شاگرد را انتخاب کنید', 'error'); return; }

            var items = [];
            var valid = true;

            $('#itemsBox .pe-item-card:not(.template)').each(function () {
                var $r = $(this);
                var itemID = parseInt($r.find('.selItem').val() || '0');
                var newDesc = $.trim($r.find('.txtNewItem').val());
                if (itemID === 0 && !newDesc) { valid = false; return; }
                function num(sel) { var v = $r.find(sel).val(); return v === '' || v === null ? null : parseInt(v); }
                var type = parseInt($r.find('.inpType').val() || '1');

                if (type === 2) {
                    var dc = parseInt($r.find('.inpDropCount').val() || '0');
                    if (dc < 1 || dc > 6) { valid = false; showToast('دراپ ست: تعداد دراپ باید ۱ تا ۶ باشد', 'error'); return false; }
                }
                if (type === 3 || type === 4 || type === 5) {
                    var have = $r.find('.combo-slot').length;
                    if (type === 3 && have !== 1) { valid = false; showToast('سوپرست: دقیقاً ۲ حرکت لازم است', 'error'); return false; }
                    if (type === 4 && have !== 2) { valid = false; showToast('تری‌ست: دقیقاً ۳ حرکت لازم است', 'error'); return false; }
                    if (type === 5 && (have < 3 || have > 5)) { valid = false; showToast('ست غول: بین ۴ تا ۶ حرکت لازم است', 'error'); return false; }
                }
                if (type === 8) {
                    var tp = $.trim($r.find('.inpTempo').val());
                    if (!/^\d(-\d){2,3}$/.test(tp)) { valid = false; showToast('تمپو نامعتبر است (نمونه درست: 3-1-2-0)', 'error'); return false; }
                }

                var extra = [];
                if (type === 3 || type === 4 || type === 5) {
                    $r.find('.combo-slot').each(function () {
                        var $s = $(this);
                        var eid = parseInt($s.find('.comboSelItem').val() || '0');
                        var enew = $.trim($s.find('.comboTxtNewItem').val());
                        if (eid === 0 && !enew) return;
                        var rv = $s.find('.comboReps').val();
                        var wv = $s.find('.comboW').val();
                        extra.push({
                            itemID: eid,
                            newItemDesc: enew,
                            repCount: rv === '' ? null : parseInt(rv),
                            wCount: wv === '' ? null : parseInt(wv)
                        });
                    });
                }

                items.push({
                    itemID: itemID,
                    newItemDesc: newDesc,
                    dayTitle: String($r.find('.inpDay').val() || ''),
                    exerciseType: type,
                    setCount: num('.inpSets'),
                    repCount: num('.inpReps'),
                    wCount: num('.inpW'),
                    restSeconds: num('.inpRest'),
                    note: $.trim($r.find('.inpNote').val()) || null,
                    extraItems: extra,
                    dropCount: type === 2 ? num('.inpDropCount') : null,
                    dropWeightPct: type === 2 ? num('.inpDropPct') : null,
                    pyramidDir: type === 6 ? num('.inpPyramidDir') : null,
                    weightStep: type === 6 ? num('.inpWeightStep') : null,
                    pauseCount: type === 7 ? num('.inpPauseCount') : null,
                    pauseRest: type === 7 ? num('.inpPauseRest') : null,
                    tempo: type === 8 ? ($.trim($r.find('.inpTempo').val()) || null) : null
                });
            });

            if (!valid || !items.length) { showToast('لیست حرکات را کامل کنید', 'error'); return; }

            apiCall('/Coach/SaveProgram', 'POST', {
                prgID: parseInt('@Model.PrgID', 10),
                memberID: memberID,
                startDateShamsi: $.trim($('#txtStart').val()),
                endDateShamsi: $.trim($('#txtEnd').val()),
                items: items
            }, function (res) {
                showToast(res.message, res.success ? 'success' : 'error');
                if (res.success) setTimeout(function () { window.location.href = '/Coach/Programs'; }, 800);
            });
        });

        // ===== وضعیت اولیه =====
        $(function () {
            $('#itemsBox .pe-item-card:not(.template)').each(function () {
                syncNewItem($(this));
                syncTechFields($(this));
            });
            applyDayFilter();
            updateAddState();
        });
    </script>
}