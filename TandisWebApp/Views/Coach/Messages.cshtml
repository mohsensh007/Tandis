@model List<TandisWebApp.DTOs.CoachMessageSummaryDto>
@{
    ViewData["Title"] = "پیام‌ها";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-chat-dots-fill hd-icon"></i> پیام‌های شاگردان</h5>
    <a href="/Coach" class="coach-back-pill"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

@if (Model.Count == 0)
{
    <div class="ms-empty">
        <div style="font-size:2.4rem" class="mb-2">💬</div>
        هنوز گفتگویی با شاگردان ندارید
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var st in Model)
        {
            <div class="col-md-6">
                <a href="/Coach/Chat?studentID=@st.StudentMemberID" class="text-decoration-none">
                    <div class="ms-card h-100">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ms-avatar"><i class="bi bi-person-fill"></i></div>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="ms-name">@st.StudentName</div>
                                <div class="ms-mobile" dir="ltr">@st.Mobile</div>
                            </div>
                            @if (st.UnreadCount > 0)
                            {
                                <span class="ms-unread">@st.UnreadCount.ToString(fa)</span>
                            }
                            <i class="bi bi-chevron-left ms-arrow"></i>
                        </div>
                        @if (!string.IsNullOrEmpty(st.LastMessage))
                        {
                            <div class="ms-preview">@st.LastMessage</div>
                            <div class="ms-date">@st.LastMessageDate - @st.LastMessageTime</div>
                        }
                        else
                        {
                            <div class="ms-preview ms-muted">هنوز پیامی رد و بدل نشده</div>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: #66d3e8;
            transition: transform .25s;
        }

        .coach-back-pill:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

            .coach-back-pill:hover i {
                transform: translateX(3px);
            }

    .ms-empty {
        background: linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: #9fb3c8;
        font-size: .9rem;
    }

    .ms-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 18px;
        padding: 16px;
        transition: transform .25s, border-color .25s;
    }

        .ms-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.25), transparent 70%);
            pointer-events: none;
        }

    a:hover .ms-card {
        transform: translateY(-4px);
        border-color: rgba(102,211,232,.45);
    }

    .ms-avatar {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
        background: linear-gradient(135deg, #667eea, #764ba2);
        box-shadow: 0 5px 14px rgba(118,75,162,.4);
    }

    .ms-name {
        font-weight: 800;
        color: #fff;
        font-size: .95rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ms-mobile {
        font-size: .75rem;
        color: #66d3e8;
        margin-top: 2px;
        text-align: right;
    }

    .ms-unread {
        flex: 0 0 auto;
        background: #ff6b81;
        color: #fff;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: .68rem;
        font-weight: 800;
        box-shadow: 0 2px 8px rgba(255,107,129,.5);
    }

    .ms-arrow {
        flex: 0 0 auto;
        color: #66d3e8;
        transition: transform .25s;
    }

    a:hover .ms-arrow {
        transform: translateX(-4px);
    }

    .ms-preview {
        margin-top: 12px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 9px 12px;
        color: #cbd3da;
        font-size: .8rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ms-muted {
        color: #8a93a6;
    }

    .ms-date {
        font-size: .68rem;
        color: #8a93a6;
        margin-top: 6px;
    }
</style>