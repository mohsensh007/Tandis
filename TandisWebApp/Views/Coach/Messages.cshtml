@model List<TandisWebApp.DTOs.CoachInboxItemDto>
@{
    ViewData["Title"] = "پیام‌ها";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
    var unread = ViewBag.UnreadMessages as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0">
        <i class="bi bi-chat-dots-fill hd-icon"></i> پیام‌های مدیریت
        @if (unread > 0)
        {
            <span class="ms-unread ms-unread-static" id="unreadBadge">@unread.ToString(fa)</span>
        }
    </h5>
    <a href="/Coach" class="purple-style coach-back-pill"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

<p class="small mb-3" style="color:#9fb3c8">
    <i class="bi bi-info-circle me-1"></i>
    در این بخش فقط پیام‌هایی که مدیریت برای شما فرستاده نمایش داده می‌شود.
</p>

@if (Model.Count == 0)
{
    <div class="ms-empty">
        <div style="font-size:2.4rem" class="mb-2">📭</div>
        هنوز پیامی از طرف مدیریت برای شما ارسال نشده است
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var msg in Model)
        {
            <div class="col-12">
                <div class="purple-style ms-card @(msg.IsRead ? "" : "ms-card-unread")"
                     data-id="@msg.MessageID" onclick="toggleMsg(this)">
                    <div class="d-flex align-items-start gap-3">
                        <div class="ms-avatar"><i class="bi bi-envelope-fill"></i></div>
                        <div class="flex-grow-1" style="min-width:0">
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="ms-name">
                                    @(string.IsNullOrEmpty(msg.Title) ? "(بدون عنوان)" : msg.Title)
                                </div>
                                @if (!msg.IsRead)
                                {
                                    <span class="ms-unread ms-dot">جدید</span>
                                }
                            </div>
                            <div class="ms-preview">@msg.Body</div>
                            <div class="ms-full" style="display:none">@msg.Body</div>
                            <div class="ms-date">@msg.CreationDate - @msg.CreationTime</div>
                        </div>
                        <i class="bi bi-chevron-down ms-arrow"></i>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #dce9ff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: #66d3e8;
        }

        .coach-back-pill:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

    .ms-empty {
        background: linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: #9fb3c8;
        font-size: .9rem;
    }

    .ms-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 18px;
        padding: 16px;
        cursor: pointer;
        transition: transform .25s, border-color .25s;
        -webkit-tap-highlight-color: transparent;
    }

        .ms-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.25), transparent 70%);
            pointer-events: none;
        }

    .ms-card-unread {
        border-color: rgba(102,211,232,.45);
        box-shadow: 0 6px 18px rgba(46,134,222,.18);
    }

    .ms-avatar {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
        background: linear-gradient(135deg, #667eea, #764ba2);
        box-shadow: 0 5px 14px rgba(118,75,162,.4);
    }

    .ms-name {
        font-weight: 800;
        color: #fff;
        font-size: .95rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ms-unread {
        flex: 0 0 auto;
        background: #ff6b81;
        color: #fff;
        border-radius: 999px;
        padding: 3px 9px;
        font-size: .68rem;
        font-weight: 800;
        box-shadow: 0 2px 8px rgba(255,107,129,.5);
        white-space: nowrap;
    }

    .ms-unread-static {
        font-size: .7rem;
        vertical-align: middle;
        margin-right: 6px;
    }

    .ms-arrow {
        flex: 0 0 auto;
        color: #66d3e8;
        transition: transform .25s;
        margin-top: 4px;
    }

    .ms-card.open .ms-arrow {
        transform: rotate(180deg);
    }

    .ms-preview {
        margin-top: 12px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 9px 12px;
        color: #cbd3da;
        font-size: .8rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ms-card.open .ms-preview {
        display: none;
    }

    .ms-full {
        margin-top: 12px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 11px 13px;
        color: #e9ecef;
        font-size: .85rem;
        line-height: 1.9;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ms-date {
        font-size: .68rem;
        color: #8a93a6;
        margin-top: 6px;
    }
</style>

@section Scripts {
    <script>
        // ✅ باز/بسته کردن پیام + علامت‌گذاری خوانده‌شده (فقط خواندنی — امکان پاسخ وجود ندارد)
        function toggleMsg(el) {
            var open = el.classList.toggle('open');
            var full = el.querySelector('.ms-full');
            if (full) full.style.display = open ? 'block' : 'none';

            if (!open) return;

            var id = parseInt(el.getAttribute('data-id'), 10);
            if (!id || el.getAttribute('data-read') === '1') return;
            el.setAttribute('data-read', '1');
            el.classList.remove('ms-card-unread');

            var dot = el.querySelector('.ms-dot');
            if (dot) dot.remove();

            apiCall('/api/Coach/Messages/Read', 'POST', id, function () {
                var badge = document.getElementById('unreadBadge');
                if (!badge) return;
                var n = parseInt((badge.textContent || '0'), 10);
                if (isNaN(n)) n = 0;
                n = n - 1;
                if (n <= 0) { badge.remove(); }
                else { badge.textContent = n.toLocaleString('fa-IR'); }
            });
        }
    </script>
}
