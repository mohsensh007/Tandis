@model TandisWebApp.DTOs.CoachStudentDetailsDto
@{
    ViewData["Title"] = Model.FullName;
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<!-- هدر -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="mb-0">👤 @Model.FullName</h5>
        <div class="text-muted small">@Model.ClassName</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge bg-@Model.StatusClass fs-6">@Model.StatusLabel</span>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">🔙 برگشت</a>
    </div>
</div>

<!-- کارت‌های اطلاعات -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-success">🎟️</div>
                <div>
                    <div class="stat-label">باقی‌مانده</div>
                    <div class="stat-value">@Model.RemainingSessions.ToString(fa)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-info">✅</div>
                <div>
                    <div class="stat-label">مصرف‌شده</div>
                    <div class="stat-value">@Model.UsedSessions.ToString(fa)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-warning">📅</div>
                <div>
                    <div class="stat-label">پایان دوره</div>
                    <div class="stat-value" style="font-size:1.1rem">@(Model.EndDate ?? "-")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-danger">📞</div>
                <div class="flex-grow-1" style="min-width:0;">
                    <div class="stat-label">موبایل</div>
                    @if (!string.IsNullOrEmpty(Model.Mobile))
                    {
                        <!-- ✅ dir=ltr تا شماره کامل و درست نمایش داده بشه -->
                        <div dir="ltr" style="text-align:right; font-size:1.05rem; font-weight:700; overflow-wrap:anywhere;">
                            <a href="tel:@Model.Mobile" class="text-decoration-none">@Model.Mobile</a>
                        </div>
                    }
                    else
                    {
                        <div class="fw-bold">-</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- تاریخچه حضور -->
<div class="card">
    <div class="card-header">🚪 تاریخچه حضور (@Model.Attendances.Count.ToString(fa) تردد)</div>
    <div class="card-body p-0">
        @if (Model.Attendances.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🚪</div>
                هنوز ترددی ثبت نشده
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>تاریخ ورود</th>
                            <th>ساعت ورود</th>
                            <th>تاریخ خروج</th>
                            <th>ساعت خروج</th>
                            <th class="text-center">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Attendances)
                        {
                            <tr>
                                <td>@(t.EntryDate ?? "-")</td>
                                <td>@(t.EntryTime ?? "-")</td>
                                <td>@(t.ExitDate ?? "-")</td>
                                <td>@(t.ExitTime ?? "-")</td>
                                <td class="text-center">
                                    @if (t.IsOpen)
                                    {
                                        <span class="badge bg-success">🟢 داخل باشگاه</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">خروج ثبت‌شده</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>