@model TandisWebApp.DTOs.CoachStudentDetailsDto
@{
    ViewData["Title"] = Model.FullName;
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<!-- هدر -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3" style="min-width:0">
        <div class="sd-avatar"><i class="bi bi-person-fill"></i></div>
        <div style="min-width:0">
            <h5 class="mb-0">@Model.FullName</h5>
            <div class="sd-sub">@Model.ClassName</div>
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="stt stt-@Model.StatusClass" style="font-size:.75rem; padding:6px 16px;">@Model.StatusLabel</span>
        <a href="javascript:history.back()" class="purple-style coach-back-pill"><i class="bi bi-arrow-right"></i> برگشت</a>
    </div>
</div>

<!-- کارت‌های اطلاعات -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="purple-style sd-card h-100">
            <div class="sd-icon grad-turquoise"><i class="bi bi-ticket-perforated-fill"></i></div>
            <div class="sd-label">باقی‌مانده</div>
            <div class="sd-value">@Model.RemainingSessions.ToString(fa)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="purple-style sd-card h-100">
            <div class="sd-icon grad-blue"><i class="bi bi-check2-circle"></i></div>
            <div class="sd-label">مصرف‌شده</div>
            <div class="sd-value">@Model.UsedSessions.ToString(fa)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="purple-style sd-card h-100">
            <div class="sd-icon grad-purple"><i class="bi bi-calendar-x-fill"></i></div>
            <div class="sd-label">پایان دوره</div>
            <div class="sd-value sd-small">@(Model.EndDate ?? "-")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="purple-style sd-card h-100">
            <div class="sd-icon grad-pink"><i class="bi bi-telephone-fill"></i></div>
            <div class="sd-label">موبایل</div>
            @if (!string.IsNullOrEmpty(Model.Mobile))
            {
                <div class="sd-value sd-small" dir="ltr">
                    <a href="tel:@Model.Mobile" class="sd-tel">@Model.Mobile</a>
                </div>
            }
            else
            {
                <div class="sd-value sd-small">-</div>
            }
        </div>
    </div>
</div>

<!-- تاریخچه حضور -->
<div class="sd-box">
    <div class="sd-box-head"><i class="bi bi-door-open-fill me-2"></i>تاریخچه حضور (@Model.Attendances.Count.ToString(fa) تردد)</div>
    <div class="purple-style p-3">
        @if (Model.Attendances.Count == 0)
        {
            <div class="sd-empty">
                <div style="font-size:2.2rem" class="mb-2">🚪</div>
                هنوز ترددی ثبت نشده
            </div>
        }
        else
        {
            @foreach (var t in Model.Attendances)
            {
                <div class="sd-att">
                    <div class="sd-att-lines">
                        <div class="sd-line"><i class="bi bi-box-arrow-in-down"></i> ورود: @(t.EntryDate ?? "-") <b>@(t.EntryTime ?? "-")</b></div>
                        <div class="sd-line"><i class="bi bi-box-arrow-out"></i> خروج: @(t.ExitDate ?? "-") <b>@(t.ExitTime ?? "-")</b></div>
                    </div>
                    @if (t.IsOpen)
                    {
                        <span class="stt stt-success">🟢 داخل باشگاه</span>
                    }
                    else
                    {
                        <span class="stt stt-secondary">خروج ثبت ‌شده</span>
                    }
                </div>
            }
        }
    </div>
</div>

<style>
    .sd-avatar {
        flex: 0 0 auto;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #172554;
        background: linear-gradient(135deg, #3B82F6, #3B82F6);
        box-shadow: 0 6px 16px rgba(59,130,246,.35);
    }

    .sd-sub {
        font-size: .78rem;
        color: #172554;
        margin-top: 3px;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(191, 219, 254,.08);
        border: 1px solid rgba(23,37,84,.18);
        color: #172554;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: #3B82F6;
            transition: transform .25s;
        }

        .coach-back-pill:hover {
            background: rgba(191, 219, 254,.14);
            color: #172554;
        }

            .coach-back-pill:hover i {
                transform: translateX(3px);
            }

    .sd-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(191, 219, 254,.10), rgba(23,37,84,.04));
        border: 1px solid rgba(23,37,84,.14);
        border-radius: 18px;
        padding: 18px 14px;
        text-align: center;
    }

        .sd-card::before {
            content: '';
            position: absolute;
            top: -35px;
            left: -35px;
            width: 110px;
            height: 110px;
            background: radial-gradient(circle, rgba(191, 219, 254,.25), transparent 70%);
            pointer-events: none;
        }

    .sd-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #172554;
        box-shadow: 0 6px 16px rgba(23,37,84,.3);
        margin-bottom: 10px;
    }

    .grad-blue {
        background: linear-gradient(135deg, #3B82F6, #3B82F6);
    }

    .grad-turquoise {
        background: linear-gradient(135deg, #3B82F6, #3B82F6);
    }

    .grad-purple {
        background: linear-gradient(135deg, #3B82F6, #FFFFFF);
    }

    .grad-pink {
        background: linear-gradient(135deg, #3B82F6, #FFFFFF);
    }

    .sd-label {
        font-size: .75rem;
        color: #172554;
        font-weight: 700;
    }

    .sd-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: #172554;
        margin-top: 4px;
    }

    .sd-small {
        font-size: 1rem;
    }

    .sd-tel {
        color: #3B82F6;
        text-decoration: none;
    }

        .sd-tel:hover {
            color: #172554;
        }

    .sd-box {
        background: linear-gradient(160deg, rgba(191, 219, 254,.08), rgba(23,37,84,.03));
        border: 1px solid rgba(23,37,84,.14);
        border-radius: 20px;
        overflow: hidden;
    }

    .sd-box-head {
        background: linear-gradient(135deg, #3B82F6 0%, #FFFFFF 100%);
        color: #172554;
        font-weight: 800;
        font-size: .95rem;
        padding: 12px 16px;
    }

    .sd-empty {
        text-align: center;
        padding: 34px 10px;
        color: #172554;
        font-size: .88rem;
    }

    .sd-att {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        background: rgba(191, 219, 254,.05);
        border: 1px solid rgba(23,37,84,.10);
        border-radius: 14px;
        padding: 10px 14px;
        margin-bottom: 8px;
    }

        .sd-att:last-child {
            margin-bottom: 0;
        }

    .sd-line {
        font-size: .78rem;
        color: rgba(23,37,84, .62);
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .sd-line b {
            color: #172554;
        }

        .sd-line i {
            color: #3B82F6;
        }

    .stt {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 800;
    }

    .stt-success {
        background: rgba(59,130,246,.16);
        color: #3B82F6;
        border: 1px solid rgba(59,130,246,.4);
    }

    .stt-warning {
        background: rgba(59,130,246,.16);
        color: #3B82F6;
        border: 1px solid rgba(59,130,246,.4);
    }

    .stt-secondary {
        background: rgba(191, 219, 254,.10);
        color: #172554;
        border: 1px solid rgba(23,37,84,.2);
    }

    .stt-danger {
        background: rgba(191, 219, 254,.16);
        color: #172554;
        border: 1px solid rgba(23,37,84,.4);
    }
</style>