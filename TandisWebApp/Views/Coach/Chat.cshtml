@model TandisWebApp.DTOs.CoachChatDto
@{
    ViewData["Title"] = Model.StudentName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-chat-dots-fill hd-icon"></i> @Model.StudentName</h5>
    <a href="/Coach/Messages" class="coach-back-pill"><i class="bi bi-arrow-right"></i> پیام‌ها</a>
</div>

<!-- ========== تاریخچه گفتگو ========== -->
<div class="ch-box" id="chBox">
    @if (Model.Messages.Count == 0)
    {
        <div class="ch-empty">
            <div style="font-size:2.2rem" class="mb-2">💬</div>
            هنوز پیامی رد و بدل نشده
        </div>
    }
    else
    {
        @foreach (var msg in Model.Messages)
        {
            <div class="ch-row @(msg.IsFromMe ? "ch-mine" : "")">
                <div class="ch-bubble">
                    @if (!string.IsNullOrEmpty(msg.Title))
                    {
                        <div class="ch-title">@msg.Title</div>
                    }
                    <div class="ch-body">@msg.Body</div>
                    <div class="ch-time">@msg.CreationDate @msg.CreationTime</div>
                </div>
            </div>
        }
    }
</div>

@* ⛔ محدودسازی پیام‌رسانی (غیرفعال شده — فقط کامنت شده، حذف نشده):
   مربی دیگر اجازه ندارد به شاگرد پیام بفرستد (فقط ادمین به مربی/عضو).
   برای فعال‌سازی دوباره کافی است کامنت زیر برداشته شود. *@
@*
<!-- ========== فرم ارسال ========== -->
<div class="ch-form-card mt-3">
    <form method="post" asp-action="SendMessage">
        <input type="hidden" name="studentID" value="@Model.StudentMemberID" />
        <div class="mb-2">
            <input type="text" name="title" class="ch-input" placeholder="عنوان (اختیاری)" />
        </div>
        <div class="mb-3">
            <textarea name="body" class="ch-input" rows="3" placeholder="متن پیام..." required></textarea>
        </div>
        <button type="submit" class="ch-send">
            <i class="bi bi-send-fill"></i> ارسال
        </button>
    </form>
</div>
*@

<style>
    .hd-icon {
        color: var(--g-primary);
        margin-left: 6px;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: var(--g-primary);
            transition: transform .25s;
        }

        .coach-back-pill:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
            color: var(--g-text);
        }

            .coach-back-pill:hover i {
                transform: translateX(3px);
            }

    .ch-box {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 8%, transparent), color-mix(in srgb, var(--g-text) 3%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 20px;
        padding: 16px;
        max-height: 440px;
        overflow-y: auto;
    }

    .ch-empty {
        text-align: center;
        padding: 34px 10px;
        color: var(--g-text);
        font-size: .88rem;
    }

    .ch-row {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 10px;
    }

        .ch-row.ch-mine {
            justify-content: flex-end;
        }

    .ch-bubble {
        max-width: 78%;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 16px;
        padding: 10px 14px;
        color: color-mix(in srgb, var(--g-text) 62%, transparent);
    }

    .ch-mine .ch-bubble {
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
        border-color: transparent;
        color: var(--g-text);
        box-shadow: 0 5px 14px color-mix(in srgb, var(--g-primary) 35%, transparent);
    }

    .ch-title {
        font-weight: 800;
        font-size: .82rem;
        margin-bottom: 4px;
    }

    .ch-body {
        font-size: .85rem;
        line-height: 1.8;
        word-break: break-word;
    }

    .ch-time {
        font-size: .65rem;
        opacity: .65;
        margin-top: 6px;
    }

    .ch-form-card {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 20px;
        padding: 16px;
    }

    .ch-input {
        width: 100%;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: .85rem;
    }

        .ch-input::placeholder {
            color: color-mix(in srgb, var(--g-text) 62%, transparent);
        }

        .ch-input:focus {
            outline: none;
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
            border-color: color-mix(in srgb, var(--g-primary) 50%, transparent);
        }

    .ch-send {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        border: none;
        color: var(--g-text);
        font-weight: 800;
        font-size: .85rem;
        border-radius: 14px;
        padding: 9px 22px;
        box-shadow: 0 6px 16px color-mix(in srgb, var(--g-primary) 40%, transparent);
        transition: all .25s;
    }

        .ch-send:hover {
            filter: brightness(1.1);
            color: var(--g-text);
        }
</style>

@section Scripts {
    <script>
        // ✅ اسکرول خودکار به آخرین پیام
        $(function () {
            var b = document.getElementById('chBox');
            if (b) b.scrollTop = b.scrollHeight;
        });
    </script>
}