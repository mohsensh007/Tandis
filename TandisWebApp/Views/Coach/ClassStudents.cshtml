@model List<TandisWebApp.DTOs.CoachStudentDto>
@{
    ViewData["Title"] = ViewBag.ClassName;
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<!-- ===== هدر گرادیان (مثل بقیه صفحات) ===== -->
<div class="cs-head-bar mb-3">
    <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0">
        <span class="cs-head-icon"><i class="bi bi-people-fill"></i></span>
        <div style="min-width:0">
            <div class="cs-head-title">شاگردان کلاس</div>
            <div class="cs-head-sub">@ViewBag.ClassName</div>
        </div>
    </div>
    <span class="cs-count">@Model.Count.ToString(fa) نفر</span>
    <a href="/Coach/Classes" class="coach-back-pill"><i class="bi bi-arrow-right"></i> کلاس‌ها</a>
</div>

<!-- ===== جستجو ===== -->
@if (Model.Count > 0)
{
    <div class="mb-3">
        <input type="text" id="csSearch" class="glass-search" placeholder="🔍 جستجوی نام شاگرد..." />
    </div>
}

@if (Model.Count == 0)
{
    <div class="cs-empty">
        <div style="font-size:2.4rem" class="mb-2">👥</div>
        هنوز هیچ شاگردی در این کلاس ثبت‌نام نکرده
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var st in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Coach/StudentDetails/@st.SportMemberID" class="text-decoration-none">
                    <div class="purple-style cs-card h-100">
                        <div class="d-flex align-items-center gap-3">
                            <div class="cs-avatar"><i class="bi bi-person-fill"></i></div>
                            <div style="min-width:0" class="flex-grow-1">
                                <div class="cs-name">@st.FullName</div>
                                <div class="cs-mobile" dir="ltr">@(string.IsNullOrEmpty(st.Mobile) ? "-" : st.Mobile)</div>
                            </div>
                            <span class="stt stt-@st.StatusClass">@st.StatusLabel</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="cs-pill"><i class="bi bi-calendar-x-fill"></i> پایان: @(st.EndDate ?? "-")</span>
                            <span class="cs-pill"><i class="bi bi-ticket-perforated-fill"></i> جلسات: @st.RemainingSessions.ToString(fa) / @st.TotalSessions.ToString(fa)</span>
                        </div>
                        <div class="cs-foot mt-3"><i class="bi bi-person-vcard"></i> مشاهده کارت و تاریخچه حضور</div>
                    </div>
                </a>
            </div>
        }
    </div>
    <div class="cs-hint mt-3"><i class="bi bi-info-circle"></i> روی کارت هر شاگرد بزنید تا کارت کامل و تاریخچه حضورش باز شود.</div>
}

<style>
    .cs-head-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        border-radius: 16px;
        padding: 12px 16px;
        color: var(--g-text);
    }

    .cs-head-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--g-nested-solid) 18%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .cs-head-title {
        font-weight: 800;
        font-size: .95rem;
    }

    .cs-head-sub {
        font-size: .75rem;
        opacity: .85;
        margin-top: 2px;
    }

    .cs-count {
        background: color-mix(in srgb, var(--g-nested-solid) 18%, transparent);
        border-radius: 999px;
        padding: 5px 14px;
        font-size: .72rem;
        font-weight: 800;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 25%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s;
    }

        .coach-back-pill:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 25%, transparent);
            color: var(--g-text);
        }

    .glass-search {
        width: 100%;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 10px 18px;
        font-size: .85rem;
    }

        .glass-search:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--g-primary) 50%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
        }

    .cs-empty {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 8%, transparent), color-mix(in srgb, var(--g-text) 3%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: var(--g-text);
        font-size: .9rem;
    }

    .cs-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 18px;
        padding: 16px;
        transition: transform .25s, border-color .25s;
    }

        .cs-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-nested-solid) 25%, transparent), transparent 70%);
            pointer-events: none;
        }

    a:hover .cs-card {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--g-primary) 45%, transparent);
    }

    .cs-avatar {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--g-text);
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
        box-shadow: 0 5px 14px color-mix(in srgb, var(--g-text) 35%, transparent);
    }

    .cs-name {
        font-weight: 800;
        color: var(--g-text);
        font-size: .92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cs-mobile {
        font-size: .73rem;
        color: var(--g-primary);
        margin-top: 2px;
        text-align: right;
    }

    .cs-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .72rem;
        font-weight: 700;
    }

        .cs-pill i {
            color: var(--g-primary);
            font-size: .8rem;
        }

    .cs-foot {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--g-primary);
        font-size: .76rem;
        font-weight: 700;
        border-top: 1px dashed color-mix(in srgb, var(--g-text) 12%, transparent);
        padding-top: 10px;
    }

    .cs-hint {
        color: var(--g-text);
        font-size: .75rem;
    }

        .cs-hint i {
            color: var(--g-primary);
        }

    .stt {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .stt-success {
        background: color-mix(in srgb, var(--g-primary) 16%, transparent);
        color: var(--g-primary);
        border: 1px solid color-mix(in srgb, var(--g-primary) 40%, transparent);
    }

    .stt-warning {
        background: color-mix(in srgb, var(--g-primary) 16%, transparent);
        color: var(--g-primary);
        border: 1px solid color-mix(in srgb, var(--g-primary) 40%, transparent);
    }

    .stt-secondary {
        background: color-mix(in srgb, var(--g-nested-solid) 10%, transparent);
        color: var(--g-text);
        border: 1px solid color-mix(in srgb, var(--g-text) 20%, transparent);
    }

    .stt-danger {
        background: color-mix(in srgb, var(--g-nested-solid) 16%, transparent);
        color: var(--g-text);
        border: 1px solid color-mix(in srgb, var(--g-text) 40%, transparent);
    }
</style>

@section Scripts {
    <script>
        $('#csSearch').on('keyup', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('.cs-card').each(function () {
                var txt = $(this).text().toLowerCase();
                $(this).closest('div[class*="col-"]').toggle(txt.indexOf(q) > -1);
            });
        });
    </script>
}