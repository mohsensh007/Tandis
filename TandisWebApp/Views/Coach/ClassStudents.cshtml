@model List<TandisWebApp.DTOs.CoachStudentDto>
@{
    ViewData["Title"] = ViewBag.ClassName;
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<!-- ===== هدر گرادیان (مثل بقیه صفحات) ===== -->
<div class="cs-head-bar mb-3">
    <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0">
        <span class="cs-head-icon"><i class="bi bi-people-fill"></i></span>
        <div style="min-width:0">
            <div class="cs-head-title">شاگردان کلاس</div>
            <div class="cs-head-sub">@ViewBag.ClassName</div>
        </div>
    </div>
    <span class="cs-count">@Model.Count.ToString(fa) نفر</span>
    <a href="/Coach/Classes" class="coach-back-pill"><i class="bi bi-arrow-right"></i> کلاس‌ها</a>
</div>

<!-- ===== جستجو ===== -->
@if (Model.Count > 0)
{
    <div class="mb-3">
        <input type="text" id="csSearch" class="glass-search" placeholder="🔍 جستجوی نام شاگرد..." />
    </div>
}

@if (Model.Count == 0)
{
    <div class="cs-empty">
        <div style="font-size:2.4rem" class="mb-2">👥</div>
        هنوز هیچ شاگردی در این کلاس ثبت‌نام نکرده
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var st in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Coach/StudentDetails/@st.SportMemberID" class="text-decoration-none">
                    <div class="cs-card h-100">
                        <div class="d-flex align-items-center gap-3">
                            <div class="cs-avatar"><i class="bi bi-person-fill"></i></div>
                            <div style="min-width:0" class="flex-grow-1">
                                <div class="cs-name">@st.FullName</div>
                                <div class="cs-mobile" dir="ltr">@(string.IsNullOrEmpty(st.Mobile) ? "-" : st.Mobile)</div>
                            </div>
                            <span class="stt stt-@st.StatusClass">@st.StatusLabel</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="cs-pill"><i class="bi bi-calendar-x-fill"></i> پایان: @(st.EndDate ?? "-")</span>
                            <span class="cs-pill"><i class="bi bi-ticket-perforated-fill"></i> جلسات: @st.RemainingSessions.ToString(fa) / @st.TotalSessions.ToString(fa)</span>
                        </div>
                        <div class="cs-foot mt-3"><i class="bi bi-person-vcard"></i> مشاهده کارت و تاریخچه حضور</div>
                    </div>
                </a>
            </div>
        }
    </div>
    <div class="cs-hint mt-3"><i class="bi bi-info-circle"></i> روی کارت هر شاگرد بزنید تا کارت کامل و تاریخچه حضورش باز شود.</div>
}

<style>
    .cs-head-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        padding: 12px 16px;
        color: #fff;
    }

    .cs-head-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .cs-head-title {
        font-weight: 800;
        font-size: .95rem;
    }

    .cs-head-sub {
        font-size: .75rem;
        opacity: .85;
        margin-top: 2px;
    }

    .cs-count {
        background: rgba(255,255,255,.18);
        border-radius: 999px;
        padding: 5px 14px;
        font-size: .72rem;
        font-weight: 800;
    }

    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.25);
        color: #fff;
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s;
    }

        .coach-back-pill:hover {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

    .glass-search {
        width: 100%;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #fff;
        border-radius: 999px;
        padding: 10px 18px;
        font-size: .85rem;
    }

        .glass-search:focus {
            outline: none;
            border-color: rgba(102,211,232,.5);
            background: rgba(255,255,255,.12);
        }

    .cs-empty {
        background: linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: #9fb3c8;
        font-size: .9rem;
    }

    .cs-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 18px;
        padding: 16px;
        transition: transform .25s, border-color .25s;
    }

        .cs-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, rgba(46,134,222,.25), transparent 70%);
            pointer-events: none;
        }

    a:hover .cs-card {
        transform: translateY(-4px);
        border-color: rgba(102,211,232,.45);
    }

    .cs-avatar {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #fff;
        background: linear-gradient(135deg, #2E86DE, #66d3e8);
        box-shadow: 0 5px 14px rgba(46,134,222,.35);
    }

    .cs-name {
        font-weight: 800;
        color: #fff;
        font-size: .92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cs-mobile {
        font-size: .73rem;
        color: #66d3e8;
        margin-top: 2px;
        text-align: right;
    }

    .cs-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(13,110,253,.30);
        color: #dce9ff;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .72rem;
        font-weight: 700;
    }

        .cs-pill i {
            color: #66d3e8;
            font-size: .8rem;
        }

    .cs-foot {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #66d3e8;
        font-size: .76rem;
        font-weight: 700;
        border-top: 1px dashed rgba(255,255,255,.12);
        padding-top: 10px;
    }

    .cs-hint {
        color: #9fb3c8;
        font-size: .75rem;
    }

        .cs-hint i {
            color: #66d3e8;
        }

    .stt {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .stt-success {
        background: rgba(56,217,169,.16);
        color: #38d9a9;
        border: 1px solid rgba(56,217,169,.4);
    }

    .stt-warning {
        background: rgba(255,193,7,.16);
        color: #ffd200;
        border: 1px solid rgba(255,193,7,.4);
    }

    .stt-secondary {
        background: rgba(255,255,255,.10);
        color: #9fb3c8;
        border: 1px solid rgba(255,255,255,.2);
    }

    .stt-danger {
        background: rgba(255,107,129,.16);
        color: #ff6b81;
        border: 1px solid rgba(255,107,129,.4);
    }
</style>

@section Scripts {
    <script>
        $('#csSearch').on('keyup', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('.cs-card').each(function () {
                var txt = $(this).text().toLowerCase();
                $(this).closest('div[class*="col-"]').toggle(txt.indexOf(q) > -1);
            });
        });
    </script>
}