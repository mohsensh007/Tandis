@model List<TandisWebApp.DTOs.CoachClassListDto>
@{
    ViewData["Title"] = "کلاس‌های من";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<!-- ========== هدر صفحه ========== -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-book-fill hd-icon"></i> کلاس‌های من</h5>
    <a href="/Coach" class="purple-style coach-back-pill"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>
<div class="mb-3">
    <input type="text" id="ccSearch" class="glass-search" placeholder="🔍 جستجو در کلاس‌ها (رشته، سانس)..." />
</div>

@if (Model.Count == 0)
{
    <div class="cc-empty">
        <div style="font-size:2.4rem" class="mb-2">📚</div>
        هنوز کلاسی برای شما ثبت نشده است
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Coach/ClassStudents/@c.SportSanseID" class="text-decoration-none">
                    <div class="purple-style cc-card h-100">
                        <div class="d-flex align-items-start gap-3">
                            <div class="cc-icon"><i class="bi bi-book-fill"></i></div>
                            <div style="min-width:0" class="flex-grow-1">
                                <div class="cc-title">@c.SportName</div>
                                <div class="cc-sub">@c.SanseName</div>
                            </div>
                            <i class="bi bi-chevron-left cc-arrow"></i>
                        </div>

                        <div class="cc-schedule">
                            <i class="bi bi-calendar3"></i>
                            <span>@c.ScheduleSummary</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="cc-pill"><i class="bi bi-people-fill"></i> @c.ActiveStudents.ToString(fa) فعال</span>
                            @if (c.ClassCapacity != null)
                            {
                                <span class="cc-pill"><i class="bi bi-person-check-fill"></i> @c.FreeNow?.ToString(fa) جای خالی</span>
                            }
                            else
                            {
                                <span class="cc-pill"><i class="bi bi-bar-chart-fill"></i> جمع: @c.TotalStudents.ToString(fa)</span>
                            }
                        </div>

                        <div class="cc-foot mt-3">
                            <i class="bi bi-people-fill"></i> مشاهده شاگردان
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .hd-icon {
        color: var(--g-primary);
        margin-left: 6px;
    }

    /* ===== دکمه بازگشت شیشه‌ای ===== */
    .coach-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .coach-back-pill i {
            color: var(--g-primary);
            transition: transform .25s;
        }

        .coach-back-pill:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
            color: var(--g-text);
            border-color: color-mix(in srgb, var(--g-primary) 45%, transparent);
        }

            .coach-back-pill:hover i {
                transform: translateX(3px);
            }

    /* ===== حالت خالی ===== */
    .cc-empty {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 8%, transparent), color-mix(in srgb, var(--g-text) 3%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: var(--g-text);
        font-size: .9rem;
    }

    /* ===== کارت کلاس شیشه‌ای ===== */
    .cc-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 18px;
        padding: 16px;
        transition: transform .25s, border-color .25s;
    }

        .cc-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-nested-solid) 25%, transparent), transparent 70%);
            pointer-events: none;
        }

    a:hover .cc-card {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--g-primary) 45%, transparent);
    }

    .cc-icon {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: var(--g-text);
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
        box-shadow: 0 6px 16px color-mix(in srgb, var(--g-text) 35%, transparent);
    }

    .cc-title {
        font-weight: 800;
        color: var(--g-text);
        font-size: .98rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cc-sub {
        font-size: .78rem;
        color: var(--g-text);
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cc-arrow {
        flex: 0 0 auto;
        color: var(--g-primary);
        font-size: 1rem;
        transition: transform .25s;
    }

    a:hover .cc-arrow {
        transform: translateX(-4px);
    }

    /* ===== کادر برنامه هفتگی ===== */
    .cc-schedule {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        background: color-mix(in srgb, var(--g-nested-solid) 5%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 10%, transparent);
        border-radius: 12px;
        padding: 9px 12px;
        margin-top: 13px;
        font-size: .78rem;
        color: color-mix(in srgb, var(--g-text) 62%, transparent);
        line-height: 1.7;
    }

        .cc-schedule i {
            color: var(--g-primary);
            font-size: .95rem;
            margin-top: 3px;
            flex: 0 0 auto;
        }

    /* ===== pill های آمار ===== */
    .cc-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .73rem;
        font-weight: 700;
    }

        .cc-pill i {
            color: var(--g-primary);
            font-size: .82rem;
        }

    /* ===== پاورقی کارت ===== */
    .cc-foot {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--g-primary);
        font-size: .78rem;
        font-weight: 700;
        border-top: 1px dashed color-mix(in srgb, var(--g-text) 12%, transparent);
        padding-top: 11px;
    }

    .glass-search {
        width: 100%;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 10px 18px;
        font-size: .85rem;
    }

        .glass-search:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--g-primary) 50%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
        }
</style>
@section Scripts {
    <script>
        $('#ccSearch').on('keyup', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('.cc-card').each(function () {
                var txt = $(this).text().toLowerCase();
                $(this).closest('div[class*="col-"]').toggle(txt.indexOf(q) > -1);
            });
        });
    </script>
}