@model List<TandisWebApp.DTOs.CoachClassListDto>
@{
    ViewData["Title"] = "کلاس‌های من";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">📚 کلاس‌های من</h5>
    <a href="/Coach" class="btn btn-outline-secondary btn-sm">🔙 داشبورد</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">📚</div>
        هیچ کلاسی برای شما تعریف نشده است
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Coach/ClassStudents/@c.SportSanseID" class="text-decoration-none">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body">
                            <div class="fw-bold fs-6 mb-1 text-dark">
                                @c.SportName
                            </div>
                            <div class="text-muted small mb-2">@c.SanseName</div>

                            <div class="small mb-3">
                                <span class="text-muted">📅</span>
                                @c.ScheduleSummary
                            </div>

                            <div class="d-flex justify-content-between small">
                                <span>👥 <strong>@c.ActiveStudents.ToString(fa)</strong> فعال</span>
                                @if (c.ClassCapacity != null)
                                {
                                    <span>💺 <strong>@c.FreeNow?.ToString(fa)</strong> جای خالی</span>
                                }
                                else
                                {
                                    <span>📊 جمع: @c.TotalStudents.ToString(fa)</span>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .hover-card {
        transition: all .2s;
    }

        .hover-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,.1) !important;
        }
</style>