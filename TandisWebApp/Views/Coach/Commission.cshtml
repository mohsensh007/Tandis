@model TandisWebApp.DTOs.CoachCommissionSummaryDto
@{
    ViewData["Title"] = "گزارش دریافتی";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
    var fromDate = Model.FromDate;
    var toDate = Model.ToDate;
}

<!-- ===== هدر ===== -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-cash-coin hd-icon"></i> گزارش دریافتی</h5>
    <a href="/Coach" class="purple-style cm-back-pill"><i class="bi bi-arrow-right"></i> داشبورد</a>
</div>

<!-- ===== فیلتر با تقویم شمسی ===== -->
<form method="get" asp-action="Commission" class="purple-style cm-filter mb-3">
    <div class="row g-2">
        <div class="col-6 col-md-3">
            <label class="cm-lbl">از تاریخ</label>
            <div class="d-flex gap-2">
                <input type="text" name="fromDate" id="txtFrom" class="cm-input" readonly value="@fromDate" placeholder="1405/01/01" />
                <button type="button" class="cm-cal-btn" onclick="openCal('txtFrom')"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <label class="cm-lbl">تا تاریخ</label>
            <div class="d-flex gap-2">
                <input type="text" name="toDate" id="txtTo" class="cm-input" readonly value="@toDate" placeholder="1405/03/31" />
                <button type="button" class="cm-cal-btn" onclick="openCal('txtTo')"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div class="col-6 col-md-3 d-flex align-items-end">
            <button type="submit" class="cm-apply w-100"><i class="bi bi-funnel-fill"></i> اعمال فیلتر</button>
        </div>
        <div class="col-6 col-md-3 d-flex align-items-end">
            <a href="/Coach/Commission" class="cm-month w-100"><i class="bi bi-calendar-month"></i> ماه جاری</a>
        </div>
    </div>
</form>

<!-- ===== کارت‌های آمار (فقط دریافتی) ===== -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="purple-style cm-card h-100">
            <div class="cm-icon grad-green"><i class="bi bi-cash-stack"></i></div>
            <div class="cm-label">دریافتی این ماه</div>
            <div class="cm-value">@Model.ThisMonthAmount.ToString("N0", fa)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="purple-style cm-card h-100">
            <div class="cm-icon grad-turquoise"><i class="bi bi-bar-chart-fill"></i></div>
            <div class="cm-label">تعداد این ماه</div>
            <div class="cm-value">@Model.ThisMonthCount.ToString(fa)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="purple-style cm-card h-100">
            <div class="cm-icon grad-purple"><i class="bi bi-wallet2"></i></div>
            <div class="cm-label">جمع دریافتی (دوره)</div>
            <div class="cm-value">@Model.TotalAmount.ToString("N0", fa)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="purple-style cm-card h-100">
            <div class="cm-icon grad-orange"><i class="bi bi-person-plus-fill"></i></div>
            <div class="cm-label">تعداد کل ثبت‌نام</div>
            <div class="cm-value">@Model.TotalCount.ToString(fa)</div>
        </div>
    </div>
</div>

<!-- ===== لیست کارت‌های بازشو (مثل گزارش تردد) ===== -->
<div class="purple-style cm-box">
    <div class="cm-box-head">
        <span><i class="bi bi-list-ul me-2"></i>جزئیات دریافتی ثبت‌نام‌ها</span>
        <span class="cm-box-count">@Model.Rows.Count.ToString(fa) رکورد</span>
    </div>
    <div class="cm-box-body">
        @if (Model.Rows.Count == 0)
        {
            <div class="cm-empty">
                <div style="font-size:2.2rem" class="mb-2">💰</div>
                در این بازه زمانی ثبت‌نامی نبوده
            </div>
        }
        else
        {
            @foreach (var r in Model.Rows)
            {
                <div class="cmr-card">
                    <!-- سر کارت: نام + تاریخ + دریافتی -->
                    <div class="cmr-head" role="button" tabindex="0" aria-expanded="false">
                        <div class="cmr-mid">
                            <div class="cmr-name">@r.StudentName</div>
                            <div class="cmr-date"><i class="bi bi-calendar3"></i> @(r.StartDate ?? "-")</div>
                        </div>
                        <div class="cmr-amount">@r.TotalCommission.ToString("N0", fa)</div>
                        <button type="button" class="cmr-toggle"><i class="bi bi-chevron-left"></i></button>
                    </div>
                    <!-- جزئیات بازشو: رشته / سانس / نوع / دریافتی جدا -->
                    <div class="cmr-details">
                        <div class="cmr-drow"><span>رشته</span><b>@r.SportName</b></div>
                        <div class="cmr-drow"><span>سانس</span><b>@r.SanseName</b></div>
                        <div class="cmr-drow"><span>تاریخ ثبت</span><b>@(r.StartDate ?? "-")</b></div>
                        <div class="cmr-drow">
                            <span>نوع</span>
                            @if (r.IsRevival)
                            {
                                <b><span class="cm-rev">تمدید</span></b>
                            }
                            else
                            {
                                <b><span class="cm-new">ثبت‌نام</span></b>
                            }
                        </div>
                        <div class="cmr-drow"><span>دریافتی مربی</span><b class="cmr-green">@r.TotalCommission.ToString("N0", fa) ریال</b></div>
                    </div>
                </div>
            }

            <!-- جمع کل -->
            <div class="cmr-total">
                <span><i class="bi bi-calculator-fill me-1"></i> جمع کل دریافتی</span>
                <b>@Model.TotalAmount.ToString("N0", fa) ریال</b>
            </div>
        }
    </div>
</div>

<!-- ===== تقویم شمسی ===== -->
<div class="modal fade" id="datePickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cm-modal">
            <div class="modal-header cm-modal-head">
                <h5 class="modal-title"><i class="bi bi-calendar3"></i> <span id="calendarTitle">انتخاب تاریخ</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="cm-nav-btn" id="prevMonth">›</button>
                    <strong id="currentMonthLabel" class="fs-5"></strong>
                    <button type="button" class="cm-nav-btn" id="nextMonth">‹</button>
                </div>
                <table class="cal-table">
                    <thead class="text-center">
                        <tr>
                            <th>شنبه</th>
                            <th>یک شنبه</th>
                            <th>دو شنبه</th>
                            <th>سه شنبه</th>
                            <th>چهار شنبه</th>
                            <th>پنج شنبه</th>
                            <th>جمعه</th>
                        </tr>
                    </thead>
                    <tbody id="calendarBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hd-icon {
        color: var(--g-primary);
        margin-left: 6px;
    }

    .cm-back-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: all .25s;
    }

        .cm-back-pill i {
            color: var(--g-primary);
            transition: transform .25s;
        }

        .cm-back-pill:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 14%, transparent);
            color: var(--g-text);
        }

            .cm-back-pill:hover i {
                transform: translateX(3px);
            }

    .cm-filter {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 18px;
        padding: 14px;
    }

    .cm-lbl {
        display: block;
        font-size: .72rem;
        color: var(--g-text);
        font-weight: 700;
        margin-bottom: 4px;
    }

    .cm-input {
        width: 100%;
        min-width: 0;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 12px;
        padding: 9px 12px;
        font-size: .85rem;
        cursor: pointer;
    }

        .cm-input:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--g-primary) 50%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
        }

    .cm-cal-btn {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 16%, transparent);
        color: var(--g-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .cm-cal-btn:hover {
            background: color-mix(in srgb, var(--g-primary) 20%, transparent);
            color: var(--g-text);
        }

    .cm-apply {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        border: none;
        color: var(--g-text);
        font-weight: 800;
        font-size: .85rem;
        border-radius: 12px;
        padding: 10px;
        box-shadow: 0 6px 16px color-mix(in srgb, var(--g-primary) 40%, transparent);
        transition: all .25s;
    }

        .cm-apply:hover {
            filter: brightness(1.1);
            color: var(--g-text);
        }

    .cm-month {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: color-mix(in srgb, var(--g-primary) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        color: var(--g-primary);
        border-radius: 12px;
        padding: 10px;
        font-weight: 700;
        font-size: .85rem;
        text-decoration: none;
        transition: all .25s;
    }

        .cm-month:hover {
            background: color-mix(in srgb, var(--g-primary) 25%, transparent);
            color: var(--g-text);
        }

    .cm-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 18px;
        padding: 18px 14px;
        text-align: center;
    }

        .cm-card::before {
            content: '';
            position: absolute;
            top: -35px;
            left: -35px;
            width: 110px;
            height: 110px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-nested-solid) 25%, transparent), transparent 70%);
            pointer-events: none;
        }

    .cm-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: var(--g-text);
        box-shadow: 0 6px 16px color-mix(in srgb, var(--g-text) 30%, transparent);
        margin-bottom: 10px;
    }

    .grad-green {
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
    }

    .grad-turquoise {
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
    }

    .grad-purple {
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
    }

    .grad-orange {
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
    }

    .cm-label {
        font-size: .73rem;
        color: var(--g-text);
        font-weight: 700;
    }

    .cm-value {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--g-text);
        margin-top: 4px;
    }

    .cm-box {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 8%, transparent), color-mix(in srgb, var(--g-text) 3%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 20px;
        overflow: hidden;
    }

    .cm-box-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        color: var(--g-text);
        font-weight: 800;
        font-size: .95rem;
        padding: 12px 16px;
    }

    .cm-box-count {
        background: color-mix(in srgb, var(--g-nested-solid) 18%, transparent);
        border-radius: 999px;
        padding: 3px 12px;
        font-size: .68rem;
        font-weight: 800;
    }

    .cm-box-body {
        padding: 12px;
    }

    .cm-empty {
        text-align: center;
        padding: 34px 10px;
        color: var(--g-text);
        font-size: .88rem;
    }

    /* ===== کارت بازشو (مثل گزارش تردد) ===== */
    .cmr-card {
        background: color-mix(in srgb, var(--g-nested-solid) 6%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 10%, transparent);
        border-radius: 14px;
        margin-bottom: 10px;
        overflow: hidden;
    }

    .cmr-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        cursor: pointer;
    }

    .cmr-mid {
        flex: 1 1 auto;
        min-width: 0;
    }

    .cmr-name {
        color: var(--g-text);
        font-weight: 800;
        font-size: .9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cmr-date {
        font-size: .72rem;
        color: var(--g-text);
        margin-top: 3px;
    }

        .cmr-date i {
            color: var(--g-primary);
            margin-left: 4px;
        }

    .cmr-amount {
        flex: 0 0 auto;
        color: var(--g-primary);
        font-weight: 800;
        font-size: .95rem;
    }

    .cmr-toggle {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: none;
        color: var(--g-text);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .25s, background .25s;
    }

    .cmr-card.open .cmr-toggle {
        transform: rotate(-90deg);
        background: color-mix(in srgb, var(--g-primary) 25%, transparent);
        color: var(--g-text);
    }

    .cmr-details {
        display: none;
        padding: 10px 14px 12px;
        border-top: 1px dashed color-mix(in srgb, var(--g-text) 15%, transparent);
        background: color-mix(in srgb, var(--g-nested-solid) 15%, transparent);
    }

    .cmr-drow {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        font-size: .78rem;
        padding: 6px 0;
        border-bottom: 1px solid color-mix(in srgb, var(--g-text) 6%, transparent);
    }

        .cmr-drow:last-child {
            border-bottom: none;
        }

        .cmr-drow span {
            color: color-mix(in srgb, var(--g-text) 62%, transparent);
            flex: 0 0 auto;
        }

        .cmr-drow b {
            color: color-mix(in srgb, var(--g-text) 62%, transparent);
            font-weight: 700;
            text-align: left;
            word-break: break-word;
        }

    .cmr-green {
        color: var(--g-primary) !important;
    }

    .cm-rev {
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        color: var(--g-primary);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: .66rem;
        font-weight: 800;
    }

    .cm-new {
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        color: var(--g-primary);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: .66rem;
        font-weight: 800;
    }

    .cmr-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        background: color-mix(in srgb, var(--g-primary) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
        border-radius: 14px;
        padding: 12px 16px;
        margin-top: 4px;
    }

        .cmr-total span {
            color: var(--g-primary);
            font-weight: 800;
            font-size: .85rem;
        }

        .cmr-total b {
            color: var(--g-primary);
            font-weight: 800;
            font-size: 1rem;
        }

    .cm-modal {
        background: color-mix(in srgb, var(--g-surface-solid) 97%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 15%, transparent);
        border-radius: 18px;
        color: var(--g-text);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
    }

    .cm-modal-head {
        background: linear-gradient(135deg, var(--g-primary) 0%, var(--g-surface-solid) 100%);
        color: var(--g-text);
        font-weight: 800;
    }

    .cm-nav-btn {
        background: color-mix(in srgb, var(--g-nested-solid) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 20%, transparent);
        color: var(--g-text);
        border-radius: 10px;
        width: 36px;
        height: 36px;
    }

        .cm-nav-btn:hover {
            background: color-mix(in srgb, var(--g-primary) 25%, transparent);
        }

    #datePickerModal .cal-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 4px;
    }

        #datePickerModal .cal-table th {
            background: linear-gradient(135deg, var(--g-primary), var(--g-surface-solid));
            color: var(--g-text);
            border-radius: 8px;
            padding: 8px 2px;
            font-size: .7rem;
            font-weight: 700;
        }

        #datePickerModal .cal-table td {
            background: color-mix(in srgb, var(--g-nested-solid) 6%, transparent);
            color: color-mix(in srgb, var(--g-text) 62%, transparent);
            border-radius: 8px;
            padding: 10px 2px;
            text-align: center;
            cursor: pointer;
            font-size: .85rem;
            transition: background .2s;
        }

            #datePickerModal .cal-table td:hover {
                background: color-mix(in srgb, var(--g-primary) 30%, transparent);
                color: var(--g-text);
            }

            #datePickerModal .cal-table td:empty {
                background: transparent;
                cursor: default;
            }

    #datePickerModal #currentMonthLabel {
        color: var(--g-text);
    }
</style>

@section Scripts {
    <script>
        // ===== باز/بسته کردن جزئیات کارت =====
        $(document).on('click', '.cmr-head', function () {
            var $c = $(this).closest('.cmr-card');
            var isOpen = $c.toggleClass('open').hasClass('open');
            $(this).attr('aria-expanded', isOpen ? 'true' : 'false');
            $c.find('.cmr-details').slideToggle(200);
        });

        // ===== تقویم شمسی =====
        function openCal(inputId) {
            initCalendar(inputId, null, true);
            new bootstrap.Modal('#datePickerModal').show();
        }
        $('#prevMonth').click(function () {
            calendarDate.m++;
            if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
            renderCalendar();
        });
        $('#nextMonth').click(function () {
            calendarDate.m--;
            if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
            renderCalendar();
        });
    </script>
}
