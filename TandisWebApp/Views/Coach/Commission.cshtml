@model TandisWebApp.DTOs.CoachCommissionSummaryDto
@{
    ViewData["Title"] = "گزارش پورسانت";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
    var fromDate = Model.FromDate;  
    var toDate = Model.ToDate;      
}

<!-- هدر -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0">💰 گزارش پورسانت</h5>
    <a href="/Coach" class="btn btn-outline-secondary btn-sm">🔙 داشبورد</a>
</div>

<!-- فیلتر -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Commission" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small">از تاریخ</label>
                <input type="text" name="fromDate" value="@fromDate" class="form-control" placeholder="1405/06/01" />
            </div>
            <div class="col-auto">
                <label class="form-label small">تا تاریخ</label>
                <input type="text" name="toDate" value="@toDate" class="form-control" placeholder="1405/06/31" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">🔍 اعمال فیلتر</button>
            </div>
            <div class="col-auto">
                <a href="/Coach/Commission" class="btn btn-outline-secondary">ماه جاری</a>
            </div>
        </form>
    </div>
</div>

<!-- کارت‌های آمار -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-success">💵</div>
                <div>
                    <div class="stat-label">پورسانت این ماه</div>
                    <div class="stat-value">@Model.ThisMonthAmount.ToString("N0", fa)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-info">📊</div>
                <div>
                    <div class="stat-label">تعداد این ماه</div>
                    <div class="stat-value">@Model.ThisMonthCount.ToString(fa)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-warning">💰</div>
                <div>
                    <div class="stat-label">جمع کل (دوره)</div>
                    <div class="stat-value">@Model.TotalAmount.ToString("N0", fa)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-gradient-danger">🎟️</div>
                <div>
                    <div class="stat-label">تعداد کل ثبت‌نام</div>
                    <div class="stat-value">@Model.TotalCount.ToString(fa)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- جدول -->
<div class="card">
    <div class="card-header">📋 جزئیات ثبت‌نام‌ها</div>
    <div class="card-body p-0">
        @if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">💰</div>
                در این بازه زمانی ثبت‌نامی نبوده
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>نام شاگرد</th>
                            <th class="d-none d-md-table-cell">رشته</th>
                            <th>تاریخ</th>
                            <th class="text-end">مبلغ</th>
                            <th class="text-end">پورسانت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@r.StudentName</div>
                                    <small class="text-muted">
                                        @r.SportName - @r.SanseName
                                        @if (r.IsRevival)
                                        {
                                            <span class="badge bg-info">تمدید</span>
                                        }
                                    </small>
                                </td>
                                <td class="d-none d-md-table-cell">@r.SportName</td>
                                <td>@(r.StartDate ?? "-")</td>
                                <td class="text-end">@r.Amount.ToString("N0", fa)</td>
                                <td class="text-end fw-bold text-success">@r.TotalCommission.ToString("N0", fa)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3">جمع کل</th>
                            <th class="text-end">@Model.Rows.Sum(r => r.Amount).ToString("N0", fa)</th>
                            <th class="text-end text-success">@Model.TotalAmount.ToString("N0", fa)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>