@model TandisWebApp.DTOs.CoachDashboardDto
@{
    ViewData["Title"] = "پنل مربی";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<!-- ========== بنر خوش‌آمد ========== -->
<div class="coach-banner mb-3">
    <div class="cb-icon"><i class="bi bi-person-badge-fill"></i></div>
    <div class="flex-grow-1" style="min-width:0">
        <div class="cb-title">پنل مربی</div>
        <div class="cb-sub">خوش آمدید، @Model.CoachName</div>
    </div>
    <span class="cb-chip"><i class="bi bi-calendar-check-fill"></i> @Model.TodayClasses.Count.ToString(fa) کلاس امروز</span>
</div>

<!-- ========== کارت‌های آمار (بدون کلاس‌های من + پورسانت بزرگ) ========== -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-4">
        <div class="cstat-card h-100 cstat-clickable" id="btnAllStudents" title="مشاهده همه شاگردان">
            <div class="cstat-icon grad-green"><i class="bi bi-people-fill"></i></div>
            <div class="cstat-label">شاگردان فعال</div>
            <div class="cstat-value">@Model.ActiveStudents.ToString(fa)</div>
            <div class="cstat-hint"><i class="bi bi-hand-index-fill"></i> برای مشاهده لیست بزنید</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="cstat-card h-100">
            <div class="cstat-icon grad-orange"><i class="bi bi-door-open-fill"></i></div>
            <div class="cstat-label">حضور امروز</div>
            <div class="cstat-value">@Model.TodayAttendance.ToString(fa)</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <a href="/Coach/Commission" class="text-decoration-none">
            <div class="cstat-card h-100">
                <div class="cstat-icon grad-turquoise"><i class="bi bi-cash-coin"></i></div>
                <div class="cstat-label">پورسانت</div>
                <div class="cstat-value cstat-link">مشاهده گزارش <i class="bi bi-arrow-left"></i></div>
            </div>
        </a>
    </div>
</div>

<!-- ========== کلاس‌های امروز ========== -->
<div class="coach-card">
    <div class="coach-card-head"><i class="bi bi-calendar3 me-2"></i>کلاس‌های امروز</div>
    <div class="p-3">
        @if (Model.TodayClasses.Count == 0)
        {
            <div class="coach-empty">
                <div style="font-size:2.2rem" class="mb-2">📅</div>
                امروز کلاسی ندارید
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var c in Model.TodayClasses)
                {
                    <div class="col-md-6">
                        <div class="class-card h-100">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div style="min-width:0">
                                    <div class="class-title">@c.SportName - @c.SanseName</div>
                                    <div class="class-time">
                                        <i class="bi bi-clock-fill"></i>
                                        @c.StartTime?.ToString(@"hh\:mm", fa) تا @c.EndTime?.ToString(@"hh\:mm", fa)
                                    </div>
                                </div>
                                <span class="status-badge @(c.Status == "ongoing" ? "st-on" : c.Status == "upcoming" ? "st-soon" : "st-done")">
                                    @c.StatusDesc
                                </span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="class-pill"><i class="bi bi-person-plus-fill"></i> ثبت‌نام: @c.RegCount.ToString(fa)</span>
                                @if (c.ClassCapacity != null)
                                {
                                    <span class="class-pill"><i class="bi bi-person-check-fill"></i> ظرفیت: @c.ClassCapacity.Value.ToString(fa)</span>
                                    <span class="class-pill"><i class="bi bi-person-dash-fill"></i> جای خالی: @c.FreeNow.Value.ToString(fa)</span>
                                }
                                <span class="class-pill"><i class="bi bi-door-open-fill"></i> حضور: @c.TodayAttendance.ToString(fa)</span>
                            </div>
                            <a href="/Coach/ClassStudents/@c.SportSanseID" class="class-btn mt-3">
                                <i class="bi bi-people-fill"></i> مشاهده شاگردان
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ========== اورلی همه شاگردان ========== -->
<div class="stu-overlay" id="stuOverlay" style="display:none">
    <div class="stu-panel">
        <div class="stu-head">
            <span><i class="bi bi-people-fill me-2"></i>همه شاگردان من</span>
            <button type="button" class="stu-close" id="stuClose"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="stu-body">
            <input type="text" id="stuSearch" class="stu-search" placeholder="🔍 جستجوی نام شاگرد..." />
            <div class="stu-list" id="stuList"></div>
        </div>
    </div>
</div>

<style>
    .coach-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 16px;
        padding: 12px 14px;
        backdrop-filter: blur(8px);
    }

    .cb-icon {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: #fff;
        background: linear-gradient(135deg, #1E6FD9, #66d3e8);
        box-shadow: 0 6px 16px rgba(30,111,217,.35);
    }

    .cb-title {
        font-weight: 800;
        color: #fff;
        font-size: 1rem;
    }

    .cb-sub {
        font-size: .78rem;
        color: #9fb3c8;
        margin-top: 2px;
    }

    .cb-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(102,211,232,.14);
        border: 1px solid rgba(102,211,232,.35);
        color: #66d3e8;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: .75rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .cstat-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 18px;
        padding: 18px 14px;
        text-align: center;
        transition: transform .25s, border-color .25s;
    }

        .cstat-card::before {
            content: '';
            position: absolute;
            top: -35px;
            left: -35px;
            width: 110px;
            height: 110px;
            background: radial-gradient(circle, rgba(46,134,222,.25), transparent 70%);
            pointer-events: none;
        }

    .cstat-clickable {
        cursor: pointer;
    }

        .cstat-clickable:hover {
            transform: translateY(-3px);
            border-color: rgba(102,211,232,.5);
        }

    .cstat-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
        box-shadow: 0 6px 16px rgba(0,0,0,.3);
        margin-bottom: 10px;
    }

    .grad-green {
        background: linear-gradient(135deg, #2E86DE, #66d3e8);
    }

    .grad-orange {
        background: linear-gradient(135deg, #2E86DE, #66d3e8);
    }

    .grad-turquoise {
        background: linear-gradient(135deg, #2E86DE, #66d3e8);
    }

    .cstat-label {
        font-size: .75rem;
        color: #9fb3c8;
        font-weight: 700;
    }

    .cstat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin-top: 4px;
        line-height: 1.1;
        min-height: 2.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .cstat-link {
        font-size: 1rem;
        color: #66d3e8;
    }

    .cstat-hint {
        font-size: .66rem;
        color: #8a93a6;
        margin-top: 7px;
    }

        .cstat-hint i {
            color: #66d3e8;
        }

    .coach-card {
        background: linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 20px;
        overflow: hidden;
    }

    .coach-card-head {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 800;
        font-size: .95rem;
        padding: 12px 16px;
    }

    .coach-empty {
        text-align: center;
        padding: 34px 10px;
        color: #9fb3c8;
        font-size: .88rem;
    }

    .class-card {
        position: relative;
        overflow: hidden;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 16px;
        padding: 14px;
    }

    .class-title {
        font-weight: 800;
        color: #fff;
        font-size: .95rem;
    }

    .class-time {
        font-size: .78rem;
        color: #9fb3c8;
        margin-top: 5px;
    }

        .class-time i {
            color: #66d3e8;
            margin-left: 4px;
        }

    .status-badge {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .st-on {
        background: rgba(56,217,169,.16);
        color: #38d9a9;
        border: 1px solid rgba(56,217,169,.4);
    }

    .st-soon {
        background: rgba(255,193,7,.16);
        color: #ffd200;
        border: 1px solid rgba(255,193,7,.4);
    }

    .st-done {
        background: rgba(255,255,255,.10);
        color: #9fb3c8;
        border: 1px solid rgba(255,255,255,.2);
    }

    .class-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(13,110,253,.30);
        color: #dce9ff;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .72rem;
        font-weight: 700;
    }

        .class-pill i {
            color: #66d3e8;
            font-size: .8rem;
        }

    .class-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border-radius: 12px;
        padding: 8px 16px;
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 5px 14px rgba(118,75,162,.35);
        transition: all .25s;
    }

    .stu-overlay {
        position: fixed;
        inset: 0;
        z-index: 1080;
        background: rgba(8,12,22,.55);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .stu-panel {
        width: 100%;
        max-width: 560px;
        max-height: 82vh;
        display: flex;
        flex-direction: column;
        background: rgba(16,20,36,.97);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,.6);
    }

    .stu-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #1E6FD9, #667eea);
        color: #fff;
        font-weight: 800;
        font-size: .92rem;
        padding: 12px 16px;
    }

    .stu-close {
        background: rgba(255,255,255,.15);
        border: none;
        color: #fff;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .stu-close:hover {
            background: rgba(255,107,129,.4);
        }

    .stu-body {
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 0;
    }

    .stu-search {
        width: 100%;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.18);
        color: #fff;
        border-radius: 999px;
        padding: 10px 18px;
        font-size: .85rem;
    }

        .stu-search:focus {
            outline: none;
            border-color: rgba(102,211,232,.5);
            background: rgba(255,255,255,.12);
        }

    .stu-list {
        overflow-y: auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 52vh;
    }

    .stu-row {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 10px 14px;
    }

    .stu-name {
        color: #fff;
        font-weight: 800;
        font-size: .88rem;
    }

    .stu-sub {
        color: #9fb3c8;
        font-size: .72rem;
        margin-top: 3px;
    }

    .stu-empty {
        text-align: center;
        color: #9fb3c8;
        padding: 26px 0;
        font-size: .85rem;
    }
</style>

@section Scripts {
    <script>
        var allStudents = [];

        function renderStudents() {
            var q = $.trim($('#stuSearch').val()).toLowerCase();
            var html = '', count = 0;
            allStudents.forEach(function (s) {
                var name = s.fullName || s.FullName || '';
                if (q && name.toLowerCase().indexOf(q) === -1) return;
                count++;
                html += '<div class="stu-row">' +
                    '<div class="stu-name">' + esc(name) + '</div>' +
                    '<div class="stu-sub">' + esc(s.sportName || s.SportName || '-') + ' - ' +
                        esc(s.sanseName || s.SanseName || '-') + ' | تا ' +
                        esc(s.endDate || s.EndDate || '-') + '</div>' +
                '</div>';
            });
            if (!count) html = '<div class="stu-empty">شاگردی یافت نشد</div>';
            $('#stuList').html(html);
        }

        $('#btnAllStudents').click(function () {
            $('#stuOverlay').fadeIn(150);
            if (!allStudents.length) {
                apiCall('/Coach/AllStudents', 'GET', null, function (res) {
                    if (res.success) { allStudents = res.data || []; renderStudents(); }
                });
            } else {
                renderStudents();
            }
        });
        function closeOverlay() { $('#stuOverlay').fadeOut(150); }
        $('#stuClose').click(closeOverlay);
        $('#stuOverlay').on('click', function (e) { if (e.target === this) closeOverlay(); });
        $(document).on('keyup', '#stuSearch', renderStudents);
    </script>
}