@model List<TandisWebApp.DTOs.CoachProgramRowDto>
@{
    ViewData["Title"] = "برنامه‌های تمرینی";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
    var activePrograms = Model.Where(p => p.IsActive).ToList();
    var inactivePrograms = Model.Where(p => !p.IsActive).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-clipboard2-pulse hd-icon"></i> برنامه‌های تمرینی</h5>
    <a href="/Coach/ProgramEdit" class="pg-new-btn"><i class="bi bi-plus-lg"></i> برنامه جدید</a>
</div>
<div class="mb-3">
    <input type="text" id="pgSearch" class="glass-search" placeholder="🔍 جستجو در برنامه‌ها (نام شاگرد)..." />
</div>

@if (Model.Count == 0)
{
    <div class="pg-empty">
        <div style="font-size:2.4rem" class="mb-2">📋</div>
        هنوز برنامه‌ای ثبت نکرده‌اید
    </div>
}
else
{
    @if (activePrograms.Count == 0)
    {
        <div class="pg-empty mb-3">
            <div style="font-size:2.4rem" class="mb-2">📋</div>
            در حال حاضر برنامهٔ فعالی ندارید
        </div>
    }
    <div class="row g-3" id="pgActiveGrid">
        @foreach (var p in activePrograms)
        {
            <div class="col-md-6 col-lg-4">
                <div class="purple-style pg-card h-100">
                    <div class="d-flex align-items-start gap-3">
                        <div class="pg-avatar"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                        <div class="flex-grow-1" style="min-width:0">
                            <div class="pg-name">@p.StudentName</div>
                            <div class="pg-dates"><i class="bi bi-calendar-range"></i> @p.StartDateShamsi تا @p.EndDateShamsi</div>
                        </div>
                        @if (p.IsActive)
                        {
                            <span class="pg-badge pg-on">فعال</span>
                        }
                        else
                        {
                            <span class="pg-badge pg-off">پایان‌یافته</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <span class="pg-pill"><i class="bi bi-list-ul"></i> @p.ItemCount.ToString(fa) حرکت</span>
                    </div>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <a href="/Coach/ProgramDetails/@p.PrgID" class="pg-view-btn"><i class="bi bi-eye-fill"></i> مشاهده</a>
                        <a href="/Coach/ProgramEdit?id=@p.PrgID" class="pg-edit-btn"><i class="bi bi-pencil-fill"></i> ویرایش</a>
                        <button type="button" class="pg-del-btn" data-prg="@p.PrgID"><i class="bi bi-trash3"></i> حذف</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (inactivePrograms.Count > 0)
    {
        <button type="button" class="pg-more-btn" id="btnInactivePrograms" aria-expanded="false" aria-controls="pgInactiveBox">
            <i class="bi bi-archive-fill"></i>
            <span>نمایش برنامه‌های غیرفعال (@inactivePrograms.Count.ToString(fa) برنامه)</span>
            <i class="bi bi-chevron-down pg-more-chev"></i>
        </button>
        <div id="pgInactiveBox" class="pg-inactive-box" hidden>
            <div class="row g-3">
                @foreach (var p in inactivePrograms)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="purple-style pg-card h-100">
                            <div class="d-flex align-items-start gap-3">
                                <div class="pg-avatar"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                                <div class="flex-grow-1" style="min-width:0">
                                    <div class="pg-name">@p.StudentName</div>
                                    <div class="pg-dates"><i class="bi bi-calendar-range"></i> @p.StartDateShamsi تا @p.EndDateShamsi</div>
                                </div>
                                <span class="pg-badge pg-off">پایان‌یافته</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="pg-pill"><i class="bi bi-list-ul"></i> @p.ItemCount.ToString(fa) حرکت</span>
                            </div>
                            <div class="d-flex gap-2 mt-3 flex-wrap">
                                <a href="/Coach/ProgramDetails/@p.PrgID" class="pg-view-btn"><i class="bi bi-eye-fill"></i> مشاهده</a>
                                <a href="/Coach/ProgramEdit?id=@p.PrgID" class="pg-edit-btn"><i class="bi bi-pencil-fill"></i> ویرایش</a>
                                <button type="button" class="pg-del-btn" data-prg="@p.PrgID"><i class="bi bi-trash3"></i> حذف</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    .hd-icon {
        color: var(--g-primary);
        margin-left: 6px;
    }

    .pg-new-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
        color: var(--g-text);
        border-radius: 12px;
        padding: 8px 18px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 5px 14px color-mix(in srgb, var(--g-primary) 35%, transparent);
        transition: all .25s;
    }

        .pg-new-btn:hover {
            filter: brightness(1.1);
            color: var(--g-text);
        }

    .pg-empty {
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 8%, transparent), color-mix(in srgb, var(--g-text) 3%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 20px;
        text-align: center;
        padding: 44px 16px;
        color: var(--g-text);
        font-size: .9rem;
    }

    .pg-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, color-mix(in srgb, var(--g-nested-solid) 10%, transparent), color-mix(in srgb, var(--g-text) 4%, transparent));
        border: 1px solid color-mix(in srgb, var(--g-text) 14%, transparent);
        border-radius: 18px;
        padding: 16px;
    }

        .pg-card::before {
            content: '';
            position: absolute;
            top: -40px;
            left: -40px;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle, color-mix(in srgb, var(--g-nested-solid) 25%, transparent), transparent 70%);
            pointer-events: none;
        }

    .pg-avatar {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--g-text);
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
        box-shadow: 0 5px 14px color-mix(in srgb, var(--g-text) 35%, transparent);
    }

    .pg-name {
        font-weight: 800;
        color: var(--g-text);
        font-size: .95rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pg-dates {
        font-size: .75rem;
        color: var(--g-text);
        margin-top: 3px;
    }

        .pg-dates i {
            color: var(--g-primary);
            margin-left: 4px;
        }

    .pg-badge {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .pg-on {
        background: color-mix(in srgb, var(--g-primary) 16%, transparent);
        color: var(--g-primary);
        border: 1px solid color-mix(in srgb, var(--g-primary) 40%, transparent);
    }

    .pg-off {
        background: color-mix(in srgb, var(--g-nested-solid) 10%, transparent);
        color: var(--g-text);
        border: 1px solid color-mix(in srgb, var(--g-text) 20%, transparent);
    }

    .pg-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--g-primary) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 30%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .73rem;
        font-weight: 700;
    }

        .pg-pill i {
            color: var(--g-primary);
            font-size: .82rem;
        }

    .pg-edit-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--g-primary) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-primary) 35%, transparent);
        color: var(--g-primary);
        border-radius: 10px;
        padding: 6px 14px;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s;
    }

        .pg-edit-btn:hover {
            background: color-mix(in srgb, var(--g-primary) 25%, transparent);
            color: var(--g-text);
        }

    .pg-del-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 35%, transparent);
        color: var(--g-text);
        border-radius: 10px;
        padding: 6px 14px;
        font-size: .78rem;
        font-weight: 700;
        transition: all .25s;
    }

        .pg-del-btn:hover {
            background: color-mix(in srgb, var(--g-nested-solid) 25%, transparent);
            color: var(--g-text);
        }

    .pg-view-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, var(--g-primary), var(--g-primary));
        color: var(--g-text);
        border-radius: 10px;
        padding: 6px 14px;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 12px color-mix(in srgb, var(--g-primary) 30%, transparent);
        transition: all .25s;
    }

        .pg-view-btn:hover {
            filter: brightness(1.12);
            color: var(--g-text);
        }

    .glass-search {
        width: 100%;
        background: color-mix(in srgb, var(--g-nested-solid) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--g-text) 18%, transparent);
        color: var(--g-text);
        border-radius: 999px;
        padding: 10px 18px;
        font-size: .85rem;
    }

        .glass-search:focus {
            outline: none;
            border-color: color-mix(in srgb, var(--g-primary) 50%, transparent);
            background: color-mix(in srgb, var(--g-nested-solid) 12%, transparent);
        }

    /* ===== دکمهٔ نمایش برنامه‌های غیرفعال ===== */
    .pg-more-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
        padding: 11px 16px;
        border: 1px solid color-mix(in srgb, var(--g-primary) 32%, transparent);
        border-radius: 14px;
        background: color-mix(in srgb, var(--g-primary) 10%, transparent);
        color: var(--g-text);
        font-size: .84rem;
        font-weight: 750;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease;
    }

        .pg-more-btn:hover {
            background: color-mix(in srgb, var(--g-primary) 18%, transparent);
            border-color: color-mix(in srgb, var(--g-primary) 45%, transparent);
        }

        .pg-more-btn i {
            color: var(--g-primary);
        }

    .pg-more-chev {
        transition: transform .25s ease;
    }

        .pg-more-btn[aria-expanded="true"] .pg-more-chev {
            transform: rotate(180deg);
        }

    .pg-inactive-box {
        margin-top: 14px;
        overflow-anchor: none;
    }
</style>

@section Scripts {
    <script>
        $(document).on('click', '.pg-del-btn', function () {
            var id = $(this).data('prg');
            if (!confirm('این برنامه حذف شود؟')) return;
            apiCall('/Coach/DeleteProgram', 'POST', id, function (res) {
                showToast(res.message, res.success ? 'success' : 'error');
                if (res.success) setTimeout(function () { location.reload(); }, 700);
            });
        });
                $('#pgSearch').on('keyup', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('.pg-card').each(function () {
                var txt = $(this).text().toLowerCase();
                $(this).closest('div[class*="col-"]').toggle(txt.indexOf(q) > -1);
            });
        });

        $('#btnInactivePrograms').on('click', function () {
            var $box = $('#pgInactiveBox');
            var willOpen = $box.prop('hidden');
            $box.prop('hidden', !willOpen);
            $(this).attr('aria-expanded', willOpen ? 'true' : 'false');
        });
    </script>
}