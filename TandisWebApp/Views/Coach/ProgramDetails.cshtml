@model TandisWebApp.DTOs.CoachProgramDetailsDto
@{
    ViewData["Title"] = "جزئیات برنامه";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");

    
    var typeLabels = new Dictionary<byte, string> {
        { 1, "عادی" }, { 2, "دراپ ست" }, { 3, "سوپرست" }, { 4, "تری‌ست" },
        { 5, "ست غول" }, { 6, "پیرامید" }, { 7, "استراحت-مکث" }, { 8, "تمپو دار" }
    };

    
    string DayIcon(string t)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var part in (t ?? "").Split('+'))
        {
            switch (part.Trim())
            {
                case "روز پا": sb.Append("🦵"); break;
                case "روز سینه": sb.Append("🏋️"); break;
                case "روز سرشانه": sb.Append("🤸"); break;
                case "روز زیر بغل": sb.Append("🚣"); break;
                case "روز جلو بازو": sb.Append("💪"); break;
                case "روز پشت بازو": sb.Append("🦾"); break;
                case "روز شکم": sb.Append("🧘"); break;
                case "روز پهلو": sb.Append("🌀"); break;
                case "روز هوازی": sb.Append("🏃"); break;
                case "روز فول بادی": sb.Append("⚡"); break;
            }
        }
        return sb.Length == 0 ? "📅" : sb.ToString();
    }
}

<!-- ===== هدر ===== -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-clipboard2-pulse hd-icon"></i> برنامه تمرینی</h5>
    <div class="d-flex gap-2">
        <a href="/Coach/ProgramEdit?id=@Model.PrgID" class="pd-edit-btn"><i class="bi bi-pencil-fill"></i> ویرایش</a>
        <a href="/Coach/Programs" class="coach-back-pill"><i class="bi bi-arrow-right"></i> برنامه‌ها</a>
    </div>
</div>

<!-- ===== بنر شاگرد ===== -->
<div class="pd-banner mb-3">
    <div class="pd-avatar"><i class="bi bi-person-fill"></i></div>
    <div class="flex-grow-1" style="min-width:0">
        <div class="pd-name">@Model.StudentName</div>
        <div class="pd-dates"><i class="bi bi-calendar-range"></i> @Model.StartDateShamsi تا @Model.EndDateShamsi</div>
    </div>
    <span class="pd-badge @(Model.IsActive ? "pd-on" : "pd-off")">@(Model.IsActive ? "فعال" : "پایان‌یافته")</span>
</div>

<!-- ===== باکس‌های روزها ===== -->
@foreach (var day in Model.Days)
{
    <div class="pd-day mb-3">
        <div class="pd-day-head">
            <span class="pd-day-icon">@DayIcon(day.DayTitle)</span>
            <span class="pd-day-title">@day.DayTitle</span>
            <span class="pd-day-count">@day.Items.Count.ToString(fa) حرکت</span>
        </div>
        <div class="pd-day-body">
            @foreach (var it in day.Items)
            {
                <div class="pd-ex">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="pd-ex-name">@it.ItemDesc</div>
                        @if (it.ExerciseType != null && it.ExerciseType != 1 && typeLabels.ContainsKey(it.ExerciseType.Value))
                        {
                            <span class="pd-type">@typeLabels[it.ExerciseType.Value]</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @if (it.SetCount != null)
                        {
                            <span class="pd-pill"><i class="bi bi-layers-fill"></i> ست: @it.SetCount.Value.ToString(fa)</span>
                        }
                        @if (it.RepCount != null)
                        {
                            <span class="pd-pill"><i class="bi bi-repeat"></i> تکرار: @it.RepCount.Value.ToString(fa)</span>
                        }
                        @if (it.WCount != null)
                        {
                            <span class="pd-pill"><i class="bi bi-barbell-fill"></i> وزن: @it.WCount.Value.ToString(fa) کیلو</span>
                        }
                        @if (it.RestSeconds != null)
                        {
                            <span class="pd-pill"><i class="bi bi-stopwatch-fill"></i> استراحت: @it.RestSeconds.Value.ToString(fa) ثانیه</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(it.Note))
                    {
                        <div class="pd-note"><i class="bi bi-info-circle"></i> @it.Note</div>
                    }
                </div>
            }
        </div>
    </div>
}

