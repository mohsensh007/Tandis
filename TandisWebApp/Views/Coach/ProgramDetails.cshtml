@model TandisWebApp.DTOs.CoachProgramDetailsDto
@{
    ViewData["Title"] = "جزئیات برنامه";
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
    var typeLabels = new Dictionary<byte, string> {
        { 1, "عادی" }, { 2, "دراپ ست" }, { 3, "سوپرست" }, { 4, "تری‌ست" },
        { 5, "ست غول" }, { 6, "پیرامید" }, { 7, "استراحت-مکث" }, { 8, "تمپو دار" }
    };

    string DayIcon(string t)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var part in (t ?? "").Split('+'))
        {
            switch (part.Trim())
            {
                case "روز پا": sb.Append("🦵"); break;
                case "روز سینه": sb.Append("🏋️"); break;
                case "روز سرشانه": sb.Append("🤸"); break;
                case "روز زیر بغل": sb.Append("🚣"); break;
                case "روز جلو بازو": sb.Append("💪"); break;
                case "روز پشت بازو": sb.Append("🦾"); break;
                case "روز شکم": sb.Append("🧘"); break;
                case "روز پهلو": sb.Append("🌀"); break;
                case "روز هوازی": sb.Append("🏃"); break;
                case "روز فول بدن": sb.Append("⚡"); break;
            }
        }
        return sb.Length == 0 ? "📅" : sb.ToString();
    }
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-clipboard2-pulse hd-icon"></i> برنامه تمرینی</h5>
    <div class="d-flex gap-2">
        <a href="/Coach/ProgramEdit?id=@Model.PrgID" class="pd-edit-btn"><i class="bi bi-pencil-fill"></i> ویرایش</a>
        <a href="/Coach/Programs" class="purple-style coach-back-pill"><i class="bi bi-arrow-right"></i> برنامه‌ها</a>
    </div>
</div>

<div class="purple-style pd-info mb-3">
    <div><b>شاگرد:</b> @Model.StudentName</div>
    <div><b>بازه:</b> @Model.StartDateShamsi تا @Model.EndDateShamsi</div>
    @if (Model.IsActive)
    {
        <span class="mp-badge mp-on">فعال</span>
    }
    else
    {

        <span class="mp-badge mp-off">پایان‌یافته</span>
    }
</div>

@foreach (var day in Model.Days)
{
    <div class="pd-day purple-style mb-3">
        <div class="pd-day-head">
            <span class="pd-day-icon">@DayIcon(day.DayTitle)</span>
            <span class="pd-day-title">@day.DayTitle</span>
            <span class="pd-day-count">@day.Items.Count.ToString(fa) حرکت</span>
        </div>
        <div class="pd-day-body">
            @foreach (var item in day.Items)
            {
                var hasCombo = item.ExtraItems != null && item.ExtraItems.Count > 0;
                <div class="pd-ex">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="pd-ex-name">@item.ItemDesc</div>
                        @if (item.ExerciseType != null && item.ExerciseType != 1 && typeLabels.ContainsKey(item.ExerciseType.Value))
                        {
                            <span class="pd-type">@typeLabels[item.ExerciseType.Value]</span>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @if (item.SetCount != null)
                        {
                            <span class="pd-pill"><i class="bi bi-layers-fill"></i> ست: @item.SetCount.Value.ToString(fa)</span>
                        }
                        @if (item.RepCount != null)
                        {
                            <span class="pd-pill"><i class="bi bi-repeat"></i> تکرار: @item.RepCount.Value.ToString(fa)</span>
                        }
                        @if (item.WCount != null)
                        {
                            <span class="pd-pill"><i class="bi bi-barbell-fill"></i> وزن: @item.WCount.Value.ToString(fa) کیلو</span>
                        }
                        @if (item.RestSeconds != null)
                        {
                            <span class="pd-pill"><i class="bi bi-stopwatch-fill"></i> استراحت: @item.RestSeconds.Value.ToString(fa) ثانیه</span>
                        }
                    </div>

                    <!-- ===== نمایش combo ===== -->
                    @if (hasCombo)
                    {
                        <div class="pd-combo">
                            <div class="pd-combo-title">🔗 حرکات هم‌گروه (انجام پشت‌سرهم بدون استراحت):</div>
                            @for (var i = 0; i < item.ExtraItems.Count; i++)
                            {
                                var ex = item.ExtraItems[i];
                                <div class="pd-combo-row">
                                    <span class="pd-combo-num">@(i + 2)</span>
                                    <div class="flex-grow-1">
                                        <div class="pd-combo-name">@ex.ItemDesc</div>
                                        <div class="d-flex flex-wrap gap-2 mt-1">
                                            @if (ex.RepCount != null)
                                            {
                                                <span class="pd-pill-sm">تکرار: @ex.RepCount.Value.ToString(fa)</span>
                                            }
                                            @if (ex.WCount != null)
                                            {
                                                <span class="pd-pill-sm">وزن: @ex.WCount.Value.ToString(fa) کیلو</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- ===== تنظیمات تکنیک ===== -->
                    @if (item.ExerciseType == 2 && item.DropCount != null)
                    {
                        <div class="pd-tech">🔻 دراپ: @(item.DropCount.Value.ToString(fa)) بار کاهش وزن@(item.DropWeightPct != null ? $" (~{item.DropWeightPct.Value.ToString(fa)}٪)" : "")</div>
                    }
                    @if (item.ExerciseType == 6 && item.PyramidDir != null)
                    {
                        var dir = item.PyramidDir.Value == 1 ? "صعودی" : item.PyramidDir.Value == 2 ? "معکوس" : "کامل";
                        <div class="pd-tech">🔺 پیرامید @dir@(item.WeightStep != null ? $", پله وزن {item.WeightStep.Value.ToString(fa)} kg" : "")</div>
                    }
                    @if (item.ExerciseType == 7 && item.PauseCount != null)
                    {
                        <div class="pd-tech">⏸ استراحت-مکث: @(item.PauseCount.Value.ToString(fa)) مینی‌ست@(item.PauseRest != null ? $", مکث {item.PauseRest.Value.ToString(fa)} ثانیه" : "")</div>
                    }
                    @if (item.ExerciseType == 8 && !string.IsNullOrEmpty(item.Tempo))
                    {
                        <div class="pd-tech">⏱ تمپو: @item.Tempo</div>
                    }

                    @if (!string.IsNullOrEmpty(item.Note))
                    {
                        <div class="pd-note"><i class="bi bi-info-circle"></i> @item.Note</div>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
