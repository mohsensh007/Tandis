    }

    .pd-day-head {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(102,211,232,.10);
        border-bottom: 1px solid rgba(102,211,232,.25);
        padding: 10px 14px;
    }

    .pd-day-icon {
        font-size: 1.2rem;
    }

    .pd-day-title {
        flex: 1 1 auto;
        color: #66d3e8;
        font-weight: 800;
        font-size: .9rem;
    }

    .pd-day-count {
        background: rgba(102,211,232,.14);
        border: 1px solid rgba(102,211,232,.35);
        color: #66d3e8;
        border-radius: 999px;
        padding: 3px 12px;
        font-size: .68rem;
        font-weight: 800;
    }

    .pd-day-body {
        padding: 12px;
    }

    .pd-ex {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

        .pd-ex:last-child {
            margin-bottom: 0;
        }

    .pd-ex-name {
        color: #fff;
        font-weight: 800;
        font-size: .92rem;
    }

    .pd-type {
        background: rgba(118,75,162,.22);
        border: 1px solid rgba(118,75,162,.5);
        color: #c9b9f9;
        border-radius: 999px;
        padding: 3px 10px;
        font-size: .68rem;
        font-weight: 800;
    }

    .pd-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(13,110,253,.14);
        border: 1px solid rgba(13,110,253,.30);
        color: #dce9ff;
        border-radius: 999px;
        padding: 3px 10px;
        font-size: .72rem;
        font-weight: 700;
    }

        .pd-pill i {
            color: #66d3e8;
        }

    .pd-pill-sm {
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.15);
        color: #cbd3da;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: .66rem;
        font-weight: 700;
    }

    /* ===== combo ===== */
    .pd-combo {
        margin-top: 10px;
        background: rgba(102,211,232,.08);
        border: 1px dashed rgba(102,211,232,.35);
        border-radius: 10px;
        padding: 10px;
    }

    .pd-combo-title {
        color: #66d3e8;
        font-size: .76rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .pd-combo-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 6px 0;
        border-top: 1px solid rgba(255,255,255,.06);
    }

        .pd-combo-row:first-of-type {
            border-top: none;
        }

    .pd-combo-num {
        flex: 0 0 auto;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        font-size: .68rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .pd-combo-name {
        color: #fff;
        font-weight: 700;
        font-size: .82rem;
    }

    /* ===== تنظیمات تکنیک ===== */
    .pd-tech {
        margin-top: 8px;
        background: rgba(255,193,7,.08);
        border: 1px solid rgba(255,193,7,.22);
        border-radius: 8px;
        padding: 6px 10px;
        font-size: .72rem;
        font-weight: 700;
        color: #ffd200;
    }

    .pd-note {
        margin-top: 8px;
        display: flex;
        align-items: flex-start;
        gap: 6px;
        font-size: .76rem;
        color: #cbd3da;
        background: rgba(255,255,255,.04);
        border-radius: 8px;
        padding: 8px 10px;
        line-height: 1.6;
    }

        .pd-note i {
            color: #66d3e8;
            margin-top: 2px;
        }

    .mp-badge {
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 800;
    }

    .mp-on {
        background: rgba(56,217,169,.18);
        color: #38d9a9;
        border: 1px solid rgba(56,217,169,.45);
    }

    .mp-off {
        background: rgba(255,255,255,.12);
        color: #cbd3da;
        border: 1px solid rgba(255,255,255,.25);
    }

    .pd-edit-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, #1E6FD9, #667eea);
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 7px 16px;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
    }

        .pd-edit-btn:hover {
            filter: brightness(1.1);
            color: #fff;
        }

    .hd-icon {
        color: #66d3e8;
        margin-left: 6px;
    }
</style>