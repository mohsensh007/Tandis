@{
    ViewData["Title"] = "سرویس";
}

<div class="commerce-page" data-commerce-page="service">
    <section class="commerce-hero" aria-labelledby="servicePageTitle">
        <div class="commerce-hero-content">
            <span class="commerce-kicker"><i class="bi bi-stars" aria-hidden="true"></i> خدمات اختصاصی باشگاه</span>
            <h1 id="servicePageTitle">خدمات تندیس</h1>
            <p>سرویس موردنیاز خود را انتخاب کنید و از اعتبار خدمات یا دستگاه POS پرداخت کنید.</p>
        </div>
        <div class="commerce-hero-icon" aria-hidden="true"><i class="bi bi-spa"></i></div>
    </section>

    <div class="commerce-notice" role="note">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        <span>قبل از پرداخت، مبلغ و نام سرویس را بررسی کنید. اطلاعات خرید از سمت سرور اعتبارسنجی می‌شود.</span>
    </div>

    <section class="commerce-panel" aria-labelledby="serviceListTitle">
        <div class="commerce-panel-head">
            <h2 class="commerce-panel-title" id="serviceListTitle"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> سرویس‌های قابل خرید</h2>
            <span class="commerce-count" id="serviceCount" aria-label="تعداد سرویس‌ها">۰</span>
        </div>
        <div id="serviceList" class="commerce-grid" aria-live="polite">
            <div class="commerce-status"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>در حال بارگذاری سرویس‌ها…</span></div>
        </div>
    </section>
</div>
