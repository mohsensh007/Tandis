@{
    var adminName = HttpContextAccessor.HttpContext?.User?.FindFirst("FullName")?.Value ?? "مدیر";
    var shiftID = HttpContextAccessor.HttpContext?.User?.FindFirst("AdminShiftID")?.Value ?? "1";
    var shiftName = shiftID == "2" ? "بانوان" : "آقایان";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <!-- Web App Manifest برای PWA -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Meta tags مخصوص Apple iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="تندیس" />
    <link rel="apple-touch-icon" href="/images/app-icon.png" />

    <!-- جلوگیری از ذخیره‌سازی در کش برای آپدیت‌های سریع‌تر -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیر | تندیس</title>
    <link rel="stylesheet" href="~/css/admin-style.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="admin-glass-body">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color:#2c3e50">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/Admin">
                <img src="~/images/logo2.png" alt="تندیس" height="36" />
                <span>پنل مدیر</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAdmin">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarAdmin">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/Admin"><i class="bi bi-grid-1x2"></i> داشبورد</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/TrafficReport"><i class="bi bi-arrow-left-right"></i> ترددها</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/RegisterReport"><i class="bi bi-arrow-repeat"></i> ثبت‌نام/تمدید</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/OneSessionReport"><i class="bi bi-ticket-perforated"></i> تک‌جلسه</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/FinanceReport"><i class="bi bi-cash-stack"></i> بدهی/دریافت</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><span class="nav-link text-warning"><i class="bi bi-building"></i> شیفت @shiftName</span></li>
                    <li class="nav-item"><span class="nav-link text-light"><i class="bi bi-person-gear"></i> @adminName</span></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Logout"><i class="bi bi-box-arrow-left"></i> خروج</a></li>
                    <!-- زنگوله پیام‌ها -->
                    <li class="nav-item dropdown">
                        <a class="nav-link position-relative" href="#" id="notifBell" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell-fill" style="font-size:20px;"></i>
                            <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:10px;display:none;">0</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:300px;max-height:400px;overflow-y:auto;">
                            <li class="dropdown-header fw-bold">پیام‌های جدید</li>
                            <li><hr class="dropdown-divider"></li>
                            <li id="notifList"><a class="dropdown-item text-muted small">در حال بارگذاری...</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-center text-primary fw-bold" href="/Admin/Messages">مشاهده همه پیام‌ها</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        @RenderBody()
    </div>

    @* === مودال تقویم جلالی مشترک (برای فیلتر بازه تاریخ در گزارش‌ها) === *@
    <div class="modal fade" id="datePickerModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calendar3"></i> <span id="calendarTitle">انتخاب تاریخ</span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="prevMonth">›</button>
                        <strong id="currentMonthLabel" class="fs-5"></strong>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="nextMonth">‹</button>
                    </div>
                    <table class="cal-table">
                        <thead class="text-center">
                            <tr>
                                <th>شنبه</th>
                                <th>یک شنبه</th>
                                <th>دو شنبه</th>
                                <th>سه شنبه</th>
                                <th>چهار شنبه</th>
                                <th>پنج شنبه</th>
                                <th>جمعه</th>
                            </tr>
                        </thead>
                        <tbody id="calendarBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top text-center py-2 mt-4">
        <small class="text-muted">پنل مدیریت باشگاه تندیس &copy; @DateTime.Now.Year</small>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- اول jalali-calendar.js -->
    <script src="~/js/jalali-calendar.js"></script>

    <!-- بعد site.js (ولی site.js رو دیگه ازش استفاده نکن) -->
    <!-- <script src="~/js/site.js?v=3"></script> -->
    <!-- به جای site.js از یه فایل جدا برای توابع دیگه استفاده کن -->
    <script src="~/js/site-functions.js?v=3"></script>
    <script>
        // === تقویم جلالی مشترک برای صفحات گزارش ===
        // رویداد ناوبری ماه که در همه گزارش‌ها یکسان است.
        // مقدار calendarCallback (آیدی input) قبل از باز کردن تقویم توسط هر صفحه تنظیم می‌شود.
        $('#prevMonth').click(function () {
            calendarDate.m++;
            if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
            renderCalendar();
        });
        $('#nextMonth').click(function () {
            calendarDate.m--;
            if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
            renderCalendar();
        });

        // تابع کمکی: باز کردن تقویم روی یک input مشخص (برای صفحات گزارش)
        // در پنل ادمین، روزهای گذشته نیز قابل انتخاب هستند.
        function openCalendar(inputId, title) {
            $('#calendarTitle').text(title || 'انتخاب تاریخ');
            initCalendar(inputId, null, true);
            new bootstrap.Modal('#datePickerModal').show();
        }

        // خروجی فرار از HTML
        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // تبدیل عدد به فارسی + جداکننده هزارگان
        function faNum(n) { return Number(n || 0).toLocaleString('fa-IR'); }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function loadNotifBell() {
            $.get('/api/Admin/Messages/UnreadCount', function (res) {
                if (res.success) {
                    var badge = $('#notifBadge');
                    if (res.count > 0) {
                        badge.text(faNum(res.count)).show();
                    } else {
                        badge.hide();
                    }
                }
            });

            $.get('/api/Admin/Messages/Inbox', function (res) {
                if (res.success && res.data && res.data.length) {
                    var html = '';
                    res.data.slice(0, 5).forEach(function (m) {
                        html += '<a class="dropdown-item small py-2' + (m.isSeen ? '' : ' fw-bold') + '" href="/Admin/Messages">' +
                            '<div class="text-truncate">' + esc(m.senderName) + '</div>' +
                            '<div class="text-muted text-truncate" style="font-size:11px;">' + esc((m.title || m.body).substring(0, 60)) + '</div>' +
                        '</a>';
                    });
                    $('#notifList').html(html);
                } else {
                    $('#notifList').html('<span class="dropdown-item text-muted small">پیامی نیست</span>');
                }
            });
        }
        $(function () {
            loadNotifBell();
            setInterval(loadNotifBell, 30000); // هر ۳۰ ثانیه
        });
    </script>
</body>
</html>
