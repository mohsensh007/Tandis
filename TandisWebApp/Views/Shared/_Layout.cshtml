@inject TandisWebApp.Services.MessageService MessageService
@inject TandisWebApp.Services.ProfileService ProfileService
@{
    var fullName = HttpContextAccessor.HttpContext?.User?.FindFirst("FullName")?.Value ?? "کاربر";
    var clubName = "باشگاه تندیس";
    try { clubName = await ProfileService.GetClubNameAsync(); } catch { }
    var isAuthenticated = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true;
    var isCoach = HttpContextAccessor.HttpContext?.User?.FindFirst("RoleID")?.Value == "2";
    var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    var loadJalaliCalendar = currentPath == "/register/renew" || Equals(ViewData["LoadJalaliCalendar"], true);
    var loadReportPager = currentPath == "/home/reports" || Equals(ViewData["LoadReportPager"], true);
    var loadPayment = currentPath == "/home" || currentPath == "/home/index"
        || currentPath == "/ticket" || currentPath == "/ticket/index"
        || currentPath == "/shop" || currentPath == "/shop/index"
        || currentPath == "/shop/buffet" || currentPath == "/service"
        || currentPath == "/service/index" || currentPath == "/register/renew"
        || Equals(ViewData["LoadPaymentScript"], true);
    var loadCommerce = currentPath == "/service" || currentPath == "/service/index"
        || currentPath == "/ticket" || currentPath == "/ticket/index"
        || currentPath == "/shop" || currentPath == "/shop/index"
        || currentPath == "/shop/buffet";
    var unreadCount = 0;
    var msgPreview = new List<TandisWebApp.DTOs.MemberMessageRowDto>();

    if (isAuthenticated)
    {
        try
        {
            var (mid, rid) = await MessageService.ResolveCurrentMemberAsync(
                User.FindFirst("MemberID")?.Value
                    ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
                User.Identity?.Name);
            if (mid > 0)
            {
                unreadCount = await MessageService.GetMemberUnreadCountAsync(mid, rid);

                // ✅ فقط پیام‌های خوانده‌نشده، حداکثر ۳ تا (بدون اسکرول)
                msgPreview = (await MessageService.GetMemberMessagesAsync(mid, rid))
                    .Where(x => x.Direction == "in" && !x.IsRead)
                    .Take(3)
                    .ToList();
            }
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
    <script>(function(){try{var t=localStorage.getItem("tandis-theme");if(!t)t=window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","light");}})();</script>
<head>
    <!-- Web App Manifest برای PWA -->
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />

    <!-- Meta tags مخصوص Apple iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="تندیس" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/app-icon-180.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/app-icon-192.png" asp-append-version="true" />

    <!-- جلوگیری از ذخیره‌سازی در کش برای آپدیت‌های سریع‌تر -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta charset="utf-8" />
    <!-- viewport-fit=cover → فعال‌شدن env(safe-area-inset-*) برای نچ (iPhone) و نوار پایین iOS -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#EFF6FF" />
    <title>@ViewData["Title"] - تندیس</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panels.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />

    <style>
        /* ===== نوار پایین شناور (فقط موبایل) ===== */
        .bottom-nav {
            position: fixed;
            bottom: max(12px, env(safe-area-inset-bottom));
            left: max(14px, calc(env(safe-area-inset-left) + 6px));
            right: max(14px, calc(env(safe-area-inset-right) + 6px));
            z-index: 1030;
            display: flex;
            justify-content: space-around;
            align-items: stretch;
            background: rgba(239,246,255,.82);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(23,37,84,.08);
            border-radius: 22px;
            box-shadow: 0 12px 32px rgba(23,37,84,.45), inset 0 1px 0 rgba(23,37,84,.06);
            padding: 8px 6px;
        }

        .bn-item {
            flex: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            color: rgba(23,37,84, .62);
            text-decoration: none;
            font-size: .66rem;
            font-weight: 600;
            padding: 8px 0 5px;
            transition: color .3s, transform .15s;
        }

            .bn-item img {
                width: 26px;
                height: 26px;
                object-fit: contain;
                opacity: .7;
                filter: grayscale(40%);
                transition: all .35s cubic-bezier(.22,.9,.35,1.2);
            }

            .bn-item:active {
                transform: scale(.92);
            }

            .bn-item.bn-active {
                color: #172554;
            }

                .bn-item.bn-active img {
                    opacity: 1;
                    filter: none;
                    transform: translateY(-2px) scale(1.1);
                }

        /* ===== نشانگر نورانی سُر‌خور ===== */
        .bn-glow {
            position: absolute;
            top: 5px;
            left: 0;
            width: 34px;
            height: 4px;
            border-radius: 999px;
            background: linear-gradient(90deg, #3B82F6, #3B82F6);
            box-shadow: 0 0 14px rgba(59,130,246,.9);
            transform: translateX(-200px) translateX(-50%);
            transition: transform .5s cubic-bezier(.22,.9,.35,1.15), opacity .3s;
            opacity: 0;
            pointer-events: none;
        }

            .bn-glow.show {
                opacity: 1;
            }

        /* ===== مودال تأیید خروج ===== */
        .logout-modal {
            background: rgba(239,246,255,.96);
            border: 1px solid rgba(23,37,84,.15);
            border-radius: 18px;
            color: #172554;
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
            box-shadow: 0 20px 50px rgba(23,37,84,.5);
        }
         /* ===== ✅ اسم باشگاه رو‌به‌روی لوگو ===== */
    .navbar-brand-club {
        display: flex !important;
        align-items: center;
        gap: 12px;
        padding: 4px 12px 4px 4px;
        background: linear-gradient(135deg, rgba(255,255,255,.18), rgba(59,130,246,.14));
        border: 1px solid rgba(59,130,246,.28);
        border-radius: 14px;
        transition: all .25s;
    }
    .navbar-brand-club:hover {
        border-color: rgba(59,130,246,.55);
        box-shadow: 0 4px 14px rgba(59,130,246,.22);
        transform: translateY(-1px);
    }
    .club-logo {
        border-radius: 10px;
        filter: drop-shadow(0 2px 6px rgba(23,37,84,.3));
    }
    .club-name-wrap {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }
    .club-name {
        font-weight: 800;
        font-size: 1rem;
        color: #172554;
        white-space: nowrap;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .club-sub {
        font-size: .68rem;
        color: #172554;
        font-weight: 600;
    }
    /* ✅ در موبایل: لوگو بدون کادر، اسم باشگاه داخل کادر مجزا در گوشه چپ */
    @@media (max-width: 767.98px) {
        .navbar-brand-club {
            background: none;
            border: none;
            padding: 0;
            gap: 8px;
            flex: 1 1 auto;
            min-width: 0;
        }
        .club-logo {
            height: 34px !important;
            border-radius: 8px;
        }
        /* کادر مجزا برای اسم باشگاه — سمت چپ نوار */
        .club-name-wrap {
            order: 2;
            margin-right: auto;
            align-items: center;
            background: linear-gradient(135deg, rgba(255,255,255,.20), rgba(59,130,246,.16));
            border: 1px solid rgba(59,130,246,.30);
            border-radius: 12px;
            padding: 5px 14px;
            box-shadow: 0 4px 12px rgba(23,37,84,.20);
        }
        .club-name {
            font-size: .84rem;
            max-width: 150px;
        }
        .club-sub {
            font-size: .60rem;
        }
    }
        /* ===== ✅ ساعت دیجیتال داخل هدر (بین لوگو و اسم) ===== */
        .header-clock {
            order: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 1.15;
            padding: 3px 12px;
            background: rgba(59,130,246,.12);
            border: 1px solid rgba(59,130,246,.32);
            border-radius: 12px;
        }

        .hc-time {
            font-size: .95rem;
            font-weight: 800;
            color: #172554;
            font-variant-numeric: tabular-nums;
            direction: ltr;
            letter-spacing: 1px;
        }

        .hc-date {
            font-size: .58rem;
            color: #172554;
            font-weight: 700;
            white-space: nowrap;
        }

        .club-logo {
            order: 0;
        }

        .club-name-wrap {
            order: 2;
        }

        @@media (max-width: 767.98px) {
            .navbar-brand-club {
                justify-content: space-between;
            }

            .club-name-wrap {
                margin-right: 0;
            }
            /* حذف auto تا space-between کار کنه */
            .header-clock {
                padding: 2px 8px;
            }

            .hc-time {
                font-size: .78rem;
            }

            .hc-date {
                font-size: .5rem;
            }
        }
    /* فاصله محتوا از بار شناور تا چیزی زیرش قایم نشه */
    @@media (max-width: 767.98px) {
        body {
            padding-bottom: calc(96px + env(safe-area-inset-bottom));
        }
    }
        /* ============================================================
               ✅ هدر موبایل — بازطراحی: لوگو راست | ساعت دقیقاً وسط | اسم چپ
               ============================================================ */
        @@media (max-width: 767.98px) {
            /* نوار بالا: فاصله و خط زیر ظریف */
            .navbar {
                padding: 8px 0;
            }

                .navbar .container-fluid {
                    padding-right: 14px;
                    padding-left: 14px;
                }
            /* برند → شبکه ۳ ستونه: 1fr | auto | 1fr  ⇒ وسط همیشه دقیقاً وسطه */
            .navbar-brand-club {
                display: grid !important;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                width: 100%;
                background: none;
                border: none;
                padding: 4px 0;
                gap: 8px;
            }
            /* لوگو — سمت راست */
            .club-logo {
                grid-column: 1;
                justify-self: start; /* RTL = راست */
                order: 0;
                height: 38px !important;
                border-radius: 10px;
                filter: drop-shadow(0 2px 8px rgba(23,37,84,.4));
            }
            /* ساعت — دقیقاً وسط، بزرگ‌تر و درخشان‌تر */
            .header-clock {
                grid-column: 2;
                justify-self: center;
                order: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 6px 20px;
                border-radius: 16px;
                background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(59,130,246,.18));
                border: 1px solid rgba(59,130,246,.35);
                box-shadow: 0 4px 18px rgba(23,37,84,.35), inset 0 1px 0 rgba(23,37,84,.07);
                -webkit-backdrop-filter: blur(8px);
                backdrop-filter: blur(8px);
            }

            .hc-time {
                font-size: 1.25rem; /* بزرگ‌تر */
                font-weight: 800;
                letter-spacing: 1.5px;
                color: #172554;
                text-shadow: 0 0 14px rgba(59,130,246,.5);
            }

            .hc-date {
                font-size: .62rem;
                color: #172554;
                margin-top: 1px;
            }
            /* اسم باشگاه — سمت چپ، داخل کادر شیشه‌ای */
            .club-name-wrap {
                grid-column: 3;
                justify-self: end; /* RTL = چپ */
                order: 0;
                margin-right: 0; /* حذف auto تا grid درست بچینه */
                background: linear-gradient(135deg, rgba(255,255,255,.20), rgba(59,130,246,.16));
                border: 1px solid rgba(59,130,246,.30);
                border-radius: 12px;
                padding: 5px 14px;
            }

            .club-name {
                font-size: .84rem;
                max-width: 110px;
            }

            .club-sub {
                display: none;
            }
        }

        /* ===== iOS/Android safe-area: فاصله نوار بالا از نچ و آیتم‌ها از نوار پایین ===== */
        .navbar {
            padding-top: calc(8px + env(safe-area-inset-top));
        }
        /* ===== هدر دو ردیفه (نمونهٔ ارسالی) ===== */
        body.member-ui { overflow-x: clip !important; }
        .mh2 {
            position: sticky !important;
            top: 0;
            z-index: 1040;
            padding: 0 !important;
            background: linear-gradient(180deg, #FFFFFF 0%, #EFF6FF 100%) !important;
            border-bottom: 1px solid rgba(23,37,84,.22);
            box-shadow: 0 10px 30px rgba(23,37,84,.35);
            transition: transform .38s cubic-bezier(.22,.9,.35,1), box-shadow .3s;
            will-change: transform;
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
        }
        .mh2.mh-hidden { transform: translateY(-118%); box-shadow: none; }
        .mh2-inner {
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: calc(8px + env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) 8px max(14px, env(safe-area-inset-left));
        }
        .mh2-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
        .mh2-top-end { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; margin-inline-start: auto; min-width: 0; }
        .mh2-top-end .mh2-club { max-width: min(44vw, 20rem); }
        /* ✅ اسم باشگاه + لوگو + «ایمن تردد تندیس» همه در یک بلوک (اسم سمت چپ تصویر) */
        .mh2-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; flex: 1 1 auto; max-width: 100%; }
        .mh2-logo-wrap {
            width: 44px;
            height: 44px;
            flex: 0 0 auto;
            display: grid;
            place-items: center;
            background: none;
            border: 0;
            box-shadow: none;
            padding: 0;
        }
        /* ✅ تصویر لوگو در هیچ حالتی بریده/پوشیده نمی‌شود */
        .mh2-logo { width: 44px; height: 44px; object-fit: contain; object-position: center; border-radius: 0; display: block; filter: drop-shadow(0 3px 8px rgba(239,246,255, .55)); }
        .mh2-titles { display: flex; flex-direction: column; gap: 1px; min-width: 0; overflow: hidden; }
        .mh2-title { font-size: clamp(.82rem, 3.4vw, 1rem); font-weight: 800; color: #172554; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mh2-sub { font-size: clamp(.56rem, 2.4vw, .66rem); color: #172554; font-weight: 700; letter-spacing: .2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        /* ✅ اسم باشگاه: چسبیده به لبهٔ چپ هدر (نه وسط، نه داخل باکس) */
        .mh2-clubwrap { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 0 0 auto; margin-inline-start: auto; margin-inline-end: 0; padding-inline-end: 0; }
        .mh2-sep { display: none; width: 1px; height: 26px; background: linear-gradient(180deg, transparent, rgba(191, 219, 254,.6), transparent); }
        .mh2-club { color: #172554; font-size: clamp(.76rem, 2.6vw, .92rem); font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: min(48vw, 24rem); text-align: left; }
        .mh2-rule { height: 1px; background: linear-gradient(90deg, rgba(191, 219, 254,.5), rgba(23,37,84,.10) 55%, transparent); }
        .mh2-bottom { display: flex; align-items: center; justify-content: flex-start; gap: 8px; flex-wrap: nowrap; min-width: 0; }
        .mh2-clock { display: flex; align-items: center; gap: 8px; font-size: .72rem; color: #172554; flex-wrap: wrap; }
        .mh2-clock b { color: #172554; font-size: .8rem; font-weight: 800; font-variant-numeric: tabular-nums; }
        .mh2-lbl { color: #172554; }
        .mh2-dot { width: 7px; height: 7px; border-radius: 50%; background: #EFF6FF; box-shadow: 0 0 10px rgba(23,37,84,.85); flex: 0 0 auto; }
        /* ✅ دکمهٔ اثر انگشت / چهره در هدر */
        .mh2-bio {
            flex: 0 0 auto;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            border: 1px solid rgba(23,37,84, .34);
            background: rgba(191, 219, 254, .12);
            color: #172554;
            font-size: 1.2rem;
            line-height: 1;
            transition: all .2s;
        }
        .mh2-bio:hover { color: #172554; background: rgba(191, 219, 254, .22); }
        .mh2-bio.bio-on { color: #172554; border-color: rgba(23,37,84, .60); box-shadow: 0 0 0 2px rgba(23,37,84, .18) inset; }
        .mh2-bio i { display: block; }
        .mh2-actions { flex-direction: row; gap: 4px; margin: 0; align-items: center; }
        .mh2-actions .nav-link {
            color: #172554;
            padding: 0;
            width: 40px;
            height: 40px;
            min-width: 40px;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            line-height: 1;
        }
        .mh2-actions .nav-link .bi,
        .mh2-actions .nav-link i { display: block; font-size: 1.05rem; line-height: 1; }
        .mh2-actions #memberBell .bi { font-size: 1.15rem; }
        .mh2-actions .nav-link:hover { color: #172554; background: rgba(191, 219, 254,.12); }
        .mh2-actions .member-user-name { max-width: 8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        /* ✅ چیدمان هدر بر اساس اندازهٔ دستگاه */
        .mh2-inner { padding-left: max(10px, env(safe-area-inset-left)); }
        @@media (max-width: 700px) {
            .mh2-club { max-width: 42vw; }
        }
        @@media (max-width: 520px) {
            .mh2-sub { display: block; font-size: .55rem; }
            .mh2-title { font-size: .92rem; }
            .mh2-logo-wrap, .mh2-logo { width: 40px; height: 40px; }
            .mh2-club { font-size: .78rem; max-width: 38vw; }
            .mh2-clock { gap: 6px; font-size: .66rem; }
            .mh2-clock b { font-size: .72rem; }
        }
        @@media (max-width: 380px) {
            .mh2-date { display: none; }
        }
        @@media (max-width: 430px) {
            .mh2-clock { gap: 5px; font-size: .64rem; }
            .mh2-clock b { font-size: .7rem; }
            .mh2-lbl { display: none; }
            .mh2-actions .nav-link { width: 36px; height: 36px; min-width: 36px; min-height: 36px; }
        }
        @@media (max-width: 340px) {
            .mh2-club, .mh2-sep { display: none; }
        }
    </style>
    <link rel="stylesheet" href="~/css/member-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-performance.css" asp-append-version="true" />
    @if (loadCommerce)
    {
        <link rel="stylesheet" href="~/css/member-commerce.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/luna.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-arctic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-glass.css" asp-append-version="true" />
</head>
<body class="admin-glass-body member-ui">
    @if (!isAuthenticated)
    {
        <script>
            var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = '/Account/Login?returnUrl=' + returnUrl;
        </script>
    }
    else
    {
        <nav class="navbar member-header mh2" id="memberHeader" aria-label="ناوبری اصلی">
            <div class="mh2-inner">
                <div class="mh2-top">
                    <a class="mh2-brand" href="@(isCoach ? "/Coach" : "/Home")" aria-label="@clubName — ایمن تردد تندیس">
                        <span class="mh2-logo-wrap">
                            <img src="~/images/logo2.png" alt="@clubName" width="38" height="38" decoding="async" class="mh2-logo" asp-append-version="true" />
                        </span>
                        <span class="mh2-titles">
                            <span class="mh2-title">ایمن تردد تندیس</span>
                            <span class="mh2-sub">نرم افزار جامع اتوماسیون مراکز ورزشی</span>
                        </span>
                    </a>

                    <div class="mh2-top-end">
                        <!-- ✅ اسم باشگاه (از دیتابیس) — سمت چپ هدر -->
                        <span class="mh2-club" title="@clubName">@clubName</span>

                        <!-- ✅ ثبت اثر انگشت / چهره برای ورود بدون رمز -->
                        <button type="button" class="mh2-bio" data-bio-enroll="1" id="btnMemberBio"
                                title="ثبت اثر انگشت / چهره" aria-label="ثبت اثر انگشت یا چهره">
                            <i class="bi bi-fingerprint" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="mh2-rule" aria-hidden="true"></div>

                <div class="mh2-bottom">
                    <div class="mh2-clock" aria-label="ساعت و تاریخ">
                        <span class="mh2-dot" aria-hidden="true"></span>
                        <span class="mh2-time"><span class="mh2-lbl">ساعت:</span> <b id="hdrTime">--:--:--</b></span>
                        <span class="mh2-date"><span class="mh2-lbl">تاریخ:</span> <b id="hdrDate">-</b></span>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container mt-3 member-main" id="mainContent">
            @RenderBody()
        </main>

        <!-- ✅ فوتر حذف شد -->
        <!-- ========== نوار پایین شناور (فقط موبایل) ========== -->
        <nav class="purple-style bottom-nav d-md-none" id="bottomNav" aria-label="ناوبری پایین">
            <span class="bn-glow" id="bnGlow"></span>

            <a href="@(isCoach ? "/Coach" : "/Home")" class="bn-item" data-key="home">
                <i class="bi bi-house-door-fill bn-icon" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <a href="/Profile/Messages" class="bn-item" data-key="messages">
                <span class="position-relative d-inline-block">
                    <i class="bi bi-chat-dots-fill bn-icon" aria-hidden="true"></i>
                    @if (unreadCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:9px;">@unreadCount</span>
                    }
                </span>
                <span>پیام‌ها</span>
            </a>
            <a href="/Home/Reports" class="bn-item" data-key="reports">
                <i class="bi bi-bar-chart-line-fill bn-icon" aria-hidden="true"></i>
                <span>گزارش‌ها</span>
            </a>
            <a href="/Profile" class="bn-item" data-key="profile">
                <i class="bi bi-person-circle bn-icon" aria-hidden="true"></i>
                <span>پروفایل</span>
            </a>
            <a href="/Account/Logout" class="bn-item js-logout" data-key="exit">
                <i class="bi bi-box-arrow-right bn-icon" aria-hidden="true"></i>
                <span>خروج</span>
            </a>
        </nav>

        <!-- مودال لیست پیام‌های عضو -->
        <div class="modal fade" id="memberMessagesModal" tabindex="-1" aria-labelledby="memberMessagesTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="memberMessagesTitle"><i class="bi bi-envelope-paper" aria-hidden="true"></i> پیام‌های من</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                    </div>
                    <div class="modal-body">
                        <div id="messagesList" class="d-flex flex-column gap-2">
                            <div class="text-center text-muted py-4">در حال بارگذاری...</div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <button class="btn btn-outline-success" id="btnMarkAllRead">
                            <i class="bi bi-check2-all me-1"></i> خواندن همه
                        </button>
                        @* ⛔ محدودسازی پیام‌رسانی (غیرفعال شده — فقط کامنت شده، حذف نشده):
                           فقط ادمین اجازه‌ی ارسال دارد؛ دکمه‌ی «پیام به مدیریت» برداشته شد.
                           برای فعال‌سازی دوباره کافی است کامنت زیر برداشته شود. *@
                        @*
                        <button class="btn btn-primary" id="btnOpenSend">
                            <i class="bi bi-send-fill me-1"></i> پیام به مدیریت
                        </button>
                        *@
                    </div>
                </div>
            </div>
        </div>

        @* ⛔ محدودسازی پیام‌رسانی (غیرفعال شده — فقط کامنت شده، حذف نشده):
           فقط ادمین اجازه‌ی ارسال پیام دارد؛ مودال «پیام به مدیریت» برای عضو غیرفعال شد.
           برای فعال‌سازی دوباره کافی است کامنت زیر برداشته شود. *@
        @*
        <!-- مودال ارسال پیام به مدیریت -->
        <div class="modal fade" id="sendToAdminModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">✉️ پیام به مدیریت</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">عنوان (اختیاری)</label>
                            <input type="text" class="form-control" id="txtMemberMsgTitle" maxlength="200">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">متن پیام</label>
                            <textarea class="form-control" id="txtMemberMsgBody" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="btn btn-primary" id="btnSendToAdmin">ارسال</button>
                    </div>
                </div>
            </div>
        </div>
        *@

        <!-- مودال تأیید خروج -->
        <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmTitle" aria-describedby="logoutConfirmDescription" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="purple-style modal-content logout-modal">
                    <div class="modal-body text-center p-4">
                        <div class="member-logout-icon"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></div>
                        <h6 class="mt-2 mb-1" id="logoutConfirmTitle">خروج از حساب</h6>
                        <p class="small text-muted mb-3" id="logoutConfirmDescription">آیا مطمئن هستید که می‌خواهید خارج شوید؟</p>
                        <div class="d-flex gap-2 member-logout-actions">
                            <button type="button" class="btn btn-secondary btn-sm flex-fill" data-bs-dismiss="modal">انصراف</button>
                            <button type="button" class="btn btn-danger btn-sm flex-fill" id="btnConfirmMemberLogout">
                                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i> خروج
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
        @if (loadJalaliCalendar)
        {
            <script src="~/js/jalali-calendar.js" asp-append-version="true"></script>
        }
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/biometric.js" asp-append-version="true"></script>
        @if (loadReportPager)
        {
            <script src="~/js/report-pager.js" asp-append-version="true"></script>
        }
        @if (loadPayment)
        {
            <script src="~/js/payment.js" asp-append-version="true"></script>
        }
        @if (loadCommerce)
        {
            <script src="~/js/member-commerce.js" asp-append-version="true"></script>
        }
        <script src="~/js/member-messages.js" asp-append-version="true"></script>

        <!-- ✅ نشانگر سُر‌خور نوار پایین -->
        <script>
            (function () {
                var bar = document.getElementById('bottomNav');
                if (!bar) return;
                var glow = document.getElementById('bnGlow');
                var items = Array.prototype.slice.call(bar.querySelectorAll('.bn-item'));
                if (!glow || !items.length) return;

                // --- تشخیص بخش فعلی از روی URL ---
                var path = window.location.pathname.toLowerCase();
                var currentKey = 'home';
                if (path.indexOf('/home/reports') === 0) {
                    currentKey = 'reports';
                } else if (path.indexOf('/profile/messages') === 0 || path.indexOf('/coach/messages') === 0 || path.indexOf('/coach/chat') === 0) {
                    currentKey = 'messages';
                } else if (path.indexOf('/profile') === 0) {
                    currentKey = 'profile';
                }

                function findItem(key) {
                    for (var i = 0; i < items.length; i++) {
                        if (items[i].getAttribute('data-key') === key) return items[i];
                    }
                    return null;
                }

                var current = findItem(currentKey);
                var lastKey = sessionStorage.getItem('bnLastKey');
                var lastItem = lastKey ? findItem(lastKey) : null;

                function centerOf(item) {
                    return item.offsetLeft + item.offsetWidth / 2;
                }

                function placeAt(item, animate) {
                    if (!item) return;
                    if (!animate) glow.style.transition = 'none';
                    glow.style.transform = 'translateX(' + centerOf(item) + 'px) translateX(-50%)';
                    if (!animate) {
                        void glow.offsetWidth;          // force reflow
                        glow.style.transition = '';
                    }
                    glow.classList.add('show');
                }

                // --- علامت‌گذاری آیتم فعال ---
                items.forEach(function (i) {
                    i.classList.toggle('bn-active', i === current);
                    if (i === current) i.setAttribute('aria-current', 'page');
                    else i.removeAttribute('aria-current');
                });

                if (current) {
                    if (lastItem && lastItem !== current) {
                        // ✅ افکت: از روی آیتم صفحه قبلی سُر می‌خوره به آیتم فعلی
                        placeAt(lastItem, false);
                        requestAnimationFrame(function () {
                            requestAnimationFrame(function () { placeAt(current, true); });
                        });
                    } else {
                        placeAt(current, false);
                    }
                }

                sessionStorage.setItem('bnLastKey', currentKey);

                window.addEventListener('resize', function () { placeAt(current, false); });
            })();
        </script>
        <!-- ✅ ساعت زنده هدر (بین لوگو و اسم باشگاه) -->
        <script>
            (function () {
                function faD(n) { return String(n).replace(/\d/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[d]; }); }
                function p2(x) { return (x < 10 ? '0' : '') + x; }
                function tickHdr() {
                    var n = new Date();
                    var el = document.getElementById('hdrTime');
                    if (el) el.textContent = faD(p2(n.getHours()) + ':' + p2(n.getMinutes()) + ':' + p2(n.getSeconds()));
                }
                var d0 = new Date();
                var de = document.getElementById('hdrDate');
                if (de) de.textContent = d0.toLocaleDateString('fa-IR', { weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit' });
                tickHdr();
                setInterval(tickHdr, 1000);
            })();
        </script>
        <!-- ✅ تأیید خروج: به جای خروج مستقیم، مودال سؤال می‌پرسه -->
        <script>
            $(document).on('click', '.js-logout', function (e) {
                e.preventDefault();
                bootstrap.Modal.getOrCreateInstance(document.getElementById('logoutConfirmModal')).show();
            });
            $('#btnConfirmMemberLogout').on('click', function () {
                window.location.href = '/Account/Logout';
            });
        </script>

        <script>
            // ✅ ناوبری ماه‌های تقویم (کپی از پنل ادمین)
            $('#prevMonth').click(function () {
                calendarDate.m++;
                if (calendarDate.m > 12) { calendarDate.m = 1; calendarDate.y++; }
                renderCalendar();
            });
            $('#nextMonth').click(function () {
                calendarDate.m--;
                if (calendarDate.m < 1) { calendarDate.m = 12; calendarDate.y--; }
                renderCalendar();
            });

            // ✅ تابع باز کردن تقویم (نسخه واقعی)
            function openCalendar(inputId, title, allowPast) {
                $('#calendarTitle').text(title || 'انتخاب تاریخ');
                initCalendar(inputId, null, allowPast || false);
                new bootstrap.Modal('#datePickerModal').show();
            }
        </script>

        <script>
            // ✅ هدر: با اسکرول به پایین مخفی، با اسکرول به بالا ظاهر می‌شود
            (function () {
                var hdr = document.getElementById('memberHeader');
                if (!hdr) return;
                var lastY = window.pageYOffset || document.documentElement.scrollTop || 0;
                var ticking = false;
                function onScroll() {
                    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
                    if (y <= 12) { hdr.classList.remove('mh-hidden'); lastY = y; return; }
                    var diff = y - lastY;
                    if (Math.abs(diff) < 6) return;
                    if (diff > 0 && y > 70) hdr.classList.add('mh-hidden');
                    else hdr.classList.remove('mh-hidden');
                    lastY = y;
                }
                window.addEventListener('scroll', function () {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(function () { onScroll(); ticking = false; });
                }, { passive: true });
            })();
        </script>

        <!-- ✅ اضافه شد -->
        @await RenderSectionAsync("Scripts", required: false)
    }
    <script src="~/js/theme.js" asp-append-version="true"></script>
</body>
</html>
