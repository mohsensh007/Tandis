@inject TandisWebApp.Services.ProfileService ProfileService
@{
    var clubName = "باشگاه تندیس";
    string? clubLogoSrc = null;

    try { clubName = await ProfileService.GetClubNameAsync(); } catch { }

    try
    {
        var logoBytes = await ProfileService.GetClubLogoAsync();
        if (logoBytes != null && logoBytes.Length > 0)
        {
            clubLogoSrc = "data:" + TandisWebApp.Services.ProfileService.DetectImageType(logoBytes)
                        + ";base64," + Convert.ToBase64String(logoBytes);
        }
    }
    catch { }
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <!-- PWA / Add to Home Screen -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="تندیس" />
    <link rel="apple-touch-icon" href="/images/app-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta charset="utf-8" />
    <!-- viewport-fit=cover → فعال‌شدن env(safe-area-inset-*) برای نچ (iPhone) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>@ViewData["Title"] - تندیس</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=6" />
    <link rel="stylesheet" href="~/css/panels.css?v=4" />
    <link rel="stylesheet" href="~/css/login-style.css?v=2" />

    <style>
        /* ===== ✅ فلیپ ۳بعدی کارت بین ورود / ثبت‌نام ===== */
        .login-fullscreen {
            perspective: 1600px;
        }

        #authCard {
            transform-style: preserve-3d;
            will-change: transform, opacity;
        }

        @@keyframes authFlipOut {
            to {
                transform: rotateY(88deg);
                opacity: 0;
            }
        }

        @@keyframes authFlipIn {
            from {
                transform: rotateY(-88deg);
                opacity: 0;
            }

            to {
                transform: rotateY(0);
                opacity: 1;
            }
        }

        /* ===== ✅ لوگوی کوچک ما — گوشه پایین-چپ کارت ===== */
        .mini-logo {
            position: absolute;
            bottom: 14px;
            left: 14px;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            opacity: .92;
            filter: drop-shadow(0 2px 6px rgba(0,0,0,.4));
        }

        /* ===== ✅ فلش بازگشت به ورود (فقط صفحه ثبت‌نام) ===== */
        .reg-back-arrow:hover {
            color: #66d3e8 !important;
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <div class="login-fullscreen">
        <!-- عکس پس‌زمینه -->
        <div class="login-background">
            <img src="~/images/gym-login-bg.webp" alt="ورزش" class="bg-image" />
            <div class="bg-overlay"></div>
        </div>

        <!-- ✅ فرم شیشه‌ای — این همون «کارت» هست که می‌چرخه -->
        <div class="purple-style login-glass-card" id="authCard" style="position:relative;">

            <!-- ✅ فلش بازگشت به ورود (فقط توی صفحه ثبت‌نام) -->
            @if (ViewData["Title"]?.ToString() == "ثبت‌نام")
            {
                <a href="javascript:void(0)" onclick="flipNavigate('/Account/Login')" title="بازگشت به ورود" id="regBackArrow"
                   style="position:absolute; top:12px; right:12px; z-index:6;
                              color:#fff; font-size:1.45rem; text-decoration:none;
                              text-shadow:0 0 10px rgba(102,211,232,.5);
                              transition:all .2s;">
                    <i class="bi bi-arrow-right"></i>
                </a>
            }

            <!-- ✅ بخش لوگو -->
            <div class="logo-section text-center mb-4">
                @if (clubLogoSrc != null)
                {
                    <!-- بالا فقط لوگوی خودِ باشگاه -->
                    <img src="@clubLogoSrc" alt="@clubName" class="main-logo" style="object-fit:contain;" />

                }
                else
                {
                    <!-- اگه باشگاه لوگو نداشت → لوگوی ما بزرگ بالا -->
                    <img src="~/images/logo2.png" alt="@clubName" class="main-logo" />
                }
                <h2 class="brand-text mt-3">@clubName</h2>
            </div>

            <div class="form-container">
                @RenderBody()
            </div>

            <!-- ✅ لوگوی ما کوچک: لاگین → پایین-چپ | ثبت‌نام → بالا-چپ (بدون تداخل) -->
            @if (clubLogoSrc != null)
            {
                <img src="~/images/logo2.png" alt="ایمن تردد" class="mini-logo"
                     style="@(ViewData["Title"]?.ToString() == "ثبت‌نام" ? "top:12px; left:12px; bottom:auto;" : "")" />
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=6"></script>

    <!-- ✅ منطق فلیپ کارت (مشترک بین ورود و ثبت‌نام) -->
    <script>
        // چرخش کارت به بیرون + رفتن به مقصد
        window.flipNavigate = function (url) {
            sessionStorage.setItem('authFlip', '1');
            var card = document.getElementById('authCard');
            if (!card) { window.location.href = url; return; }
            card.style.animation = 'authFlipOut .3s ease-in forwards';
            setTimeout(function () { window.location.href = url; }, 280);
        };

        function playFlipIn() {
            var card = document.getElementById('authCard');
            if (card) card.style.animation = 'authFlipIn .45s cubic-bezier(.22,.9,.35,1.1)';
        }

        // بارگذاری عادی
        document.addEventListener('DOMContentLoaded', function () {
            if (sessionStorage.getItem('authFlip') === '1') {
                sessionStorage.removeItem('authFlip');
                playFlipIn();
            }
        });

        // ✅ فیکس دکمه Back مرورگر (bfcache)
        window.addEventListener('pageshow', function (e) {
            if (!e.persisted) return;
            var card = document.getElementById('authCard');
            if (!card) return;
            card.style.animation = 'none';
            void card.offsetWidth;
            playFlipIn();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>