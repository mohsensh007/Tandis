@{
    ViewData["Title"] = "مالی";
}

<div class="row g-3">
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">بدهی کل</div>
            <div class="fw-bold text-danger fs-5" id="totalDebit">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">اعتبار ورزشی</div>
            <div class="fw-bold text-success fs-5" id="sportCredit">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">اعتبار فروشگاه</div>
            <div class="fw-bold text-info fs-5" id="buffetCredit">-</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">اعتبار سرویس</div>
            <div class="fw-bold text-warning fs-5" id="serviceCredit">-</div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>تراکنش‌های مالی</span>
        <a href="/Accounting/AddMoney" class="btn btn-sm btn-light">💰 شارژ اعتبار</a>
    </div>
    <div class="card-body">
        <div id="docList"><div class="text-center text-muted p-3">در حال بارگذاری...</div></div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        apiCall('/api/Accounting/FinanceSummary', 'GET', null, function (res) {
            var d = res.data;
            $('#totalDebit').text(d.totalDebitDisplay);
            $('#sportCredit').text(d.sportCreditDisplay);
            $('#buffetCredit').text(d.buffetCreditDisplay);
            $('#serviceCredit').text(d.serviceCreditDisplay);
        });

        apiCall('/api/Accounting/FinanceDocs', 'GET', null, function (res) {
            var html = '';
            if (!res.data || res.data.length === 0) {
                html = '<div class="text-center text-muted p-3">تراکنشی یافت نشد</div>';
            } else {
                html = '<div class="table-responsive"><table class="table table-striped table-sm"><thead><tr>' +
                    '<th>تاریخ</th><th>نوع</th><th>شرح</th><th>مبلغ</th></tr></thead><tbody>';
                $.each(res.data, function (i, d) {
                    var typeBadge = d.docType === 'بستانکار' ? 'bg-success' : 'bg-danger';
                    html += '<tr><td>' + (d.creationDateDisplay || '-') + '</td>' +
                        '<td><span class="badge ' + typeBadge + '">' + d.docType + '</span></td>' +
                        '<td>' + (d.docDesc || '-') + '</td><td>' + d.amountDisplay + '</td></tr>';
                });
                html += '</tbody></table></div>';
            }
            $('#docList').html(html);
        });
    });
</script>
}
