@{
    ViewData["Title"] = "خرید بلیت";
}

<div class="commerce-page" data-commerce-page="ticket">
    <section class="commerce-hero" aria-labelledby="ticketPageTitle">
        <div class="commerce-hero-content">
            <span class="commerce-kicker"><i class="bi bi-ticket-perforated" aria-hidden="true"></i> ورود مهمان و جلسه آزاد</span>
            <h1 id="ticketPageTitle">خرید بلیت جلسه آزاد</h1>
            <p>تعرفه مناسب را انتخاب کنید؛ مبلغ از اعتبار ورزشی شما کسر می‌شود یا با POS پرداخت می‌کنید.</p>
        </div>
        <div class="commerce-hero-icon" aria-hidden="true"><i class="bi bi-ticket-detailed"></i></div>
    </section>

    <div class="commerce-notice" role="note">
        <i class="bi bi-wallet2" aria-hidden="true"></i>
        <span>صدور بلیت به‌صورت آنی انجام می‌شود. پس از ثبت موفق، پیام نتیجه را مشاهده خواهید کرد.</span>
    </div>

    <section class="commerce-panel" aria-labelledby="ticketListTitle">
        <div class="commerce-panel-head">
            <h2 class="commerce-panel-title" id="ticketListTitle"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> تعرفه‌های فعال</h2>
            <span class="commerce-count" id="ticketCount" aria-label="تعداد تعرفه‌ها">۰</span>
        </div>
        <div id="ticketList" class="commerce-grid" aria-live="polite">
            <div class="commerce-status"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>در حال بارگذاری تعرفه‌ها…</span></div>
        </div>
    </section>
</div>
